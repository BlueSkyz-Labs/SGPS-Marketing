---
import Header from "@/components/layout/Header.astro";
import Footer from "@/components/layout/Footer.astro";
import CommandNavigator from "@/components/experience/CommandNavigator.astro";
import JourneyBar from "@/components/experience/JourneyBar.astro";
import IntegrityLens from "@/components/integrity/IntegrityLens.astro";
import { SITE } from "@/data/site";
import {
  absoluteUrl,
  canonicalForPath,
  defaultOgImagePath,
  hreflangLinks,
  organizationJsonLd,
  safeJsonLd,
  websiteJsonLd,
} from "@/lib/seo";
import { getAlternatePath, getLanguageFromPath } from "@/lib/i18n";
import { isNonProductionSiteUrl } from "@/lib/truth";
import "@/styles/global.css";

interface Props {
  title: string;
  description: string;
  path?: string;
  ogImage?: string;
  noindex?: boolean;
  /** Stable integrity surface id; the lens renders only for modeled surfaces. */
  surface?: string;
}

const {
  title,
  description,
  path = Astro.url.pathname,
  ogImage = defaultOgImagePath(),
  noindex = false,
  surface,
} = Astro.props;

const fullTitle = title.includes(SITE.name) ? title : `${title} · ${SITE.name}`;
const currentLang = getLanguageFromPath(path);
const canonical = canonicalForPath(path, SITE.url);
const ogImageUrl = absoluteUrl(SITE.url, ogImage);
const structuredData = [organizationJsonLd(SITE.url), websiteJsonLd(SITE.url)];
const robotsNoindex = noindex || isNonProductionSiteUrl(SITE.url);
---

<!doctype html>
<html lang={currentLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" href="/icons/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/icons/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <link rel="manifest" href="/icons/site.webmanifest" />
    <link rel="mask-icon" href="/icons/safari-pinned-tab.svg" color="#2564FF" />
    <meta name="msapplication-config" content="/browserconfig.xml" />
    <meta name="theme-color" content="#0B1020" />
    <meta name="description" content={description} />
    <title>{fullTitle}</title>
    <link rel="canonical" href={canonical} />
    {
      hreflangLinks(path, SITE.url).map((link) => (
        <link rel="alternate" hreflang={link.hreflang} href={link.href} />
      ))
    }
    <link
      rel="alternate"
      hreflang="x-default"
      href={canonicalForPath(getAlternatePath(path, "en"), SITE.url)}
    />
    {robotsNoindex ? <meta name="robots" content="noindex, nofollow" /> : null}
    <meta property="og:type" content="website" />
    <meta
      property="og:locale"
      content={currentLang === "vi" ? "vi_VN" : "en_US"}
    />
    <meta
      property="og:locale:alternate"
      content={currentLang === "vi" ? "en_US" : "vi_VN"}
    />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    {
      structuredData.map((data) => (
        <script
          is:inline
          type="application/ld+json"
          set:html={safeJsonLd(data)}
        />
      ))
    }
  </head>
  <body class="flex min-h-screen flex-col">
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <Header />
    <CommandNavigator />
    <script>
      import { initAnalyticsBridge } from "@/scripts/analytics-bridge";

      initAnalyticsBridge();
    </script>
    <main id="main-content" class="flex-1" tabindex="-1">
      <slot />
      {surface ? <IntegrityLens surface={surface} lang={currentLang} /> : null}
      <JourneyBar />
    </main>
    <Footer />
  </body>
</html>
