---
import Container from "@/components/layout/Container.astro";
import BrandStory from "@/components/sections/BrandStory.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { SITE } from "@/data/site";
---

<BaseLayout
  title="About BlueSkyz"
  description="Meet BlueSkyz Labs, the product house founded by Tony Nguyen in Ho Chi Minh City."
>
  <Container class="py-16 sm:py-20">
    <section class="max-w-3xl" aria-labelledby="about-page-title">
      <p
        class="text-xs font-semibold tracking-[0.16em] text-[var(--text-muted)] uppercase"
      >
        About BlueSkyz
      </p>
      <h1
        id="about-page-title"
        class="mt-4 text-4xl font-semibold tracking-tight sm:text-5xl"
      >
        Build with clarity. Earn trust through the work.
      </h1>
      <p class="mt-6 max-w-2xl text-lg leading-8 text-[var(--text-secondary)]">
        {SITE.proposition} {SITE.supporting}
      </p>
    </section>

    <BrandStory />
  </Container>
</BaseLayout>
