---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Container from "@/components/layout/Container.astro";
import PageHeader from "@/components/layout/PageHeader.astro";
import EditionIndex from "@/components/editorial/EditionIndex.astro";
---

<BaseLayout
  title="Tuyển tập"
  description="Tuyển chọn các tuyên bố site này đã công bố, mỗi mục dẫn tới bằng chứng phía sau."
  path="/vi/editions/"
>
  <section class="py-16 lg:py-24">
    <Container>
      <PageHeader
        title="Tuyển tập đã công bố"
        lede="Tuyển chọn các tuyên bố đã công bố tại đây. Mỗi tuyển tập dẫn tới bằng chứng của từng mục; không thêm bất cứ điều gì site chưa công bố."
      />
      <div class="mt-12">
        <EditionIndex lang="vi" />
      </div>
    </Container>
  </section>
</BaseLayout>
