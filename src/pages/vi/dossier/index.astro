---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { PAGE_META } from "@/data/page-meta";
import Container from "@/components/layout/Container.astro";
import PageHeader from "@/components/layout/PageHeader.astro";
import DossierComposer from "@/components/dossier/DossierComposer.astro";
---

<BaseLayout
  title={PAGE_META["vi"].dossier.title}
  description={PAGE_META["vi"].dossier.description}
  path="/vi/dossier/"
>
  <section class="py-16 lg:py-24">
    <Container>
      <PageHeader
        title="Bản tóm tắt để in"
        lede="Chọn các tuyên bố và nguồn đã công bố để in hoặc trình bày. Không có gì rời khỏi trang này và không có gì được lưu."
      />
      <div class="mt-12">
        <DossierComposer lang="vi" />
      </div>
    </Container>
  </section>
</BaseLayout>
