---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { PAGE_META } from "@/data/page-meta";
import Container from "@/components/layout/Container.astro";
import DossierDocument from "@/components/dossier/DossierDocument.astro";
---

<BaseLayout
  title={PAGE_META["vi"].dossierPrint.title}
  description={PAGE_META["vi"].dossierPrint.description}
  path="/vi/dossier/print/"
  noindex
  followLinks
>
  <section class="py-16 lg:py-24">
    <Container>
      <DossierDocument lang="vi" />
    </Container>
  </section>
</BaseLayout>
