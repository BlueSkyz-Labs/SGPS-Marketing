---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Container from "@/components/layout/Container.astro";
import ButtonLink from "@/components/ui/ButtonLink.astro";
import PageHeader from "@/components/layout/PageHeader.astro";
---

<BaseLayout
  title="Không tìm thấy trang"
  description="Trang bạn yêu cầu không thể tìm thấy."
  path="/vi/404/"
  noindex={true}
>
  <section class="py-20 lg:py-28">
    <Container>
      <PageHeader
        eyebrow="404"
        eyebrowVariant="numeral"
        title="Không tìm thấy trang này"
        lede="Có thể trang đã được chuyển sang địa chỉ khác. Bạn thử một trong các liên kết dưới đây."
      />
      <div class="mt-10 flex flex-wrap gap-3">
        <ButtonLink href="/vi/" variant="primary">
          Về trang chủ
        </ButtonLink>
        <ButtonLink href="/vi/products/" variant="secondary">
          Xem sản phẩm
        </ButtonLink>
      </div>
    </Container>
  </section>
</BaseLayout>
