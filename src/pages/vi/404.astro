---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Container from "@/components/layout/Container.astro";
import ButtonLink from "@/components/ui/ButtonLink.astro";
import PageHeader from "@/components/layout/PageHeader.astro";
---

<BaseLayout
  title="Không tìm thấy trang"
  description="Trang bạn yêu cầu không thể tìm thấy."
  path="/vi/404/"
  noindex={true}
>
  <section class="py-20 lg:py-28">
    <Container>
      <div class="not-found-moment mx-auto max-w-2xl text-center">
        <div class="sail-drift" aria-hidden="true">
          ⛵
        </div>
        <div class="mt-6">
          <PageHeader
            eyebrow="404"
            eyebrowVariant="numeral"
            title="Không tìm thấy trang này"
            lede="Lạc giữa biển khơi? Cánh buồm nào cũng có lúc lạc hướng. Để chúng tôi đưa bạn về đúng đường."
          />
        </div>
        <div class="mt-10 flex flex-wrap justify-center gap-3">
          <ButtonLink href="/vi/" variant="primary">
            Về trang chủ
          </ButtonLink>
          <ButtonLink href="/vi/products/" variant="secondary">
            Xem sản phẩm
          </ButtonLink>
        </div>
      </div>
    </Container>
  </section>
</BaseLayout>
