---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Container from "@/components/layout/Container.astro";
import ButtonLink from "@/components/ui/ButtonLink.astro";
---

<BaseLayout
  title="Không tìm thấy trang"
  description="Trang bạn yêu cầu không thể tìm thấy."
  path="/vi/404/"
  noindex={true}
>
  <section class="py-20 lg:py-28">
    <Container>
      <div class="mx-auto max-w-2xl text-center">
        <div class="sail-drift" aria-hidden="true">⛵</div>
        <p class="mt-6 text-sm font-semibold uppercase tracking-widest text-[var(--text-secondary)]">
          404
        </p>
        <h1 class="mt-2 text-4xl font-bold tracking-tight sm:text-5xl">
          Lạc giữa biển khơi?
        </h1>
        <p class="mt-4 text-lg leading-relaxed text-[var(--text-secondary)]">
          Cánh buồm nào cũng có lúc lạc hướng. Để chúng tôi đưa bạn về đúng đường.
        </p>
        <div class="mt-10 flex flex-wrap justify-center gap-3">
          <ButtonLink href="/vi/" variant="primary">
            Về trang chủ
          </ButtonLink>
          <ButtonLink href="/vi/products/" variant="secondary">
            Xem sản phẩm
          </ButtonLink>
        </div>
      </div>
    </Container>
  </section>
</BaseLayout>
