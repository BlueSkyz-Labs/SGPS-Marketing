---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { PAGE_META } from "@/data/page-meta";
import Container from "@/components/layout/Container.astro";
import PageHeader from "@/components/layout/PageHeader.astro";
import ProductCard from "@/components/product/ProductCard.astro";
import ProofFirstEmptyState from "@/components/product/ProofFirstEmptyState.astro";
import { getPublicProducts } from "@/lib/products";

const products = await getPublicProducts();
const allInDevelopment =
  products.length > 0 &&
  products.every((product) => product.data.lifecycle === "development");
const emptyDescription =
  "Sản phẩm chỉ được công bố kèm bằng chứng công khai có thể xác minh.";
---

<BaseLayout
  title={PAGE_META["vi"].products.title}
  description={
    products.length ? PAGE_META["vi"].products.description : emptyDescription
  }
  path="/vi/products/"
  scene="product"
>
  <section class="py-16 lg:py-20">
    <Container>
      <PageHeader
        title="Sản phẩm của BlueSkyz"
        lede={
          products.length === 0
            ? "Sản phẩm xuất hiện ở đây khi chúng sẵn sàng đánh giá. Chúng tôi chỉ công bố những gì bạn có thể xác minh."
            : allInDevelopment
              ? "Cả hai đang phát triển. Mỗi trang đều nêu trạng thái."
              : "Mỗi trang nói rõ trạng thái và căn cứ của sản phẩm đó."
        }
      />
      {products.length > 0 && (
        <p class="studio-shelf__framing mt-6 text-base font-medium text-[var(--text-secondary)]">
          {products.length} sản phẩm. Một triết lý: công cụ nhỏ bạn có thể xác
          minh, xây cho người dùng.
        </p>
      )}
      {products.length === 0 ? (
        <div class="mt-12">
          <ProofFirstEmptyState lang="vi" />
        </div>
      ) : (
        <section class="mt-12" aria-labelledby="published-products">
          <h2
            id="published-products"
            class:list={[
              "text-xs font-semibold tracking-[0.18em] text-[var(--text-secondary)] uppercase [&:lang(vi)]:normal-case [&:lang(vi)]:tracking-[var(--tracking-eyebrow)]",
              allInDevelopment && "sr-only",
            ]}
          >
            {allInDevelopment ? "Đang phát triển" : "Sản phẩm"}
          </h2>
          <div class="studio-shelf mt-8">
            {products.map((product) => (
              <div
                data-product-slug={product.data.slug}
                class="studio-shelf__item"
              >
                <ProductCard product={product} lang="vi" showThumb />
              </div>
            ))}
          </div>
        </section>
      )}
    </Container>
  </section>
</BaseLayout>
