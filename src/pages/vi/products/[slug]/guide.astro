---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ProductGuide from "@/components/product/ProductGuide.astro";
import { getGuideProducts } from "@/lib/showcases";

export async function getStaticPaths() {
  return (await getGuideProducts()).map(({ product, showcase }) => ({
    params: { slug: product.data.slug },
    props: { product, showcase: showcase.data },
  }));
}

const { product, showcase } = Astro.props;
const guide = showcase.guide!;
---

<BaseLayout
  title={`${guide.title.vi} — BlueSkyz Labs`}
  description={guide.intro.vi.slice(0, 200)}
  path={`/vi/products/${product.data.slug}/guide/`}
  ogImage={showcase.screens[0]?.src}
  scene="product"
>
  <ProductGuide product={product} showcase={showcase} lang="vi" />
</BaseLayout>
