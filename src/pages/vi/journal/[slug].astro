---
import BaseLayout from "@/layouts/BaseLayout.astro";
import JournalPost from "@/components/journal/JournalPost.astro";
import { getCollection, render } from "astro:content";
import { SITE } from "@/data/site";
import { JOURNAL_COPY } from "@/data/journal-copy";
import {
  blogPostingJsonLd,
  journalArtVariant,
  journalFeedPath,
  journalPostBreadcrumbJsonLd,
  journalPostPath,
  journalPostStaticPaths,
} from "@/lib/journal-posts";

// Journey P1-A: published posts only (drafts get no route); an unpaired VI/EN
// post fails the build. zh / zh-Hant have no post pages (posts are VI + EN).
export async function getStaticPaths() {
  return journalPostStaticPaths(await getCollection("journal"), "vi");
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const post = entry.data;
// Press standard R3: the stamped 1200x675 hero render is the share image.
const og = post.hero
  ? {
      ogImage: journalArtVariant(post.hero.src, "og"),
      ogImageSize: { width: 1200, height: 675 },
      ogImageAltText: post.hero.alt,
    }
  : {};
const extraJsonLd = [
  blogPostingJsonLd(post, SITE.url),
  journalPostBreadcrumbJsonLd({
    lang: "vi",
    id: post.id,
    title: post.title,
    journalLabel: JOURNAL_COPY["vi"].title,
    siteUrl: SITE.url,
  }),
];
---

<BaseLayout
  title={post.title}
  description={post.description}
  path={journalPostPath("vi", post.id)}
  extraJsonLd={extraJsonLd}
  {...og}
  feed={{
    href: journalFeedPath("vi"),
    title: `${JOURNAL_COPY["vi"].title} | ${SITE.name}`,
  }}
>
  <JournalPost entry={post} Content={Content} />
</BaseLayout>
