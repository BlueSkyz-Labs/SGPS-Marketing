---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { PAGE_META } from "@/data/page-meta";
import Container from "@/components/layout/Container.astro";
import PageHeader from "@/components/layout/PageHeader.astro";
import ProductSignInLane from "@/components/empty-state/ProductSignInLane.astro";
import PublicContactEmails from "@/components/empty-state/PublicContactEmails.astro";
import { EMPTY_STATE_COPY } from "@/data/empty-state-copy";
import { labelFor } from "@/data/site";
---

<BaseLayout
  title={PAGE_META["vi"]["contact"].title}
  description={PAGE_META["vi"]["contact"].description}
  path="/vi/contact/"
>
  <section class="py-16 lg:py-24">
    <Container>
      <PageHeader
        eyebrow="Liên hệ"
        title="Liên hệ BlueSkyz"
        lede={labelFor(EMPTY_STATE_COPY.contactLede, "vi")}
      />
      <ul class="mt-12 grid gap-4 sm:grid-cols-2">
        <li class="flex min-w-0 flex-col justify-center rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-raised)] p-6">
          <a
            href="/vi/security/"
            class="inline-flex min-h-11 items-center gap-2 text-lg font-semibold tracking-tight text-[var(--action-primary)] no-underline hover:underline"
          >
            Bảo mật →
          </a>
          <p class="mt-2 text-sm leading-relaxed text-[var(--text-secondary)]">
            Xem trang Bảo mật
          </p>
        </li>
        <ProductSignInLane lang="vi" />
        <PublicContactEmails
          lang="vi"
          boundary="Hợp tác và câu hỏi chung. Kênh báo cáo bảo mật riêng tư chỉ dành cho lỗ hổng bảo mật, không dùng cho hợp tác hay hỗ trợ thông thường."
        />
      </ul>
    </Container>
  </section>
</BaseLayout>
