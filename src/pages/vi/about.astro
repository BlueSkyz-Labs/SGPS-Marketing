---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { PAGE_META } from "@/data/page-meta";
import Container from "@/components/layout/Container.astro";
import PageHeader from "@/components/layout/PageHeader.astro";
import AboutComposition from "@/components/empty-state/AboutComposition.astro";
---

<BaseLayout
  title={PAGE_META["vi"]["about"].title}
  description={PAGE_META["vi"]["about"].description}
  path="/vi/about/"
>
  <section class="py-16 lg:py-24">
    <Container>
      <PageHeader
        eyebrow="Về BlueSkyz"
        title="Về BlueSkyz Labs"
        lede="Chúng tôi xây dựng những sản phẩm thông minh để trao quyền cho con người và nâng tầm cách công việc được thực hiện. Chúng tôi đang làm Sổ Trọ, sổ tay điện tử cho chủ trọ, và Sổ Tâm, cuốn nhật ký riêng tư. Cả hai sản phẩm đều đang trong giai đoạn phát triển."
      />
      <AboutComposition lang="vi" />
    </Container>
  </section>
</BaseLayout>
