---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Container from "@/components/layout/Container.astro";
import PageHeader from "@/components/layout/PageHeader.astro";
import { SITE } from "@/data/site";
---

<BaseLayout
  title="Về BlueSkyz"
  description={`Về BlueSkyz Labs — ${SITE.proposition}`}
  path="/vi/about/"
>
  <section class="py-16 lg:py-24">
    <Container>
      <PageHeader
        eyebrow="Về chúng tôi"
        title="Chúng tôi là ai"
        lede="Chúng tôi xây dựng những sản phẩm thông minh để trao quyền cho con người và nâng tầm cách công việc được thực hiện. Một góc nhìn cao hơn xây dựng một ngày mai tươi sáng hơn."
      />
      <div
        class="mt-12 max-w-2xl rounded-xl border border-[var(--border-subtle)] border-l-[3px] border-l-[color-mix(in_srgb,var(--brand-cobalt)_60%,var(--border-subtle))] bg-white p-6"
      >
        <p
          class="text-[0.65rem] font-semibold tracking-[0.14em] text-[var(--text-muted)] uppercase"
        >
          Ghi chú
        </p>
        <p
          class="mt-2 text-sm font-semibold tracking-tight text-[var(--text-primary)]"
        >
          Tony Nguyen — Nhà sáng lập &amp; Giám đốc điều hành
        </p>
        <p class="mt-3 text-sm leading-[1.65] text-[var(--text-secondary)]">
          Trang này do BlueSkyz dẫn dắt. Thông tin nhà sáng lập chỉ được công bố
          khi được phê duyệt cho trang công khai — không có nội dung nào được
          viết trước khi phê duyệt.
        </p>
      </div>
    </Container>
  </section>
</BaseLayout>
