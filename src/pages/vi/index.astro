---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Container from "@/components/layout/Container.astro";
import Hero from "@/components/sections/Hero.astro";
import FlagshipTheatre from "@/components/product/FlagshipTheatre.astro";
import ProductHouse from "@/components/product/ProductHouse.astro";
import OneHouse from "@/components/sections/OneHouse.astro";
import Trust from "@/components/sections/Trust.astro";
import AboutBlueSkyz from "@/components/sections/AboutBlueSkyz.astro";
import NextStep from "@/components/sections/NextStep.astro";
import MaisonIndex from "@/components/maison/MaisonIndex.astro";
import HorizonField from "@/components/experience/HorizonField.astro";
import { getFlagshipProduct, getPublicProducts } from "@/lib/products";
import { SITE } from "@/data/site";

// C2 six-act homepage (VI): Hero → Flagship Theatre → Product House →
// One House → Trust → About → Next Step. Power-user surfaces keep their
// routes/components but no longer lead the homepage.
const products = await getPublicProducts();
/** Public refs the proof selector binds against (slug + name only). */
const productRefs = products.map((product) => ({
  slug: product.data.slug,
  name: product.data.name,
}));
const flagship = await getFlagshipProduct();
---

<BaseLayout
  title={SITE.name}
  description={`${SITE.taglineLead} ${SITE.taglineAccent} — Chúng tôi xây dựng những sản phẩm thông minh để trao quyền cho con người và nâng tầm cách công việc được thực hiện.`}
  path="/vi/"
  scene="ink"
>
  <Hero lang="vi" />
  <Container>
    <FlagshipTheatre product={flagship} products={productRefs} lang="vi" />
    <ProductHouse products={products} lang="vi" />
    <OneHouse lang="vi" />
    <Trust lang="vi" />
    <AboutBlueSkyz lang="vi" />
    <NextStep lang="vi" />
    <MaisonIndex lang="vi" />
  </Container>
  <HorizonField
    class="c2-closing-signature"
    data-closing-horizon
    aria-hidden="true"
  />
</BaseLayout>
