---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Container from "@/components/layout/Container.astro";
import Atlas from "@/components/experience/Atlas.astro";
import ExperienceSpine from "@/components/experience/ExperienceSpine.astro";
import IntentLens from "@/components/experience/IntentLens.astro";
import Hero from "@/components/sections/Hero.astro";
import FeaturedProducts from "@/components/sections/FeaturedProducts.astro";
import FlagshipProof from "@/components/sections/FlagshipProof.astro";
import OneHouse from "@/components/sections/OneHouse.astro";
import Trust from "@/components/sections/Trust.astro";
import AboutBlueSkyz from "@/components/sections/AboutBlueSkyz.astro";
import NextStep from "@/components/sections/NextStep.astro";
import { getFlagshipProduct, getPublicProducts } from "@/lib/products";
import { SITE } from "@/data/site";

const products = await getPublicProducts();
const flagship = await getFlagshipProduct();
---

<BaseLayout
  title={SITE.name}
  description={`${SITE.taglineLead} ${SITE.taglineAccent} — Chúng tôi xây dựng những sản phẩm thông minh để trao quyền cho con người và nâng tầm cách công việc được thực hiện.`}
  path="/vi/"
>
  <Hero lang="vi" />
  <ExperienceSpine lang="vi" />
  <Container>
    <IntentLens lang="vi" />
    <FeaturedProducts products={products} lang="vi" />
    <OneHouse lang="vi" />
    {flagship ? <FlagshipProof product={flagship} lang="vi" /> : null}
    <Trust lang="vi" />
    <AboutBlueSkyz lang="vi" />
    <NextStep lang="vi" />
    <Atlas lang="vi" />
  </Container>
</BaseLayout>
