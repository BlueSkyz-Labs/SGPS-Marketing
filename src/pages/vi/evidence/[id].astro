---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Container from "@/components/layout/Container.astro";
import EvidencePassport from "@/components/integrity/EvidencePassport.astro";
import { getEvidencePassport, getEvidencePassportIds } from "@/lib/claims";
import { getPublicProducts } from "@/lib/products";

export async function getStaticPaths() {
  const products = (await getPublicProducts()).map((product) => ({
    slug: product.data.slug,
    name: product.data.name,
  }));
  return getEvidencePassportIds(products).map((id) => ({ params: { id } }));
}

const { id } = Astro.params;
const products = (await getPublicProducts()).map((product) => ({
  slug: product.data.slug,
  name: product.data.name,
}));
const passport = getEvidencePassport(id ?? "", products);
const title = passport ? `Bằng chứng: ${passport.claim.vi}` : "Bằng chứng";
---

<BaseLayout
  title={title}
  description={passport?.claim.vi ?? "Hộ chiếu bằng chứng"}
  path={`/vi/evidence/${id}/`}
>
  <section class="py-16 lg:py-24">
    <Container>
      <div class="max-w-3xl">
        <EvidencePassport id={id ?? ""} lang="vi" products={products} />
      </div>
    </Container>
  </section>
</BaseLayout>
