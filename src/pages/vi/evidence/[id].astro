---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Container from "@/components/layout/Container.astro";
import EvidencePassport from "@/components/integrity/EvidencePassport.astro";
import { getEvidencePassport, getEvidencePassportIds } from "@/lib/claims";
import { getPublicProducts } from "@/lib/products";
import { claimReviewJsonLd, isClaimReviewState } from "@/lib/seo";
import { SITE } from "@/data/site";

export async function getStaticPaths() {
  const products = (await getPublicProducts()).map((product) => ({
    slug: product.data.slug,
    name: product.data.name,
  }));
  return getEvidencePassportIds(products).map((id) => ({ params: { id } }));
}

const { id } = Astro.params;
const products = (await getPublicProducts()).map((product) => ({
  slug: product.data.slug,
  name: product.data.name,
}));
const passport = getEvidencePassport(id ?? "", products);
const title = passport
  ? `Bằng chứng: ${passport.titleLabel?.vi ?? passport.claim.vi}`
  : "Bằng chứng";
/** ClaimReview only when a review with evidence exists; the state's honest
 * label is the rating (no scores, per the site's truth-state grammar). */
const CLAIM_STATE_LABELS = {
  reviewed: "Đã xem xét",
  "source-linked": "Đã gắn nguồn",
} as const;
const claimReview =
  passport && isClaimReviewState(passport.state)
    ? [
        claimReviewJsonLd(SITE.url, `/vi/evidence/${id}/`, {
          claimText: passport.claim.vi ?? passport.claim.en,
          lang: "vi",
          stateLabel: CLAIM_STATE_LABELS[passport.state],
          reviewedOn: passport.reviewedOn,
        }),
      ]
    : [];
---

<BaseLayout
  title={title}
  description={passport?.claim.vi ?? "Bằng chứng cho tuyên bố này"}
  path={`/vi/evidence/${id}/`}
  extraJsonLd={claimReview}
>
  <section class="py-16 lg:py-24">
    <Container>
      <div class="max-w-3xl">
        <p class="evidence-passport__page-title" data-passport-page-title>
          Bằng chứng cho tuyên bố này
        </p>
        <EvidencePassport
          id={id ?? ""}
          lang="vi"
          products={products}
          claimAs="h1"
        />
      </div>
    </Container>
  </section>
</BaseLayout>
