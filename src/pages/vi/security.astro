---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Container from "@/components/layout/Container.astro";
import PageHeader from "@/components/layout/PageHeader.astro";
import SafeAction from "@/components/integrity/SafeAction.astro";
import BoundaryCard from "@/components/integrity/BoundaryCard.astro";
import BilingualMirror from "@/components/integrity/BilingualMirror.astro";
import { SECURITY_BOUNDARY } from "@/data/integrity";
import { SITE, SECURITY_ADVISORY_URL } from "@/data/site";
---

<BaseLayout
  title="Bảo mật"
  description="Báo cáo lỗ hổng riêng tư đến BlueSkyz Labs qua GitHub Security Advisories, với bằng chứng công khai và ranh giới có thể xác minh."
  path="/vi/security/"
  surface="security"
>
  <section class="py-16 lg:py-24">
    <Container>
      <PageHeader
        eyebrow="Bảo mật"
        title="Báo cáo riêng tư, có trách nhiệm"
        lede="Báo cáo vấn đề bảo mật qua kênh riêng tư. Không mở issue GitHub công khai cho các báo cáo lỗ hổng."
      />
      {
        SITE.securityEmail ? (
          <p class="mt-8 max-w-2xl text-[var(--text-secondary)]">
            Email{" "}
            <a
              href={`mailto:${SITE.securityEmail}`}
              class="inline-flex min-h-11 items-center font-semibold text-[var(--action-primary)] no-underline hover:underline"
            >
              {SITE.securityEmail}
            </a>
            .
          </p>
        ) : null
      }
      <div class="mt-10">
        <SafeAction
          href={SECURITY_ADVISORY_URL}
          label="Mở báo cáo lỗ hổng riêng tư"
          boundary="private-reporting"
          lang="vi"
        />
      </div>
      <div class="mt-10 max-w-2xl">
        <BoundaryCard boundary={SECURITY_BOUNDARY} lang="vi" />
      </div>
      <p class="mt-6 max-w-2xl text-sm text-[var(--text-muted)]">
        Không công bố huy hiệu bug-bounty, SLA hoặc chứng nhận nào khi chưa có
        bằng chứng xác minh.
      </p>
      <div class="mt-12 max-w-3xl">
        <BilingualMirror lang="vi" />
      </div>
    </Container>
  </section>
</BaseLayout>
