---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Container from "@/components/layout/Container.astro";
import PageHeader from "@/components/layout/PageHeader.astro";
import { SITE, SECURITY_ADVISORY_URL } from "@/data/site";
---

<BaseLayout
  title="Bảo mật"
  description="Liên hệ và báo cáo bảo mật cho BlueSkyz Labs."
  path="/vi/security/"
>
  <section class="py-16 lg:py-24">
    <Container>
      <PageHeader
        eyebrow="Bảo mật"
        title="Báo cáo riêng tư, có trách nhiệm"
        lede="Báo cáo vấn đề bảo mật qua kênh riêng tư. Không mở issue GitHub công khai cho các báo cáo lỗ hổng."
      />
      {
        SITE.securityEmail ? (
          <p class="mt-8 max-w-2xl text-[var(--text-secondary)]">
            Email{" "}
            <a
              href={`mailto:${SITE.securityEmail}`}
              class="inline-flex min-h-11 items-center font-semibold text-[var(--action-primary)] no-underline hover:underline"
            >
              {SITE.securityEmail}
            </a>
            .
          </p>
        ) : null
      }
      <div class="mt-10">
        <a
          href={SECURITY_ADVISORY_URL}
          rel="noopener noreferrer"
          class="inline-flex min-h-11 items-center gap-1.5 rounded-lg bg-[var(--action-primary)] px-5 text-sm font-semibold text-white no-underline transition-opacity hover:opacity-90"
        >
          Mở báo cáo lỗ hổng riêng tư
          <span aria-hidden="true">→</span>
        </a>
      </div>
      <p class="mt-6 max-w-2xl text-sm text-[var(--text-muted)]">
        Không công bố huy hiệu bug-bounty, SLA hoặc chứng nhận nào khi chưa có
        bằng chứng xác minh.
      </p>
    </Container>
  </section>
</BaseLayout>
