---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Container from "@/components/layout/Container.astro";
import PageHeader from "@/components/layout/PageHeader.astro";
import { SITE } from "@/data/site";

const hasBusinessEmail = Boolean(SITE.contactEmail);
---

<BaseLayout
  title="Hỗ trợ"
  description="Các đường dẫn hỗ trợ và khắc phục của BlueSkyz Labs: những gì đang có, những gì chưa công bố, và cách liên hệ."
  path="/vi/support/"
>
  <section class="py-16 lg:py-24">
    <Container>
      <PageHeader
        eyebrow="Hỗ trợ"
        title="Trợ giúp minh bạch"
        lede="Điểm hỗ trợ cho từng sản phẩm sẽ được công bố trên trang sản phẩm tương ứng khi được xác minh. Trong thời gian chờ, hãy sử dụng các kênh bên dưới."
      />
      {
        hasBusinessEmail ? (
          <p class="mt-8 max-w-2xl text-[var(--text-secondary)]">
            Email{" "}
            <a
              href={`mailto:${SITE.contactEmail}`}
              class="inline-flex min-h-11 items-center font-semibold text-[var(--action-primary)] no-underline hover:underline"
            >
              {SITE.contactEmail}
            </a>{" "}
            cho hỗ trợ sản phẩm chung cho đến khi có kênh cụ thể theo sản phẩm.
          </p>
        ) : (
          <p class="mt-8 max-w-2xl text-[var(--text-secondary)]">
            Email hỗ trợ doanh nghiệp sẽ xuất hiện ở đây khi BlueSkyz công bố.
            Trong thời gian chờ, Báo cáo bảo mật là kênh tin cậy có thể hành
            động.
          </p>
        )
      }
      <div class="mt-10 flex flex-wrap gap-3">
        <a
          href="/vi/security/"
          class="inline-flex min-h-11 items-center rounded-lg border border-[var(--border-subtle)] bg-white px-5 text-sm font-semibold text-[var(--text-primary)] no-underline transition-colors hover:border-[var(--action-primary)]"
        >
          Báo cáo bảo mật
        </a>
        {
          hasBusinessEmail ? (
            <a
              href="/vi/contact/"
              class="inline-flex min-h-11 items-center rounded-lg border border-[var(--border-subtle)] bg-white px-5 text-sm font-semibold text-[var(--text-primary)] no-underline transition-colors hover:border-[var(--action-primary)]"
            >
              Liên hệ BlueSkyz
            </a>
          ) : (
            <a
              href="/vi/about/"
              class="inline-flex min-h-11 items-center rounded-lg border border-[var(--border-subtle)] bg-white px-5 text-sm font-semibold text-[var(--text-primary)] no-underline transition-colors hover:border-[var(--action-primary)]"
            >
              Về BlueSkyz
            </a>
          )
        }
      </div>
    </Container>
  </section>
</BaseLayout>
