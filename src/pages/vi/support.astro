---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { PAGE_META } from "@/data/page-meta";
import Container from "@/components/layout/Container.astro";
import PageHeader from "@/components/layout/PageHeader.astro";
import { SITE } from "@/data/site";

const hasSupportEmail = Boolean(SITE.supportEmail);
---

<BaseLayout
  title={PAGE_META["vi"]["support"].title}
  description={PAGE_META["vi"]["support"].description}
  path="/vi/support/"
>
  <section class="py-16 lg:py-24">
    <Container>
      <PageHeader
        eyebrow="Hỗ trợ"
        title="Nhận trợ giúp"
        lede={
          hasSupportEmail
            ? "Kênh báo cáo bảo mật chỉ dành cho lỗ hổng bảo mật."
            : "Hiện chưa có hộp thư hỗ trợ chung. Kênh báo cáo bảo mật chỉ dành cho lỗ hổng bảo mật."
        }
      />
      {hasSupportEmail ? (
        <p class="mt-8 max-w-2xl text-[var(--text-secondary)]">
          Email{" "}
          <a
            href={`mailto:${SITE.supportEmail}`}
            class="inline-flex min-h-11 items-center font-semibold text-[var(--action-primary)] no-underline hover:underline"
          >
            {SITE.supportEmail}
          </a>{" "}
          cho hỗ trợ sản phẩm chung cho đến khi có kênh cụ thể theo sản phẩm.
        </p>
      ) : (
        <p class="mt-8 max-w-2xl text-[var(--text-secondary)]">
          Chưa có email hỗ trợ sản phẩm chung được xác minh. Chỉ sử dụng kênh hỗ
          trợ riêng khi đã được công bố trên trang sản phẩm có xác minh. Báo cáo
          bảo mật chỉ dành cho lỗ hổng nghi vấn, không tiếp nhận yêu cầu hỗ trợ
          thông thường.
        </p>
      )}
      <div class="mt-10 flex flex-wrap gap-3">
        <a
          href="/vi/security/"
          class="inline-flex min-h-11 items-center rounded-lg border border-[var(--border-subtle)] bg-[var(--surface-raised)] px-5 text-sm font-semibold text-[var(--text-primary)] no-underline transition-colors hover:border-[var(--action-primary)]"
        >
          Báo cáo lỗ hổng bảo mật
        </a>
        {hasSupportEmail ? (
          <a
            href="/vi/contact/"
            class="inline-flex min-h-11 items-center rounded-lg border border-[var(--border-subtle)] bg-[var(--surface-raised)] px-5 text-sm font-semibold text-[var(--text-primary)] no-underline transition-colors hover:border-[var(--action-primary)]"
          >
            Liên hệ BlueSkyz
          </a>
        ) : (
          <a
            href="/vi/about/"
            class="inline-flex min-h-11 items-center rounded-lg border border-[var(--border-subtle)] bg-[var(--surface-raised)] px-5 text-sm font-semibold text-[var(--text-primary)] no-underline transition-colors hover:border-[var(--action-primary)]"
          >
            Về BlueSkyz
          </a>
        )}
      </div>
    </Container>
  </section>
</BaseLayout>
