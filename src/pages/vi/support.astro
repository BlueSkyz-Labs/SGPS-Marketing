---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { PAGE_META } from "@/data/page-meta";
import Container from "@/components/layout/Container.astro";
import PageHeader from "@/components/layout/PageHeader.astro";
import ButtonLink from "@/components/ui/ButtonLink.astro";
import { SITE } from "@/data/site";

// Contact is always the primary action: /vi/contact/ renders a real business
// route (published mailbox when present, otherwise BusinessRouteState with the
// private vulnerability channel), so it is never a dead end. Security stays a
// secondary link for vulnerability reports only.
const hasSupportEmail = Boolean(SITE.supportEmail);
---

<BaseLayout
  title={PAGE_META["vi"]["support"].title}
  description={PAGE_META["vi"]["support"].description}
  path="/vi/support/"
>
  <section class="py-16 lg:py-24">
    <Container>
      <PageHeader
        eyebrow="Hỗ trợ"
        title="Nhận trợ giúp"
        lede={
          hasSupportEmail
            ? "Kênh báo cáo bảo mật chỉ dành cho lỗ hổng bảo mật."
            : "Hiện chưa có hộp thư hỗ trợ chung. Kênh báo cáo bảo mật chỉ dành cho lỗ hổng bảo mật."
        }
      />
      {hasSupportEmail ? (
        <p class="mt-8 max-w-2xl text-[var(--text-secondary)]">
          Email{" "}
          <a
            href={`mailto:${SITE.supportEmail}`}
            class="inline-flex min-h-11 items-center font-semibold text-[var(--action-primary)] no-underline hover:underline"
          >
            {SITE.supportEmail}
          </a>{" "}
          cho hỗ trợ sản phẩm chung cho đến khi có kênh cụ thể theo sản phẩm.
        </p>
      ) : null}
      <div class="mt-10 flex flex-wrap items-center gap-3" data-support-actions>
        <ButtonLink href="/vi/contact/" data-support-primary>
          Liên hệ
        </ButtonLink>
        <ButtonLink
          href="/vi/security/"
          variant="secondary"
          data-support-security
        >
          Bảo mật (chỉ báo cáo lỗ hổng)
        </ButtonLink>
      </div>
    </Container>
  </section>
</BaseLayout>
