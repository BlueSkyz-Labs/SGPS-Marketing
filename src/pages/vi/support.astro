---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { PAGE_META } from "@/data/page-meta";
import Container from "@/components/layout/Container.astro";
import PageHeader from "@/components/layout/PageHeader.astro";
import ButtonLink from "@/components/ui/ButtonLink.astro";
import { SITE } from "@/data/site";

// A published support mailbox is the primary action: the visitor gets one
// direct way to ask for help. Without it, Contact is primary (it renders a
// real business route, never a dead end). Security stays a secondary link
// for vulnerability reports only.
const hasSupportEmail = Boolean(SITE.supportEmail);
---

<BaseLayout
  title={PAGE_META["vi"]["support"].title}
  description={PAGE_META["vi"]["support"].description}
  path="/vi/support/"
>
  <section class="py-16 lg:py-24">
    <Container>
      <PageHeader
        title="Nhận trợ giúp"
        lede={
          hasSupportEmail
            ? "Có câu hỏi về ứng dụng? Hãy gửi email cho chúng tôi."
            : "Hiện chưa có hộp thư hỗ trợ chung. Kênh báo cáo bảo mật chỉ dành cho lỗ hổng bảo mật."
        }
      />
      <div class="mt-10 flex flex-wrap items-center gap-3" data-support-actions>
        {hasSupportEmail ? (
          <ButtonLink
            href={`mailto:${SITE.supportEmail}`}
            data-support-primary
            data-support-mailbox
          >
            {SITE.supportEmail}
          </ButtonLink>
        ) : (
          <ButtonLink href="/vi/contact/" data-support-primary>
            Liên hệ
          </ButtonLink>
        )}
        <ButtonLink
          href="/vi/security/"
          variant="secondary"
          data-support-security
        >
          Bảo mật (chỉ báo cáo lỗ hổng)
        </ButtonLink>
      </div>
    </Container>
  </section>
</BaseLayout>
