---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Container from "@/components/layout/Container.astro";
import DossierDocument from "@/components/dossier/DossierDocument.astro";
---

<BaseLayout
  title="Public dossier — printable"
  description="A printable view of what this site has already published, with every source link and boundary stated."
  path="/en/dossier/print/"
>
  <section class="py-16 lg:py-24">
    <Container>
      <DossierDocument lang="en" />
    </Container>
  </section>
</BaseLayout>
