---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Container from "@/components/layout/Container.astro";
import PageHeader from "@/components/layout/PageHeader.astro";
import BoundaryCard from "@/components/integrity/BoundaryCard.astro";
import { PRIVACY_BOUNDARY } from "@/data/integrity";
import { SITE } from "@/data/site";

const hasBusinessEmail = Boolean(SITE.contactEmail);
---

<BaseLayout
  title="Privacy"
  description="Privacy information for BlueSkyz Labs."
  path="/en/privacy/"
  surface="privacy"
>
  <section class="py-16 lg:py-24">
    <Container>
      <PageHeader
        eyebrow="Privacy"
        title="Clear data boundaries"
        lede="This corporate site is static marketing content. Full legal privacy wording publishes when BlueSkyz approves it."
      />
      <dl class="mt-12 max-w-2xl space-y-8">
        <div
          class="rounded-xl border border-[var(--border-subtle)] bg-white p-6"
        >
          <dt class="text-sm font-semibold tracking-tight">
            What is collected
          </dt>
          <dd class="mt-2 text-sm leading-relaxed text-[var(--text-secondary)]">
            This site does not require accounts, forms, or tracking cookies for
            basic browsing. Standard web server and CDN request logs may record
            technical connection data such as IP address, user agent, and
            requested URL.
          </dd>
        </div>
        <div
          class="rounded-xl border border-[var(--border-subtle)] bg-white p-6"
        >
          <dt class="text-sm font-semibold tracking-tight">Why</dt>
          <dd class="mt-2 text-sm leading-relaxed text-[var(--text-secondary)]">
            Request logs exist for security, abuse prevention, and reliable
            delivery of static assets — not for advertising profiles.
          </dd>
        </div>
        <div
          class="rounded-xl border border-[var(--border-subtle)] bg-white p-6"
        >
          <dt class="text-sm font-semibold tracking-tight">How it is used</dt>
          <dd class="mt-2 text-sm leading-relaxed text-[var(--text-secondary)]">
            Logs stay with the hosting platform operators for operational
            purposes. No third-party ad pixels or session-recording scripts ship
            on this foundation.
          </dd>
        </div>
        <div
          class="rounded-xl border border-[var(--border-subtle)] bg-white p-6"
        >
          <dt class="text-sm font-semibold tracking-tight">
            Deletion and product privacy
          </dt>
          <dd class="mt-2 text-sm leading-relaxed text-[var(--text-secondary)]">
            There is no customer account on this corporate site to export or
            delete. Product-specific privacy practices publish on each product
            surface when that product is public.
          </dd>
        </div>
      </dl>
      <div class="mt-12 max-w-2xl">
        <BoundaryCard boundary={PRIVACY_BOUNDARY} lang="en" />
      </div>
      <div class="mt-12 flex flex-wrap gap-3">
        <a
          href="/en/security/"
          class="inline-flex min-h-11 items-center rounded-lg border border-[var(--border-subtle)] bg-white px-5 text-sm font-semibold text-[var(--text-primary)] no-underline transition-colors hover:border-[var(--action-primary)]"
        >
          Security reporting
        </a>
        {
          hasBusinessEmail ? (
            <a
              href="/en/contact/"
              class="inline-flex min-h-11 items-center rounded-lg border border-[var(--border-subtle)] bg-white px-5 text-sm font-semibold text-[var(--text-primary)] no-underline transition-colors hover:border-[var(--action-primary)]"
            >
              Contact BlueSkyz
            </a>
          ) : (
            <a
              href="/en/about/"
              class="inline-flex min-h-11 items-center rounded-lg border border-[var(--border-subtle)] bg-white px-5 text-sm font-semibold text-[var(--text-primary)] no-underline transition-colors hover:border-[var(--action-primary)]"
            >
              About BlueSkyz
            </a>
          )
        }
      </div>
    </Container>
  </section>
</BaseLayout>
