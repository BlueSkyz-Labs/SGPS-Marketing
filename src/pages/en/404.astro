---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Container from "@/components/layout/Container.astro";
import ButtonLink from "@/components/ui/ButtonLink.astro";
---

<BaseLayout
  title="Page not found"
  description="The page you requested could not be found."
  path="/en/404/"
  noindex={true}
>
  <section class="py-20 lg:py-28">
    <Container>
      <div class="mx-auto max-w-2xl text-center">
        <div class="sail-drift" aria-hidden="true">⛵</div>
        <p class="mt-6 text-sm font-semibold uppercase tracking-widest text-[var(--text-secondary)]">
          404
        </p>
        <h1 class="mt-2 text-4xl font-bold tracking-tight sm:text-5xl">
          Lost at sea?
        </h1>
        <p class="mt-4 text-lg leading-relaxed text-[var(--text-secondary)]">
          Even sails drift off course. Let’s get you back on track.
        </p>
        <div class="mt-10 flex flex-wrap justify-center gap-3">
          <ButtonLink href="/en/" variant="primary">
            Go home
          </ButtonLink>
          <ButtonLink href="/en/products/" variant="secondary">
            Browse products
          </ButtonLink>
        </div>
      </div>
    </Container>
  </section>
</BaseLayout>
