---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { PAGE_META } from "@/data/page-meta";
import Container from "@/components/layout/Container.astro";
import PageHeader from "@/components/layout/PageHeader.astro";
import ButtonLink from "@/components/ui/ButtonLink.astro";
import { SITE } from "@/data/site";

// Contact is always the primary action: /en/contact/ renders a real business
// route (published mailbox when present, otherwise BusinessRouteState with the
// private vulnerability channel), so it is never a dead end. Security stays a
// secondary link for vulnerability reports only.
const hasSupportEmail = Boolean(SITE.supportEmail);
---

<BaseLayout
  title={PAGE_META["en"]["support"].title}
  description={PAGE_META["en"]["support"].description}
  path="/en/support/"
>
  <section class="py-16 lg:py-24">
    <Container>
      <PageHeader
        eyebrow="Support"
        title="How to get help"
        lede={
          hasSupportEmail
            ? "Security reporting is for vulnerabilities only."
            : "No general support mailbox has been published yet. Security reporting is for vulnerabilities only."
        }
      />
      {hasSupportEmail ? (
        <p class="mt-8 max-w-2xl text-[var(--text-secondary)]">
          Email{" "}
          <a
            href={`mailto:${SITE.supportEmail}`}
            class="inline-flex min-h-11 items-center font-semibold text-[var(--action-primary)] underline underline-offset-4 hover:no-underline"
          >
            {SITE.supportEmail}
          </a>{" "}
          for general product support until a product-specific path is
          published.
        </p>
      ) : null}
      <div class="mt-10 flex flex-wrap items-center gap-3" data-support-actions>
        <ButtonLink href="/en/contact/" data-support-primary>
          Contact
        </ButtonLink>
        <ButtonLink
          href="/en/security/"
          variant="secondary"
          data-support-security
        >
          Security (vulnerability reports only)
        </ButtonLink>
      </div>
    </Container>
  </section>
</BaseLayout>
