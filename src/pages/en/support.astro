---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Container from "@/components/layout/Container.astro";
import PageHeader from "@/components/layout/PageHeader.astro";
import { SITE } from "@/data/site";

const hasBusinessEmail = Boolean(SITE.contactEmail);
---

<BaseLayout
  title="Support"
  description="Support for BlueSkyz Labs products."
  path="/en/support/"
>
  <section class="py-16 lg:py-24">
    <Container>
      <PageHeader
        eyebrow="Support"
        title="Help that stays honest"
        lede="Product-specific support destinations publish on each product profile when verified. Until then, use the working paths below."
      />
      {
        hasBusinessEmail ? (
          <p class="mt-8 max-w-2xl text-[var(--text-secondary)]">
            Email{" "}
            <a
              href={`mailto:${SITE.contactEmail}`}
              class="inline-flex min-h-11 items-center font-semibold text-[var(--action-primary)] no-underline hover:underline"
            >
              {SITE.contactEmail}
            </a>{" "}
            for general product support until a product-specific path is
            published.
          </p>
        ) : (
          <p class="mt-8 max-w-2xl text-[var(--text-secondary)]">
            A corporate support email will appear here when BlueSkyz publishes
            one. Until then, Security reporting is the actionable trust channel.
          </p>
        )
      }
      <div class="mt-10 flex flex-wrap gap-3">
        <a
          href="/en/security/"
          class="inline-flex min-h-11 items-center rounded-lg border border-[var(--border-subtle)] bg-white px-5 text-sm font-semibold text-[var(--text-primary)] no-underline transition-colors hover:border-[var(--action-primary)]"
        >
          Security reporting
        </a>
        {
          hasBusinessEmail ? (
            <a
              href="/en/contact/"
              class="inline-flex min-h-11 items-center rounded-lg border border-[var(--border-subtle)] bg-white px-5 text-sm font-semibold text-[var(--text-primary)] no-underline transition-colors hover:border-[var(--action-primary)]"
            >
              Contact BlueSkyz
            </a>
          ) : (
            <a
              href="/en/about/"
              class="inline-flex min-h-11 items-center rounded-lg border border-[var(--border-subtle)] bg-white px-5 text-sm font-semibold text-[var(--text-primary)] no-underline transition-colors hover:border-[var(--action-primary)]"
            >
              About BlueSkyz
            </a>
          )
        }
      </div>
    </Container>
  </section>
</BaseLayout>
