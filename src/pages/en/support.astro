---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Container from "@/components/layout/Container.astro";
import { SITE } from "@/data/site";

const hasBusinessEmail = Boolean(SITE.contactEmail);
---

<BaseLayout
  title="Support"
  description="Support for BlueSkyz Labs products."
  path="/en/support/"
>
  <section class="py-16">
    <Container>
      <h1 class="text-3xl font-semibold tracking-tight">Support</h1>
      <p class="mt-4 max-w-2xl text-[var(--text-secondary)]">
        Product-specific support destinations publish on each product profile
        when verified. Until then, use the working paths below.
      </p>
      {
        hasBusinessEmail ? (
          <p class="mt-6 max-w-2xl text-[var(--text-secondary)]">
            Email{" "}
            <a
              href={`mailto:${SITE.contactEmail}`}
              class="inline-flex min-h-11 items-center font-semibold text-[var(--action-primary)] no-underline hover:underline"
            >
              {SITE.contactEmail}
            </a>{" "}
            for general product support until a product-specific path is
            published.
          </p>
        ) : (
          <p class="mt-6 max-w-2xl text-[var(--text-secondary)]">
            A corporate support email will appear here when BlueSkyz publishes
            one. Until then, Security reporting is the actionable trust channel.
          </p>
        )
      }
      <div class="mt-8 flex flex-wrap gap-4">
        <a
          href="/en/security/"
          class="inline-flex min-h-11 items-center text-sm font-semibold text-[var(--action-primary)] no-underline hover:underline"
        >
          Security reporting
        </a>
        {
          hasBusinessEmail ? (
            <a
              href="/en/contact/"
              class="inline-flex min-h-11 items-center text-sm font-semibold text-[var(--action-primary)] no-underline hover:underline"
            >
              Contact BlueSkyz
            </a>
          ) : (
            <a
              href="/en/about/"
              class="inline-flex min-h-11 items-center text-sm font-semibold text-[var(--action-primary)] no-underline hover:underline"
            >
              About BlueSkyz
            </a>
          )
        }
      </div>
    </Container>
  </section>
</BaseLayout>
