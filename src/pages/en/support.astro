---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { PAGE_META } from "@/data/page-meta";
import Container from "@/components/layout/Container.astro";
import PageHeader from "@/components/layout/PageHeader.astro";
import ButtonLink from "@/components/ui/ButtonLink.astro";
import { SITE } from "@/data/site";

// A published support mailbox is the primary action: the visitor gets one
// direct way to ask for help. Without it, Contact is primary (it renders a
// real business route, never a dead end). Security stays a secondary link
// for vulnerability reports only.
const hasSupportEmail = Boolean(SITE.supportEmail);
---

<BaseLayout
  title={PAGE_META["en"]["support"].title}
  description={PAGE_META["en"]["support"].description}
  path="/en/support/"
>
  <section class="py-16 lg:py-24">
    <Container>
      <PageHeader
        title="How to get help"
        lede={
          hasSupportEmail
            ? "Questions about our apps? Email us."
            : "No general support mailbox has been published yet. Security reporting is for vulnerabilities only."
        }
      />
      <div class="mt-10 flex flex-wrap items-center gap-3" data-support-actions>
        {hasSupportEmail ? (
          <ButtonLink
            href={`mailto:${SITE.supportEmail}`}
            data-support-primary
            data-support-mailbox
          >
            {SITE.supportEmail}
          </ButtonLink>
        ) : (
          <ButtonLink href="/en/contact/" data-support-primary>
            Contact
          </ButtonLink>
        )}
        <ButtonLink
          href="/en/security/"
          variant="secondary"
          data-support-security
        >
          Security (vulnerability reports only)
        </ButtonLink>
      </div>
    </Container>
  </section>
</BaseLayout>
