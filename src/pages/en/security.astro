---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Container from "@/components/layout/Container.astro";
import PageHeader from "@/components/layout/PageHeader.astro";
import SafeAction from "@/components/integrity/SafeAction.astro";
import BoundaryCard from "@/components/integrity/BoundaryCard.astro";
import BilingualMirror from "@/components/integrity/BilingualMirror.astro";
import { SECURITY_BOUNDARY } from "@/data/integrity";
import { SITE, SECURITY_ADVISORY_URL } from "@/data/site";
---

<BaseLayout
  title="Security"
  description="Report vulnerabilities privately to BlueSkyz Labs via GitHub Security Advisories, with published evidence and boundaries you can verify yourself."
  path="/en/security/"
  surface="security"
>
  <section class="py-16 lg:py-24">
    <Container>
      <PageHeader
        eyebrow="Security"
        title="Report privately, responsibly"
        lede="Report security issues through a private channel. Do not open a public GitHub issue for vulnerability reports."
      />
      {
        SITE.securityEmail ? (
          <p class="mt-8 max-w-2xl text-[var(--text-secondary)]">
            Email{" "}
            <a
              href={`mailto:${SITE.securityEmail}`}
              class="inline-flex min-h-11 items-center font-semibold text-[var(--action-primary)] no-underline hover:underline"
            >
              {SITE.securityEmail}
            </a>
            .
          </p>
        ) : null
      }
      <div class="mt-10">
        <SafeAction
          href={SECURITY_ADVISORY_URL}
          label="Open private vulnerability reporting"
          boundary="private-reporting"
          lang="en"
        />
      </div>
      <div class="mt-10 max-w-2xl">
        <BoundaryCard boundary={SECURITY_BOUNDARY} lang="en" />
      </div>
      <p class="mt-6 max-w-2xl text-sm text-[var(--text-muted)]">
        No bug-bounty, SLA, or certification badges are published without
        verified evidence.
      </p>
      <div class="mt-12 max-w-3xl">
        <BilingualMirror lang="en" />
      </div>
    </Container>
  </section>
</BaseLayout>
