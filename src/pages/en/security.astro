---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Container from "@/components/layout/Container.astro";
import PageHeader from "@/components/layout/PageHeader.astro";
import { SITE, SECURITY_ADVISORY_URL } from "@/data/site";
---

<BaseLayout
  title="Security"
  description="Security contact and reporting for BlueSkyz Labs."
  path="/en/security/"
>
  <section class="py-16 lg:py-24">
    <Container>
      <PageHeader
        eyebrow="Security"
        title="Report privately, responsibly"
        lede="Report security issues through a private channel. Do not open a public GitHub issue for vulnerability reports."
      />
      {
        SITE.securityEmail ? (
          <p class="mt-8 max-w-2xl text-[var(--text-secondary)]">
            Email{" "}
            <a
              href={`mailto:${SITE.securityEmail}`}
              class="inline-flex min-h-11 items-center font-semibold text-[var(--action-primary)] no-underline hover:underline"
            >
              {SITE.securityEmail}
            </a>
            .
          </p>
        ) : null
      }
      <div class="mt-10">
        <a
          href={SECURITY_ADVISORY_URL}
          rel="noopener noreferrer"
          class="inline-flex min-h-11 items-center gap-1.5 rounded-lg bg-[var(--action-primary)] px-5 text-sm font-semibold text-white no-underline transition-opacity hover:opacity-90"
        >
          Open private vulnerability reporting
          <span aria-hidden="true">→</span>
        </a>
      </div>
      <p class="mt-6 max-w-2xl text-sm text-[var(--text-muted)]">
        No bug-bounty, SLA, or certification badges are published without
        verified evidence.
      </p>
    </Container>
  </section>
</BaseLayout>
