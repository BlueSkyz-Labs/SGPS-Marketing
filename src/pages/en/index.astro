---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Container from "@/components/layout/Container.astro";
import Hero from "@/components/sections/Hero.astro";
import FlagshipTheatre from "@/components/product/FlagshipTheatre.astro";
import ProductHouse from "@/components/product/ProductHouse.astro";
import ProofBand from "@/components/sections/ProofBand.astro";
import HorizonField from "@/components/experience/HorizonField.astro";
import { getFlagshipProduct, getPublicProducts } from "@/lib/products";
import { SITE } from "@/data/site";

// Experience v6 S1 home: Hero (registry promise) → Flagship → second product
// → one proof band. Removed from home (components kept): One House,
// About, Next step, House index, Trust cards.
const products = await getPublicProducts();
/** Public refs the proof selector binds against (slug + name only). */
const productRefs = products.map((product) => ({
  slug: product.data.slug,
  name: product.data.name,
}));
const flagship = await getFlagshipProduct();
---

<BaseLayout
  title={SITE.name}
  description={`${SITE.taglineLead} ${SITE.taglineAccent} ${SITE.proposition}`}
  path="/en/"
  scene="ink"
>
  <Hero lang="en" />
  <Container>
    <FlagshipTheatre
      product={flagship}
      products={productRefs}
      lang="en"
      compact
    />
    <ProductHouse products={products} lang="en" mode="continuation" compact />
    <ProofBand lang="en" />
  </Container>
  <HorizonField
    class="c2-closing-signature"
    data-closing-horizon
    aria-hidden="true"
  />
</BaseLayout>
