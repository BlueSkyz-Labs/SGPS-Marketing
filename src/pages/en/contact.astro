---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Container from "@/components/layout/Container.astro";
import PageHeader from "@/components/layout/PageHeader.astro";
import SafeAction from "@/components/integrity/SafeAction.astro";
import { SITE, SECURITY_ADVISORY_URL } from "@/data/site";

const hasBusinessEmail = Boolean(SITE.contactEmail);
---

<BaseLayout
  title="Contact"
  description="Contact BlueSkyz Labs for business, security, or general inquiries."
  path="/en/contact/"
>
  <section class="py-16 lg:py-24">
    <Container>
      <PageHeader
        eyebrow="Contact"
        title="Reach the right lane"
        lede="Reach BlueSkyz through the lane that matches your need. Email addresses appear here when BlueSkyz publishes them."
      />
      <ul class="mt-12 grid gap-4 sm:grid-cols-2">
        {
          !hasBusinessEmail ? (
            <li class="flex flex-col rounded-xl border border-[var(--border-subtle)] bg-white p-6">
              <h2 class="text-lg font-semibold tracking-tight">Security</h2>
              <p class="mt-2 flex-1 text-sm leading-relaxed text-[var(--text-secondary)]">
                Use GitHub private vulnerability reporting. A security email
                will appear here when BlueSkyz publishes one.
              </p>
              <div class="mt-5">
                <SafeAction
                  href={SECURITY_ADVISORY_URL}
                  label="Open private vulnerability reporting"
                  boundary="private-reporting"
                  lang="en"
                />
              </div>
            </li>
          ) : null
        }
        <li
          class="flex flex-col rounded-xl border border-[var(--border-subtle)] bg-white p-6"
        >
          <h2 class="text-lg font-semibold tracking-tight">
            Business / general
          </h2>
          <p
            class="mt-2 flex-1 text-sm leading-relaxed text-[var(--text-secondary)]"
          >
            {
              hasBusinessEmail ? (
                <>
                  Email{" "}
                  <a
                    href={`mailto:${SITE.contactEmail}`}
                    class="inline-flex min-h-11 items-center font-semibold text-[var(--action-primary)] no-underline hover:underline"
                  >
                    {SITE.contactEmail}
                  </a>{" "}
                  for business inquiries.
                </>
              ) : (
                "A business email will appear here when BlueSkyz publishes one. Until then, use About to learn who we are, or Security reporting for an actionable trust channel."
              )
            }
          </p>
        </li>
      </ul>
    </Container>
  </section>
</BaseLayout>
