---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { PAGE_META } from "@/data/page-meta";
import Container from "@/components/layout/Container.astro";
import PageHeader from "@/components/layout/PageHeader.astro";
import SafeAction from "@/components/integrity/SafeAction.astro";
import ProductSignInLane from "@/components/empty-state/ProductSignInLane.astro";
import PublicContactEmails from "@/components/empty-state/PublicContactEmails.astro";
import { EMPTY_STATE_COPY } from "@/data/empty-state-copy";
import { labelFor, SECURITY_ADVISORY_URL } from "@/data/site";
---

<BaseLayout
  title={PAGE_META["en"]["contact"].title}
  description={PAGE_META["en"]["contact"].description}
  path="/en/contact/"
>
  <section class="py-16 lg:py-24">
    <Container>
      <PageHeader
        eyebrow="Contact"
        title="Contact"
        lede={labelFor(EMPTY_STATE_COPY.contactLede, "en")}
      />
      <ul class="mt-12 grid gap-4 sm:grid-cols-2">
        <li class="flex min-w-0 flex-col justify-center rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-raised)] p-6">
          <h2 class="text-lg font-semibold tracking-tight">Security</h2>
          <p class="mt-2 text-sm leading-relaxed text-[var(--text-secondary)]">
            <a href="/en/security/" class="text-[var(--action-primary)] underline">
              Visit the Security page
            </a>
          </p>
          <div class="mt-3">
            <SafeAction
              href={SECURITY_ADVISORY_URL}
              label="Open private vulnerability reporting"
              boundary="private-reporting"
              lang="en"
            />
          </div>
        </li>
        <ProductSignInLane lang="en" />
        <PublicContactEmails
          lang="en"
          boundary="Business and general enquiries. Private security reporting is only for suspected vulnerabilities."
        />
      </ul>
    </Container>
  </section>
</BaseLayout>
