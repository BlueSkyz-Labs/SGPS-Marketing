---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Container from "@/components/layout/Container.astro";
import { SITE, SECURITY_ADVISORY_URL } from "@/data/site";

const hasBusinessEmail = Boolean(SITE.contactEmail);
---

<BaseLayout
  title="Contact"
  description="Contact BlueSkyz Labs for business, security, or general inquiries."
  path="/en/contact/"
>
  <section class="py-16">
    <Container>
      <h1 class="text-3xl font-semibold tracking-tight">Contact</h1>
      <p class="mt-4 max-w-2xl text-[var(--text-secondary)]">
        Reach BlueSkyz through the lane that matches your need. Email addresses
        appear here when BlueSkyz publishes them.
      </p>
      <ul
        class="mt-10 divide-y divide-[var(--border-subtle)] border-y border-[var(--border-subtle)]"
      >
        {
          !hasBusinessEmail ? (
            <li class="py-6">
              <h2 class="text-lg font-semibold tracking-tight">Security</h2>
              <p class="mt-2 max-w-2xl text-[var(--text-secondary)]">
                Use GitHub private vulnerability reporting. A security email
                will appear here when BlueSkyz publishes one.
              </p>
              <a
                href={SECURITY_ADVISORY_URL}
                rel="noopener noreferrer"
                class="mt-4 inline-flex min-h-11 items-center text-sm font-semibold text-[var(--action-primary)] no-underline hover:underline"
              >
                Open private vulnerability reporting
              </a>
            </li>
          ) : null
        }
        <li class="py-6">
          <h2 class="text-lg font-semibold tracking-tight">
            Business / general
          </h2>
          <p class="mt-2 max-w-2xl text-[var(--text-secondary)]">
            {
              hasBusinessEmail ? (
                <>
                  Email{" "}
                  <a
                    href={`mailto:${SITE.contactEmail}`}
                    class="inline-flex min-h-11 items-center font-semibold text-[var(--action-primary)] no-underline hover:underline"
                  >
                    {SITE.contactEmail}
                  </a>{" "}
                  for business inquiries.
                </>
              ) : (
                "A business email will appear here when BlueSkyz publishes one. Until then, use About to learn who we are, or Security reporting for an actionable trust channel."
              )
            }
          </p>
        </li>
      </ul>
    </Container>
  </section>
</BaseLayout>
