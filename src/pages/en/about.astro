---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { PAGE_META } from "@/data/page-meta";
import Container from "@/components/layout/Container.astro";
import PageHeader from "@/components/layout/PageHeader.astro";
import AboutComposition from "@/components/empty-state/AboutComposition.astro";
---

<BaseLayout
  lastUpdated
  title={PAGE_META["en"]["about"].title}
  description={PAGE_META["en"]["about"].description}
  path="/en/about/"
>
  <section class="py-16 lg:py-24">
    <Container>
      <PageHeader title="About BlueSkyz Labs" />
      <AboutComposition lang="en" />
    </Container>
  </section>
</BaseLayout>
