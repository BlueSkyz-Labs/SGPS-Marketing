---
import type { CollectionEntry } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Container from "@/components/layout/Container.astro";
import ProductStatus from "@/components/product/ProductStatus.astro";
import ProductLadder from "@/components/product/ProductLadder.astro";
import AppAccess from "@/components/product/AppAccess.astro";
import ProductShowcase from "@/components/product/ProductShowcase.astro";
import ButtonLink from "@/components/ui/ButtonLink.astro";
import NoCaptureStage from "@/components/empty-state/NoCaptureStage.astro";
import ProductVisual from "@/components/product/ProductVisual.astro";
import {
  PAGE_LABELS,
  productPageCopy,
} from "@/components/product/product-page-copy";
import { EMPTY_STATE_COPY } from "@/data/empty-state-copy";
import { productCopy, proofCaptionForKind } from "@/lib/product-copy";
import { resolveLifecycleCta } from "@/lib/lifecycle-cta";
import { getShowcase } from "@/lib/showcases";
import { safeJsonLd, productJsonLd } from "@/lib/seo";
import { productBreadcrumbJsonLd } from "@/lib/breadcrumbs";
import { getPublicProducts } from "@/lib/products";
import { productMeta } from "@/data/page-meta";
import { labelFor, SITE } from "@/data/site";

/**
 * v8 W3 product profile (en).
 * Top of page, in order: breadcrumb, icon + name + status, one-liner, one
 * primary action (at most), sign-in text link, one Availability line.
 */
export async function getStaticPaths() {
  const products = await getPublicProducts();
  return products.map((product) => ({
    params: { slug: product.data.slug },
    props: { product },
  }));
}

interface Props {
  product: CollectionEntry<"products">;
}

const { product } = Astro.props;
const lang = "en" as const;
const { data } = product;
const media = data.proof.media;
const copy = productCopy(data, "en");
const page = productPageCopy(data, "en");
const showcase = (await getShowcase(data.slug))?.data ?? null;

// This page already *is* the recorded status surface, so the mapper only adds
// an action when it yields an eligible first-party Try destination and the
// record carries no direct app sign-in. A development product never renders Try.
const cta = resolveLifecycleCta(
  {
    slug: data.slug,
    lifecycle: data.lifecycle,
    availability: data.availability,
    primaryActionHref: data.primaryAction.href,
    productName: data.name,
  },
  "en",
);
const showTryCta = cta.verb === "try" && !data.appAccess?.signInUrl;

const proofLinks = [
  { href: data.proof.privacyUrl, label: PAGE_LABELS.privacy[lang] },
  { href: data.proof.securityUrl, label: PAGE_LABELS.security[lang] },
  { href: data.proof.supportUrl, label: PAGE_LABELS.support[lang] },
].filter((link): link is { href: string; label: string } => Boolean(link.href));

const productStructuredData = productJsonLd(
  {
    name: data.name,
    description: copy.shortDescription,
    slug: data.slug,
    mediaUrl: media?.src,
    ...(media ? { mediaCaption: proofCaptionForKind(media.kind, "en") } : {}),
    platforms: data.platforms,
  },
  SITE.url,
  "en",
);
const meta = productMeta(data.slug, "en", {
  title: data.name,
  description: copy.shortDescription,
});
const breadcrumbStructuredData = productBreadcrumbJsonLd(
  "en",
  data.slug,
  data.name,
  SITE.url,
);
const isIdentityArt = media?.kind === "identity-art";
---

<BaseLayout
  title={meta.title}
  description={meta.description}
  path={`/en/products/${data.slug}/`}
  scene="product"
>
  <script
    type="application/ld+json"
    set:html={safeJsonLd(productStructuredData)}
  ></script>
  {breadcrumbStructuredData ? (
    <script
      type="application/ld+json"
      set:html={safeJsonLd(breadcrumbStructuredData)}
    ></script>
  ) : null}
  <article class="py-12 sm:py-16">
    <Container>
      <nav
        aria-label="Breadcrumb"
        class="text-sm font-medium text-[var(--text-muted)]"
      >
        <ol class="flex items-center gap-2">
          <li>
            <a
              href={"/en/products/"}
              class="breadcrumb-link inline-flex min-h-11 items-center text-sm font-semibold text-[var(--action-primary)] no-underline hover:underline"
            >
              Products
            </a>
          </li>
          <li aria-hidden="true" class="text-[var(--border-subtle)]">
            /
          </li>
          <li aria-current="page" class="text-[var(--text-primary)]">
            {data.name}
          </li>
        </ol>
      </nav>

      <header class="mt-8 flex items-center gap-5 sm:gap-6">
        <div
          class="relative flex size-20 flex-shrink-0 items-center justify-center overflow-hidden rounded-2xl bg-white/5 p-2 shadow-[0_12px_32px_-8px_rgba(11,16,32,0.35)] ring-1 ring-inset ring-white/10 sm:size-28 sm:p-2.5"
          aria-hidden="true"
        >
          <img
            src={`/products/${data.slug}/icon.png`}
            alt=""
            class="h-full w-full rounded-[22%] object-contain"
            loading="eager"
            fetchpriority="low"
            decoding="async"
            width="128"
            height="128"
          />
        </div>
        <div class="min-w-0">
          <div class="flex flex-wrap items-center gap-x-4 gap-y-2">
            <h1 class="type-d2 text-[var(--text-primary)]">{data.name}</h1>
            <ProductStatus label={data.publicLabel} lang="en" />
          </div>
          <!-- Endorsed lockup: hidden on phones (the page header already names the studio). -->
          <div class="profile-lockup mt-3" aria-hidden="true">
            <img
              src={`/brand/blueskyz/v4/products/${data.slug}_endorsed_lockup_light.svg`}
              alt=""
              class="profile-lockup-light h-8 w-auto sm:h-10"
              loading="eager"
              decoding="async"
            />
            <img
              src={`/brand/blueskyz/v4/products/${data.slug}_endorsed_lockup_dark.svg`}
              alt=""
              class="profile-lockup-dark h-8 w-auto sm:h-10"
              loading="eager"
              decoding="async"
            />
          </div>
        </div>
      </header>

      <p class="mt-8 max-w-3xl text-lg leading-relaxed text-[var(--text-secondary)] sm:text-xl">
        {page.oneLiner}
      </p>

      <div class="mt-6 flex flex-wrap items-center gap-x-6 gap-y-3">
        {showTryCta ? (
          <ButtonLink
            href={cta.href}
            data-primary-action
            data-product-cta={cta.verb}
          >
            {cta.label}
          </ButtonLink>
        ) : showcase ? (
          <ButtonLink href="#profile-showcase" data-primary-action>
            {PAGE_LABELS.seeScreens[lang]}
          </ButtonLink>
        ) : null}
        {data.appAccess?.signInUrl ? (
          <a
            class="profile-signin inline-flex min-h-12 items-center text-sm font-semibold text-[var(--action-primary)] underline underline-offset-4"
            href={data.appAccess.signInUrl}
            rel="noopener noreferrer"
            data-app-signin
          >
            {PAGE_LABELS.signIn[lang]}
          </a>
        ) : null}
      </div>

      <AppAccess
        appAccess={data.appAccess}
        lang="en"
        web={data.platforms.includes("web")}
      />
      <ProductLadder lifecycle={data.lifecycle} lang="en" />
      {!showcase && media && !isIdentityArt ? (
        <NoCaptureStage media={media} lang="en" />
      ) : null}
      {!showcase && isIdentityArt ? (
        // Identity art is not shown here: the Sổ Tâm artwork carries an
        // unconfirmed tagline (OG-3). Only the status-honest line renders.
        <p
          class="mt-10 text-sm text-[var(--text-muted)]"
          data-profile-identity-stage
          data-no-capture
        >
          {labelFor(EMPTY_STATE_COPY.noCaptures, "en")}
        </p>
      ) : null}

      {page.whatItDoes.length > 0 ? (
        <section class="mt-14" aria-labelledby="profile-jobs">
          <h2
            id="profile-jobs"
            class="text-xl font-semibold tracking-tight text-[var(--text-primary)] sm:text-2xl"
          >
            {PAGE_LABELS.whatItDoes[lang]}
          </h2>
          <ul class="profile-does mt-5 max-w-3xl" data-what-it-does>
            {page.whatItDoes.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </section>
      ) : null}

      {showcase ? (
        <ProductShowcase
          showcase={showcase}
          lang="en"
          productName={data.name}
        />
      ) : null}

      {media && showcase ? (
        <figure class="m-0 mt-14 max-w-4xl" data-profile-identity-stage>
          <ProductVisual media={media} />
          <figcaption class="mt-3 text-sm text-[var(--text-muted)]">
            {PAGE_LABELS.artCaption[lang]}
          </figcaption>
        </figure>
      ) : null}

      {proofLinks.length > 0 ? (
        <p
          class="mt-14 text-sm text-[var(--text-secondary)]"
          data-profile-trust
        >
          {proofLinks.map((link, i) => (
            <>
              {i > 0 ? <span aria-hidden="true"> · </span> : null}
              <a
                href={link.href}
                class="profile-trust-link inline-flex min-h-11 items-center font-semibold text-[var(--action-primary)] underline underline-offset-4"
              >
                {link.label}
              </a>
            </>
          ))}
        </p>
      ) : null}
    </Container>
  </article>
</BaseLayout>

<style>
  .profile-lockup-light {
    display: block;
  }
  .profile-lockup-dark {
    display: none;
  }
  :global([data-theme="dark"]) .profile-lockup-light {
    display: none;
  }
  :global([data-theme="dark"]) .profile-lockup-dark {
    display: block;
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"])) .profile-lockup-light {
      display: none;
    }
    :global(:root:not([data-theme="light"])) .profile-lockup-dark {
      display: block;
    }
  }
  @media (max-width: 479px) {
    .profile-lockup {
      display: none;
    }
  }
  .profile-trust-link {
    min-width: 2.75rem;
    justify-content: center;
  }
  .profile-does {
    margin: 0;
    padding-left: 1.25rem;
    list-style: disc;
    color: var(--text-secondary);
    font-size: 1rem;
    line-height: 1.6;
  }
  .profile-does li + li {
    margin-top: 0.5rem;
  }
</style>
