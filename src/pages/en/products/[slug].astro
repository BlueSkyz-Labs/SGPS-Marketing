---
import type { CollectionEntry } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Container from "@/components/layout/Container.astro";
import ProductStatus from "@/components/product/ProductStatus.astro";
import ProductLadder from "@/components/product/ProductLadder.astro";
import ProductVisual from "@/components/product/ProductVisual.astro";
import NoCaptureStage from "@/components/empty-state/NoCaptureStage.astro";
import ButtonLink from "@/components/ui/ButtonLink.astro";
import { productCopy, proofCaptionForKind } from "@/lib/product-copy";
import { resolveLifecycleCta } from "@/lib/lifecycle-cta";
import AppAccess from "@/components/product/AppAccess.astro";
import ProductShowcase from "@/components/product/ProductShowcase.astro";
import { getShowcase } from "@/lib/showcases";
import { getPublicProducts } from "@/lib/products";
import { safeJsonLd, productJsonLd } from "@/lib/seo";
import { productBreadcrumbJsonLd } from "@/lib/breadcrumbs";
import { audienceText } from "@/lib/product-audience";
import { productMeta } from "@/data/page-meta";
import { labelFor, SHARED_LABELS, SITE } from "@/data/site";

export async function getStaticPaths() {
  const products = await getPublicProducts();
  return products.map((product) => ({
    params: { slug: product.data.slug },
    props: { product },
  }));
}

interface Props {
  product: CollectionEntry<"products">;
}

const { product } = Astro.props;
const { data } = product;
const media = data.proof.media;
const copy = productCopy(data, "en");
const capabilities = copy.capabilities;
const showcase = (await getShowcase(data.slug))?.data ?? null;

// Plan v5 W3.2 — this page already *is* the recorded status surface, so the
// mapper only adds an action when it yields an eligible first-party Try
// destination and the record carries no direct app sign-in. A development
// product therefore never renders Try here.
const cta = resolveLifecycleCta(
  {
    slug: data.slug,
    lifecycle: data.lifecycle,
    availability: data.availability,
    primaryActionHref: data.primaryAction.href,
  },
  "en",
);
const showTryCta = cta.verb === "try" && !data.appAccess?.signInUrl;

const PLATFORM_LABELS: Record<string, string> = {
  web: "Web",
  "browser-extension": "Browser extension",
  android: "Android",
  ios: "iOS",
  macos: "macOS",
  windows: "Windows",
  api: "API",
};

const AUDIENCE_LABELS: Record<string, string> = {
  individual: "Individuals",
  professional: "Professionals",
  team: "Teams",
  business: "Businesses",
  organization: "Organizations",
};

const proofLinks = [
  { href: data.proof.publicUrl, label: "Product site" },
  { href: data.proof.documentationUrl, label: "Documentation" },
  // Product source revisions are recorded internally; private GitHub repos are not public proof links.
  { href: data.proof.privacyUrl, label: "Privacy" },
  { href: data.proof.securityUrl, label: "Security" },
  { href: data.proof.supportUrl, label: "Support" },
].filter((link): link is { href: string; label: string } => Boolean(link.href));

const productStructuredData = productJsonLd(
  {
    name: data.name,
    description: copy.shortDescription,
    slug: data.slug,
    mediaUrl: media?.src,
    ...(media ? { mediaCaption: proofCaptionForKind(media.kind, "en") } : {}),
    platforms: data.platforms,
  },
  SITE.url,
  "en",
);
const meta = productMeta(data.slug, "en", {
  title: data.name,
  description: copy.shortDescription,
});
const breadcrumbStructuredData = productBreadcrumbJsonLd(
  "en",
  data.slug,
  data.name,
  SITE.url,
);
---

<BaseLayout
  title={meta.title}
  description={meta.description}
  path={`/en/products/${data.slug}/`}
  scene="product"
>
  <script
    type="application/ld+json"
    set:html={safeJsonLd(productStructuredData)}
  ></script>
  {breadcrumbStructuredData ? (
    <script
      type="application/ld+json"
      set:html={safeJsonLd(breadcrumbStructuredData)}
    ></script>
  ) : null}
  <article class="py-12 sm:py-16">
    <Container>
      <!-- Breadcrumb navigation -->
      <nav
        aria-label="Breadcrumb"
        class="text-sm font-medium text-[var(--text-muted)]"
      >
        <ol class="flex items-center gap-2">
          <li>
            <a
              href="/en/products/"
              class="breadcrumb-link inline-flex min-h-11 items-center text-sm font-semibold text-[var(--action-primary)] no-underline hover:underline"
            >
              Products
            </a>
          </li>
          <li aria-hidden="true" class="text-[var(--border-subtle)]">
            /
          </li>
          <li aria-current="page" class="text-[var(--text-primary)]">
            {data.name}
          </li>
        </ol>
      </nav>

      <!-- Hero Stage: 128px Squircle Icon + Endorsed Brand Lockup + Dual CTAs -->
      <header class="mt-8 flex flex-col md:flex-row md:items-start justify-between gap-6 pb-10 border-b border-[var(--border-subtle)]">
        <div class="flex flex-col sm:flex-row sm:items-center gap-6">
          <!-- 128px App Icon in Squircle Container with Ambient Glow -->
          <div
            class="relative flex-shrink-0 size-24 sm:size-28 rounded-2xl overflow-hidden bg-white/5 backdrop-blur-sm shadow-[0_12px_32px_-8px_rgba(11,16,32,0.35)] ring-1 ring-inset ring-white/10 p-2.5 flex items-center justify-center"
            aria-hidden="true"
          >
            <img
              src={`/products/${data.slug}/icon.png`}
              alt=""
              class="w-full h-full object-contain"
              loading="eager"
              fetchpriority="low"
              decoding="async"
              width="128"
              height="128"
            />
          </div>

          <div>
            <div class="flex flex-wrap items-center gap-3">
              <ProductStatus label={data.publicLabel} lang="en" />
              <p class="text-xs font-medium tracking-wide text-[var(--text-muted)]">
                {copy.endorsement}
              </p>
            </div>

            <h1 class="type-d2 mt-3 text-[var(--text-primary)]">{data.name}</h1>

            <!-- Authentic Endorsed Lockup SVG -->
            <div class="mt-3" aria-hidden="true">
              <img
                src={`/brand/blueskyz/v4/products/${data.slug}_endorsed_lockup_light.svg`}
                alt=""
                class="h-8 sm:h-10 w-auto profile-lockup-light"
                loading="eager"
                decoding="async"
              />
              <img
                src={`/brand/blueskyz/v4/products/${data.slug}_endorsed_lockup_dark.svg`}
                alt=""
                class="h-8 sm:h-10 w-auto profile-lockup-dark"
                loading="eager"
                decoding="async"
              />
            </div>
          </div>
        </div>

        <!-- Lifecycle CTA (only when the mapper yields an eligible first-party Try); sign-in stays the direct app entry -->
        <div class="flex flex-wrap items-center gap-3 pt-2">
          {showTryCta ? (
            <span data-product-cta={cta.verb}>
              <ButtonLink
                href={cta.href}
                class="shadow-[var(--bsl-shadow-subtle)]"
              >
                {cta.label}
              </ButtonLink>
            </span>
          ) : null}
          {data.appAccess?.signInUrl ? (
            <ButtonLink
              href={data.appAccess.signInUrl}
              class="shadow-[var(--bsl-shadow-subtle)]"
            >
              {labelFor(SHARED_LABELS.signIn, "en")} · {data.name}
            </ButtonLink>
          ) : null}
          {data.secondaryAction ? (
            <ButtonLink href={data.secondaryAction.href} variant="secondary">
              {data.secondaryAction.label}
            </ButtonLink>
          ) : null}
        </div>
      </header>

      <!-- Short Description -->
      <p class="mt-8 max-w-3xl text-lg sm:text-xl leading-relaxed text-[var(--text-secondary)]">
        {copy.shortDescription}
      </p>

      <AppAccess
        appAccess={data.appAccess}
        productName={data.name}
        lang="en"
        showSignIn={false}
      />
      <ProductLadder lifecycle={data.lifecycle} lang="en" />
      {!showcase && media ? <NoCaptureStage media={media} lang="en" /> : null}

      <!-- Status & Platforms Bento -->
      <section class="mt-12" aria-labelledby="profile-status">
        <h2
          id="profile-status"
          class="text-xs font-semibold uppercase tracking-widest text-[var(--text-muted)]"
        >
          Platforms and audience
        </h2>
        <dl class="mt-4 grid gap-4 sm:grid-cols-2">
          <div class="rounded-[var(--radius-card)] border border-[var(--border-subtle)] p-5 bg-[var(--surface-raised)] transition-[border-color,box-shadow] duration-200 hover:border-[color-mix(in_srgb,var(--brand-cobalt)_40%,var(--border-subtle))]">
            <dt class="text-xs font-semibold uppercase tracking-wider text-[var(--text-muted)]">
              Platforms
            </dt>
            <dd class="mt-2 text-base font-semibold text-[var(--text-primary)]">
              {data.platforms
                .map((p: string) => PLATFORM_LABELS[p] ?? p)
                .join(", ")}
            </dd>
          </div>
          <div class="rounded-[var(--radius-card)] border border-[var(--border-subtle)] p-5 bg-[var(--surface-raised)] transition-[border-color,box-shadow] duration-200 hover:border-[color-mix(in_srgb,var(--brand-cobalt)_40%,var(--border-subtle))]">
            <dt class="text-xs font-semibold uppercase tracking-wider text-[var(--text-muted)]">
              Audience
            </dt>
            <dd class="mt-2 text-base font-semibold text-[var(--text-primary)]">
              {audienceText(data.slug, data.audience, AUDIENCE_LABELS, "en")}
            </dd>
          </div>
        </dl>
      </section>

      <!-- Feature Bento Grid: What it's for (Jobs) -->
      <section class="mt-16" aria-labelledby="profile-jobs">
        <div class="flex items-center gap-3">
          <span
            class="inline-block size-2 rounded-full bg-[var(--brand-cobalt)]"
            aria-hidden="true"
          ></span>
          <h2
            id="profile-jobs"
            class="text-xl sm:text-2xl font-semibold tracking-tight text-[var(--text-primary)]"
          >
            What it’s for
          </h2>
        </div>
        <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {copy.jobs.map((job: string, i: number) => (
            <div class="group relative rounded-[var(--radius-card)] border border-[var(--border-subtle)] bg-[var(--surface-raised)] p-5 transition-[transform,box-shadow,border-color] duration-200 hover:-translate-y-0.5 hover:border-[color-mix(in_srgb,var(--brand-cobalt)_40%,var(--border-subtle))] hover:shadow-[0_12px_28px_-8px_color-mix(in_srgb,var(--brand-cobalt)_18%,transparent)] motion-reduce:transition-none motion-reduce:hover:translate-y-0">
              <span
                class="text-xs font-mono font-bold tracking-widest text-[var(--badge-ink)]"
                aria-hidden="true"
              >
                {String(i + 1).padStart(2, "0")}
              </span>
              <p class="mt-2 text-sm leading-relaxed text-[var(--text-secondary)] group-hover:text-[var(--text-primary)] overflow-wrap-anywhere">
                {job}
              </p>
            </div>
          ))}
        </div>
      </section>

      <!-- Feature Bento Grid: Capabilities -->
      {capabilities.length > 0 ? (
        <section class="mt-16" aria-labelledby="profile-capabilities">
          <div class="flex items-center gap-3">
            <span
              class="inline-block size-2 rounded-full bg-[var(--brand-cobalt)]"
              aria-hidden="true"
            ></span>
            <h2
              id="profile-capabilities"
              class="text-xl sm:text-2xl font-semibold tracking-tight text-[var(--text-primary)]"
            >
              {data.lifecycle === "active" || data.lifecycle === "maintenance"
                ? "Main capabilities"
                : labelFor(SHARED_LABELS.scopeHeading, "en")}
            </h2>
          </div>
          <div class="mt-6 grid gap-4 sm:grid-cols-2">
            {capabilities.map((capability: string, i: number) => (
              <div class="relative flex items-start gap-4 rounded-[var(--radius-card)] border border-[var(--border-subtle)] bg-[var(--surface-raised)] p-5 transition-[transform,box-shadow,border-color] duration-200 hover:-translate-y-0.5 hover:border-[color-mix(in_srgb,var(--brand-cobalt)_40%,var(--border-subtle))] hover:shadow-[0_12px_28px_-8px_color-mix(in_srgb,var(--brand-cobalt)_18%,transparent)] motion-reduce:transition-none motion-reduce:hover:translate-y-0">
                <div
                  class="flex size-8 flex-shrink-0 items-center justify-center rounded-lg bg-[color-mix(in_srgb,var(--brand-cobalt)_12%,var(--surface-subtle))] text-xs font-mono font-bold text-[var(--badge-ink)] ring-1 ring-inset ring-[var(--brand-cobalt)]/20"
                  aria-hidden="true"
                >
                  {String(i + 1).padStart(2, "0")}
                </div>
                <div class="min-w-0 flex-1">
                  <p class="text-sm font-medium leading-relaxed text-[var(--text-primary)] overflow-wrap-anywhere">
                    {capability}
                  </p>
                </div>
              </div>
            ))}
          </div>
        </section>
      ) : null}

      <!-- Real screens of the running app (GOLIVE W5) -->

      {showcase ? (
        <ProductShowcase
          showcase={showcase}
          lang="en"
          productName={data.name}
        />
      ) : null}

      <!-- Proof artifact: brand identity artwork on the ink stage, captioned as artwork -->
      {media && showcase ? (
        <section class="mt-16" aria-labelledby="profile-proof">
          <div class="flex items-center gap-3">
            <span
              class="inline-block size-2 rounded-full bg-[var(--brand-cobalt)]"
              aria-hidden="true"
            ></span>
            <h2
              id="profile-proof"
              class="text-xl sm:text-2xl font-semibold tracking-tight text-[var(--text-primary)]"
            >
              Brand artwork and references
            </h2>
          </div>
          <figure class="mt-6 m-0 max-w-4xl" data-profile-identity-stage>
            <ProductVisual media={media} />
            <figcaption class="mt-3 text-sm text-[var(--text-muted)]">
              {proofCaptionForKind(media.kind, "en")}
            </figcaption>
          </figure>
        </section>
      ) : null}

      <!-- Trust Paths -->
      {proofLinks.length > 0 ? (
        <section class="mt-16" aria-labelledby="profile-trust">
          <div class="flex items-center gap-3">
            <span
              class="inline-block size-2 rounded-full bg-[var(--brand-cobalt)]"
              aria-hidden="true"
            ></span>
            <h2
              id="profile-trust"
              class="text-xl sm:text-2xl font-semibold tracking-tight text-[var(--text-primary)]"
            >
              Privacy, security, support
            </h2>
          </div>
          <ul class="mt-6 flex flex-wrap gap-3">
            {proofLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="inline-flex min-h-11 items-center gap-2 rounded-[var(--radius-card)] border border-[var(--border-subtle)] bg-[var(--surface-raised)] px-4 py-2 text-sm font-semibold text-[var(--action-primary)] no-underline transition-[background-color,border-color,transform] duration-150 hover:-translate-y-0.5 hover:border-[var(--brand-cobalt)] hover:shadow-sm motion-reduce:transition-none motion-reduce:hover:translate-y-0"
                >
                  {link.label}
                  <svg
                    class="size-4 opacity-70"
                    viewBox="0 0 20 20"
                    fill="currentColor"
                    aria-hidden="true"
                  >
                    <path
                      fill-rule="evenodd"
                      d="M5.22 14.78a.75.75 0 001.06 0l7.22-7.22v5.69a.75.75 0 001.5 0v-7.5a.75.75 0 00-.75-.75h-7.5a.75.75 0 000 1.5h5.69l-7.22 7.22a.75.75 0 000 1.06z"
                      clip-rule="evenodd"
                    />
                  </svg>
                </a>
              </li>
            ))}
          </ul>
        </section>
      ) : null}
    </Container>
  </article>
</BaseLayout>

<style>
  .profile-lockup-light {
    display: block;
  }
  .profile-lockup-dark {
    display: none;
  }
  :global([data-theme="dark"]) .profile-lockup-light {
    display: none;
  }
  :global([data-theme="dark"]) .profile-lockup-dark {
    display: block;
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"])) .profile-lockup-light {
      display: none;
    }
    :global(:root:not([data-theme="light"])) .profile-lockup-dark {
      display: block;
    }
  }
</style>
