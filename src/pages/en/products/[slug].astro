---
import type { CollectionEntry } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Container from "@/components/layout/Container.astro";
import ProductStatus from "@/components/product/ProductStatus.astro";
import ProductLadder from "@/components/product/ProductLadder.astro";
import ButtonLink from "@/components/ui/ButtonLink.astro";
import { productCopy } from "@/lib/product-copy";
import AppAccess from "@/components/product/AppAccess.astro";
import { getPublicProducts } from "@/lib/products";
import { safeJsonLd, productJsonLd } from "@/lib/seo";
import { labelFor, SHARED_LABELS, SITE } from "@/data/site";

export async function getStaticPaths() {
  const products = await getPublicProducts();
  return products.map((product) => ({
    params: { slug: product.data.slug },
    props: { product },
  }));
}

interface Props {
  product: CollectionEntry<"products">;
}

const { product } = Astro.props;
const { data } = product;
const media = data.proof.media;
const copy = productCopy(data, "en");
const capabilities = copy.capabilities;

const PLATFORM_LABELS: Record<string, string> = {
  web: "Web",
  "browser-extension": "Browser extension",
  android: "Android",
  ios: "iOS",
  macos: "macOS",
  windows: "Windows",
  api: "API",
};

const AUDIENCE_LABELS: Record<string, string> = {
  individual: "Individuals",
  professional: "Professionals",
  team: "Teams",
  business: "Businesses",
  organization: "Organizations",
};

const proofLinks = [
  { href: data.proof.publicUrl, label: "Product site" },
  { href: data.proof.documentationUrl, label: "Documentation" },
  // Product source revisions are recorded internally; private GitHub repos are not public proof links.
  { href: data.proof.privacyUrl, label: "Privacy" },
  { href: data.proof.securityUrl, label: "Security" },
  { href: data.proof.supportUrl, label: "Support" },
].filter((link): link is { href: string; label: string } => Boolean(link.href));

const productStructuredData = productJsonLd(
  {
    name: data.name,
    description: copy.shortDescription,
    slug: data.slug,
    mediaUrl: media?.src,
    platforms: data.platforms,
  },
  SITE.url,
  "en",
);
---

<BaseLayout
  title={`${data.name} — BlueSkyz Labs`}
  description={copy.shortDescription}
  path={`/en/products/${data.slug}/`}
  ogImage={data.proof.media?.src}
  scene="product"
>
  <script
    type="application/ld+json"
    set:html={safeJsonLd(productStructuredData)}
  ></script>
  <article class="py-16">
    <Container>
      <p class="text-sm font-medium text-[var(--text-muted)]">
        <a
          href="/en/products/"
          class="inline-flex min-h-11 items-center text-sm font-semibold text-[var(--action-primary)] no-underline hover:underline"
        >
          Products
        </a>
        <span aria-hidden="true"> / </span>
        <span>{data.name}</span>
      </p>

      <div class="mt-6 flex flex-wrap items-center gap-3">
        <ProductStatus label={data.publicLabel} lang="en" />
        <p class="text-xs font-medium tracking-wide text-[var(--text-muted)]">
          {copy.endorsement}
        </p>
      </div>

      <h1 class="mt-4 max-w-[20ch] text-4xl font-semibold tracking-tight text-[var(--text-primary)] sm:text-5xl">
        {data.name}
      </h1>
      <p class="mt-5 max-w-2xl text-lg text-[var(--text-secondary)]">
        {copy.shortDescription}
      </p>

      <div class="mt-8 flex flex-wrap gap-3">
        {data.appAccess?.signInUrl ? (
          <ButtonLink href={data.appAccess.signInUrl}>
            {labelFor(SHARED_LABELS.signIn, "en")} · {data.name}
          </ButtonLink>
        ) : null}
        {data.secondaryAction ? (
          <ButtonLink href={data.secondaryAction.href} variant="secondary">
            {data.secondaryAction.label}
          </ButtonLink>
        ) : null}
      </div>

      <AppAccess
        appAccess={data.appAccess}
        productName={data.name}
        lang="en"
        showSignIn={false}
      />
      <ProductLadder lifecycle={data.lifecycle} lang="en" />

      <section class="mt-14" aria-labelledby="profile-status">
        <h2
          id="profile-status"
          class="text-xl font-semibold tracking-tight text-[var(--text-primary)]"
        >
          Status and platforms
        </h2>
        <dl class="mt-4 grid gap-4 sm:grid-cols-3">
          <div class="rounded-[var(--radius-card)] border border-[var(--border-subtle)] p-4 bg-[var(--bg-surface)]">
            <dt class="text-xs font-semibold uppercase tracking-wider text-[var(--text-muted)]">
              Status
            </dt>
            <dd class="mt-1 text-sm font-medium text-[var(--text-primary)]">
              {copy.statusLabel}
            </dd>
          </div>
          <div class="rounded-[var(--radius-card)] border border-[var(--border-subtle)] p-4 bg-[var(--bg-surface)]">
            <dt class="text-xs font-semibold uppercase tracking-wider text-[var(--text-muted)]">
              Platforms
            </dt>
            <dd class="mt-1 text-sm font-medium text-[var(--text-primary)]">
              {data.platforms
                .map((p: string) => PLATFORM_LABELS[p] ?? p)
                .join(", ")}
            </dd>
          </div>
          <div class="rounded-[var(--radius-card)] border border-[var(--border-subtle)] p-4 bg-[var(--bg-surface)]">
            <dt class="text-xs font-semibold uppercase tracking-wider text-[var(--text-muted)]">
              Audience
            </dt>
            <dd class="mt-1 text-sm font-medium text-[var(--text-primary)]">
              {data.audience
                .map((a: string) => AUDIENCE_LABELS[a] ?? a)
                .join(", ")}
            </dd>
          </div>
        </dl>
      </section>

      <section class="mt-14" aria-labelledby="profile-jobs">
        <h2
          id="profile-jobs"
          class="text-xl font-semibold tracking-tight text-[var(--text-primary)]"
        >
          What it’s for
        </h2>
        <ul class="mt-4 list-disc space-y-2 pl-5 text-[var(--text-secondary)]">
          {copy.jobs.map((job: string) => (
            <li>{job}</li>
          ))}
        </ul>
      </section>

      {capabilities.length > 0 ? (
        <section class="mt-14" aria-labelledby="profile-capabilities">
          <h2
            id="profile-capabilities"
            class="text-xl font-semibold tracking-tight text-[var(--text-primary)]"
          >
            {data.lifecycle === "active" || data.lifecycle === "maintenance"
              ? "Main capabilities"
              : "Development focus"}
          </h2>
          <ul class="mt-4 list-disc space-y-2 pl-5 text-[var(--text-secondary)]">
            {capabilities.map((capability: string) => (
              <li>{capability}</li>
            ))}
          </ul>
        </section>
      ) : null}

      {media ? (
        <section class="mt-14" aria-labelledby="profile-proof">
          <h2
            id="profile-proof"
            class="text-xl font-semibold tracking-tight text-[var(--text-primary)]"
          >
            Brand artwork and references
          </h2>
          <img
            class="mt-4 h-auto w-full max-w-4xl rounded-[var(--radius-card)] border border-[var(--border-subtle)] bg-[var(--c3-image-surface-background)]"
            src={media.src}
            alt={media.alt}
            width={media.width}
            height={media.height}
            loading="lazy"
            decoding="async"
          />
        </section>
      ) : null}

      {proofLinks.length > 0 ? (
        <section class="mt-14" aria-labelledby="profile-trust">
          <h2
            id="profile-trust"
            class="text-xl font-semibold tracking-tight text-[var(--text-primary)]"
          >
            Trust paths
          </h2>
          <ul class="mt-4 flex flex-wrap gap-4">
            {proofLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="inline-flex min-h-11 items-center text-sm font-semibold text-[var(--action-primary)] no-underline hover:underline"
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </section>
      ) : null}
    </Container>
  </article>
</BaseLayout>
