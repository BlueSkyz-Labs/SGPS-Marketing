---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Container from "@/components/layout/Container.astro";
import PageHeader from "@/components/layout/PageHeader.astro";
import ProductCard from "@/components/product/ProductCard.astro";
import ProofFirstEmptyState from "@/components/product/ProofFirstEmptyState.astro";
import { getPublicProducts } from "@/lib/products";
import IntentControl from "@/components/experience/IntentControl.astro";

const products = await getPublicProducts();
const allInDevelopment =
  products.length > 0 &&
  products.every((product) => product.data.lifecycle === "development");
const emptyDescription = products.length
  ? "Explore BlueSkyz Labs products with truthful status and evidence."
  : "Products are published only with verifiable public evidence.";
---

<BaseLayout
  title="Products: Sổ Trọ and Sổ Tâm, in development"
  description={emptyDescription}
  path="/en/products/"
  scene="product"
>
  <section class="py-16 lg:py-20">
    <Container>
      <PageHeader
        title="Our products"
        lede={
          products.length === 0
            ? "Products appear here when they are ready to evaluate. We publish only what you can verify."
            : allInDevelopment
              ? "Every product here is in development. Each page states its status and what backs it."
              : "Each product page states its status and what backs it."
        }
      />
      {products.length === 0 ? (
        <div class="mt-12">
          <ProofFirstEmptyState lang="en" />
        </div>
      ) : (
        <section class="mt-12" aria-labelledby="published-products">
          <h2
            id="published-products"
            class="text-xs font-semibold tracking-[0.18em] text-[var(--text-secondary)] uppercase"
          >
            {allInDevelopment ? "In development" : "Products"}
          </h2>
          <div class="mt-6 grid gap-4 md:grid-cols-2">
            {products.map((product) => (
              <ProductCard product={product} lang="en" />
            ))}
          </div>
        </section>
      )}
    </Container>
  </section>
  {/* Experience v6 S3: Atlas and evidence moved to /verify; one quiet link remains. */}
  <section class="border-t border-[var(--border-subtle)] py-16 lg:py-20">
    <Container>
      <IntentControl lang="en" />
      <p class="mt-8">
        <a
          href="/en/verify/"
          class="inline-flex min-h-11 items-center text-sm font-semibold text-[var(--action-primary)] underline underline-offset-4 hover:no-underline"
          data-verify-link
        >
          How we verify →
        </a>
      </p>
    </Container>
  </section>
</BaseLayout>
