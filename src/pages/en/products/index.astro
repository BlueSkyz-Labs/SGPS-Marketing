---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Container from "@/components/layout/Container.astro";
import PageHeader from "@/components/layout/PageHeader.astro";
import ProductCard from "@/components/product/ProductCard.astro";
import ButtonLink from "@/components/ui/ButtonLink.astro";
import { SITE } from "@/data/site";
import { emptyRegistryPrimaryCta, emptyRegistrySecondaryCta } from "@/lib/act";
import { getPublicProducts } from "@/lib/products";

const products = await getPublicProducts();
const emptyPrimary = emptyRegistryPrimaryCta(SITE.contactEmail, "en");
const emptySecondary = emptyRegistrySecondaryCta(SITE.contactEmail, "en");
const emptyDescription = products.length
  ? "Explore BlueSkyz Labs products with truthful status and evidence."
  : "BlueSkyz Labs has not published public products yet. Listings appear when products are ready to evaluate.";
---

<BaseLayout
  title="Products"
  description={emptyDescription}
  path="/en/products/"
>
  <section class="py-16 lg:py-24">
    <Container>
      <PageHeader
        title="Products you can verify"
        lede="Products appear here when they are ready to evaluate. We publish only what you can verify."
      />
      {
        products.length === 0 ? (
          <div class="mt-12 max-w-2xl rounded-xl border border-[var(--border-subtle)] bg-white p-6">
            <p class="text-sm leading-relaxed text-[var(--text-secondary)]">
              No public products are published yet. When a product is ready to
              evaluate, it will appear here with clear status and evidence.
            </p>
            <div class="mt-6 flex flex-wrap gap-3">
              <ButtonLink href={`/en${emptyPrimary.href}`}>
                {emptyPrimary.label}
              </ButtonLink>
              <ButtonLink
                href={`/en${emptySecondary.href}`}
                variant="secondary"
              >
                {emptySecondary.label}
              </ButtonLink>
            </div>
          </div>
        ) : (
          <div class="mt-12 grid gap-4 md:grid-cols-2">
            {products.map((product) => (
              <ProductCard product={product} lang="en" />
            ))}
          </div>
        )
      }
    </Container>
  </section>
</BaseLayout>
