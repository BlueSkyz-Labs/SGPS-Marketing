---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Container from "@/components/layout/Container.astro";
import EvidenceExplorer from "@/components/integrity/EvidenceExplorer.astro";
import { getEvidencePassport, getEvidencePassportIds } from "@/lib/claims";
import { getPublicProducts } from "@/lib/products";
import { claimReviewJsonLd, isClaimReviewState } from "@/lib/seo";
import { SITE } from "@/data/site";

export async function getStaticPaths() {
  const products = (await getPublicProducts()).map((product) => ({
    slug: product.data.slug,
    name: product.data.name,
  }));
  return getEvidencePassportIds(products).map((id) => ({ params: { id } }));
}

const { id } = Astro.params;
const products = (await getPublicProducts()).map((product) => ({
  slug: product.data.slug,
  name: product.data.name,
}));
const passport = getEvidencePassport(id ?? "", products);
const title = passport
  ? `Evidence: ${passport.titleLabel?.en ?? passport.claim.en}`
  : "Evidence";
/** ClaimReview only when a review with evidence exists; the state's honest
 * label is the rating (no scores, per the site's truth-state grammar). */
const CLAIM_STATE_LABELS = {
  reviewed: "Reviewed",
  "source-linked": "Source-linked",
} as const;
const claimReview =
  passport && isClaimReviewState(passport.state)
    ? [
        claimReviewJsonLd(SITE.url, `/en/evidence/${id}/`, {
          claimText: passport.claim.en,
          lang: "en",
          stateLabel: CLAIM_STATE_LABELS[passport.state],
          reviewedOn: passport.reviewedOn,
        }),
      ]
    : [];
---

<BaseLayout
  title={title}
  description={passport?.claim.en ?? "Evidence for this claim"}
  path={`/en/evidence/${id}/`}

  extraJsonLd={claimReview}
>
  <section class="py-16 lg:py-24">
    <Container>
      <div class="max-w-3xl">
        <p class="evidence-passport__page-title" data-passport-page-title>
          Evidence for this claim
        </p>
        <EvidenceExplorer
          id={id ?? ""}
          lang="en"
          products={products}
          claimAs="h1"
        />
      </div>
    </Container>
  </section>
</BaseLayout>
