---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Container from "@/components/layout/Container.astro";
import ButtonLink from "@/components/ui/ButtonLink.astro";
import PageHeader from "@/components/layout/PageHeader.astro";
---

<BaseLayout
  title="Page not found"
  description="The page you requested could not be found. Here are working paths instead."
  path="/en/404/"
  noindex={true}
>
  <section class="py-20 lg:py-28">
    <Container>
      <PageHeader
        eyebrow="404"
        title="Page not found"
        lede="The page you requested does not exist or has been moved. Here are working paths instead."
      />
      <p class="mt-4 max-w-2xl text-sm text-[var(--text-muted)]">
        Không tìm thấy trang bạn yêu cầu — hãy bắt đầu lại từ một trong các
        đường dẫn bên dưới.
      </p>
      <div class="mt-10 flex flex-wrap gap-3">
        <ButtonLink href="/en/" variant="primary">Go home</ButtonLink>
        <ButtonLink href="/vi/" variant="secondary">Trang chủ (VI)</ButtonLink>
        <ButtonLink href="/en/products/" variant="secondary">
          Browse products
        </ButtonLink>
        <ButtonLink href="/en/security/" variant="secondary"
          >Security</ButtonLink
        >
      </div>
    </Container>
  </section>
</BaseLayout>
