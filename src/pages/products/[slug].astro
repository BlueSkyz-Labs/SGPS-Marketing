---
import type { CollectionEntry } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Container from "@/components/layout/Container.astro";
import ProductStatus from "@/components/product/ProductStatus.astro";
import ButtonLink from "@/components/ui/ButtonLink.astro";
import { getPublicProducts } from "@/lib/products";

export async function getStaticPaths() {
  const products = await getPublicProducts();
  return products.map((product) => ({
    params: { slug: product.data.slug },
    props: { product },
  }));
}

interface Props {
  product: CollectionEntry<"products">;
}

const { product } = Astro.props;
const { data } = product;
const screenshot = data.proof.screenshot;
const capabilities = data.capabilities ?? [];

const PLATFORM_LABELS: Record<string, string> = {
  web: "Web",
  android: "Android",
  ios: "iOS",
  macos: "macOS",
  windows: "Windows",
  api: "API",
};

const AUDIENCE_LABELS: Record<string, string> = {
  individual: "Individuals",
  professional: "Professionals",
  team: "Teams",
  business: "Businesses",
  organization: "Organizations",
};

const proofLinks = [
  { href: data.proof.publicUrl, label: "Product site" },
  { href: data.proof.documentationUrl, label: "Documentation" },
  { href: data.proof.repositoryUrl, label: "Source" },
  { href: data.proof.privacyUrl, label: "Privacy" },
  { href: data.proof.securityUrl, label: "Security" },
  { href: data.proof.supportUrl, label: "Support" },
].filter((link): link is { href: string; label: string } => Boolean(link.href));
return Astro.redirect("/en/products/");
---

<BaseLayout
  title={data.name}
  description={data.shortDescription}
  path={`/products/${data.slug}/`}
  ogImage={data.proof.screenshot?.src}
>
  <article class="py-16">
    <Container>
      <p class="text-sm font-medium text-[var(--text-muted)]">
        <a
          href="/products/"
          class="inline-flex min-h-11 items-center text-sm font-semibold text-[var(--action-primary)] no-underline hover:underline"
          >Products</a
        >
        <span aria-hidden="true"> / </span>
        <span>{data.name}</span>
      </p>

      <div class="mt-6 flex flex-wrap items-center gap-3">
        <ProductStatus label={data.publicLabel} />
        <p class="text-xs font-medium tracking-wide text-[var(--text-muted)]">
          {data.endorsement}
        </p>
      </div>

      <h1 class="mt-4 max-w-[20ch] text-4xl font-semibold tracking-tight">
        {data.name}
      </h1>
      <p class="mt-5 max-w-2xl text-lg text-[var(--text-secondary)]">
        {data.shortDescription}
      </p>

      <div class="mt-8 flex flex-wrap gap-3">
        <ButtonLink href={data.primaryAction.href}
          >{data.primaryAction.label}</ButtonLink
        >
        {
          data.secondaryAction ? (
            <ButtonLink href={data.secondaryAction.href} variant="secondary">
              {data.secondaryAction.label}
            </ButtonLink>
          ) : null
        }
      </div>

      <section class="mt-14" aria-labelledby="profile-status">
        <h2 id="profile-status" class="text-xl font-semibold tracking-tight">
          Status and platforms
        </h2>
        <dl class="mt-4 grid gap-4 sm:grid-cols-2">
          <div>
            <dt class="text-sm font-medium text-[var(--text-muted)]">Status</dt>
            <dd class="mt-1 text-[var(--text-primary)]">{data.publicLabel}</dd>
          </div>
          <div>
            <dt class="text-sm font-medium text-[var(--text-muted)]">
              Platforms
            </dt>
            <dd class="mt-1 text-[var(--text-primary)]">
              {
                data.platforms
                  .map((p: string) => PLATFORM_LABELS[p] ?? p)
                  .join(", ")
              }
            </dd>
          </div>
          <div>
            <dt class="text-sm font-medium text-[var(--text-muted)]">
              Audience
            </dt>
            <dd class="mt-1 text-[var(--text-primary)]">
              {
                data.audience
                  .map((a: string) => AUDIENCE_LABELS[a] ?? a)
                  .join(", ")
              }
            </dd>
          </div>
        </dl>
      </section>

      <section class="mt-14" aria-labelledby="profile-jobs">
        <h2 id="profile-jobs" class="text-xl font-semibold tracking-tight">
          What it’s for
        </h2>
        <ul class="mt-4 list-disc space-y-2 pl-5 text-[var(--text-secondary)]">
          {data.jobs.map((job: string) => <li>{job}</li>)}
        </ul>
      </section>

      {
        capabilities.length > 0 ? (
          <section class="mt-14" aria-labelledby="profile-capabilities">
            <h2
              id="profile-capabilities"
              class="text-xl font-semibold tracking-tight"
            >
              Main capabilities
            </h2>
            <ul class="mt-4 list-disc space-y-2 pl-5 text-[var(--text-secondary)]">
              {capabilities.map((capability: string) => (
                <li>{capability}</li>
              ))}
            </ul>
          </section>
        ) : null
      }

      {
        screenshot ? (
          <section class="mt-14" aria-labelledby="profile-proof">
            <h2 id="profile-proof" class="text-xl font-semibold tracking-tight">
              Evidence
            </h2>
            <img
              class="mt-4 h-auto w-full max-w-3xl rounded-[var(--radius-card)] border border-[var(--border-subtle)]"
              src={screenshot.src}
              alt={screenshot.alt}
              width={screenshot.width}
              height={screenshot.height}
              loading="lazy"
              decoding="async"
            />
          </section>
        ) : null
      }

      {
        proofLinks.length > 0 ? (
          <section class="mt-14" aria-labelledby="profile-trust">
            <h2 id="profile-trust" class="text-xl font-semibold tracking-tight">
              Trust paths
            </h2>
            <ul class="mt-4 flex flex-wrap gap-4">
              {proofLinks.map((link) => (
                <li>
                  <a
                    href={link.href}
                    class="inline-flex min-h-11 items-center text-sm font-semibold text-[var(--action-primary)] no-underline hover:underline"
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </section>
        ) : null
      }
    </Container>
  </article>
</BaseLayout>
