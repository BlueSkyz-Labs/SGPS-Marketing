---
import { SITE } from "@/data/site";
import {
  DEFAULT_OG_IMAGE,
  absoluteUrl,
  canonicalForPath,
  defaultOgImagePath,
  hreflangLinks,
  organizationJsonLd,
  safeJsonLd,
  websiteJsonLd,
  xDefaultPath,
} from "@/lib/seo";
import { isNonProductionSiteUrl } from "@/lib/truth";

// Language gateway: indexable and the home cluster's x-default (Owner
// decision F16, 2026-10-01). Single all-locale title and description.
// English-first and single-language: the page is a language selector, so the
// title says so and the description names the four languages by endonym.
const title = "BlueSkyz Labs | Choose your language";
const description =
  "Choose a language for BlueSkyz Labs, which is building Sổ Trọ and Sổ Tâm, both in development: English, Tiếng Việt, 简体中文 or 繁體中文.";
// Google reads the site name from WebSite markup on the domain root, so the
// gateway carries the same Organization and WebSite JSON-LD as every page.
const structuredData = [organizationJsonLd(SITE.url), websiteJsonLd(SITE.url)];
const canonical = canonicalForPath("/", SITE.url);
// Brand Kit v4 website Open Graph card (1200x630), same committed asset as every
// BaseLayout page, so a shared gateway link carries the kit card.
const ogImageUrl = absoluteUrl(SITE.url, defaultOgImagePath());
// Non-production origins (preview, workers.dev, localhost) stay out of search.
const robotsNoindex = isNonProductionSiteUrl(SITE.url);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {robotsNoindex ? <meta name="robots" content="noindex, nofollow" /> : null}
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {hreflangLinks("/", SITE.url).map((link) => (
      <link rel="alternate" hreflang={link.hreflang} href={link.href} />
    ))}
    <link
      rel="alternate"
      hreflang="x-default"
      href={canonicalForPath(xDefaultPath("/"), SITE.url)}
    />
    <!-- Brand Kit v4 head contract (00_START_HERE/IMPLEMENTATION/favicon-head.html).
         Links only: no stylesheet, font or script request, so the inline-only
         first paint of ADR 0009 is unchanged. -->
    <link rel="icon" href="/icons/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/icons/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <link rel="manifest" href="/icons/site.webmanifest" />
    <link rel="mask-icon" href="/icons/safari-pinned-tab.svg" color="#2564FF" />
    <meta name="msapplication-config" content="/browserconfig.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content={String(DEFAULT_OG_IMAGE.width)} />
    <meta
      property="og:image:height"
      content={String(DEFAULT_OG_IMAGE.height)}
    />
    <meta property="og:image:alt" content={DEFAULT_OG_IMAGE.alt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={DEFAULT_OG_IMAGE.alt} />
    <meta name="color-scheme" content="light dark" />
    <meta
      name="theme-color"
      content="#f7f8fa"
      media="(prefers-color-scheme: light)"
    />
    <meta
      name="theme-color"
      content="#0b1020"
      media="(prefers-color-scheme: dark)"
    />
    <title>{title}</title>
    {structuredData.map((data) => (
      <script
        is:inline
        type="application/ld+json"
        set:html={safeJsonLd(data)}
      ></script>
    ))}
    <!--
      Static gateway (ADR 0009): all styling is inline so the first paint is
      already branded and scheme-correct with no stylesheet, font or script
      request. Colours mirror the global tokens (--brand-porcelain/--brand-ink,
      --border-subtle, --action-fill); the font stack mirrors --font-sans and
      falls back to system fonts, so no web font is downloaded here.
    -->
    <style is:inline>
      :root {
        color-scheme: light dark;
        --bg: #f7f8fa;
        --fg: #0b1020;
        --muted: #334155;
        --tile: #ffffff;
        --line: #cbd5e1;
        --accent: #1d4ed8;
        --shadow: 0 8px 28px rgba(11, 16, 32, 0.12);
      }
      @media (prefers-color-scheme: dark) {
        :root {
          --bg: #0b1020;
          --fg: #ffffff;
          --muted: #cbd5e1;
          --tile: #0f172a;
          --line: #334155;
          --accent: #3b82f6;
          --shadow: none;
        }
      }
      html {
        background: var(--bg);
      }
      body {
        margin: 0;
        min-height: 100vh;
        min-height: 100dvh;
        display: grid;
        place-items: center;
        background: var(--bg);
        color: var(--fg);
        font-family:
          "Inter Variable",
          "Inter Fallback",
          Inter,
          ui-sans-serif,
          system-ui,
          -apple-system,
          "Segoe UI",
          "Noto Sans",
          "PingFang SC",
          "Microsoft YaHei",
          "Noto Sans CJK SC",
          sans-serif;
        line-height: 1.5;
        -webkit-text-size-adjust: 100%;
      }
      main {
        box-sizing: border-box;
        width: 100%;
        max-width: 34rem;
        padding: 2rem 1rem 3rem;
        text-align: center;
      }
      .logo {
        display: block;
        width: 10rem;
        height: auto;
        margin: 0 auto 2rem;
      }
      h1 {
        margin: 0 0 0.5rem;
        font-size: var(--size-6);
        font-weight: 650;
        line-height: 1.25;
        letter-spacing: -0.01em;
      }
      .sub {
        margin: 0 0 2rem;
        color: var(--muted);
        font-size: var(--size-3);
      }
      nav {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 0.75rem;
      }
      nav a {
        box-sizing: border-box;
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 4.5rem;
        padding: 0.75rem 1rem;
        border: 1px solid var(--line);
        border-radius: var(--radius-card);
        background: var(--tile);
        box-shadow: var(--shadow);
        color: var(--fg);
        font-size: var(--size-5);
        font-weight: 600;
        text-decoration: none;
      }
      nav a:hover {
        border-color: var(--accent);
      }
      nav a:focus-visible {
        outline: 3px solid var(--accent);
        outline-offset: 2px;
      }
      @media (max-width: 22rem) {
        nav {
          grid-template-columns: minmax(0, 1fr);
        }
      }
      @media (forced-colors: active) {
        nav a {
          border-color: LinkText;
        }
      }
    </style>
  </head>
  <body>
    <main>
      <picture>
        <source
          media="(prefers-color-scheme: dark)"
          srcset="/brand/blueskyz/v4/logos/horizontal-reverse-white.svg"
        />
        <img
          class="logo"
          src="/brand/blueskyz/v4/logos/horizontal-flat-light.svg"
          alt="BlueSkyz Labs logo"
          width="160"
          height="50"
        />
      </picture>
      <h1>Choose your language</h1>
      <p class="sub">
        <span lang="vi">Chọn ngôn ngữ</span> ·
        <span lang="zh-Hans">选择语言</span> ·
        <span lang="zh-Hant">選擇語言</span>
      </p>
      <nav aria-label="Language">
        <a href="/vi/" data-language-choice="vi" lang="vi">
          Tiếng Việt
        </a>
        <a href="/en/" data-language-choice="en" lang="en">
          English
        </a>
        <a href="/zh/" data-language-choice="zh" lang="zh-Hans">
          简体中文
        </a>
        <a href="/zh-hant/" data-language-choice="zh-hant" lang="zh-Hant">
          繁體中文
        </a>
      </nav>
    </main>
    <script>
      import { LANGUAGE_STORAGE_KEY, resolveInitialLanguage } from "@/lib/i18n";

      let stored: string | null = null;
      try {
        stored = window.localStorage.getItem(LANGUAGE_STORAGE_KEY);
      } catch {
        // First visit can still resolve from browser preference.
      }

      const browserLanguages = navigator.languages?.length
        ? navigator.languages
        : [navigator.language];
      const countryHint = document.documentElement.dataset.country ?? null;
      const language = resolveInitialLanguage(
        stored,
        browserLanguages,
        countryHint,
      );

      window.location.replace(`/${language}/`);
    </script>
  </body>
</html>
