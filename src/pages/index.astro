---
const title = "BlueSkyz Labs";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex, follow" />
    <title>{title}</title>
  </head>
  <body>
    <main>
      <p>Choose your language / Chọn ngôn ngữ</p>
      <nav aria-label="Language">
        <a href="/vi/" data-language-choice="vi">Tiếng Việt</a>
        <a href="/en/" data-language-choice="en">English</a>
      </nav>
      <noscript>
        <p><a href="/en/">Continue in English</a></p>
      </noscript>
    </main>
    <script>
      import {
        LANGUAGE_STORAGE_KEY,
        resolveInitialLanguage,
      } from "@/lib/i18n";

      let stored: string | null = null;
      try {
        stored = window.localStorage.getItem(LANGUAGE_STORAGE_KEY);
      } catch {
        // First visit can still resolve from browser preference.
      }

      const browserLanguages = navigator.languages?.length
        ? navigator.languages
        : [navigator.language];
      const countryHint = document.documentElement.dataset.country ?? null;
      const language = resolveInitialLanguage(
        stored,
        browserLanguages,
        countryHint,
      );

      window.location.replace(`/${language}/`);
    </script>
  </body>
</html>
