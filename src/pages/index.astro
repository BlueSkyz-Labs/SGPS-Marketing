---
const title = "BlueSkyz Labs";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, follow" />
    <meta name="color-scheme" content="light dark" />
    <meta
      name="theme-color"
      content="#f7f8fa"
      media="(prefers-color-scheme: light)"
    />
    <meta
      name="theme-color"
      content="#0b1020"
      media="(prefers-color-scheme: dark)"
    />
    <title>{title}</title>
    <!--
      Static gateway (ADR 0009): all styling is inline so the first paint is
      already branded and scheme-correct with no stylesheet, font or script
      request. Colours mirror the global tokens (--brand-porcelain/--brand-ink,
      --border-subtle, --action-fill); the font stack mirrors --font-sans and
      falls back to system fonts, so no web font is downloaded here.
    -->
    <style is:inline>
      :root {
        color-scheme: light dark;
        --bg: #f7f8fa;
        --fg: #0b1020;
        --muted: #334155;
        --tile: #ffffff;
        --line: #cbd5e1;
        --accent: #1d4ed8;
        --shadow: 0 8px 28px rgba(11, 16, 32, 0.12);
      }
      @media (prefers-color-scheme: dark) {
        :root {
          --bg: #0b1020;
          --fg: #ffffff;
          --muted: #cbd5e1;
          --tile: #0f172a;
          --line: #334155;
          --accent: #3b82f6;
          --shadow: none;
        }
      }
      html {
        background: var(--bg);
      }
      body {
        margin: 0;
        min-height: 100vh;
        min-height: 100dvh;
        display: grid;
        place-items: center;
        background: var(--bg);
        color: var(--fg);
        font-family:
          "Inter Variable",
          "Inter Fallback",
          Inter,
          ui-sans-serif,
          system-ui,
          -apple-system,
          "Segoe UI",
          "Noto Sans",
          "PingFang SC",
          "Microsoft YaHei",
          "Noto Sans CJK SC",
          sans-serif;
        line-height: 1.5;
        -webkit-text-size-adjust: 100%;
      }
      main {
        box-sizing: border-box;
        width: 100%;
        max-width: 34rem;
        padding: 2rem 1rem 3rem;
        text-align: center;
      }
      .logo {
        display: block;
        width: 10rem;
        height: auto;
        margin: 0 auto 2rem;
      }
      h1 {
        margin: 0 0 0.5rem;
        font-size: 1.5rem;
        font-weight: 650;
        line-height: 1.25;
        letter-spacing: -0.01em;
      }
      .sub {
        margin: 0 0 2rem;
        color: var(--muted);
        font-size: 1rem;
      }
      nav {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 0.75rem;
      }
      nav a {
        box-sizing: border-box;
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 4.5rem;
        padding: 0.75rem 1rem;
        border: 1px solid var(--line);
        border-radius: 0.75rem;
        background: var(--tile);
        box-shadow: var(--shadow);
        color: var(--fg);
        font-size: 1.25rem;
        font-weight: 600;
        text-decoration: none;
      }
      nav a:hover {
        border-color: var(--accent);
      }
      nav a:focus-visible {
        outline: 3px solid var(--accent);
        outline-offset: 2px;
      }
      @media (max-width: 22rem) {
        nav {
          grid-template-columns: minmax(0, 1fr);
        }
      }
      @media (forced-colors: active) {
        nav a {
          border-color: LinkText;
        }
      }
    </style>
  </head>
  <body>
    <main>
      <picture>
        <source
          media="(prefers-color-scheme: dark)"
          srcset="/brand/blueskyz/v4/logos/horizontal-reverse-white.svg"
        />
        <img
          class="logo"
          src="/brand/blueskyz/v4/logos/horizontal-flat-light.svg"
          alt="BlueSkyz Labs"
          width="160"
          height="50"
        />
      </picture>
      <h1>Choose your language</h1>
      <p class="sub" lang="vi">
        Chọn ngôn ngữ
      </p>
      <nav aria-label="Language">
        <a href="/vi/" data-language-choice="vi" lang="vi">
          Tiếng Việt
        </a>
        <a href="/en/" data-language-choice="en" lang="en">
          English
        </a>
        <a href="/zh/" data-language-choice="zh" lang="zh-Hans">
          简体中文
        </a>
        <a href="/zh-hant/" data-language-choice="zh-hant" lang="zh-Hant">
          繁體中文
        </a>
      </nav>
    </main>
    <script>
      import { LANGUAGE_STORAGE_KEY, resolveInitialLanguage } from "@/lib/i18n";

      let stored: string | null = null;
      try {
        stored = window.localStorage.getItem(LANGUAGE_STORAGE_KEY);
      } catch {
        // First visit can still resolve from browser preference.
      }

      const browserLanguages = navigator.languages?.length
        ? navigator.languages
        : [navigator.language];
      const countryHint = document.documentElement.dataset.country ?? null;
      const language = resolveInitialLanguage(
        stored,
        browserLanguages,
        countryHint,
      );

      window.location.replace(`/${language}/`);
    </script>
  </body>
</html>
