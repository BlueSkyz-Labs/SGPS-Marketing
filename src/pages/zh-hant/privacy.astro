---
// zh-Hant copy: machine-assisted (OpenCC s2twp), pending native review.
import BaseLayout from "@/layouts/BaseLayout.astro";
import { PAGE_META } from "@/data/page-meta";
import Container from "@/components/layout/Container.astro";
import PageHeader from "@/components/layout/PageHeader.astro";
import BoundaryCard from "@/components/integrity/BoundaryCard.astro";
import ProvenanceLens from "@/components/provenance/ProvenanceLens.astro";
import { PRIVACY_BOUNDARY } from "@/data/integrity";
import { SITE } from "@/data/site";

const hasBusinessEmail = Boolean(SITE.contactEmail);
---

<BaseLayout
  title={PAGE_META["zh-hant"]["privacy"].title}
  description={PAGE_META["zh-hant"]["privacy"].description}
  path="/zh-hant/privacy/"
  surface="privacy"
  lensTraces={false}
  lensBoundaries={false}
>
  <section class="py-16 lg:py-24">
    <Container>
      <PageHeader
        eyebrow="隱私"
        title="清晰的資料邊界"
        lede="本企業站點為靜態營銷內容。完整的法律隱私文案將在 BlueSkyz 批准後發布。"
      />
      <dl class="mt-12 max-w-2xl space-y-8">
        <div class="rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-raised)] p-6">
          <dt class="text-sm font-semibold tracking-tight">收集內容</dt>
          <dd class="mt-2 text-sm leading-relaxed text-[var(--text-secondary)]">
            本站基本瀏覽無需帳戶、表單或追蹤 Cookie。標準 Web 伺服器與 CDN
            請求日誌可能記錄技術連線資料，例如 IP 地址、使用者代理與請求 URL。
          </dd>
        </div>
        <div class="rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-raised)] p-6">
          <dt class="text-sm font-semibold tracking-tight">原因</dt>
          <dd class="mt-2 text-sm leading-relaxed text-[var(--text-secondary)]">
            請求日誌用於安全、濫用防護與靜態資源的可靠交付 — 而非廣告畫像。
          </dd>
        </div>
        <div class="rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-raised)] p-6">
          <dt class="text-sm font-semibold tracking-tight">使用方式</dt>
          <dd class="mt-2 text-sm leading-relaxed text-[var(--text-secondary)]">
            日誌由託管平台營運方用於運維目的。本基礎架構不載入任何第三方廣告畫素或會話錄製指令碼。
          </dd>
        </div>
        <div class="rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-raised)] p-6">
          <dt class="text-sm font-semibold tracking-tight">刪除與產品隱私</dt>
          <dd class="mt-2 text-sm leading-relaxed text-[var(--text-secondary)]">
            本企業站點沒有可供匯出或刪除的客戶帳戶。產品相關的隱私作法將在該產品發布後於對應頁面說明。
          </dd>
        </div>
      </dl>
      <div class="mt-12 max-w-2xl">
        <BoundaryCard boundary={PRIVACY_BOUNDARY} lang="zh-hant" />
      </div>
      <div class="mt-12 flex flex-wrap gap-3">
        <a
          href="/zh-hant/security/"
          class="inline-flex min-h-11 items-center rounded-lg border border-[var(--border-subtle)] bg-[var(--surface-raised)] px-5 text-sm font-semibold text-[var(--text-primary)] no-underline transition-colors hover:border-[var(--action-primary)]"
        >
          安全報告
        </a>
        {hasBusinessEmail ? (
          <a
            href="/zh-hant/contact/"
            class="inline-flex min-h-11 items-center rounded-lg border border-[var(--border-subtle)] bg-[var(--surface-raised)] px-5 text-sm font-semibold text-[var(--text-primary)] no-underline transition-colors hover:border-[var(--action-primary)]"
          >
            聯絡 BlueSkyz
          </a>
        ) : (
          <a
            href="/zh-hant/about/"
            class="inline-flex min-h-11 items-center rounded-lg border border-[var(--border-subtle)] bg-[var(--surface-raised)] px-5 text-sm font-semibold text-[var(--text-primary)] no-underline transition-colors hover:border-[var(--action-primary)]"
          >
            關於 BlueSkyz
          </a>
        )}
      </div>
      <div class="mt-12">
        <ProvenanceLens
          subject="privacy-no-tracking-on-this-site"
          lang="zh-hant"
        />
      </div>
    </Container>
  </section>
</BaseLayout>
