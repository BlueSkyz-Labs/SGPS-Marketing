---
// zh-Hant copy: machine-assisted (OpenCC s2twp), pending native review.
import BaseLayout from "@/layouts/BaseLayout.astro";
import Container from "@/components/layout/Container.astro";
import EvidencePassport from "@/components/integrity/EvidencePassport.astro";
import { getEvidencePassport, getEvidencePassportIds } from "@/lib/claims";
import { getPublicProducts } from "@/lib/products";
import { claimReviewJsonLd } from "@/lib/seo";
import { SITE } from "@/data/site";

export async function getStaticPaths() {
  const products = (await getPublicProducts()).map((product) => ({
    slug: product.data.slug,
    name: product.data.name,
  }));
  return getEvidencePassportIds(products).map((id) => ({ params: { id } }));
}

const { id } = Astro.params;
const products = (await getPublicProducts()).map((product) => ({
  slug: product.data.slug,
  name: product.data.name,
}));
const passport = getEvidencePassport(id ?? "", products);
const title = passport ? `證據：${passport.claim["zh-hant"]}` : "證據";

/** ClaimReview only when a review with evidence exists; the state's honest
 * label is the rating (no scores, per the site's truth-state grammar). */
const CLAIM_STATE_LABELS: Record<string, string> = {
  reviewed: "已審閱",
  "source-linked": "已關聯來源",
};
const claimReview =
  passport && passport.state in CLAIM_STATE_LABELS
    ? [
        claimReviewJsonLd(SITE.url, `/zh-hant/evidence/${id}/`, {
          claimText: passport.claim["zh-hant"] ?? passport.claim.en,
          lang: "zh-hant",
          stateLabel: CLAIM_STATE_LABELS[passport.state],
          reviewedOn: passport.reviewedOn,
        }),
      ]
    : [];---

<BaseLayout
  title={title}
  description={passport?.claim["zh-hant"] ?? "這項說法的證據"}
  path={`/zh-hant/evidence/${id}/`}
  extraJsonLd={claimReview}
>
  <section class="py-16 lg:py-24">
    <Container>
      <div class="max-w-3xl">
        <p class="evidence-passport__page-title" data-passport-page-title>
          這項說法的證據
        </p>
        <EvidencePassport
          id={id ?? ""}
          lang="zh-hant"
          products={products}
          claimAs="h1"
        />
      </div>
    </Container>
  </section>
</BaseLayout>
