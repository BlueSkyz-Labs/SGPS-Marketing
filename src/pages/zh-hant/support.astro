---
// zh-Hant copy: machine-assisted (OpenCC s2twp), pending native review.
import BaseLayout from "@/layouts/BaseLayout.astro";
import { PAGE_META } from "@/data/page-meta";
import Container from "@/components/layout/Container.astro";
import PageHeader from "@/components/layout/PageHeader.astro";
import ButtonLink from "@/components/ui/ButtonLink.astro";
import { SITE } from "@/data/site";

// A published support mailbox is the primary action: the visitor gets one
// direct way to ask for help. Without it, Contact is primary (it renders a
// real business route, never a dead end). Security stays a secondary link
// for vulnerability reports only.
const hasSupportEmail = Boolean(SITE.supportEmail);
---

<BaseLayout
  title={PAGE_META["zh-hant"]["support"].title}
  description={PAGE_META["zh-hant"]["support"].description}
  path="/zh-hant/support/"
>
  <section class="py-16 lg:py-24">
    <Container>
      <PageHeader
        eyebrow="支援"
        title="如何取得協助"
        lede={
          hasSupportEmail
            ? "對我們的應用程式有疑問？請來信。"
            : "目前尚未公布通用支援信箱。資安通報僅用於漏洞。"
        }
      />
      <div class="mt-10 flex flex-wrap items-center gap-3" data-support-actions>
        {hasSupportEmail ? (
          <ButtonLink
            href={`mailto:${SITE.supportEmail}`}
            data-support-primary
            data-support-mailbox
          >
            {SITE.supportEmail}
          </ButtonLink>
        ) : (
          <ButtonLink href="/zh-hant/contact/" data-support-primary>
            聯絡我們
          </ButtonLink>
        )}
        <ButtonLink
          href="/zh-hant/security/"
          variant="secondary"
          data-support-security
        >
          安全（僅限漏洞通報）
        </ButtonLink>
      </div>
    </Container>
  </section>
</BaseLayout>
