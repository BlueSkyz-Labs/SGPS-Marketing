---
// zh-Hant copy: machine-assisted (OpenCC s2twp), pending native review.
import BaseLayout from "@/layouts/BaseLayout.astro";
import Container from "@/components/layout/Container.astro";
import PageHeader from "@/components/layout/PageHeader.astro";
import SafeAction from "@/components/integrity/SafeAction.astro";
import BoundaryCard from "@/components/integrity/BoundaryCard.astro";
import BilingualMirror from "@/components/integrity/BilingualMirror.astro";
import { SECURITY_BOUNDARY } from "@/data/integrity";
import { SITE, SECURITY_ADVISORY_URL } from "@/data/site";
import CraftStory from "@/components/editorial/CraftStory.astro";
import { getCraftStory } from "@/data/craft-stories";
const craftStory = getCraftStory("private-security-reporting");
---

<BaseLayout
  title="資訊安全"
  description="透過 GitHub Security Advisories 私下向 BlueSkyz Labs 報告漏洞，並附上您可自行核驗的已發布證據與邊界說明。"
  path="/zh-hant/security/"
  surface="security"
  lensBoundaries={false}
  lensTraces={false}
>
  <section class="py-16 lg:py-24">
    <Container>
      <PageHeader
        eyebrow="資訊安全"
        title="私密、負責任地報告"
        lede="請透過私有管道報告安全問題。請勿就漏洞報告在 GitHub 上公開開 issue。"
      />
      {SITE.securityEmail ? (
        <p class="mt-8 max-w-2xl text-[var(--text-secondary)]">
          Email{" "}
          <a
            href={`mailto:${SITE.securityEmail}`}
            class="inline-flex min-h-11 items-center font-semibold text-[var(--action-primary)] no-underline hover:underline"
          >
            {SITE.securityEmail}
          </a>
          .
        </p>
      ) : null}
      <div class="mt-10">
        <SafeAction
          href={SECURITY_ADVISORY_URL}
          label="開啟私有漏洞報告"
          boundary="private-reporting"
          lang="zh-hant"
        />
      </div>
      <div class="mt-10 max-w-2xl">
        <BoundaryCard boundary={SECURITY_BOUNDARY} lang="zh-hant" />
      </div>
      <div class="mt-12 max-w-3xl">
        <BilingualMirror lang="zh-hant" />
      </div>
      <div class="mt-12 max-w-3xl">
        {craftStory && <CraftStory story={craftStory} lang="zh-hant" />}
      </div>
    </Container>
  </section>
</BaseLayout>
