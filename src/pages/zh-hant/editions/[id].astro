---
// zh-Hant copy: machine-assisted (OpenCC s2twp), pending native review.
import BaseLayout from "@/layouts/BaseLayout.astro";
import Container from "@/components/layout/Container.astro";
import EditionStory from "@/components/editorial/EditionStory.astro";
import { EDITIONS } from "@/data/editions";
import { resolveEdition } from "@/lib/editions";

export function getStaticPaths() {
  return EDITIONS.map((edition) => ({
    params: { id: edition.id },
    props: { edition },
  }));
}

const { edition } = Astro.props;
const view = resolveEdition(edition, "zh-hant");
---

<BaseLayout
  title={view.title}
  description={view.deck}
  path={`/zh-hant/editions/${view.id}/`}
>
  <section class="py-16 lg:py-24">
    <Container>
      <EditionStory edition={edition} lang="zh-hant" />
    </Container>
  </section>
</BaseLayout>
