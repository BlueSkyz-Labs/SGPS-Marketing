---
// zh-Hant copy: machine-assisted (OpenCC s2twp), pending native review.
import BaseLayout from "@/layouts/BaseLayout.astro";
import Container from "@/components/layout/Container.astro";
import EditionStory from "@/components/editorial/EditionStory.astro";
import { EDITIONS } from "@/data/editions";
import { editionBreadcrumbJsonLd } from "@/lib/breadcrumbs";
import { safeJsonLd } from "@/lib/seo";
import { SITE } from "@/data/site";
import { resolveEdition } from "@/lib/editions";

export function getStaticPaths() {
  return EDITIONS.map((edition) => ({
    params: { id: edition.id },
    props: { edition },
  }));
}

const { edition } = Astro.props;
const view = resolveEdition(edition, "zh-hant");
const breadcrumb = editionBreadcrumbJsonLd(
  "zh-hant",
  view.id,
  view.title,
  SITE.url,
);
---

<BaseLayout
  title={view.title}
  description={view.deck}
  path={`/zh-hant/editions/${view.id}/`}
>
  {breadcrumb ? (
    <script
      type="application/ld+json"
      set:html={safeJsonLd(breadcrumb)}
    ></script>
  ) : null}
  <section class="py-16 lg:py-24">
    <Container>
      <EditionStory edition={edition} lang="zh-hant" />
    </Container>
  </section>
</BaseLayout>
