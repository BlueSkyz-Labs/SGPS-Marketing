    <Container>
      <PageHeader
        title="已發布選集"
        lede="本站已發布陳述的精選集合。每個選集都連結到每一項背後的證據；不新增本站尚未發布的任何內容。"
      />
      <div class="mt-12">
        <EditionIndex lang="zh-hant" />
      </div>
    </Container>
  </section>
</BaseLayout>
