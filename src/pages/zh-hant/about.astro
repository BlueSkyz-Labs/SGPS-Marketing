---
// zh-Hant copy: machine-assisted (OpenCC s2twp), pending native review.
import BaseLayout from "@/layouts/BaseLayout.astro";
import Container from "@/components/layout/Container.astro";
import PageHeader from "@/components/layout/PageHeader.astro";
---

<BaseLayout
  title="關於我們"
  description="關於 BlueSkyz Labs — 我們打造智慧化產品，賦能個人並提升工作方式。"
  path="/zh-hant/about/"
>
  <section class="py-16 lg:py-24">
    <Container>
      <PageHeader
        eyebrow="關於我們"
        title="我們是誰"
        lede="我們打造智慧化產品，賦能個人並提升工作方式。更高的視角，成就更明亮的明天。"
      />
      <div class="mt-12 max-w-2xl rounded-xl border border-[var(--border-subtle)] border-l-[3px] border-l-[color-mix(in_srgb,var(--brand-cobalt)_60%,var(--border-subtle))] bg-[var(--surface-raised)] p-6">
        <p class="text-[0.65rem] font-semibold tracking-[0.14em] text-[var(--text-muted)] uppercase">
          說明
        </p>
        <p class="mt-2 text-sm font-semibold tracking-tight text-[var(--text-primary)]">
          Tony Nguyen — 創辦人兼執行長
        </p>
        <p class="mt-3 text-sm leading-[1.65] text-[var(--text-secondary)]">
          本頁面保持以公司為主導。創辦人資訊僅在獲批後發布於公開站點 —
          在此之前不預先撰寫任何內容。
        </p>
      </div>
    </Container>
  </section>
</BaseLayout>
