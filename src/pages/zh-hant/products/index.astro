---
// zh-Hant copy: machine-assisted (OpenCC s2twp), pending native review.
import BaseLayout from "@/layouts/BaseLayout.astro";
import { PAGE_META } from "@/data/page-meta";
import Container from "@/components/layout/Container.astro";
import PageHeader from "@/components/layout/PageHeader.astro";
import ProductCard from "@/components/product/ProductCard.astro";
import ProofFirstEmptyState from "@/components/product/ProofFirstEmptyState.astro";
import { getPublicProducts } from "@/lib/products";

const products = await getPublicProducts();
const allInDevelopment =
  products.length > 0 &&
  products.every((product) => product.data.lifecycle === "development");
const emptyDescription = "產品僅在具備可核驗的公開證據時發布。";
---

<BaseLayout
  title={PAGE_META["zh-hant"].products.title}
  description={
    products.length
      ? PAGE_META["zh-hant"].products.description
      : emptyDescription
  }
  path="/zh-hant/products/"
  scene="product"
>
  <section class="py-16 lg:py-20">
    <Container>
      <PageHeader
        title="我們的產品"
        lede={
          products.length === 0
            ? "產品將在可評估時展示於此。我們只發布你可以核驗的內容。"
            : allInDevelopment
              ? "兩項產品都在開發中。每個頁面都說明其狀態。"
              : "每個頁面都註明產品狀態與依據。"
        }
      />
      {products.length === 0 ? (
        <div class="mt-12">
          <ProofFirstEmptyState lang="zh-hant" />
        </div>
      ) : (
        <section class="mt-12" aria-labelledby="published-products">
          <h2
            id="published-products"
            class:list={[
              "text-xs font-semibold tracking-[0.18em] text-[var(--text-secondary)] uppercase [&:lang(vi)]:normal-case [&:lang(vi)]:tracking-[var(--tracking-eyebrow)]",
              allInDevelopment && "sr-only",
            ]}
          >
            {allInDevelopment ? "開發中" : "產品"}
          </h2>
          <div class="mt-6 grid gap-4 md:grid-cols-2">
            {products.map((product) => (
              <ProductCard product={product} lang="zh-hant" showThumb />
            ))}
          </div>
        </section>
      )}
    </Container>
  </section>
</BaseLayout>
