---
// zh-Hant copy: machine-assisted (OpenCC s2twp), pending native review.
import BaseLayout from "@/layouts/BaseLayout.astro";
import Container from "@/components/layout/Container.astro";
import ButtonLink from "@/components/ui/ButtonLink.astro";
import PageHeader from "@/components/layout/PageHeader.astro";
---

<BaseLayout
  title="找不到頁面"
  description="你請求的頁面無法找到。"
  path="/zh-hant/404/"
  noindex={true}
>
  <section class="py-20 lg:py-28">
    <Container>
      <div class="not-found-moment mx-auto max-w-2xl text-center">
        <div class="sail-drift" aria-hidden="true">
          ⛵
        </div>
        <div class="mt-6">
          <PageHeader
            eyebrow="404"
            eyebrowVariant="numeral"
            title="找不到頁面"
            lede="在海上迷失了？ 即使是帆也會偏離航向。讓我們帶你回到正軌。"
          />
        </div>
        <div class="mt-10 flex flex-wrap justify-center gap-3">
          <ButtonLink href="/zh-hant/" variant="primary">
            返回首頁
          </ButtonLink>
          <ButtonLink href="/zh-hant/products/" variant="secondary">
            瀏覽產品
          </ButtonLink>
        </div>
      </div>
    </Container>
  </section>
</BaseLayout>
