---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Container from "@/components/layout/Container.astro";
import ButtonLink from "@/components/ui/ButtonLink.astro";
---

<BaseLayout
  title="找不到頁面"
  description="你請求的頁面無法找到。"
  path="/zh-hant/404/"
  noindex={true}
>
  <section class="py-20 lg:py-28">
    <Container>
      <div class="mx-auto max-w-2xl text-center">
        <div class="sail-drift" aria-hidden="true">⛵</div>
        <p class="mt-6 text-sm font-semibold uppercase tracking-widest text-[var(--text-secondary)]">
          404
        </p>
        <h1 class="mt-2 text-4xl font-bold tracking-tight sm:text-5xl">
          在海上迷失了？
        </h1>
        <p class="mt-4 text-lg leading-relaxed text-[var(--text-secondary)]">
          即使是帆也會偏離航向。讓我們帶你回到正軌。
        </p>
        <div class="mt-10 flex flex-wrap justify-center gap-3">
          <ButtonLink href="/zh-hant/" variant="primary">
            返回首頁
          </ButtonLink>
          <ButtonLink href="/zh-hant/products/" variant="secondary">
            瀏覽產品
          </ButtonLink>
        </div>
      </div>
    </Container>
  </section>
</BaseLayout>
