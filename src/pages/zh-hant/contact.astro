---
// zh-Hant copy: machine-assisted (OpenCC s2twp), pending native review.
import BaseLayout from "@/layouts/BaseLayout.astro";
import Container from "@/components/layout/Container.astro";
import PageHeader from "@/components/layout/PageHeader.astro";
import SafeAction from "@/components/integrity/SafeAction.astro";
import ProductSignInLane from "@/components/empty-state/ProductSignInLane.astro";
import BusinessRouteState from "@/components/empty-state/BusinessRouteState.astro";
import { EMPTY_STATE_COPY } from "@/data/empty-state-copy";
import { SITE, SECURITY_ADVISORY_URL, labelFor } from "@/data/site";

const hasBusinessEmail = Boolean(SITE.contactEmail);
---

<BaseLayout
  title="聯絡我們"
  description="就商務、安全或一般諮詢聯絡 BlueSkyz Labs。"
  path="/zh-hant/contact/"
>
  <section class="py-16 lg:py-24">
    <Container>
      <PageHeader
        eyebrow="聯絡我們"
        title="為您匹配正確的通道"
        lede={labelFor(EMPTY_STATE_COPY.contactLede, "zh-hant")}
      />
      <ul class="mt-12 grid gap-4 sm:grid-cols-2">
        <li class="flex min-w-0 flex-col rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-raised)] p-6">
          <h2 class="text-lg font-semibold tracking-tight">安全</h2>
          <p class="mt-2 flex-1 text-sm leading-relaxed text-[var(--text-secondary)]">
            如發現疑似安全漏洞，請透過 GitHub 私密通道報告。
          </p>
          <div class="mt-5">
            <SafeAction
              href={SECURITY_ADVISORY_URL}
              label="開啟私有漏洞報告"
              boundary="private-reporting"
              lang="zh-hant"
            />
          </div>
        </li>
        <ProductSignInLane lang="zh-hant" />
        {hasBusinessEmail ? (
          <li class="flex min-w-0 flex-col rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-raised)] p-6 sm:col-span-2">
            <h2 class="text-lg font-semibold tracking-tight">
              商務 / 一般諮詢
            </h2>
            <p class="mt-2 flex-1 text-sm leading-relaxed text-[var(--text-secondary)]">
              <>
                Email{" "}
                <a
                  href={`mailto:${SITE.contactEmail}`}
                  class="inline-flex min-h-11 items-center font-semibold text-[var(--action-primary)] no-underline hover:underline"
                >
                  {SITE.contactEmail}
                </a>{" "}
                用於商務諮詢。
              </>
            </p>
          </li>
        ) : (
          <BusinessRouteState
            lang="zh-hant"
            heading="商務 / 一般諮詢"
            boundary="私密安全報告僅用於揭露疑似漏洞，不是商務或一般諮詢通道。"
          />
        )}
      </ul>
    </Container>
  </section>
</BaseLayout>
