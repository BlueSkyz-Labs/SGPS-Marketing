---
// zh-Hant copy: machine-assisted (OpenCC s2twp), pending native review.
import BaseLayout from "@/layouts/BaseLayout.astro";
import { PAGE_META } from "@/data/page-meta";
import Container from "@/components/layout/Container.astro";
import PageHeader from "@/components/layout/PageHeader.astro";
import SafeAction from "@/components/integrity/SafeAction.astro";
import ProductSignInLane from "@/components/empty-state/ProductSignInLane.astro";
import PublicContactEmails from "@/components/empty-state/PublicContactEmails.astro";
import { EMPTY_STATE_COPY } from "@/data/empty-state-copy";
import { labelFor, SECURITY_ADVISORY_URL } from "@/data/site";
---

<BaseLayout
  title={PAGE_META["zh-hant"]["contact"].title}
  description={PAGE_META["zh-hant"]["contact"].description}
  path="/zh-hant/contact/"
>
  <section class="py-16 lg:py-24">
    <Container>
      <PageHeader
        eyebrow="聯絡我們"
        title="聯絡我們"
        lede={labelFor(EMPTY_STATE_COPY.contactLede, "zh-hant")}
      />
      <ul class="mt-12 grid gap-4 sm:grid-cols-2">
        <li class="flex min-w-0 flex-col justify-center rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-raised)] p-6">
          <h2 class="text-lg font-semibold tracking-tight">安全</h2>
          <p class="mt-2 text-sm leading-relaxed text-[var(--text-secondary)]">
            <a
              href="/zh-hant/security/"
              class="text-[var(--action-primary)] underline"
            >
              前往安全性頁面
            </a>
          </p>
          <div class="mt-3">
            <SafeAction
              href={SECURITY_ADVISORY_URL}
              label="開啟私密漏洞通報"
              boundary="private-reporting"
              lang="zh-hant"
            />
          </div>
        </li>
        <ProductSignInLane lang="zh-hant" />
        <PublicContactEmails
          lang="zh-hant"
          boundary="私密資安通報僅用於通報疑似漏洞，不受理商務或一般諮詢。"
        />
      </ul>
    </Container>
  </section>
</BaseLayout>
