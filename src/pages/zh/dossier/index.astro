---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { PAGE_META } from "@/data/page-meta";
import Container from "@/components/layout/Container.astro";
import PageHeader from "@/components/layout/PageHeader.astro";
import DossierComposer from "@/components/dossier/DossierComposer.astro";
---

<BaseLayout
  title={PAGE_META["zh"].dossier.title}
  description={PAGE_META["zh"].dossier.description}
  path="/zh/dossier/"
>
  <section class="py-16 lg:py-24">
    <Container>
      <PageHeader
        title="可打印摘要"
        lede="选择已发布的声明与来源，用于打印或展示。内容不会离开本页，也不会被保存。"
      />
      <div class="mt-12">
        <DossierComposer lang="zh" />
      </div>
    </Container>
  </section>
</BaseLayout>
