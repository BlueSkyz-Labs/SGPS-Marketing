---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { PAGE_META } from "@/data/page-meta";
import Container from "@/components/layout/Container.astro";
import PageHeader from "@/components/layout/PageHeader.astro";
import ButtonLink from "@/components/ui/ButtonLink.astro";
import { SITE } from "@/data/site";

// A published support mailbox is the primary action: the visitor gets one
// direct way to ask for help. Without it, Contact is primary (it renders a
// real business route, never a dead end). Security stays a secondary link
// for vulnerability reports only.
const hasSupportEmail = Boolean(SITE.supportEmail);
---

<BaseLayout
  title={PAGE_META["zh"]["support"].title}
  description={PAGE_META["zh"]["support"].description}
  path="/zh/support/"
>
  <section class="py-16 lg:py-24">
    <Container>
      <PageHeader
        title="如何获得帮助"
        lede={
          hasSupportEmail
            ? "对我们的应用有疑问？请发邮件给我们。"
            : "目前尚未公布通用支持邮箱。安全漏洞报告仅用于漏洞。"
        }
      />
      <div class="mt-10 flex flex-wrap items-center gap-3" data-support-actions>
        {hasSupportEmail ? (
          <ButtonLink
            href={`mailto:${SITE.supportEmail}`}
            data-support-primary
            data-support-mailbox
          >
            {SITE.supportEmail}
          </ButtonLink>
        ) : (
          <ButtonLink href="/zh/contact/" data-support-primary>
            联系我们
          </ButtonLink>
        )}
        <ButtonLink
          href="/zh/security/"
          variant="secondary"
          data-support-security
        >
          安全（仅限漏洞报告）
        </ButtonLink>
      </div>
    </Container>
  </section>
</BaseLayout>
