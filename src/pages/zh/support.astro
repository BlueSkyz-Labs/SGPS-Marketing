---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Container from "@/components/layout/Container.astro";
import PageHeader from "@/components/layout/PageHeader.astro";
import { SITE } from "@/data/site";

const hasBusinessEmail = Boolean(SITE.contactEmail);
---

<BaseLayout
  title="支持"
  description="BlueSkyz Labs 的支持途径与可操作求助：当前可用的、尚未公布的内容，以及如何联系我们。"
  path="/zh/support/"
>
  <section class="py-16 lg:py-24">
    <Container>
      <PageHeader
        eyebrow="支持"
        title="诚实坦诚的帮助"
        lede="各产品的支持入口将在核实后显示在产品资料页。通用支持状态见下方；报告安全漏洞仅用于漏洞披露。"
      />
      {hasBusinessEmail ? (
        <p class="mt-8 max-w-2xl text-[var(--text-secondary)]">
          Email{" "}
          <a
            href={`mailto:${SITE.contactEmail}`}
            class="inline-flex min-h-11 items-center font-semibold text-[var(--action-primary)] no-underline hover:underline"
          >
            {SITE.contactEmail}
          </a>{" "}
          可提供一般产品支持，直至发布针对产品的支持通道。
        </p>
      ) : (
        <p class="mt-8 max-w-2xl text-[var(--text-secondary)]">
          通用产品支持邮箱尚未核实。请仅使用已在经验证的产品资料页上公布的
          专用支持入口。安全漏洞报告仅用于疑似安全问题，不接受一般客户支持请求。
        </p>
      )}
      <div class="mt-10 flex flex-wrap gap-3">
        <a
          href="/zh/security/"
          class="inline-flex min-h-11 items-center rounded-lg border border-[var(--border-subtle)] bg-white px-5 text-sm font-semibold text-[var(--text-primary)] no-underline transition-colors hover:border-[var(--action-primary)]"
        >
          安全报告
        </a>
        {hasBusinessEmail ? (
          <a
            href="/zh/contact/"
            class="inline-flex min-h-11 items-center rounded-lg border border-[var(--border-subtle)] bg-white px-5 text-sm font-semibold text-[var(--text-primary)] no-underline transition-colors hover:border-[var(--action-primary)]"
          >
            联系 BlueSkyz
          </a>
        ) : (
          <a
            href="/zh/about/"
            class="inline-flex min-h-11 items-center rounded-lg border border-[var(--border-subtle)] bg-white px-5 text-sm font-semibold text-[var(--text-primary)] no-underline transition-colors hover:border-[var(--action-primary)]"
          >
            关于 BlueSkyz
          </a>
        )}
      </div>
    </Container>
  </section>
</BaseLayout>
