---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { PAGE_META } from "@/data/page-meta";
import Container from "@/components/layout/Container.astro";
import PageHeader from "@/components/layout/PageHeader.astro";
import ButtonLink from "@/components/ui/ButtonLink.astro";
import { SITE } from "@/data/site";

// Contact is always the primary action: /zh/contact/ renders a real business
// route (published mailbox when present, otherwise BusinessRouteState with the
// private vulnerability channel), so it is never a dead end. Security stays a
// secondary link for vulnerability reports only.
const hasSupportEmail = Boolean(SITE.supportEmail);
---

<BaseLayout
  title={PAGE_META["zh"]["support"].title}
  description={PAGE_META["zh"]["support"].description}
  path="/zh/support/"
>
  <section class="py-16 lg:py-24">
    <Container>
      <PageHeader
        eyebrow="支持"
        title="如何获得帮助"
        lede={
          hasSupportEmail
            ? "安全漏洞报告仅用于漏洞。"
            : "目前尚未公布通用支持邮箱。安全漏洞报告仅用于漏洞。"
        }
      />
      {hasSupportEmail ? (
        <p class="mt-8 max-w-2xl text-[var(--text-secondary)]">
          请发邮件至{" "}
          <a
            href={`mailto:${SITE.supportEmail}`}
            class="inline-flex min-h-11 items-center font-semibold text-[var(--action-primary)] no-underline hover:underline"
          >
            {SITE.supportEmail}
          </a>{" "}
          获取一般产品支持，直至发布各产品专属的支持渠道。
        </p>
      ) : null}
      <div class="mt-10 flex flex-wrap items-center gap-3" data-support-actions>
        <ButtonLink href="/zh/contact/" data-support-primary>
          联系我们
        </ButtonLink>
        <ButtonLink
          href="/zh/security/"
          variant="secondary"
          data-support-security
        >
          安全（仅限漏洞报告）
        </ButtonLink>
      </div>
    </Container>
  </section>
</BaseLayout>
