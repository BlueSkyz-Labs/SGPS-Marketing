---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Container from "@/components/layout/Container.astro";
import PageHeader from "@/components/layout/PageHeader.astro";
import AboutComposition from "@/components/empty-state/AboutComposition.astro";
---

<BaseLayout
  title="关于我们"
  description="关于 BlueSkyz Labs — 我们打造智能化产品，赋能个人并提升工作方式。"
  path="/zh/about/"
>
  <section class="py-16 lg:py-24">
    <Container>
      <PageHeader
        eyebrow="关于我们"
        title="关于 BlueSkyz Labs"
        lede="我们打造智能化产品，赋能个人并提升工作方式。我们正在打造面向房东的 Sổ Trọ 和私密日记 Sổ Tâm，两款产品均在开发中。"
      />
      <AboutComposition lang="zh" />
    </Container>
  </section>
</BaseLayout>
