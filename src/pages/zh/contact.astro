---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { PAGE_META } from "@/data/page-meta";
import Container from "@/components/layout/Container.astro";
import PageHeader from "@/components/layout/PageHeader.astro";
import SafeAction from "@/components/integrity/SafeAction.astro";
import ProductSignInLane from "@/components/empty-state/ProductSignInLane.astro";
import PublicContactEmails from "@/components/empty-state/PublicContactEmails.astro";
import { EMPTY_STATE_COPY } from "@/data/empty-state-copy";
import { SECURITY_ADVISORY_URL, labelFor } from "@/data/site";
---

<BaseLayout
  title={PAGE_META["zh"]["contact"].title}
  description={PAGE_META["zh"]["contact"].description}
  path="/zh/contact/"
>
  <section class="py-16 lg:py-24">
    <Container>
      <PageHeader
        eyebrow="联系我们"
        title="联系我们"
        lede={labelFor(EMPTY_STATE_COPY.contactLede, "zh")}
      />
      <ul class="mt-12 grid gap-4 sm:grid-cols-2">
        <li class="flex min-w-0 flex-col rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-raised)] p-6">
          <h2 class="text-lg font-semibold tracking-tight">安全</h2>
          <p class="mt-2 flex-1 text-sm leading-relaxed text-[var(--text-secondary)]">
            如果你怀疑发现了安全漏洞，请通过 GitHub 私密报告。
          </p>
          <div class="mt-5">
            <SafeAction
              href={SECURITY_ADVISORY_URL}
              label="打开私密漏洞报告"
              boundary="private-reporting"
              lang="zh"
            />
          </div>
        </li>
        <ProductSignInLane lang="zh" />
        <PublicContactEmails
          lang="zh"
          boundary="私密安全报告仅用于报告疑似漏洞，不接收商务或一般咨询。"
        />
      </ul>
    </Container>
  </section>
</BaseLayout>
