---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Container from "@/components/layout/Container.astro";
import PageHeader from "@/components/layout/PageHeader.astro";
import SafeAction from "@/components/integrity/SafeAction.astro";
import { SITE, SECURITY_ADVISORY_URL } from "@/data/site";

const hasBusinessEmail = Boolean(SITE.contactEmail);
---

<BaseLayout
  title="联系我们"
  description="就商务、安全或一般咨询联系 BlueSkyz Labs。"
  path="/zh/contact/"
>
  <section class="py-16 lg:py-24">
    <Container>
      <PageHeader
        eyebrow="联系我们"
        title="为您匹配正确的通道"
        lede="请根据您的需求选择合适的通道联系 BlueSkyz。邮箱地址将在 BlueSkyz 公布后显示于此。"
      />
      <ul class="mt-12 grid gap-4 sm:grid-cols-2">
        {!hasBusinessEmail ? (
          <li class="flex min-w-0 flex-col rounded-xl border border-[var(--border-subtle)] bg-white p-6">
            <h2 class="text-lg font-semibold tracking-tight">安全</h2>
            <p class="mt-2 flex-1 text-sm leading-relaxed text-[var(--text-secondary)]">
              请使用 GitHub 私有漏洞报告。安全邮箱将在 BlueSkyz 公布后显示于此。
            </p>
            <div class="mt-5">
              <SafeAction
                href={SECURITY_ADVISORY_URL}
                label="打开私有漏洞报告"
                boundary="private-reporting"
                lang="zh"
              />
            </div>
          </li>
        ) : null}
        <li class="flex flex-col rounded-xl border border-[var(--border-subtle)] bg-white p-6">
          <h2 class="text-lg font-semibold tracking-tight">商务 / 一般咨询</h2>
          <p class="mt-2 flex-1 text-sm leading-relaxed text-[var(--text-secondary)]">
            {hasBusinessEmail ? (
              <>
                Email{" "}
                <a
                  href={`mailto:${SITE.contactEmail}`}
                  class="inline-flex min-h-11 items-center font-semibold text-[var(--action-primary)] no-underline hover:underline"
                >
                  {SITE.contactEmail}
                </a>{" "}
                用于商务咨询。
              </>
            ) : (
              "商务联系邮箱尚未核实。您可以在「关于我们」查看已公开的信息。私密安全报告仅用于披露疑似漏洞，不是商务或一般咨询通道。"
            )}
          </p>
        </li>
      </ul>
    </Container>
  </section>
</BaseLayout>
