---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { PAGE_META } from "@/data/page-meta";
import Container from "@/components/layout/Container.astro";
import PageHeader from "@/components/layout/PageHeader.astro";
import SafeAction from "@/components/integrity/SafeAction.astro";
import PublicContactEmails from "@/components/empty-state/PublicContactEmails.astro";
import { EMPTY_STATE_COPY } from "@/data/empty-state-copy";
import { labelFor, SECURITY_ADVISORY_URL } from "@/data/site";
---

<BaseLayout
  title={PAGE_META["zh"]["contact"].title}
  description={PAGE_META["zh"]["contact"].description}
  path="/zh/contact/"
>
  <section class="py-16 lg:py-24">
    <Container>
      <PageHeader
        title="联系我们"
        lede={labelFor(EMPTY_STATE_COPY.contactLede, "zh")}
      />
      <ul class="mt-12 grid gap-x-8 sm:grid-cols-2">
        <PublicContactEmails
          lang="zh"
          boundary="商务与一般咨询。私密安全报告仅用于报告疑似漏洞。"
        />
        <li
          data-contact-card="security"
          class="contact-section flex min-w-0 flex-col"
        >
          <h2 class="contact-section__heading">安全</h2>
          <p class="mt-2 text-sm leading-relaxed text-[var(--text-secondary)]">
            <a
              href="/zh/security/"
              class="inline-flex min-h-11 items-center font-semibold text-[var(--action-primary)] underline decoration-1 underline-offset-[0.3em]"
            >
              访问安全页面
            </a>
          </p>
          <div class="mt-3">
            <SafeAction
              variant="tertiary"
              fit
              href={SECURITY_ADVISORY_URL}
              label="打开私密漏洞报告"
              boundary="private-reporting"
              lang="zh"
            />
          </div>
        </li>
      </ul>
    </Container>
  </section>
</BaseLayout>
