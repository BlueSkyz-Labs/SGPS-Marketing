---
import HorizonSeam from "@/components/experience/HorizonSeam.astro";
import type { CollectionEntry } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Container from "@/components/layout/Container.astro";
import ProductStatus from "@/components/product/ProductStatus.astro";
import ProductLadder from "@/components/product/ProductLadder.astro";
import ProductHero from "@/components/product/ProductHero.astro";
import ProductContactAction from "@/components/product/ProductContactAction.astro";
import AppAccess from "@/components/product/AppAccess.astro";
import ProductShowcase from "@/components/product/ProductShowcase.astro";
import ButtonLink from "@/components/ui/ButtonLink.astro";
import NoCaptureStage from "@/components/empty-state/NoCaptureStage.astro";
import ProductVisual from "@/components/product/ProductVisual.astro";
import ProductSides from "@/components/product/ProductSides.astro";
import {
  AVAILABILITY,
  PAGE_LABELS,
  productPageCopy,
  webPreviewOpen,
} from "@/components/product/product-page-copy";
import { EMPTY_STATE_COPY } from "@/data/empty-state-copy";
import { productCopy, proofCaptionForKind } from "@/lib/product-copy";
import { resolveLifecycleCta } from "@/lib/lifecycle-cta";
import { appOpenAction } from "@/lib/app-open-action";
import { getShowcase } from "@/lib/showcases";
import { heroScreen } from "@/lib/product-hero";
import {
  getProductIconThumbPath,
  localizeSiteHref,
} from "@/lib/product-routes";
import { appLanguageNames } from "@/lib/app-languages";
import { safeJsonLd, productJsonLd, showcaseScreenshots } from "@/lib/seo";
import { productBreadcrumbJsonLd } from "@/lib/breadcrumbs";
import { getPublicProducts } from "@/lib/products";
import { productMeta } from "@/data/page-meta";
import { productTransitionStyle } from "@/lib/product-transition";
import { labelFor, SITE } from "@/data/site";
import {
  PRODUCT_OG_SIZE,
  productOgImageAlt,
  productOgImagePath,
} from "@/lib/product-og";

/**
 * v8 W3 product profile (zh).
 * Top of page, in order: breadcrumb, icon + name + status, one-liner, one
 * primary action (at most), sign-in text link, one Availability line.
 */
export async function getStaticPaths() {
  const products = await getPublicProducts();
  return products.map((product) => ({
    params: { slug: product.data.slug },
    props: { product },
  }));
}

interface Props {
  product: CollectionEntry<"products">;
}

const { product } = Astro.props;
const lang = "zh" as const;
const { data } = product;
const media = data.proof.media;
const copy = productCopy(data, "zh");
const page = productPageCopy(data, "zh");
const showcase = (await getShowcase(data.slug))?.data ?? null;
const heroShot = heroScreen(showcase);

// This page already *is* the recorded status surface, so the mapper only adds
// an action when it yields an eligible first-party Try destination and the
// record carries no direct app sign-in. A development product never renders Try.
const cta = resolveLifecycleCta(
  {
    slug: data.slug,
    lifecycle: data.lifecycle,
    availability: data.availability,
    primaryActionHref: data.primaryAction.href,
    productName: data.name,
  },
  "zh",
);
const openApp = appOpenAction(data.slug, data.appAccess, lang);
const showTryCta = cta.verb === "try" && !data.appAccess?.signInUrl;

const privacyHref = data.proof.privacyUrl
  ? localizeSiteHref(data.proof.privacyUrl, lang)
  : null;
const proofLinks = [
  { href: data.proof.privacyUrl, label: PAGE_LABELS.privacy[lang] },
  { href: data.proof.securityUrl, label: PAGE_LABELS.security[lang] },
  { href: data.proof.supportUrl, label: PAGE_LABELS.support[lang] },
]
  .filter((link): link is { href: string; label: string } => Boolean(link.href))
  .map((link) => ({ ...link, href: localizeSiteHref(link.href, lang) }));

const productStructuredData = productJsonLd(
  {
    name: data.name,
    description: copy.shortDescription,
    slug: data.slug,
    mediaUrl: media?.src,
    ...(media ? { mediaCaption: proofCaptionForKind(media.kind, "zh") } : {}),
    platforms: data.platforms,
    screenshots: showcaseScreenshots(showcase),
    ...(data.applicationCategory
      ? { applicationCategory: data.applicationCategory }
      : {}),
    ...(data.appLanguages ? { appLanguages: data.appLanguages } : {}),
  },
  SITE.url,
  "zh",
);
const meta = productMeta(data.slug, "zh", {
  title: data.name,
  description: copy.shortDescription,
});
const breadcrumbStructuredData = productBreadcrumbJsonLd(
  "zh",
  data.slug,
  data.name,
  SITE.url,
);
const appLanguage = appLanguageNames(data.appLanguages, lang);
const isIdentityArt = media?.kind === "identity-art";
// UX-U5: a profile with no real screens yet (Sổ Tâm) gets next steps, no lockup.
const awaitingScreens = !showcase && isIdentityArt;
---

<BaseLayout
  journeyPrimary={awaitingScreens ? "contact" : undefined}
  lastUpdated
  title={meta.title}
  description={meta.description}
  path={`/zh/products/${data.slug}/`}
  ogImage={productOgImagePath(data.slug)}
  ogImageSize={PRODUCT_OG_SIZE}
  ogImageAltText={productOgImageAlt(data.name, "zh")}
  scene="product"
>
  <script
    type="application/ld+json"
    set:html={safeJsonLd(productStructuredData)}
  ></script>
  {breadcrumbStructuredData ? (
    <script
      type="application/ld+json"
      set:html={safeJsonLd(breadcrumbStructuredData)}
    ></script>
  ) : null}
  <article class="py-12 sm:py-16">
    <Container>
      <nav
        aria-label="Breadcrumb"
        class="text-sm font-medium text-[var(--text-muted)]"
      >
        <ol class="flex items-center gap-2">
          <li>
            <a
              href={"/zh/products/"}
              class="breadcrumb-link inline-flex min-h-11 items-center text-sm font-semibold text-[var(--action-primary)] underline underline-offset-4 hover:no-underline"
            >
              产品
            </a>
          </li>
          <li aria-hidden="true" class="text-[var(--border-subtle)]">
            /
          </li>
          <li aria-current="page" class="text-[var(--text-primary)]">
            {data.name}
          </li>
        </ol>
      </nav>

      <ProductHero art={heroShot}>
        <Fragment slot="intro">
          <!-- Text zoom: the icon is rem-sized and grows with 200% text, so the
               title block may drop under it instead of squeezing to ~40px. -->
          <header class="flex flex-wrap items-center gap-5 sm:gap-6">
            <div
              class="relative flex size-20 flex-shrink-0 items-center justify-center overflow-hidden rounded-2xl bg-white/5 p-2 shadow-[0_12px_32px_-8px_rgba(11,16,32,0.35)] ring-1 ring-inset ring-white/10 sm:size-28 sm:p-2.5"
              aria-hidden="true"
            >
              <img
                src={getProductIconThumbPath(data.slug)}
                alt=""
                class="h-full w-full rounded-[22%] object-contain"
                loading="eager"
                fetchpriority="low"
                decoding="async"
                width="128"
                height="128"
              />
            </div>
            <div class="min-w-0 flex-1 basis-40">
              <div class="flex flex-wrap items-center gap-x-4 gap-y-2">
                <h1
                  class="type-d2 profile-title text-[var(--text-primary)]"
                  style={productTransitionStyle("card", data.slug)}
                  data-product-profile-title
                >
                  {data.name}
                </h1>
                <ProductStatus label={data.publicLabel} lang="zh" />
              </div>
            </div>
          </header>
          <HorizonSeam class="horizon-rule" data-horizon-rule />

          <p class="mt-8 max-w-3xl text-lg leading-relaxed text-[var(--text-secondary)] sm:text-xl">
            {page.oneLiner}
          </p>
        </Fragment>
        <Fragment slot="actions">
          {openApp ? (
            <ButtonLink
              href={openApp.href}
              data-primary-action
              data-product-cta="try"
            >
              {openApp.label}
            </ButtonLink>
          ) : showTryCta ? (
            <ButtonLink
              href={cta.href}
              data-primary-action
              data-product-cta={cta.verb}
            >
              {cta.label}
            </ButtonLink>
          ) : showcase ? (
            <ButtonLink href="#profile-showcase" data-primary-action>
              {PAGE_LABELS.seeScreens[lang]}
            </ButtonLink>
          ) : null}
          <ProductContactAction
            appAccess={data.appAccess}
            lang="zh"
            webPreview={webPreviewOpen(data)}
          />
        </Fragment>
        <Fragment slot="status">
          <ProductSides showcase={showcase} lang="zh" />
          <AppAccess
            appAccess={data.appAccess}
            lang="zh"
            web={data.platforms.includes("web")}
            webPreview={webPreviewOpen(data)}
          />
          {appLanguage ? (
            <p
              class="mt-2 text-sm leading-relaxed text-[var(--text-secondary)]"
              data-app-language
            >
              {PAGE_LABELS.appLanguage[lang]}
              {AVAILABILITY.colon[lang]}
              {appLanguage}
            </p>
          ) : null}
          <ProductLadder lifecycle={data.lifecycle} lang="zh" />
        </Fragment>
      </ProductHero>
      {!showcase && media && !isIdentityArt ? (
        <NoCaptureStage media={media} lang="zh" />
      ) : null}
      {!showcase && isIdentityArt ? (
        // Identity art is not shown here: the Sổ Tâm artwork carries an
        // unconfirmed tagline (OG-3). Only the status-honest line renders.
        <p
          class="mt-10 text-sm text-[var(--text-muted)]"
          data-profile-identity-stage
          data-no-capture
        >
          {labelFor(EMPTY_STATE_COPY.noCaptures, "zh")}
        </p>
      ) : null}

      {page.whatItDoes.length > 0 ? (
        <section class="profile-jobs mt-14" aria-labelledby="profile-jobs">
          <h2
            id="profile-jobs"
            class="text-xl font-semibold tracking-tight text-[var(--text-primary)] sm:text-2xl"
          >
            {PAGE_LABELS.whatItDoes[lang]}
          </h2>
          <ul class="profile-does mt-4" data-what-it-does>
            {page.whatItDoes.map((item) => (
              <li class="profile-does__tile">
                <span class="profile-does__text">{item}</span>
              </li>
            ))}
          </ul>
        </section>
      ) : null}

      {showcase ? (
        <ProductShowcase
          showcase={showcase}
          lang="zh"
          productName={data.name}
        />
      ) : null}

      {media && showcase ? (
        <figure class="m-0 mt-14 max-w-lg" data-profile-identity-stage>
          <ProductVisual
            sizes="(min-width: 32rem) 32rem, calc(100vw - 2.5rem)"
            media={media}
            alt={`${data.name} \u2014 ${PAGE_LABELS.artIdentity[lang]}`}
          />
          <figcaption class="mt-3 text-sm text-[var(--text-muted)]">
            {PAGE_LABELS.artCaption[lang]}
          </figcaption>
        </figure>
      ) : null}

      {proofLinks.length > 0 ? (
        <div
          class="mt-14 text-sm text-[var(--text-secondary)]"
          data-profile-trust
        >
          <p>
            {proofLinks.map((link, i) => (
              <>
                {i > 0 ? <span aria-hidden="true"> · </span> : null}
                <a
                  href={link.href}
                  class="profile-trust-link inline-flex min-h-11 items-center font-semibold text-[var(--action-primary)] underline underline-offset-4 hover:no-underline"
                  aria-describedby={
                    link.href === privacyHref
                      ? "product-privacy-scope"
                      : undefined
                  }
                >
                  {link.label}
                </a>
              </>
            ))}
          </p>
          {privacyHref ? (
            <span
              class="sr-only"
              id="product-privacy-scope"
              data-product-privacy-scope
            >
              {PAGE_LABELS.privacyScope[lang]}
            </span>
          ) : null}
        </div>
      ) : null}
    </Container>
  </article>
</BaseLayout>

<style>
  .profile-trust-link {
    min-width: 2.75rem;
    justify-content: center;
  }
  /* F3: the profile H1 steps up to the d1 size from 768 px so it outranks
     the 32 px section headings; phones keep 32 px. */
  @media (min-width: 768px) {
    .profile-title {
      font-size: var(--size-8);
    }
  }
  /* F14: what it does as feature tiles (record strings only). Each tile
     follows the section's width through a container query; one column by
     default. */
  .profile-jobs {
    container: profile-jobs / inline-size;
  }
  /* ACQ-05: no margin reset here. An unlayered scoped `margin: 0` beats the
     layered `mt-*` utility, which left the H2 flush against the list. The
     preflight already zeroes list margins; `mt-4` sets the 16 px heading gap,
     the same mechanism the showcase H2 uses. */
  .profile-does {
    display: grid;
    gap: 0.75rem;
    padding: 0;
    list-style: none;
  }
  .profile-does__tile {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
    min-width: 0;
    padding: 1.125rem 1.25rem;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md, 0.75rem);
    background: var(--surface-raised);
    box-shadow:
      inset 0 1px 0 var(--specular),
      0 14px 32px -26px color-mix(in srgb, #0b1020 55%, transparent);
  }
  .profile-does__tile {
    --specular: color-mix(in srgb, white 70%, transparent);
  }
  :global([data-theme="dark"]) .profile-does__tile {
    --specular: color-mix(in srgb, white 9%, transparent);
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"])) .profile-does__tile {
      --specular: color-mix(in srgb, white 9%, transparent);
    }
  }
  .profile-does__text {
    min-width: 0;
    color: var(--text-primary);
    font-size: var(--size-3);
    line-height: 1.55;
    overflow-wrap: anywhere;
  }
  @container profile-jobs (min-width: 36rem) {
    .profile-does {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .profile-does__tile:last-child:nth-child(odd) {
      grid-column: 1 / -1;
    }
  }
  /* Wide: a six-track grid keeps any last row of two or one tiles full-width
     instead of leaving a hole. */
  @container profile-jobs (min-width: 60rem) {
    .profile-does {
      grid-template-columns: repeat(6, minmax(0, 1fr));
    }
    .profile-does__tile,
    .profile-does__tile:last-child:nth-child(odd) {
      grid-column: span 2;
    }
    .profile-does__tile:nth-last-child(2):nth-child(3n + 1),
    .profile-does__tile:last-child:nth-child(3n + 2) {
      grid-column: span 3;
    }
    .profile-does__tile:last-child:nth-child(3n + 1) {
      grid-column: 1 / -1;
    }
  }
</style>
