---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { PAGE_META } from "@/data/page-meta";
import Container from "@/components/layout/Container.astro";
import PageHeader from "@/components/layout/PageHeader.astro";
import ProductCard from "@/components/product/ProductCard.astro";
import ProofFirstEmptyState from "@/components/product/ProofFirstEmptyState.astro";
import { getPublicProducts } from "@/lib/products";

const products = await getPublicProducts();
const allInDevelopment =
  products.length > 0 &&
  products.every((product) => product.data.lifecycle === "development");
const emptyDescription = "产品仅在具备可核验的公开证据时发布。";
---

<BaseLayout
  title={PAGE_META["zh"].products.title}
  description={
    products.length ? PAGE_META["zh"].products.description : emptyDescription
  }
  path="/zh/products/"
  scene="product"
>
  <section class="py-16 lg:py-20">
    <Container>
      <PageHeader
        title="我们的产品"
        lede={
          products.length === 0
            ? "产品将在可评估时展示于此。我们只发布你可以核验的内容。"
            : allInDevelopment
              ? "两款产品都在开发中。每个页面都说明其状态。"
              : "每个页面都写明产品状态及其依据。"
        }
      />
      {products.length > 0 && (
        <p class="studio-shelf__framing mt-6 text-base font-medium text-[var(--text-secondary)]">
          {products.length} 款产品。同一种理念：小而可验证的工具，为使用者而造。
        </p>
      )}
      {products.length === 0 ? (
        <div class="mt-12">
          <ProofFirstEmptyState lang="zh" />
        </div>
      ) : (
        <section class="mt-12" aria-labelledby="published-products">
          <h2
            id="published-products"
            class:list={[
              "text-xs font-semibold tracking-[0.18em] text-[var(--text-secondary)] uppercase [&:lang(vi)]:normal-case [&:lang(vi)]:tracking-[var(--tracking-eyebrow)]",
              allInDevelopment && "sr-only",
            ]}
          >
            {allInDevelopment ? "开发中" : "产品"}
          </h2>
          <div class="studio-shelf mt-8">
            {products.map((product) => (
              <div
                data-product-slug={product.data.slug}
                class="studio-shelf__item"
              >
                <ProductCard product={product} lang="zh" showThumb />
              </div>
            ))}
          </div>
        </section>
      )}
    </Container>
  </section>
</BaseLayout>
