---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ProductGuide from "@/components/product/ProductGuide.astro";
import { getGuideProducts } from "@/lib/showcases";
import { guideMeta } from "@/data/page-meta";
import { productBreadcrumbJsonLd } from "@/lib/breadcrumbs";
import { safeJsonLd } from "@/lib/seo";
import { SITE } from "@/data/site";

export async function getStaticPaths() {
  return (await getGuideProducts()).map(({ product, showcase }) => ({
    params: { slug: product.data.slug },
    props: { product, showcase: showcase.data },
  }));
}

const { product, showcase } = Astro.props;
const guide = showcase.guide!;
const meta = guideMeta(product.data.slug, "zh", {
  title: guide.title.zh,
  description: guide.intro.zh.slice(0, 200),
});
const breadcrumbStructuredData = productBreadcrumbJsonLd(
  "zh",
  product.data.slug,
  product.data.name,
  SITE.url,
  guide.title.zh,
);
---

<BaseLayout
  title={meta.title}
  description={meta.description}
  path={`/zh/products/${product.data.slug}/guide/`}
  scene="product"
>
  {breadcrumbStructuredData ? (
    <script
      type="application/ld+json"
      set:html={safeJsonLd(breadcrumbStructuredData)}
    ></script>
  ) : null}
  <ProductGuide product={product} showcase={showcase} lang="zh" />
</BaseLayout>
