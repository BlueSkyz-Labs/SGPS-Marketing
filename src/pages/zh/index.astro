---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Container from "@/components/layout/Container.astro";
import Hero from "@/components/sections/Hero.astro";
import FlagshipTheatre from "@/components/product/FlagshipTheatre.astro";
import ProductHouse from "@/components/product/ProductHouse.astro";
import OneHouse from "@/components/sections/OneHouse.astro";
import Trust from "@/components/sections/Trust.astro";
import AboutBlueSkyz from "@/components/sections/AboutBlueSkyz.astro";
import NextStep from "@/components/sections/NextStep.astro";
import HorizonField from "@/components/experience/HorizonField.astro";
import { getFlagshipProduct, getPublicProducts } from "@/lib/products";
import { SITE } from "@/data/site";

// C2 six-act homepage: Hero → Flagship Theatre → Product House → One House →
// Trust → About → Next Step. Power-user surfaces (ExperienceSpine, IntentLens,
// Atlas) keep their routes/components but no longer lead the homepage.
const products = await getPublicProducts();
const flagship = await getFlagshipProduct();
---

<BaseLayout
  title={SITE.name}
  description={`${SITE.taglineLead} ${SITE.taglineAccent} ${SITE.proposition}`}
  path="/zh/"
  scene="ink"
>
  <Hero lang="zh" />
  <Container>
    <FlagshipTheatre product={flagship} lang="zh" />
    <ProductHouse products={products} lang="zh" />
    <OneHouse lang="zh" />
    <Trust lang="zh" />
    <AboutBlueSkyz lang="zh" />
    <NextStep lang="zh" />
  </Container>
  <HorizonField
    class="c2-closing-signature"
    data-closing-horizon
    aria-hidden="true"
  />
</BaseLayout>
