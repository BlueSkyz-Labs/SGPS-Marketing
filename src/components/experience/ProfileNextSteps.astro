---
import BlueSkyzIcon from "@/components/icon/BlueSkyzIcon.astro";
import { getProfileNextActions } from "@/lib/journey";
import { SHARED_LABELS, labelFor, type Language } from "@/data/site";

/**
 * UX-U5 (P1-7): an early, in-page "Next steps" row for a product profile that
 * has no real screens yet, so the visitor is never left without an action.
 * Links are existing routes with existing approved labels. The accessible name
 * carries the product name so it stays distinct from the closing journey bar.
 */
interface Props {
  lang: Language;
  productName: string;
}
const { lang, productName } = Astro.props;
const navLabel = labelFor(SHARED_LABELS.nextSteps, lang);
const actions = getProfileNextActions(lang);
---

<nav
  class="profile-next mt-10"
  aria-label={`${navLabel}: ${productName}`}
  data-profile-next-steps
>
  <p class="eyebrow">{navLabel}</p>
  <ul class="mt-3 flex flex-wrap gap-3 p-0 m-0 list-none">
    {actions.map((action) => (
      <li>
        <a
          class="inline-flex min-h-11 items-center gap-1.5 rounded-lg border border-[var(--border-subtle)] bg-[var(--surface-raised)] px-4 text-sm font-semibold text-[var(--text-primary)] no-underline transition-[border-color,box-shadow] duration-150 hover:border-[var(--action-primary)] hover:shadow-sm"
          href={action.href}
        >
          {action.label}
          <BlueSkyzIcon
            name="arrow-right"
            class="size-4 shrink-0 text-[var(--action-primary)]"
          />
        </a>
      </li>
    ))}
  </ul>
</nav>
