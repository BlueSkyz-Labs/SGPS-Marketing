---
import BlueSkyzIcon from "@/components/icon/BlueSkyzIcon.astro";
import Container from "@/components/layout/Container.astro";
import {
  getJourneyActions,
  orderItemsByMission,
  routeKeyFromPath,
} from "@/lib/journey";
import { getMissionOrders, getMissionEvidenceKeys } from "@/data/experience";
import { DEFAULT_EXPERIENCE_INTENT } from "@/lib/experience-intent";
import { getLanguageFromPath } from "@/lib/i18n";
import { SHARED_LABELS, labelFor } from "@/data/site";

const pathname = Astro.url.pathname;
const lang = getLanguageFromPath(pathname);
const actions = getJourneyActions(pathname, lang);
const navLabel = labelFor(SHARED_LABELS.nextSteps, lang);
const missionOrders = getMissionOrders();
const missionEvidence = getMissionEvidenceKeys();
const renderedActions =
  pathname === `/${lang}/products/`
    ? orderItemsByMission(
        actions,
        (action) => action.href,
        missionOrders[DEFAULT_EXPERIENCE_INTENT] ?? [],
      )
    : actions;
---

{actions.length > 0 && (
  <nav
    class="border-t border-[var(--border-subtle)] bg-[var(--surface-subtle)]"
    aria-label={navLabel}
    data-journey-bar
    data-mission-orders={JSON.stringify(missionOrders)}
    data-mission-evidence={JSON.stringify(missionEvidence)}
  >
    <Container class="flex flex-col gap-3 py-6 sm:flex-row sm:items-center sm:justify-between">
      <p class="eyebrow">{navLabel}</p>
      <ul class="flex flex-wrap gap-3">
        {renderedActions.map((action) => (
          <li
            data-step-key={routeKeyFromPath(action.href)}
            data-neutral-order={actions.indexOf(action)}
          >
            <a
              class="inline-flex min-h-11 items-center gap-1.5 rounded-lg border border-[var(--border-subtle)] bg-[var(--surface-raised)] px-4 text-sm font-semibold text-[var(--text-primary)] no-underline transition-[border-color,box-shadow] duration-150 hover:border-[var(--action-primary)] hover:shadow-sm"
              href={action.href}
            >
              {action.label}
              <BlueSkyzIcon
                name="arrow-right"
                class="size-4 shrink-0 text-[var(--action-primary)]"
              />
            </a>
          </li>
        ))}
      </ul>
    </Container>
  </nav>
)}
