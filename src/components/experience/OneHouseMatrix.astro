---
import { brandAssets } from "@/data/brand-assets";
import { SHARED_LABELS, labelFor, type Language } from "@/data/site";
import {
  PRINCIPLE_DIMENSION_KEYS,
  PRINCIPLE_DIMENSION_LABELS,
  PRINCIPLE_MATRIX,
} from "@/data/experience";

interface Props {
  lang?: Language;
}

const { lang = "en" } = Astro.props;

/**
 * Brand Kit v4 principle cards: the four official principle SVGs, one per card,
 * in matrix order. The asset is the identity; the card is only the frame — no
 * drawn substitute, no re-coloured copy.
 */
const principleIcons = [
  brandAssets.principles.intelligence,
  brandAssets.principles.elevation,
  brandAssets.principles.trust,
  brandAssets.principles.impact,
] as const;

const matrixLabel = labelFor(SHARED_LABELS.brandPrinciples, lang);
---

<ul
  class="mt-10 grid min-w-0 gap-5 sm:grid-cols-2 xl:grid-cols-4 xl:gap-6"
  data-principle-matrix
  aria-label={matrixLabel}
>
  {PRINCIPLE_MATRIX.map((principle, index) => (
    <li
      data-principle-card={principle.id}
      class="flex min-w-0 flex-col rounded-[var(--bsl-radius-lg)] border border-[var(--border-subtle)] bg-[var(--surface-raised)] p-5 transition-[transform,border-color,box-shadow] duration-200 ease-[var(--motion-ease-standard)] hover:-translate-y-0.5 hover:border-[color-mix(in_srgb,var(--brand-cobalt)_38%,var(--border-subtle))] hover:shadow-[0_18px_44px_-14px_color-mix(in_srgb,var(--brand-cobalt)_30%,transparent)] motion-reduce:transition-none motion-reduce:hover:translate-y-0 motion-reduce:hover:shadow-none sm:p-6"
    >
      <div class="flex min-w-0 items-center justify-between gap-3">
        <span
          class="grid size-11 shrink-0 place-items-center rounded-[var(--bsl-radius-md)] border border-[color-mix(in_srgb,var(--brand-cobalt)_22%,var(--border-subtle))] bg-[var(--surface-subtle)]"
          aria-hidden="true"
        >
          <img
            src={principleIcons[index]}
            alt=""
            width="26"
            height="26"
            loading="lazy"
            decoding="async"
          />
        </span>
        <span
          class="text-xs font-semibold tracking-[0.14em] text-[var(--text-muted)]"
          aria-hidden="true"
        >
          {String(index + 1).padStart(2, "0")}
        </span>
      </div>

      <h3 class="mt-5 text-lg font-semibold tracking-tight text-[var(--text-primary)] [overflow-wrap:anywhere]">
        {principle.name[lang]}
      </h3>
      <p class="mt-2 min-w-0 text-sm leading-[1.65] text-[var(--text-muted)] [overflow-wrap:anywhere]">
        {principle.summary[lang]}
      </p>

      <dl class="mt-5 grid min-w-0 gap-4 border-t border-[var(--border-subtle)] pt-5">
        {PRINCIPLE_DIMENSION_KEYS.map((key) => (
          <div class="min-w-0">
            <dt class="text-xs font-semibold tracking-[0.14em] text-[var(--text-muted)] uppercase [overflow-wrap:anywhere]">
              {PRINCIPLE_DIMENSION_LABELS[key][lang]}
            </dt>
            <dd class="mt-1.5 text-sm leading-[1.65] text-[var(--text-secondary)] [overflow-wrap:anywhere]">
              {principle.dimensions[key][lang]}
            </dd>
          </div>
        ))}
      </dl>
    </li>
  ))}
</ul>
