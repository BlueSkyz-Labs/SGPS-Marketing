---
import { TRUST_LEDGER, type TrustState } from "@/data/trust-ledger";

type Language = "en" | "vi";

interface Props {
  lang?: Language;
}

const { lang = "en" } = Astro.props;

const STATUS_LABELS: Record<TrustState, Record<Language, string>> = {
  available: { en: "Available", vi: "Có sẵn" },
  "not-published": { en: "Not published yet", vi: "Chưa công bố" },
};

const STATUS_CLASSES: Record<TrustState, string> = {
  available:
    "border-[color-mix(in_srgb,var(--brand-cobalt)_35%,transparent)] bg-[color-mix(in_srgb,var(--brand-cobalt)_6%,white)] text-[var(--action-primary)]",
  "not-published":
    "border-[var(--border-subtle)] bg-[var(--surface-subtle)] text-[var(--text-muted)]",
};
---

<ul class="mt-10 flex flex-col gap-3" data-trust-ledger>
  {
    TRUST_LEDGER.map((entry) => (
      <li data-trust-surface={entry.id}>
        <a
          href={entry.href[lang]}
          class="group grid min-h-11 gap-2 rounded-lg border border-[var(--border-subtle)] bg-white p-5 no-underline transition-[border-color,box-shadow] duration-150 hover:border-[var(--action-primary)] hover:shadow-sm sm:grid-cols-[minmax(0,14rem)_minmax(0,1fr)_auto] sm:items-center sm:gap-6"
        >
          <span class="flex items-center justify-between gap-3 sm:justify-start">
            <span class="flex flex-wrap items-center gap-3">
              <span class="text-base font-semibold tracking-tight text-[var(--text-primary)]">
                {entry.label[lang]}
              </span>
              <span
                class:list={[
                  "inline-flex items-center rounded-md border px-2 py-0.5 text-xs font-medium",
                  STATUS_CLASSES[entry.state],
                ]}
              >
                {STATUS_LABELS[entry.state][lang]}
              </span>
            </span>
            <span
              aria-hidden="true"
              class="text-[var(--action-primary)] transition-transform group-hover:translate-x-0.5 sm:hidden"
            >
              →
            </span>
          </span>
          <span class="text-sm text-[var(--text-muted)]">
            {entry.summary[lang]}
          </span>
          <span
            aria-hidden="true"
            class="hidden text-[var(--action-primary)] transition-transform group-hover:translate-x-0.5 sm:block"
          >
            →
          </span>
        </a>
      </li>
    ))
  }
</ul>
