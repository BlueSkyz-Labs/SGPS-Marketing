---
import { TRUST_LEDGER, type TrustState } from "@/data/trust-ledger";
import EvidenceDetails from "@/components/integrity/EvidenceDetails.astro";
import type { Language } from "@/data/site";

interface Props {
  lang?: Language;
  /** false: omit the per-lane Decision Room link (one entry point instead). */
  compare?: boolean;
}

const { lang = "en", compare = true } = Astro.props;

const STATUS_LABELS: Record<TrustState, Record<Language, string>> = {
  available: { en: "Available", vi: "Có sẵn", zh: "可用", "zh-hant": "可用" },
  "not-published": {
    en: "Not published yet",
    vi: "Chưa công bố",
    zh: "尚未公布",
    "zh-hant": "尚未公布",
  },
};

const STATUS_CLASSES: Record<TrustState, string> = {
  available:
    "border-[color-mix(in_srgb,var(--brand-cobalt)_35%,transparent)] bg-[color-mix(in_srgb,var(--brand-cobalt)_6%,var(--surface-raised))] text-[var(--action-primary)]",
  "not-published":
    "border-[var(--border-subtle)] bg-[var(--surface-subtle)] text-[var(--text-muted)]",
};

const OPEN_LABEL: Record<Language, string> = {
  en: "Open",
  vi: "Mở",
  zh: "打开",
  "zh-hant": "開啟",
};

const COMPARE_LABEL: Record<Language, string> = {
  en: "Compare claims",
  vi: "So sánh tuyên bố",
  zh: "比较声明",
  "zh-hant": "比較聲明",
};
---

<ul class="mt-10 flex flex-col gap-3" data-trust-ledger>
  {TRUST_LEDGER.map((entry) => (
    <li data-trust-surface={entry.id}>
      <div class="trust-ledger-card grid gap-3 rounded-lg border border-[var(--border-subtle)] bg-[var(--surface-raised)] p-5 sm:grid-cols-[minmax(0,14rem)_minmax(0,1fr)] sm:items-start sm:gap-6">
        <div class="flex flex-wrap items-center gap-3">
          <span class="text-base font-semibold tracking-tight text-[var(--text-primary)]">
            {entry.label[lang]}
          </span>
          <span
            class:list={[
              "inline-flex items-center rounded-md border px-2.5 py-1 text-xs font-semibold",
              STATUS_CLASSES[entry.state],
            ]}
          >
            {STATUS_LABELS[entry.state][lang]}
          </span>
        </div>
        <div class="flex flex-col items-start gap-2">
          <EvidenceDetails
            summary={entry.summary[lang]}
            evidence={[
              {
                label: `${OPEN_LABEL[lang]}: ${entry.label[lang]}`,
                href: entry.href[lang],
              },
            ]}
            lang={lang}
          />
          {compare && (
            <a
              href={`/${lang}/decision-room/#room-item-trust-${entry.id}`}
              class="inline-flex min-h-11 items-center text-sm font-medium text-[var(--action-primary)] underline-offset-2 hover:underline"
              data-decision-hook={`trust:${entry.id}`}
            >
              {COMPARE_LABEL[lang]} →
            </a>
          )}
        </div>
      </div>
    </li>
  ))}
</ul>
