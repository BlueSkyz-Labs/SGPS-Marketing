---
import { TRUST_LEDGER, type TrustState } from "@/data/trust-ledger";
import EvidenceDetails from "@/components/integrity/EvidenceDetails.astro";

type Language = "en" | "vi";

interface Props {
  lang?: Language;
}

const { lang = "en" } = Astro.props;

const STATUS_LABELS: Record<TrustState, Record<Language, string>> = {
  available: { en: "Available", vi: "Có sẵn" },
  "not-published": { en: "Not published yet", vi: "Chưa công bố" },
};

const STATUS_CLASSES: Record<TrustState, string> = {
  available:
    "border-[color-mix(in_srgb,var(--brand-cobalt)_35%,transparent)] bg-[color-mix(in_srgb,var(--brand-cobalt)_6%,white)] text-[var(--action-primary)]",
  "not-published":
    "border-[var(--border-subtle)] bg-[var(--surface-subtle)] text-[var(--text-muted)]",
};

const OPEN_LABEL: Record<Language, string> = { en: "Open", vi: "Mở" };

const COMPARE_LABEL: Record<Language, string> = {
  en: "Compare in the Decision Room",
  vi: "So sánh trong Phòng Quyết định",
};
---

<ul class="mt-10 flex flex-col gap-3" data-trust-ledger>
  {
    TRUST_LEDGER.map((entry) => (
      <li data-trust-surface={entry.id}>
        <div class="trust-ledger-card grid gap-3 rounded-lg border border-[var(--border-subtle)] bg-white p-5 sm:grid-cols-[minmax(0,14rem)_minmax(0,1fr)] sm:items-start sm:gap-6">
          <div class="flex flex-wrap items-center gap-3">
            <span class="text-base font-semibold tracking-tight text-[var(--text-primary)]">
              {entry.label[lang]}
            </span>
            <span
              class:list={[
                "inline-flex items-center rounded-md border px-2.5 py-1 text-xs font-semibold",
                STATUS_CLASSES[entry.state],
              ]}
            >
              {STATUS_LABELS[entry.state][lang]}
            </span>
          </div>
          <div class="flex flex-col items-start gap-2">
            <EvidenceDetails
              summary={entry.summary[lang]}
              evidence={[
                {
                  label: `${OPEN_LABEL[lang]}: ${entry.label[lang]}`,
                  href: entry.href[lang],
                },
              ]}
              lang={lang}
            />
            <a
              href={`/${lang}/decision-room/#room-item-trust-${entry.id}`}
              class="text-sm font-medium text-[var(--action-primary)] underline-offset-2 hover:underline"
              data-decision-hook={`trust:${entry.id}`}
            >
              {COMPARE_LABEL[lang]} →
            </a>
          </div>
        </div>
      </li>
    ))
  }
</ul>
