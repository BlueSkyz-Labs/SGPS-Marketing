---
import {
  buildAtlasModel,
  type AtlasNode,
  type AtlasNodeKind,
} from "@/lib/atlas";
import { getPublicProducts } from "@/lib/products";

import type { Language } from "@/data/site";

interface Props {
  lang?: Language;
}

const { lang = "en" } = Astro.props;
const isVi = lang === "vi";
const isZh = lang === "zh";
const isZhHant = lang === "zh-hant";

const products = await getPublicProducts();
const { nodes, edges } = buildAtlasModel(lang, products);

const kindLabels: Record<AtlasNodeKind, string> = {
  brand: isVi ? "Thương hiệu" : isZh ? "品牌" : isZhHant ? "品牌" : "Brand",
  principle: isVi
    ? "Nguyên tắc"
    : isZh
      ? "原则"
      : isZhHant
        ? "原則"
        : "Principle",
  trust: isVi ? "Tin cậy" : isZh ? "信任" : isZhHant ? "信任" : "Trust",
  claim: isVi ? "Tuyên bố" : isZh ? "声明" : isZhHant ? "聲明" : "Claim",
  evidence: isVi
    ? "Bằng chứng"
    : isZh
      ? "证据"
      : isZhHant
        ? "證據"
        : "Evidence",
  product: isVi ? "Sản phẩm" : isZh ? "产品" : isZhHant ? "產品" : "Product",
};

const heading = isVi
  ? "Bản đồ bằng chứng"
  : isZh
    ? "证据地图"
    : isZhHant
      ? "證據地圖"
      : "Evidence map";

const emptyLabel = isVi
  ? "Chưa có sản phẩm công khai nào được công bố."
  : isZh
    ? "目前尚未发布任何公开产品。"
    : isZhHant
      ? "目前尚未發布任何公開產品。"
      : "No public products are published yet.";

const groupTitles = {
  house: isVi
    ? "Ngôi nhà"
    : isZh
      ? "品牌之家"
      : isZhHant
        ? "品牌之家"
        : "The house",
  proof: isVi
    ? "Tin cậy & bằng chứng"
    : isZh
      ? "信任与证据"
      : isZhHant
        ? "信任與證據"
        : "Trust & evidence",
  products: isVi ? "Sản phẩm" : isZh ? "产品" : isZhHant ? "產品" : "Products",
};

// Editorial reference codes: claims and evidence carry short footnote-style
// marks in the plate (full labels live in the authoritative index below), so
// long statements never collide inside the drawing.
const codes = new Map<string, string>();
let claimCount = 0;
let evidenceCount = 0;
for (const node of nodes) {
  if (node.kind === "claim") codes.set(node.id, `C${++claimCount}`);
  if (node.kind === "evidence") codes.set(node.id, `E${++evidenceCount}`);
}
const indexOf = new Map(nodes.map((node, index) => [node.id, index]));

type Anchor = "start" | "middle" | "end";
interface Placed {
  x: number;
  y: number;
  lx: number;
  ly: number;
  anchor: Anchor;
}

interface Sector {
  radius: number;
  from: number;
  to: number;
}

type Plate = {
  width: number;
  height: number;
  cx: number;
  cy: number;
  rings: number[];
  sectors: Record<Exclude<AtlasNodeKind, "brand">, Sector>;
  labelled: AtlasNodeKind[];
};

// Deterministic radial composition (no randomness, no runtime layout): each
// kind owns an angular sector on its own orbit so labels never share space.
const DESKTOP: Plate = {
  width: 1000,
  height: 560,
  cx: 500,
  cy: 282,
  rings: [170, 232, 330],
  sectors: {
    principle: { radius: 170, from: 232, to: 308 },
    trust: { radius: 232, from: 152, to: 196 },
    claim: { radius: 232, from: -24, to: 24 },
    evidence: { radius: 330, from: -38, to: 38 },
    product: { radius: 232, from: 42, to: 138 },
  },
  labelled: ["brand", "principle", "trust", "claim", "evidence", "product"],
};

const MOBILE: Plate = {
  width: 360,
  height: 420,
  cx: 176,
  cy: 214,
  rings: [100, 138, 164],
  sectors: {
    principle: { radius: 100, from: 240, to: 300 },
    trust: { radius: 138, from: 158, to: 202 },
    claim: { radius: 124, from: -32, to: 32 },
    evidence: { radius: 164, from: -52, to: 52 },
    product: { radius: 138, from: 50, to: 130 },
  },
  // Narrow plate: only the house and claim marks are labelled; trust,
  // evidence and product names stay in the authoritative index below.
  labelled: ["brand", "principle", "claim"],
};

const toRad = (deg: number) => (deg * Math.PI) / 180;
const round = (value: number) => Math.round(value * 10) / 10;

function layout(plate: Plate): Map<string, Placed> {
  const placed = new Map<string, Placed>();
  placed.set("brand", {
    x: plate.cx,
    y: plate.cy,
    lx: plate.cx,
    ly: plate.cy + 44,
    anchor: "middle",
  });
  for (const kind of Object.keys(plate.sectors) as Array<
    keyof Plate["sectors"]
  >) {
    const members = nodes.filter((node) => node.kind === kind);
    const { radius, from, to } = plate.sectors[kind];
    members.forEach((node, index) => {
      const angle =
        members.length === 1
          ? (from + to) / 2
          : from + ((to - from) * index) / (members.length - 1);
      const cos = Math.cos(toRad(angle));
      const sin = Math.sin(toRad(angle));
      const x = round(plate.cx + radius * cos);
      const y = round(plate.cy + radius * sin);
      const anchor: Anchor =
        cos > 0.34 ? "start" : cos < -0.34 ? "end" : "middle";
      const gap = kind === "evidence" || kind === "claim" ? 12 : 16;
      const lx = round(
        anchor === "start" ? x + gap : anchor === "end" ? x - gap : x,
      );
      // Narrow plates stagger neighbouring centred labels so short words on
      // adjacent nodes never share a baseline.
      const stagger = plate.width < 500 && index % 2 === 1 ? 14 : 0;
      const ly = round(
        anchor === "middle"
          ? y + (sin < 0 ? -18 - stagger : 28 + stagger)
          : y + 4.5,
      );
      placed.set(node.id, { x, y, lx, ly, anchor });
    });
  }
  return placed;
}

const plates = [
  {
    id: "d",
    plate: DESKTOP,
    positions: layout(DESKTOP),
    className: "hidden md:block",
  },
  { id: "m", plate: MOBILE, positions: layout(MOBILE), className: "md:hidden" },
];

const nodeRadius: Record<AtlasNodeKind, number> = {
  brand: 13,
  principle: 6.5,
  trust: 7,
  claim: 6,
  evidence: 4.5,
  product: 8,
};

const labelFor = (node: AtlasNode): string => codes.get(node.id) ?? node.label;

// Gentle orbital bend: brand edges bow slightly clockwise; claim → evidence
// edges bow outward so the evidence rail reads as footnotes, not wiring.
function edgePath(a: Placed, b: Placed, bend: number): string {
  const mx = (a.x + b.x) / 2;
  const my = (a.y + b.y) / 2;
  const dx = b.x - a.x;
  const dy = b.y - a.y;
  const qx = round(mx - dy * bend);
  const qy = round(my + dx * bend);
  return `M${a.x} ${a.y} Q${qx} ${qy} ${b.x} ${b.y}`;
}

const groups = [
  { id: "house", title: groupTitles.house, kinds: ["brand", "principle"] },
  {
    id: "proof",
    title: groupTitles.proof,
    kinds: ["trust", "claim", "evidence"],
  },
  { id: "products", title: groupTitles.products, kinds: ["product"] },
].map((group) => ({
  ...group,
  members: nodes.filter((node) => group.kinds.includes(node.kind)),
}));
---

<section
  class="atlas-section border-b border-[var(--border-subtle)] py-16 lg:py-20"
  aria-labelledby="atlas-title"
>
  <h2 id="atlas-title" class="type-d2 text-balance">
    {heading}
  </h2>
  <div data-atlas class="atlas-stage mt-10">
    <div class="atlas-plate">
      {plates.map(({ id, plate, positions, className }) => (
        <svg
          viewBox={`0 0 ${plate.width} ${plate.height}`}
          role="presentation"
          aria-hidden="true"
          class:list={["atlas-svg w-full", className]}
        >
          <defs>
            <radialGradient id={`atlas-${id}-core`} cx="50%" cy="50%" r="50%">
              <stop
                offset="0%"
                stop-color="var(--brand-cobalt)"
                stop-opacity="0.55"
              />
              <stop
                offset="45%"
                stop-color="var(--brand-cobalt)"
                stop-opacity="0.16"
              />
              <stop
                offset="100%"
                stop-color="var(--brand-cobalt)"
                stop-opacity="0"
              />
            </radialGradient>
            <linearGradient id={`atlas-${id}-edge`} x1="0" y1="0" x2="1" y2="0">
              <stop
                offset="0%"
                stop-color="var(--brand-cobalt)"
                stop-opacity="0.75"
              />
              <stop
                offset="100%"
                stop-color="var(--brand-porcelain)"
                stop-opacity="0.35"
              />
            </linearGradient>
            <pattern
              id={`atlas-${id}-grid`}
              width="24"
              height="24"
              patternUnits="userSpaceOnUse"
            >
              <rect
                x="11.5"
                y="11.5"
                width="1"
                height="1"
                fill="var(--brand-porcelain)"
                opacity="0.14"
              />
            </pattern>
          </defs>

          <rect
            width={plate.width}
            height={plate.height}
            fill={`url(#atlas-${id}-grid)`}
          />
          <ellipse
            cx={plate.cx}
            cy={plate.cy}
            rx={plate.rings[1]}
            ry={plate.rings[1]}
            fill={`url(#atlas-${id}-core)`}
          />
          {plate.rings.map((ring, index) => (
            <ellipse
              class="atlas-orbit"
              cx={plate.cx}
              cy={plate.cy}
              rx={ring}
              ry={ring}
              fill="none"
              stroke="var(--brand-porcelain)"
              stroke-opacity={0.16 - index * 0.035}
              stroke-dasharray={index === 0 ? "none" : "2 6"}
            />
          ))}

          <g class="atlas-edges">
            {edges.map((edge) => {
              const from = positions.get(edge.from);
              const to = positions.get(edge.to);
              if (!from || !to) return null;
              const isFootnote = edge.from !== "brand";
              return (
                <path
                  data-atlas-i={indexOf.get(edge.to)}
                  d={edgePath(from, to, isFootnote ? -0.18 : 0.08)}
                  fill="none"
                  stroke={
                    isFootnote
                      ? "var(--brand-porcelain)"
                      : `url(#atlas-${id}-edge)`
                  }
                  stroke-opacity={isFootnote ? 0.32 : 0.9}
                  stroke-width={isFootnote ? 0.9 : 1.2}
                  stroke-dasharray={isFootnote ? "3 4" : undefined}
                  vector-effect="non-scaling-stroke"
                />
              );
            })}
          </g>

          {nodes.map((node) => {
            const point = positions.get(node.id);
            if (!point) return null;
            const r = nodeRadius[node.kind];
            const showLabel = plate.labelled.includes(node.kind);
            return (
              <g
                class={`atlas-node atlas-node--${node.kind}`}
                data-atlas-i={indexOf.get(node.id)}
              >
                {node.kind === "brand" ? (
                  <ellipse
                    cx={point.x}
                    cy={point.y}
                    rx={r + 9}
                    ry={r + 9}
                    fill="none"
                    stroke="var(--brand-cobalt)"
                    stroke-opacity="0.55"
                  />
                ) : null}
                {node.kind === "product" ? (
                  <ellipse
                    cx={point.x}
                    cy={point.y}
                    rx={r + 5}
                    ry={r + 5}
                    fill="none"
                    stroke="var(--brand-porcelain)"
                    stroke-opacity="0.28"
                  />
                ) : null}
                <circle cx={point.x} cy={point.y} r={r} />
                {node.kind === "principle" ? (
                  <path
                    d={`M${point.x} ${point.y - 3}L${point.x + 3} ${point.y}L${point.x} ${point.y + 3}L${point.x - 3} ${point.y}Z`}
                    fill="var(--brand-ink)"
                  />
                ) : null}
                {showLabel ? (
                  <text
                    x={point.lx}
                    y={point.ly}
                    text-anchor={point.anchor}
                    class={`atlas-label atlas-label--${node.kind}`}
                  >
                    {labelFor(node)}
                  </text>
                ) : null}
              </g>
            );
          })}
        </svg>
      ))}
    </div>

    <div class="atlas-index">
      {groups.map((group) => (
        <div class="atlas-group">
          <h3 class="atlas-group__title">
            {group.title}
            <span class="atlas-group__count">{group.members.length}</span>
          </h3>
          {group.members.length > 0 ? (
            <ul class="atlas-list" role="list">
              {group.members.map((node) => (
                <li
                  data-atlas-node
                  data-atlas-kind={node.kind}
                  data-atlas-i={indexOf.get(node.id)}
                  class="atlas-row"
                >
                  <span
                    class={`atlas-swatch atlas-swatch--${node.kind}`}
                    aria-hidden="true"
                  />
                  {codes.has(node.id) ? (
                    <span class="atlas-code">{codes.get(node.id)}</span>
                  ) : null}
                  <a href={node.href} class="atlas-row__link">
                    {node.label}
                  </a>
                  <span class="atlas-row__kind">{kindLabels[node.kind]}</span>
                </li>
              ))}
            </ul>
          ) : (
            <p class="atlas-group__empty">{emptyLabel}</p>
          )}
        </div>
      ))}
    </div>

    {products.length === 0 && (
      <p class="mt-4 text-sm text-[var(--text-muted)]">{emptyLabel}</p>
    )}
  </div>
</section>

<style>
  /* Atlas — evidence constellation. The plate is an ink stage in both themes
     (like the identity stage), so plate colours use fixed brand tokens; the
     index below follows the page theme. Static SVG/CSS only: no client JS,
     no animation on nodes; hover/focus linking uses :has() as a progressive
     enhancement and degrades to a plain, complete index. */
  .atlas-plate {
    position: relative;
    overflow: hidden;
    border: 1px solid
      color-mix(in srgb, var(--brand-porcelain) 12%, transparent);
    border-radius: var(--radius-xl);
    background:
      radial-gradient(
        60% 70% at 50% 45%,
        color-mix(in srgb, var(--brand-cobalt) 18%, transparent),
        transparent 70%
      ),
      linear-gradient(
        170deg,
        #0f172a 0%,
        var(--brand-ink) 55%,
        color-mix(in srgb, var(--brand-ink) 72%, black) 100%
      );
    box-shadow:
      inset 0 1px 0 color-mix(in srgb, var(--brand-porcelain) 10%, transparent),
      0 24px 60px -28px color-mix(in srgb, var(--brand-ink) 70%, transparent);
    color: var(--brand-porcelain);
    padding: clamp(0.75rem, 2vw, 1.5rem);
  }

  .atlas-svg {
    height: auto;
    overflow: visible;
  }

  .atlas-node circle {
    stroke-width: 1.25;
    transition:
      opacity var(--motion-normal) var(--motion-ease-standard),
      filter var(--motion-normal) var(--motion-ease-standard);
  }
  .atlas-node--brand circle {
    fill: var(--brand-cobalt);
    stroke: color-mix(in srgb, var(--brand-porcelain) 70%, transparent);
  }
  .atlas-node--principle circle {
    fill: var(--brand-porcelain);
    stroke: color-mix(in srgb, var(--brand-cobalt) 60%, transparent);
  }
  .atlas-node--trust circle {
    fill: var(--brand-ink);
    stroke: var(--brand-porcelain);
    stroke-width: 2;
  }
  .atlas-node--claim circle {
    fill: color-mix(in srgb, var(--brand-cobalt) 80%, white);
    stroke: color-mix(in srgb, var(--brand-porcelain) 60%, transparent);
  }
  .atlas-node--evidence circle {
    fill: var(--brand-ink);
    stroke: color-mix(in srgb, var(--brand-cobalt) 70%, white);
    stroke-width: 1.5;
  }
  .atlas-node--product circle {
    fill: var(--brand-porcelain);
    stroke: var(--brand-cobalt);
    stroke-width: 2.5;
  }

  .atlas-label {
    fill: color-mix(in srgb, var(--brand-porcelain) 84%, transparent);
    font-size: var(--size-2);
    font-weight: 500;
    letter-spacing: 0.01em;
  }
  .atlas-label--brand {
    fill: var(--brand-porcelain);
    font-size: var(--size-3);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .atlas-label--product {
    fill: var(--brand-porcelain);
    font-weight: 600;
  }
  .atlas-label--claim,
  .atlas-label--evidence {
    fill: color-mix(in srgb, var(--brand-cobalt) 45%, white);
    font-size: var(--size-1);
    font-weight: 700;
    letter-spacing: 0.12em;
  }

  .atlas-edges path,
  .atlas-node {
    transition: opacity var(--motion-normal) var(--motion-ease-standard);
  }

  /* Index ↔ plate linking (progressive enhancement). */
  .atlas-stage:has(.atlas-index [data-atlas-i]:is(:hover, :focus-within))
    .atlas-plate
    :is(.atlas-node, .atlas-edges path) {
    opacity: 0.22;
  }
  .atlas-stage:has(.atlas-index [data-atlas-i="0"]:is(:hover, :focus-within))
    .atlas-plate
    .atlas-svg
    [data-atlas-i="0"],
  .atlas-stage:has(.atlas-index [data-atlas-i="1"]:is(:hover, :focus-within))
    .atlas-plate
    .atlas-svg
