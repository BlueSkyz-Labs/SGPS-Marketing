---
import { buildAtlasModel, type AtlasNodeKind } from "@/lib/atlas";
import { getPublicProducts } from "@/lib/products";

interface Props {
  lang?: "en" | "vi";
}

const { lang = "en" } = Astro.props;
const isVi = lang === "vi";

const products = await getPublicProducts();
const { nodes, edges } = buildAtlasModel(lang, products);

const kindLabels: Record<AtlasNodeKind, string> = {
  brand: isVi ? "Thương hiệu" : "Brand",
  principle: isVi ? "Nguyên tắc" : "Principle",
  trust: isVi ? "Tin cậy" : "Trust",
  claim: isVi ? "Tuyên bố" : "Claim",
  evidence: isVi ? "Bằng chứng" : "Evidence",
  product: isVi ? "Sản phẩm" : "Product",
};

// Decorative SVG labels are truncated; the semantic node list below is the
// authoritative source of full labels.
const truncate = (text: string, max: number): string => {
  if (text.length <= max) return text;
  const cut = text.slice(0, max - 1);
  const lastSpace = cut.lastIndexOf(" ");
  const body =
    lastSpace >= Math.floor(max * 0.55) ? cut.slice(0, lastSpace) : cut;
  return `${body}…`;
};

const heading = "BlueSkyz Atlas";
const lede = isVi
  ? "Sơ đồ hóa từ chính những nguồn trang này công bố: thương hiệu mẹ, các nguyên tắc, những bề mặt tin cậy có thể xác minh, và các tuyên bố công khai cùng bằng chứng mà chúng dẫn chiếu. Nút sản phẩm chỉ xuất hiện khi sản phẩm thật được công bố."
  : "Mapped from the same sources this site publishes: the masterbrand, its principles, verifiable trust surfaces, and the public claims with the evidence they cite. Product nodes appear only when real products are public.";

const emptyLabel = isVi
  ? "Chưa có sản phẩm công khai nào được công bố."
  : "No public products are published yet.";

// Deterministic constellation layouts (no randomness): a landscape plate for
// desktop and a portrait plate for narrow screens so labels stay legible.
const desktopPositions = new Map<string, { x: number; y: number }>();
desktopPositions.set("brand", { x: 320, y: 164 });
nodes
  .filter((node) => node.kind === "principle")
  .forEach((node, index) => {
    desktopPositions.set(node.id, { x: 88 + index * 154.6, y: 52 });
  });
nodes
  .filter((node) => node.kind === "trust")
  .forEach((node, index) => {
    desktopPositions.set(node.id, { x: 130 + index * 190, y: 276 });
  });
nodes
  .filter((node) => node.kind === "claim")
  .forEach((node, index) => {
    desktopPositions.set(node.id, { x: 560, y: 120 + index * 90 });
  });
nodes
  .filter((node) => node.kind === "evidence")
  .forEach((node, index) => {
    desktopPositions.set(node.id, { x: 440 + index * 70, y: 250 });
  });
nodes
  .filter((node) => node.kind === "product")
  .forEach((node, index) => {
    desktopPositions.set(node.id, { x: 600, y: 96 + index * 44 });
  });

const mobilePositions = new Map<string, { x: number; y: number }>();
mobilePositions.set("brand", { x: 180, y: 272 });
nodes
  .filter((node) => node.kind === "principle")
  .forEach((node, index) => {
    const column = index % 2;
    const row = Math.floor(index / 2);
    mobilePositions.set(node.id, { x: 92 + column * 176, y: 66 + row * 112 });
  });
nodes
  .filter((node) => node.kind === "trust")
  .forEach((node, index) => {
    mobilePositions.set(node.id, { x: 60 + index * 120, y: 392 });
  });
nodes
  .filter((node) => node.kind === "claim")
  .forEach((node, index) => {
    mobilePositions.set(node.id, { x: 290, y: 226 + index * 74 });
  });
nodes
  .filter((node) => node.kind === "evidence")
  .forEach((node, index) => {
    mobilePositions.set(node.id, { x: 96 + index * 62, y: 330 });
  });
nodes
  .filter((node) => node.kind === "product")
  .forEach((node, index) => {
    mobilePositions.set(node.id, { x: 330, y: 210 + index * 40 });
  });
---

<section
  class="border-b border-[var(--border-subtle)] py-16 lg:py-20"
  aria-labelledby="atlas-title"
>
  <h2
    id="atlas-title"
    class="text-3xl font-semibold tracking-tight text-balance sm:text-4xl"
  >
    {heading}
  </h2>
  <p class="mt-4 max-w-2xl text-lg text-[var(--text-secondary)] text-pretty">
    {lede}
  </p>

  <div data-atlas class="mt-10">
    <svg
      viewBox="0 0 640 320"
      role="presentation"
      aria-hidden="true"
      class="hidden w-full md:block"
    >
      {
        edges.map((edge) => {
          const from = desktopPositions.get(edge.from);
          const to = desktopPositions.get(edge.to);
          if (!from || !to) return null;
          return (
            <line
              x1={from.x}
              y1={from.y}
              x2={to.x}
              y2={to.y}
              stroke="color-mix(in srgb, var(--brand-cobalt) 35%, transparent)"
              stroke-width="1"
            />
          );
        })
      }
      {
        nodes.map((node) => {
          const point = desktopPositions.get(node.id);
          if (!point) return null;
          const isBrand = node.kind === "brand";
          return (
            <g>
              <circle
                cx={point.x}
                cy={point.y}
                r={isBrand ? 10 : node.kind === "claim" ? 8 : 6}
                fill={
                  isBrand
                    ? "var(--brand-cobalt)"
                    : node.kind === "trust" || node.kind === "evidence"
                      ? "var(--brand-porcelain)"
                      : "color-mix(in srgb, var(--brand-cobalt) 55%, white)"
                }
                stroke="color-mix(in srgb, var(--brand-cobalt) 45%, transparent)"
                stroke-width="1"
              />
              {node.kind !== "evidence" ? (
                <text
                  x={point.x}
                  y={point.y - 18}
                  text-anchor="middle"
                  font-size="13"
                  fill="var(--text-secondary)"
                >
                  {node.kind === "claim"
                    ? truncate(node.label, 16)
                    : node.label}
                </text>
              ) : null}
            </g>
          );
        })
      }
    </svg>

    <svg
      viewBox="0 0 360 424"
      role="presentation"
      aria-hidden="true"
      class="w-full md:hidden"
    >
      {
        edges.map((edge) => {
          const from = mobilePositions.get(edge.from);
          const to = mobilePositions.get(edge.to);
          if (!from || !to) return null;
          return (
            <line
              x1={from.x}
              y1={from.y}
              x2={to.x}
              y2={to.y}
              stroke="color-mix(in srgb, var(--brand-cobalt) 35%, transparent)"
              stroke-width="1"
            />
          );
        })
      }
      {
        nodes.map((node) => {
          const point = mobilePositions.get(node.id);
          if (!point) return null;
          const isBrand = node.kind === "brand";
          return (
            <g>
              <circle
                cx={point.x}
                cy={point.y}
                r={isBrand ? 11 : node.kind === "claim" ? 8 : 6}
                fill={
                  isBrand
                    ? "var(--brand-cobalt)"
                    : node.kind === "trust" || node.kind === "evidence"
                      ? "var(--brand-porcelain)"
                      : "color-mix(in srgb, var(--brand-cobalt) 55%, white)"
                }
                stroke="color-mix(in srgb, var(--brand-cobalt) 45%, transparent)"
                stroke-width="1"
              />
              {node.kind !== "evidence" ? (
                <text
                  x={point.x}
                  y={point.y - 18}
                  text-anchor="middle"
                  font-size="14"
                  fill="var(--text-muted)"
                >
                  {node.kind === "claim"
                    ? truncate(node.label, 18)
                    : node.label}
                </text>
              ) : null}
            </g>
          );
        })
      }
    </svg>

    <ul
      class="atlas-list mt-8 divide-y divide-[var(--border-subtle)] rounded-lg border border-[var(--border-subtle)] bg-white"
    >
      {
        nodes.map((node) => (
          <li
            data-atlas-node
            data-atlas-kind={node.kind}
            class="flex items-center justify-between gap-4 px-4"
          >
            <a
              href={node.href}
              class="inline-flex min-h-11 items-center text-sm font-medium text-[var(--text-primary)] no-underline hover:text-[var(--action-primary)]"
            >
              {node.label}
            </a>
            <span class="text-[0.65rem] font-semibold tracking-[0.14em] text-[var(--text-muted)] uppercase">
              {kindLabels[node.kind]}
            </span>
          </li>
        ))
      }
    </ul>

    {
      products.length === 0 && (
        <p class="mt-4 text-sm text-[var(--text-muted)]">{emptyLabel}</p>
      )
    }
  </div>
</section>
