---
import { buildDecisionItems, MAX_COMPARISON } from "@/lib/decision-room";
import {
  ATELIER_CONSTRAINTS,
  ATELIER_GOALS,
  ATELIER_REASON_KEYS,
} from "@/lib/decision-atelier";
import { getPublicProducts } from "@/lib/products";
import type { Language } from "@/data/site";

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const products = (await getPublicProducts()).map((product) => ({
  slug: product.data.slug,
  name: product.data.name,
}));
const items = buildDecisionItems(products);

const COPY = {
