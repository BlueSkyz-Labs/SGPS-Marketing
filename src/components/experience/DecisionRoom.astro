  },
  vi: {
    heading: "Phòng Quyết định",
    lede: "Đặt tối đa bốn dữ kiện công khai cạnh nhau — tuyên bố có nguồn, các tuyến tin cậy, và ranh giới để giữ chúng trung thực. Không điểm số, không đề xuất.",
    add: "So sánh",
    remove: "Bỏ",
    reset: "Xóa so sánh",
    boardTitle: "So sánh",
    empty: "Chưa chọn mục nào. Chọn tối đa bốn mục bên dưới.",
    source: "Xem nguồn",
    count: "Đang so sánh {n}/{max}",
    full: "So sánh tối đa {max} mục.",
  },
  zh: {
    heading: "决策室",
    lede: "将最多四项公开事实并列对照 — 有来源的声明、信任路径，以及确保其严谨的边界说明。不作结论，不提建议。",
    add: "对比",
    remove: "移除",
    reset: "清空对比",
    boardTitle: "对比栏",
    empty: "尚未选择任何项目。请在下方选择最多四项。",
    source: "查看来源",
    count: "已对比 {n}/{max} 项",
    full: "对比栏最多容纳 {max} 项。",
  },
} as const;

const KIND_LABELS = {
  claim: { en: "Claim", vi: "Tuyên bố", zh: "声明" },
  trust: { en: "Trust", vi: "Tin cậy", zh: "信任" },
  product: { en: "Product", vi: "Sản phẩm", zh: "产品" },
} as const;

/** C4-E Task 3 — atelier controls copy. */
const ATELIER_COPY = {
  en: {
    heading: "Arrange for a goal",
    lede: "Group the published items for what you are actually doing. Items are listed, never ordered by quality.",
    goal: "Goal",
    none: "No goal — source order",
    constraints: "Narrow to",
    reset: "Reset arrangement",
    grouped: "{n} items arranged",
    cleared: "Source order restored.",
