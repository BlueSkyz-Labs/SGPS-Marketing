  },
  zh: {
    heading: "按目标排列",
    lede: "按你正在做的事情对已发布条目分组。条目仅作列举，不按优劣排序。",
    goal: "目标",
    none: "不选择 — 按来源顺序",
    constraints: "缩小范围",
    reset: "重置排列",
    grouped: "已排列 {n} 项",
    cleared: "已恢复来源顺序。",
    noneMatch: "没有已发布条目符合该选择。",
    goals: {
      explore: "探索",
      evaluate: "评估",
      verify: "核实",
      architecture: "架构",
      "work-with-blueskyz": "与 BlueSkyz 合作",
    },
    constraintsLabels: {
      technical: "技术",
      trust: "信任",
      availability: "可用性",
    },
    reasons: {
      "in-scope": "列出原因：它是符合该目标的已发布条目。",
      "carries-source": "列出原因：它附有已发布的来源。",
      "states-limits": "列出原因：它说明了自身未确立的内容。",
      "trust-surface": "列出原因：它发布在信任界面上。",
      "product-fact": "列出原因：它是已发布的产品事实。",
    },
    groups: {
      "starting-points": "起点",
      "open-questions": "待解问题",
      "sourced-facts": "有来源的事实",
      "stated-limits": "已声明的限制",
      "evidence-backed": "有证据支持",
      "trust-signals": "信任信号",
      "product-truth": "产品事实",
    },
  },
} as const;

const GROUP_IDS = [
  "starting-points",
  "open-questions",
  "sourced-facts",
  "stated-limits",
  "evidence-backed",
  "trust-signals",
  "product-truth",
] as const;

const atelierCopy = ATELIER_COPY[lang];

const copy = COPY[lang];
const domId = (id: string): string =>
  `room-item-${id.replace(/[^a-z0-9-]+/gi, "-")}`;
---

<section
  class="decision-room"
  data-decision-room
  data-max={MAX_COMPARISON}
  data-msg-count={copy.count}
  data-msg-full={copy.full}
  data-msg-grouped={atelierCopy.grouped}
  data-msg-cleared={atelierCopy.cleared}
  data-msg-none={atelierCopy.noneMatch}
  aria-labelledby="decision-room-title"
>
  <h2 id="decision-room-title" class="decision-room__title">
    {copy.heading}
  </h2>
  <p class="decision-room__lede">{copy.lede}</p>

  <div class="decision-room__atelier" data-atelier-controls hidden>
    <h3 class="decision-room__atelier-title">{atelierCopy.heading}</h3>
    <p class="decision-room__atelier-lede">{atelierCopy.lede}</p>
    <div class="decision-room__atelier-field">
      <label class="decision-room__atelier-label" for="atelier-goal">
        {atelierCopy.goal}
      </label>
      <select
        class="decision-room__atelier-select"
        id="atelier-goal"
        data-atelier-goal
      >
        <option value="">{atelierCopy.none}</option>
        {ATELIER_GOALS.map((goal) => (
          <option value={goal}>{atelierCopy.goals[goal]}</option>
        ))}
      </select>
    </div>
    <fieldset class="decision-room__atelier-field">
      <legend class="decision-room__atelier-label">
        {atelierCopy.constraints}
      </legend>
      {ATELIER_CONSTRAINTS.map((constraint) => (
        <label class="decision-room__atelier-check">
          <input
            type="checkbox"
            value={constraint}
            data-atelier-constraint={constraint}
          />
          <span>{atelierCopy.constraintsLabels[constraint]}</span>
        </label>
      ))}
    </fieldset>
    <button
      type="button"
      class="decision-room__atelier-reset"
      data-atelier-reset
    >
      {atelierCopy.reset}
    </button>
    <p
      class="decision-room__atelier-status"
      data-atelier-status
      aria-live="polite"
    ></p>
  </div>

  {GROUP_IDS.map((groupId) => (
    <template data-atelier-label={groupId}>
      {atelierCopy.groups[groupId]}
    </template>
  ))}

  {ATELIER_REASON_KEYS.map((reasonKey) => (
    <template data-atelier-reason={reasonKey}>
      {atelierCopy.reasons[reasonKey]}
    </template>
  ))}

  <div class="decision-room__items" data-decision-items>
    {items.map((item, index) => (
      <article
        id={domId(item.id)}
        class="decision-room__item"
        data-decision-item={item.id}
        data-item-kind={item.kind}
        data-source-index={index}
        data-has-evidence={item.evidenceHref ? "" : undefined}
        data-has-boundary={item.boundaryText ? "" : undefined}
      >
        <span class="decision-room__kind">{KIND_LABELS[item.kind][lang]}</span>
        <h3 class="decision-room__label">{item.label[lang]}</h3>
        {item.summary ? (
          <p class="decision-room__summary">{item.summary[lang]}</p>
        ) : null}
        {item.boundaryText ? (
          <p class="decision-room__boundary">{item.boundaryText[lang]}</p>
        ) : null}
        {item.evidenceHref ? (
          <a
            href={item.evidenceHref[lang]}
            rel={
              /^https?:\/\//i.test(item.evidenceHref[lang])
                ? "noopener noreferrer"
                : undefined
            }
            class="decision-room__source"
          >
            {copy.source} →
          </a>
        ) : null}
        <button
          type="button"
          class="decision-room__add"
          data-decision-add={item.id}
          aria-pressed="false"
        >
          {copy.add}
        </button>
      </article>
    ))}
  </div>

  <p class="decision-room__empty" data-decision-empty-state>
    {copy.empty}
  </p>

  <div class="decision-room__board" data-decision-board hidden>
    <h3 class="decision-room__board-title">{copy.boardTitle}</h3>
    <ul class="decision-room__rows">
      {items.map((item) => (
        <li data-decision-row={item.id} hidden>
          <span class="decision-room__row-label">{item.label[lang]}</span>
          <button
            type="button"
            class="decision-room__remove"
            data-decision-remove={item.id}
          >
            {copy.remove}
          </button>
        </li>
      ))}
    </ul>
  </div>

  <button type="button" class="decision-room__reset" data-decision-reset hidden>
    {copy.reset}
  </button>

  <p class="sr-only" role="status" aria-live="polite" data-decision-live></p>
</section>

<noscript>
  <style>
    [data-decision-add],
    [data-decision-reset] {
      display: none !important;
    }
  </style>
</noscript>

<script>
  import { initDecisionRoom } from "@/scripts/decision-room";

  initDecisionRoom();
</script>
