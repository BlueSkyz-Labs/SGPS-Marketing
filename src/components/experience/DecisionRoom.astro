      architecture: "Architecture",
      "work-with-blueskyz": "Work with BlueSkyz",
    },
    constraintsLabels: {
      technical: "Technical",
      trust: "Trust",
      availability: "Availability",
    },
    reasons: {
      "in-scope":
        "Listed because it is a published item in scope for this goal.",
      "carries-source": "Listed because a published source is attached to it.",
      "states-limits": "Listed because it states what it does not establish.",
      "trust-surface": "Listed because it is published on a trust surface.",
      "product-fact": "Listed because it is a published product fact.",
    },
    groups: {
      "starting-points": "Starting points",
      "open-questions": "Open questions",
      "sourced-facts": "Sourced facts",
      "stated-limits": "Stated limits",
      "evidence-backed": "Evidence backed",
      "trust-signals": "Trust signals",
      "product-truth": "Product truth",
    },
  },
  vi: {
    heading: "Sắp xếp theo mục tiêu",
    lede: "Nhóm các mục đã công bố theo đúng việc bạn đang làm. Các mục được liệt kê, không xếp theo chất lượng.",
    goal: "Mục tiêu",
    none: "Không chọn — theo thứ tự nguồn",
    constraints: "Thu hẹp theo",
    reset: "Đặt lại sắp xếp",
    grouped: "Đã sắp xếp {n} mục",
    cleared: "Đã trở về thứ tự nguồn.",
    noneMatch: "Không có mục công khai nào khớp lựa chọn đó.",
    goals: {
      explore: "Khám phá",
      evaluate: "Đánh giá",
      verify: "Kiểm chứng",
      architecture: "Kiến trúc",
      "work-with-blueskyz": "Làm việc với BlueSkyz",
    },
    constraintsLabels: {
      technical: "Kỹ thuật",
      trust: "Tin cậy",
      availability: "Sẵn sàng",
    },
    reasons: {
      "in-scope":
        "Được liệt kê vì là mục đã công bố thuộc phạm vi mục tiêu này.",
      "carries-source": "Được liệt kê vì có nguồn đã công bố kèm theo.",
      "states-limits": "Được liệt kê vì nêu rõ điều nó không xác lập.",
      "trust-surface": "Được liệt kê vì được công bố trên bề mặt tin cậy.",
      "product-fact": "Được liệt kê vì là dữ kiện sản phẩm đã công bố.",
    },
    groups: {
      "starting-points": "Điểm bắt đầu",
      "open-questions": "Câu hỏi mở",
