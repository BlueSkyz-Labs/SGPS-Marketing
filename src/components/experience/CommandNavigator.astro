---
import { buildNavigatorIndex } from "@/lib/navigator";
import { getPublicProducts } from "@/lib/products";
import { getLanguageFromPath } from "@/lib/i18n";

const lang = getLanguageFromPath(Astro.url.pathname);
const isVi = lang === "vi";
const isZh = lang === "zh";
const items = buildNavigatorIndex(lang, await getPublicProducts());

const KIND_LABELS: Record<string, string> = {
  route: isVi ? "Trang" : isZh ? "页面" : "Page",
  trust: isVi ? "Tin cậy" : isZh ? "信任" : "Trust",
  product: isVi ? "Sản phẩm" : isZh ? "产品" : "Product",
  evidence: isVi ? "Bằng chứng" : isZh ? "证据" : "Evidence",
};

const navLabel = isVi
  ? "Điều hướng nhanh"
  : isZh
    ? "快速导航"
    : "Quick navigation";
const placeholder = isVi ? "Tìm trang…" : isZh ? "搜索页面…" : "Search pages…";
const emptyLabel = isVi
  ? "Không tìm thấy mục phù hợp."
  : isZh
    ? "未找到匹配的目的地。"
    : "No matching destinations.";
const resultTemplate = isVi ? "%n kết quả" : isZh ? "%n 个结果" : "%n results";
const resultNone = isVi ? "Không có kết quả" : isZh ? "无结果" : "No results";
---

<dialog class="command-navigator" aria-label={navLabel} data-command-navigator>
  <div class="command-navigator__panel">
    <label class="sr-only" for="command-navigator-input">
      {navLabel}
    </label>
    <input
      id="command-navigator-input"
      type="search"
      placeholder={placeholder}
      autocomplete="off"
      spellcheck="false"
      data-command-input
    />
    <ul class="command-navigator__list" data-command-list>
      {items.map((item) => {
        const searchText =
          `${item.label} ${item.aliases.join(" ")}`.toLocaleLowerCase(lang);
        return (
          <li
            data-command-item
            data-command-kind={item.kind}
            data-search={searchText}
          >
            <a href={item.href}>{item.label}</a>
            <span class="command-navigator__kind">
              {KIND_LABELS[item.kind] ?? item.kind}
            </span>
          </li>
        );
      })}
    </ul>
    <p
      class="sr-only"
      role="status"
      aria-live="polite"
      data-command-live
      data-live-template={resultTemplate}
      data-live-none={resultNone}
    ></p>
    <p class="command-navigator__empty" data-command-empty hidden>
      {emptyLabel}
    </p>
  </div>
</dialog>

<noscript>
  <style>
    [data-command-navigator],
    [data-command-trigger] {
      display: none !important;
    }
  </style>
</noscript>

<script>
  import { initCommandNavigator } from "@/scripts/command-navigator";

  initCommandNavigator();
</script>
