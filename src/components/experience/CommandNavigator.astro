---
import { buildNavigatorIndex } from "@/lib/navigator";
import { getPublicProducts } from "@/lib/products";
import { getLanguageFromPath } from "@/lib/i18n";
import { buildConciergeCorpus } from "@/lib/concierge-corpus";
import { getNav } from "@/data/site";
import {
  AVAILABILITY,
  webPreviewOpen,
} from "@/components/product/product-page-copy";
import BlueSkyzIcon from "@/components/icon/BlueSkyzIcon.astro";

const lang = getLanguageFromPath(Astro.url.pathname);
const isVi = lang === "vi";
const isZh = lang === "zh";
const isZhHant = lang === "zh-hant";
const publicProducts = await getPublicProducts();
const items = buildNavigatorIndex(lang, publicProducts);

// C3-E deterministic step: the concierge corpus feeds this navigator instead of
// rendering a second surface. Each corpus record's verbatim canonical text
// joins the search text of the navigator item at the same path, so visitors
// can find a product or surface by what its published claims say. Claim
// records are skipped: their evidence-passport items already carry the same
// statement as their label. No item, link or visible copy is added, and a
// record without a matching item is dropped rather than invented.
// The product description fed to the corpus is the locale's own copy (the
// top-level field is English-only); the top-level value is only a fallback.
const corpusText = new Map<string, string>();
for (const record of buildConciergeCorpus({
  lang,
  products: publicProducts.map((entry) => ({
    slug: entry.data.slug,
    name: entry.data.name,
    description:
      entry.data.i18n?.[lang]?.shortDescription ?? entry.data.shortDescription,
  })),
})) {
  if (record.kind === "claim") continue;
  const path = new URL(record.publicUrl).pathname;
  corpusText.set(path, `${corpusText.get(path) ?? ""} ${record.text}`.trim());
}

const KIND_LABELS: Record<string, string> = {
  route: isVi ? "Trang" : isZh ? "页面" : isZhHant ? "頁面" : "Page",
  trust: isVi ? "Tin cậy" : isZh ? "信任" : isZhHant ? "信任" : "Trust",
  product: isVi ? "Sản phẩm" : isZh ? "产品" : isZhHant ? "產品" : "Product",
  evidence: isVi
    ? "Bằng chứng"
    : isZh
      ? "证据"
      : isZhHant
        ? "證據"
        : "Evidence",
};

const navLabel = isVi
  ? "Điều hướng nhanh"
  : isZh
    ? "快速导航"
    : isZhHant
      ? "快速導覽"
      : "Quick navigation";
// Native dialog close action, always named in the current locale.
const closeLabel = isVi ? "Đóng" : isZh ? "关闭" : isZhHant ? "關閉" : "Close";
const placeholder = isVi
  ? "Tìm trang…"
  : isZh
    ? "搜索页面…"
    : isZhHant
      ? "搜尋頁面…"
      : "Search pages…";
const emptyLabel = isVi
  ? "Không tìm thấy mục phù hợp."
  : isZh
    ? "未找到匹配的目的地。"
    : isZhHant
      ? "找不到符合的頁面。"
      : "No matching destinations.";
const resultTemplate = isVi
  ? "%n kết quả"
  : isZh
    ? "%n 个结果"
    : isZhHant
      ? "%n 個結果"
      : "%n results";
const resultNone = isVi
  ? "Không có kết quả"
  : isZh
    ? "无结果"
    : isZhHant
      ? "無結果"
      : "No results";

// U1 (C-01): honest recovery for the commonest intents. No price, date or link
// is invented: the status line reuses the existing availability copy
// (per-product state + "no store release"), and the links are the Products and
// Contact nav entries of the current locale.
const fallbackLinks = getNav(lang).filter(
  (link) =>
    link.href === `/${lang}/products/` || link.href === `/${lang}/contact/`,
);
// Preview 2026-10-15: once a product's web app is open as a preview, the
// line names each product with its own state from the registry, so a "sign
// up" search does not call an open preview "in development".
const semi = lang === "zh" || lang === "zh-hant" ? "；" : "; ";
const colon = AVAILABILITY.colon[lang];
const statusLine = publicProducts.some((entry) => webPreviewOpen(entry.data))
  ? [
      ...publicProducts.map(
        (entry) =>
          `${entry.data.name}${colon}${
            webPreviewOpen(entry.data)
              ? AVAILABILITY.preview[lang]
              : AVAILABILITY.inDevelopment[lang]
          }`,
      ),
      `${AVAILABILITY.native[lang]}${colon}${AVAILABILITY.noStore[lang]}`,
    ].join(semi)
  : `${AVAILABILITY.inDevelopment[lang]}${semi}${AVAILABILITY.noStore[lang]}`;
const STATUS_INTENTS: Record<string, string[]> = {
  en: [
    "price",
    "prices",
    "pricing",
    "cost",
    "free",
    "buy",
    "download",
    "install",
    "app",
    "sign up",
    "signup",
    "register",
    "waitlist",
  ],
  vi: [
    "giá",
    "bao nhiêu",
    "miễn phí",
    "mua",
    "tải",
    "tải app",
    "tải về",
    "cài đặt",
    "app",
    "đăng ký",
    "danh sách chờ",
    "price",
    "pricing",
    "download",
    "waitlist",
  ],
  zh: ["价格", "多少钱", "免费", "购买", "下载", "安装", "注册", "报名"],
  "zh-hant": ["價格", "多少錢", "免費", "購買", "下載", "安裝", "註冊", "報名"],
};
const statusIntents = (STATUS_INTENTS[lang] ?? []).join("|");
---

<dialog class="command-navigator" aria-label={navLabel} data-command-navigator>
  <div class="command-navigator__panel">
    <label class="sr-only" for="command-navigator-input">
      {navLabel}
    </label>
    <div class="flex items-center gap-2">
      <input
        id="command-navigator-input"
        type="search"
        placeholder={placeholder}
        autocomplete="off"
        spellcheck="false"
        class="min-w-0 flex-1"
        data-command-input
      />
      <form method="dialog" class="shrink-0">
        <button
          type="submit"
          data-command-close
          aria-label={closeLabel}
          title={closeLabel}
          class="inline-flex h-11 w-11 items-center justify-center rounded-lg border border-[var(--border-subtle)] bg-[var(--surface-raised)] text-[var(--text-primary)] hover:bg-[var(--surface-subtle)]"
        >
          <BlueSkyzIcon name="close" class="h-5 w-5" />
        </button>
      </form>
    </div>
    <ul class="command-navigator__list" data-command-list>
      {items.map((item) => {
        // Rank tiers: label (title) > short keywords > long body text.
        const keys = item.aliases
          .filter((alias) => alias.trim().split(/\s+/).length <= 3)
          .join(" ");
        const body = [
          ...item.aliases.filter(
            (alias) => alias.trim().split(/\s+/).length > 3,
          ),
          corpusText.get(item.href) ?? "",
        ]
          .join(" ")
          .trim();
        return (
          <li
            data-command-item
            data-command-kind={item.kind}
            data-title={item.label}
            data-keys={keys}
            data-body={body}
          >
            <a href={item.href}>{item.label}</a>
            <span class="command-navigator__kind">
              {KIND_LABELS[item.kind] ?? item.kind}
            </span>
          </li>
        );
      })}
    </ul>
    <p
      class="sr-only"
      role="status"
      aria-live="polite"
      data-command-live
      data-live-template={resultTemplate}
      data-live-none={resultNone}
    ></p>
    <p class="command-navigator__empty" data-command-empty hidden>
      {emptyLabel}
    </p>
    <div class="command-navigator__fallback" data-command-fallback hidden>
      <p
        class="command-navigator__status"
        data-command-status
        data-intents={statusIntents}
        hidden
      >
        {statusLine.charAt(0).toLocaleUpperCase(lang)}
        {statusLine.slice(1)}.
      </p>
      <ul>
        {fallbackLinks.map((link) => (
          <li>
            <a href={link.href}>{link.label}</a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</dialog>

<noscript>
  <style>
    [data-command-navigator],
    [data-command-trigger] {
      display: none !important;
    }
  </style>
</noscript>

<script>
  import { initCommandNavigator } from "@/scripts/command-navigator";
  // Shares this module (already on every page) so the header menu enhancement
  // adds no extra script request to first paint.
  import { initMobileMenu } from "@/scripts/mobile-menu";

  initCommandNavigator();
  initMobileMenu();
</script>
