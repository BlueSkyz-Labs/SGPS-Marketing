---
interface Props extends Record<string, unknown> {
  class?: string;
}

const { class: className = "", ...rest } = Astro.props;
---

<div
  class:list={["horizon-field", className]}
  data-horizon
  aria-hidden="true"
  {...rest}
>
  <span class="horizon-field__halo"></span>
  <span class="horizon-field__line"></span>
  <span class="horizon-field__depth"></span>
</div>
