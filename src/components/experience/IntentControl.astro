---
import {
  EXPERIENCE_INTENTS,
  DEFAULT_EXPERIENCE_INTENT,
} from "@/lib/experience-intent";
import type { Language } from "@/data/site";

interface Props {
  lang?: Language;
}

const { lang = "en" } = Astro.props;

const INTENT_LABELS = {
  "explore-products": {
    en: "Explore products",
    vi: "Khám phá sản phẩm",
    zh: "探索产品",
  },
  "evaluate-product": {
    en: "Evaluate a product",
    vi: "Đánh giá sản phẩm",
    zh: "评估产品",
  },
  "verify-trust": {
    en: "Verify trust",
    vi: "Kiểm chứng tin cậy",
    zh: "核验信任",
  },
  "understand-architecture": {
    en: "Understand architecture",
    vi: "Tìm hiểu kiến trúc",
    zh: "了解架构",
  },
  "work-with-us": {
    en: "Work with us",
    vi: "Làm việc cùng chúng tôi",
    zh: "与我们合作",
  },
} as const;

type IntentKey = keyof typeof INTENT_LABELS;
type LangKey = Language;

const getIntentLabel = (intent: string, lang: Language): string => {
  const labels =
    INTENT_LABELS[intent as IntentKey] ?? INTENT_LABELS["explore-products"];
  return (labels[lang as LangKey] ?? labels["en"]) as string;
};

const kicker =
  lang === "vi"
    ? "Bạn đang quan tâm điều gì?"
    : lang === "zh"
      ? "您关注什么？"
      : "What brings you here?";
---

<div
  class="mt-8 flex flex-col gap-3 border-b border-[var(--border-subtle)] pb-8 sm:mt-10 sm:flex-row sm:items-center sm:justify-between"
  data-intent-control
>
  <p
    id="intent-control-label"
    class="text-xs font-semibold tracking-[0.18em] text-[var(--text-muted)] uppercase"
  >
    {kicker}
  </p>
  <div
    role="group"
    aria-labelledby="intent-control-label"
    class="flex flex-wrap gap-2"
  >
    {EXPERIENCE_INTENTS.map((intent) => (
      <button
        type="button"
        class="intent-chip"
        data-intent={intent}
        aria-pressed={intent === DEFAULT_EXPERIENCE_INTENT ? "true" : "false"}
      >
        {getIntentLabel(intent, lang)}
      </button>
    ))}
  </div>
</div>

<script>
  import { initIntentControl } from "@/scripts/experience-intent";

  initIntentControl();
</script>
