---
import { generateVietQRPayload, VIETNAM_BANKS } from "@/lib/vietqr";
import { renderQRSVG } from "@/lib/qrcode";

// Initial server-side defaults
const initialRoom = "Phòng 201";
const initialRent = 3500000;
const initialElecOld = 1450;
const initialElecNew = 1520;
const initialElecRate = 3500;
const initialWaterUsage = 5;
const initialWaterRate = 25000;
const initialService = 100000;
const initialBankBin = "970422"; // MBBank
const initialAccount = "0901234567";

const initialElecDiff = Math.max(0, initialElecNew - initialElecOld);
const initialElecCost = initialElecDiff * initialElecRate;
const initialWaterCost = initialWaterUsage * initialWaterRate;
const initialTotal =
  initialRent + initialElecCost + initialWaterCost + initialService;
const initialPurpose = "TIEN PHONG 201";

const initialPayload = generateVietQRPayload({
  bankBin: initialBankBin,
  accountNumber: initialAccount,
  amount: initialTotal,
  purpose: initialPurpose,
});

const initialSvg = renderQRSVG(initialPayload, {
  size: 240,
  margin: 2,
  alt: "Mã VietQR thanh toán phòng trọ",
});

function formatVND(amount: number): string {
  return amount.toLocaleString("vi-VN") + " đ";
}
---

<section
  class="mt-16 rounded-[var(--radius-card)] border border-[var(--border-subtle)] bg-[var(--surface-raised)] p-6 sm:p-8"
  aria-labelledby="vietqr-calculator-title"
  data-vietqr-calculator
>
  <div class="max-w-3xl">
    <div class="inline-flex items-center gap-2 rounded-full border border-[var(--border-subtle)] bg-[var(--surface-subtle)] px-3 py-1 text-xs font-semibold uppercase tracking-wider text-[var(--action-primary)]">
      <span>Tiện ích Sổ Trọ · VietQR Engine</span>
    </div>
    <h2
      id="vietqr-calculator-title"
      class="mt-3 text-2xl font-bold tracking-tight text-[var(--text-primary)] sm:text-3xl"
    >
      Tính tiền phòng & Tạo mã VietQR tức thì
    </h2>
    <p class="mt-2 text-base text-[var(--text-secondary)]">
      Xử lý 100% cục bộ trên thiết bị của bạn. Tự động tính tiền điện nước, sinh
      mã QR chuẩn NAPAS 247 và định dạng hóa đơn gửi Zalo nhanh chóng.
    </p>
  </div>

  <div class="mt-8 grid grid-cols-1 gap-8 lg:grid-cols-12">
    <!-- Left Column: Inputs Form -->
    <div class="space-y-5 lg:col-span-7">
      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
        <div>
          <label
            for="room-name"
            class="block text-sm font-medium text-[var(--text-primary)]"
          >
            Tên phòng / Căn hộ
          </label>
          <input
            id="room-name"
            type="text"
            value={initialRoom}
            data-input-room
            class="mt-1 block min-h-11 w-full rounded-[var(--radius-button)] border border-[var(--border-subtle)] bg-[var(--surface-subtle)] px-3 py-2 text-[var(--text-primary)] focus:border-[var(--action-primary)] focus:outline-none"
          />
        </div>

        <div>
          <label
            for="room-rent"
            class="block text-sm font-medium text-[var(--text-primary)]"
          >
            Tiền thuê phòng (đ)
          </label>
          <input
            id="room-rent"
            type="number"
            step="50000"
            value={initialRent}
            data-input-rent
            class="mt-1 block min-h-11 w-full rounded-[var(--radius-button)] border border-[var(--border-subtle)] bg-[var(--surface-subtle)] px-3 py-2 text-[var(--text-primary)] focus:border-[var(--action-primary)] focus:outline-none"
          />
        </div>
      </div>

      <!-- Electricity Subsection -->
      <fieldset class="rounded-[var(--radius-card)] border border-[var(--border-subtle)] p-4">
        <legend class="px-2 text-sm font-semibold text-[var(--text-primary)]">
          Điện sinh hoạt
        </legend>
        <div class="grid grid-cols-1 gap-3 sm:grid-cols-3">
          <div>
            <label
              for="elec-old"
              class="block text-xs font-medium text-[var(--text-secondary)]"
            >
              Chỉ số cũ (kWh)
            </label>
            <input
              id="elec-old"
              type="number"
              value={initialElecOld}
              data-input-elec-old
              class="mt-1 block min-h-11 w-full rounded-[var(--radius-button)] border border-[var(--border-subtle)] bg-[var(--surface-subtle)] px-3 py-2 text-[var(--text-primary)] focus:border-[var(--action-primary)] focus:outline-none"
            />
          </div>
          <div>
            <label
              for="elec-new"
              class="block text-xs font-medium text-[var(--text-secondary)]"
            >
              Chỉ số mới (kWh)
            </label>
            <input
              id="elec-new"
              type="number"
              value={initialElecNew}
              data-input-elec-new
              class="mt-1 block min-h-11 w-full rounded-[var(--radius-button)] border border-[var(--border-subtle)] bg-[var(--surface-subtle)] px-3 py-2 text-[var(--text-primary)] focus:border-[var(--action-primary)] focus:outline-none"
            />
          </div>
          <div>
            <label
              for="elec-rate"
              class="block text-xs font-medium text-[var(--text-secondary)]"
            >
              Đơn giá (đ/kWh)
            </label>
            <input
              id="elec-rate"
              type="number"
              value={initialElecRate}
              data-input-elec-rate
              class="mt-1 block min-h-11 w-full rounded-[var(--radius-button)] border border-[var(--border-subtle)] bg-[var(--surface-subtle)] px-3 py-2 text-[var(--text-primary)] focus:border-[var(--action-primary)] focus:outline-none"
            />
          </div>
        </div>
      </fieldset>

      <!-- Water & Services Subsection -->
      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
        <fieldset class="rounded-[var(--radius-card)] border border-[var(--border-subtle)] p-4">
          <legend class="px-2 text-sm font-semibold text-[var(--text-primary)]">
            Nước sinh hoạt
          </legend>
          <div class="grid grid-cols-2 gap-2">
            <div>
              <label
                for="water-usage"
                class="block text-xs font-medium text-[var(--text-secondary)]"
              >
                Số m³
              </label>
              <input
                id="water-usage"
                type="number"
                value={initialWaterUsage}
                data-input-water-usage
                class="mt-1 block min-h-11 w-full rounded-[var(--radius-button)] border border-[var(--border-subtle)] bg-[var(--surface-subtle)] px-3 py-2 text-[var(--text-primary)] focus:border-[var(--action-primary)] focus:outline-none"
              />
            </div>
            <div>
              <label
                for="water-rate"
                class="block text-xs font-medium text-[var(--text-secondary)]"
              >
                Đơn giá (đ/m³)
              </label>
              <input
                id="water-rate"
                type="number"
                value={initialWaterRate}
                data-input-water-rate
                class="mt-1 block min-h-11 w-full rounded-[var(--radius-button)] border border-[var(--border-subtle)] bg-[var(--surface-subtle)] px-3 py-2 text-[var(--text-primary)] focus:border-[var(--action-primary)] focus:outline-none"
              />
            </div>
          </div>
        </fieldset>

        <div>
          <label
            for="service-fee"
            class="block text-sm font-medium text-[var(--text-primary)]"
          >
            Phí dịch vụ / Rác / Wifi (đ)
          </label>
          <input
            id="service-fee"
            type="number"
            value={initialService}
            data-input-service
            class="mt-1 block min-h-11 w-full rounded-[var(--radius-button)] border border-[var(--border-subtle)] bg-[var(--surface-subtle)] px-3 py-2 text-[var(--text-primary)] focus:border-[var(--action-primary)] focus:outline-none"
          />
        </div>
      </div>

      <!-- Bank Beneficiary Subsection -->
      <fieldset class="rounded-[var(--radius-card)] border border-[var(--border-subtle)] p-4">
        <legend class="px-2 text-sm font-semibold text-[var(--text-primary)]">
          Tài khoản nhận thanh toán
        </legend>
        <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
          <div>
            <label
              for="bank-bin"
              class="block text-xs font-medium text-[var(--text-secondary)]"
            >
              Ngân hàng thụ hưởng
            </label>
            <select
              id="bank-bin"
              data-select-bank
              class="mt-1 block min-h-11 w-full rounded-[var(--radius-button)] border border-[var(--border-subtle)] bg-[var(--surface-subtle)] px-3 py-2 text-[var(--text-primary)] focus:border-[var(--action-primary)] focus:outline-none"
            >
              {VIETNAM_BANKS.map((b) => (
                <option value={b.bin} selected={b.bin === initialBankBin}>
                  {b.shortName} ({b.bin})
                </option>
              ))}
            </select>
          </div>

          <div>
            <label
              for="bank-account"
              class="block text-xs font-medium text-[var(--text-secondary)]"
            >
              Số tài khoản ngân hàng
            </label>
            <input
              id="bank-account"
              type="text"
              value={initialAccount}
              data-input-account
              class="mt-1 block min-h-11 w-full rounded-[var(--radius-button)] border border-[var(--border-subtle)] bg-[var(--surface-subtle)] px-3 py-2 text-[var(--text-primary)] focus:border-[var(--action-primary)] focus:outline-none"
            />
          </div>
        </div>
      </fieldset>
    </div>

    <!-- Right Column: Receipt Preview & QR Output -->
    <div class="flex flex-col justify-between rounded-[var(--radius-card)] border border-[var(--border-subtle)] bg-[var(--surface-subtle)] p-6 lg:col-span-5">
      <div>
        <h3 class="text-base font-semibold tracking-tight text-[var(--text-primary)]">
          Chi tiết phiếu báo tiền phòng
        </h3>

        <div class="mt-4 space-y-2 border-b border-[var(--border-subtle)] pb-4 text-sm">
          <div class="flex justify-between">
            <span class="text-[var(--text-secondary)]">Tiền thuê phòng:</span>
            <span class="font-medium text-[var(--text-primary)]" data-disp-rent>
              {formatVND(initialRent)}
            </span>
          </div>
          <div class="flex justify-between">
            <span class="text-[var(--text-secondary)]">
              Tiền điện (<span data-disp-elec-usage>{initialElecDiff}</span>{" "}
              kWh):
            </span>
            <span class="font-medium text-[var(--text-primary)]" data-disp-elec>
              {formatVND(initialElecCost)}
            </span>
          </div>
          <div class="flex justify-between">
            <span class="text-[var(--text-secondary)]">
              Tiền nước (<span data-disp-water-usage>{initialWaterUsage}</span>{" "}
              m³):
            </span>
            <span
              class="font-medium text-[var(--text-primary)]"
              data-disp-water
            >
              {formatVND(initialWaterCost)}
            </span>
          </div>
          <div class="flex justify-between">
            <span class="text-[var(--text-secondary)]">Phí dịch vụ:</span>
            <span
              class="font-medium text-[var(--text-primary)]"
              data-disp-service
            >
              {formatVND(initialService)}
            </span>
          </div>
        </div>

        <div class="mt-4 flex items-baseline justify-between">
          <span class="text-base font-bold text-[var(--text-primary)]">
            Tổng cộng:
          </span>
          <span
            class="text-2xl font-extrabold text-[var(--action-primary)]"
            data-total-amount
          >
            {formatVND(initialTotal)}
          </span>
        </div>

        <!-- QR Display Container -->
        <div class="mt-6 flex flex-col items-center justify-center rounded-[var(--radius-card)] border border-[var(--border-subtle)] bg-white p-4 shadow-xs">
          <div
            data-qr-container
            class="flex items-center justify-center text-slate-900"
            set:html={initialSvg}
          />
          <p class="mt-2 text-xs font-semibold text-slate-700">
            Quét bằng ứng dụng Ngân hàng (NAPAS 247)
          </p>
        </div>

        <!-- Raw Payload Container (Accordion / Monospace) -->
        <div class="mt-4">
          <label class="block text-xs font-semibold text-[var(--text-secondary)]">
            Chuỗi mã VietQR EMVCo (NAPAS 247):
          </label>
          <div
            data-vietqr-payload
            class="mt-1 max-h-16 overflow-x-auto rounded-[var(--radius-button)] border border-[var(--border-subtle)] bg-[var(--surface-raised)] p-2 font-mono text-[10px] text-[var(--text-secondary)] select-all break-all"
          >
            {initialPayload}
          </div>
        </div>
      </div>

      <!-- Action Buttons -->
      <div class="mt-6 space-y-3">
        <div
          data-copy-feedback
          class="hidden rounded-[var(--radius-button)] bg-emerald-500/10 px-3 py-2 text-center text-xs font-semibold text-emerald-600 dark:text-emerald-400"
          aria-live="polite"
        >
          ✓ Đã sao chép vào bộ nhớ tạm!
        </div>

        <button
          type="button"
          data-copy-zalo
          class="flex min-h-11 w-full cursor-pointer items-center justify-center gap-2 rounded-[var(--radius-button)] bg-[var(--action-primary)] px-4 py-2.5 text-sm font-semibold text-white transition-opacity hover:opacity-95 active:scale-[0.98]"
        >
          <span>Sao chép hóa đơn gửi Zalo</span>
        </button>

        <button
          type="button"
          data-copy-payload
          class="flex min-h-11 w-full cursor-pointer items-center justify-center gap-2 rounded-[var(--radius-button)] border border-[var(--border-subtle)] bg-[var(--surface-raised)] px-4 py-2.5 text-sm font-semibold text-[var(--text-primary)] transition-colors hover:bg-[var(--surface-subtle)] active:scale-[0.98]"
        >
          <span>Sao chép mã VietQR</span>
        </button>
      </div>
    </div>
  </div>
</section>

<script>
  import { generateVietQRPayload } from "@/lib/vietqr";
  import { renderQRSVG } from "@/lib/qrcode";

  function initVietQRCalculator() {
    const root = document.querySelector("[data-vietqr-calculator]");
    if (!root) return;

    const roomInput = root.querySelector<HTMLInputElement>("[data-input-room]");
    const rentInput = root.querySelector<HTMLInputElement>("[data-input-rent]");
    const elecOldInput = root.querySelector<HTMLInputElement>(
      "[data-input-elec-old]",
    );
    const elecNewInput = root.querySelector<HTMLInputElement>(
      "[data-input-elec-new]",
    );
    const elecRateInput = root.querySelector<HTMLInputElement>(
      "[data-input-elec-rate]",
    );
    const waterUsageInput = root.querySelector<HTMLInputElement>(
      "[data-input-water-usage]",
    );
    const waterRateInput = root.querySelector<HTMLInputElement>(
      "[data-input-water-rate]",
    );
    const serviceInput = root.querySelector<HTMLInputElement>(
      "[data-input-service]",
    );
    const bankSelect =
      root.querySelector<HTMLSelectElement>("[data-select-bank]");
    const accountInput = root.querySelector<HTMLInputElement>(
      "[data-input-account]",
    );

    const dispRent = root.querySelector("[data-disp-rent]");
    const dispElec = root.querySelector("[data-disp-elec]");
    const dispElecUsage = root.querySelector("[data-disp-elec-usage]");
    const dispWater = root.querySelector("[data-disp-water]");
    const dispWaterUsage = root.querySelector("[data-disp-water-usage]");
    const dispService = root.querySelector("[data-disp-service]");
    const dispTotal = root.querySelector("[data-total-amount]");
    const qrContainer = root.querySelector("[data-qr-container]");
    const payloadContainer = root.querySelector("[data-vietqr-payload]");

    const copyZaloBtn =
      root.querySelector<HTMLButtonElement>("[data-copy-zalo]");
    const copyPayloadBtn = root.querySelector<HTMLButtonElement>(
      "[data-copy-payload]",
    );
    const feedbackToast = root.querySelector("[data-copy-feedback]");

    function formatVND(n: number) {
      return n.toLocaleString("vi-VN") + " đ";
    }

    let currentPayload = "";
    let currentTotal = 0;

    function recalculate() {
      const room = roomInput?.value.trim() || "Phòng";
      const rent = Math.max(0, parseInt(rentInput?.value || "0", 10) || 0);
      const elecOld = Math.max(
        0,
        parseInt(elecOldInput?.value || "0", 10) || 0,
      );
      const elecNew = Math.max(
        0,
        parseInt(elecNewInput?.value || "0", 10) || 0,
      );
      const elecRate = Math.max(
        0,
        parseInt(elecRateInput?.value || "0", 10) || 0,
      );
      const waterUsage = Math.max(
        0,
        parseInt(waterUsageInput?.value || "0", 10) || 0,
      );
      const waterRate = Math.max(
        0,
        parseInt(waterRateInput?.value || "0", 10) || 0,
      );
      const service = Math.max(
        0,
        parseInt(serviceInput?.value || "0", 10) || 0,
      );
      const bankBin = bankSelect?.value || "970422";
      const account = accountInput?.value.trim() || "0901234567";

      const elecUsage = Math.max(0, elecNew - elecOld);
      const elecCost = elecUsage * elecRate;
      const waterCost = waterUsage * waterRate;
      currentTotal = rent + elecCost + waterCost + service;

      if (dispRent) dispRent.textContent = formatVND(rent);
      if (dispElec) dispElec.textContent = formatVND(elecCost);
      if (dispElecUsage) dispElecUsage.textContent = String(elecUsage);
      if (dispWater) dispWater.textContent = formatVND(waterCost);
      if (dispWaterUsage) dispWaterUsage.textContent = String(waterUsage);
      if (dispService) dispService.textContent = formatVND(service);
      if (dispTotal) dispTotal.textContent = formatVND(currentTotal);

      const purpose = `TIEN ${room.toUpperCase()}`;
      try {
        currentPayload = generateVietQRPayload({
          bankBin,
          accountNumber: account,
          amount: currentTotal,
          purpose,
        });

        if (payloadContainer) {
          payloadContainer.textContent = currentPayload;
        }

        if (qrContainer) {
          qrContainer.innerHTML = renderQRSVG(currentPayload, {
            size: 240,
            margin: 2,
            alt: `Mã VietQR ${room}`,
          });
        }
      } catch (err) {
        console.error("VietQR generation error:", err);
      }
    }

    const inputs = [
      roomInput,
      rentInput,
      elecOldInput,
      elecNewInput,
      elecRateInput,
      waterUsageInput,
      waterRateInput,
      serviceInput,
      bankSelect,
      accountInput,
    ];

    inputs.forEach((input) => {
      input?.addEventListener("input", recalculate);
      input?.addEventListener("change", recalculate);
    });

    recalculate();

    function showFeedback(text: string) {
      if (!feedbackToast) return;
      feedbackToast.textContent = text;
      feedbackToast.classList.remove("hidden");
      setTimeout(() => {
        feedbackToast.classList.add("hidden");
      }, 3000);
    }

    copyPayloadBtn?.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(currentPayload);
        showFeedback("✓ Đã sao chép mã VietQR!");
      } catch {
        showFeedback("✓ Vui lòng sao chép thủ công từ khung mã.");
      }
    });

    copyZaloBtn?.addEventListener("click", async () => {
      const room = roomInput?.value.trim() || "Phòng";
      const rent = parseInt(rentInput?.value || "0", 10) || 0;
      const elecOld = parseInt(elecOldInput?.value || "0", 10) || 0;
      const elecNew = parseInt(elecNewInput?.value || "0", 10) || 0;
      const elecRate = parseInt(elecRateInput?.value || "0", 10) || 0;
      const waterUsage = parseInt(waterUsageInput?.value || "0", 10) || 0;
      const waterRate = parseInt(waterRateInput?.value || "0", 10) || 0;
      const service = parseInt(serviceInput?.value || "0", 10) || 0;
      const bankName = bankSelect?.selectedOptions[0]?.text || "Ngân hàng";
      const account = accountInput?.value.trim() || "";

      const elecUsage = Math.max(0, elecNew - elecOld);
      const elecCost = elecUsage * elecRate;
      const waterCost = waterUsage * waterRate;

      const message = [
        `PHIẾU BÁO TIỀN PHÒNG - ${room.toUpperCase()}`,
        `-----------------------------`,
        `- Tiền phòng: ${formatVND(rent)}`,
        `- Tiền điện: ${elecUsage} kWh (${elecOld} -> ${elecNew}) x ${formatVND(elecRate)} = ${formatVND(elecCost)}`,
        `- Tiền nước: ${waterUsage} m³ x ${formatVND(waterRate)} = ${formatVND(waterCost)}`,
        `- Phí dịch vụ: ${formatVND(service)}`,
        `-----------------------------`,
        `TỔNG CỘNG: ${formatVND(currentTotal)}`,
        ``,
        `THÔNG TIN CHUYỂN KHOẢN:`,
        `- Ngân hàng: ${bankName}`,
        `- Số tài khoản: ${account}`,
        `- Nội dung: TIEN ${room.toUpperCase()}`,
        `(Quét mã VietQR trên phiếu để chuyển khoản nhanh)`,
      ].join("\n");

      try {
        await navigator.clipboard.writeText(message);
        showFeedback("✓ Đã sao chép hóa đơn gửi Zalo!");
      } catch {
        showFeedback("✓ Vui lòng sao chép thông tin chi tiết.");
      }
    });
  }

  // Support both normal load and client-side transitions
  initVietQRCalculator();
  document.addEventListener("astro:page-load", initVietQRCalculator);
</script>
