---
import type { CollectionEntry } from "astro:content";
import ProductStatus from "@/components/product/ProductStatus.astro";
import { SHARED_LABELS, labelFor, type Language } from "@/data/site";
import { getProductProfilePath } from "@/lib/product-routes";
import { productTransitionStyle } from "@/lib/product-transition";

interface Props {
  product: CollectionEntry<"products">;
  lang: Language;
  emphasis?: "default" | "hero";
}

const { product, lang, emphasis = "default" } = Astro.props;
const { data } = product;
const profileHref = getProductProfilePath(lang, data.slug);
const profileLabel = labelFor(SHARED_LABELS.viewProfile, lang);
---

<article
  data-product-card
  data-product-tier={data.featuredTier}
  class:list={[
    "rounded-[var(--radius-card)] border border-[var(--border-subtle)] bg-white p-6 transition-[transform,box-shadow,border-color] duration-200 ease-[var(--motion-ease-standard)] hover:-translate-y-0.5 hover:border-[color-mix(in_srgb,var(--brand-cobalt)_38%,var(--border-subtle))] hover:shadow-[0_18px_44px_-14px_color-mix(in_srgb,var(--brand-cobalt)_30%,transparent)] motion-reduce:transition-none motion-reduce:hover:translate-y-0 motion-reduce:hover:shadow-none",
    emphasis === "hero" && "md:p-8",
  ]}
>
  <ProductStatus label={data.publicLabel} />
  <h3
    class:list={[
      "mt-3 font-semibold tracking-tight text-[var(--text-primary)]",
      emphasis === "hero" ? "text-2xl sm:text-3xl" : "text-xl",
    ]}
  >
    <a
      href={profileHref}
      class="text-inherit no-underline hover:underline"
      data-product-continuity="card"
      style={productTransitionStyle("card", data.slug)}
    >
      {data.name}
    </a>
  </h3>
  <p class="mt-3 text-[var(--text-secondary)]">{data.shortDescription}</p>
  <p class="mt-4 text-xs font-medium tracking-wide text-[var(--text-muted)]">
    {data.endorsement}
  </p>
  <div class="mt-5 flex flex-wrap items-center gap-4">
    <a
      href={profileHref}
      class="inline-flex min-h-11 items-center text-sm font-semibold text-[var(--action-primary)] no-underline hover:underline"
    >
      {profileLabel}
    </a>
    <a
      href={data.primaryAction.href}
      rel={/^https?:\/\//i.test(data.primaryAction.href)
        ? "noopener noreferrer"
        : undefined}
      class="inline-flex min-h-11 items-center text-sm font-semibold text-[var(--text-secondary)] no-underline hover:text-[var(--text-primary)] hover:underline"
    >
      {data.primaryAction.label}
    </a>
  </div>
</article>
