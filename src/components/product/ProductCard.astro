>
  <!-- Icon + Status Badge Header -->
  <header class="flex flex-wrap items-start justify-between gap-3">
    <div class="relative flex-shrink-0">
      <!-- Squircle icon container with ambient drop-shadow -->
      <div
        class="size-12 sm:size-14 rounded-[1.25rem] overflow-hidden bg-white/5 backdrop-blur-sm shadow-[0_8px_24px_-6px_rgba(11,16,32,0.35)] ring-1 ring-inset ring-white/5"
        aria-hidden="true"
      >
        <img
          src={iconHref}
          alt=""
          class="w-full h-full object-cover"
          loading="lazy"
          decoding="async"
        />
        <!-- Subtle ambient glow matched to brand cobalt -->
        <div
          class="absolute inset-0 bg-gradient-to-br from-[color-mix(in_srgb,var(--brand-cobalt)_18%,transparent)] to-transparent pointer-events-none"
          aria-hidden="true"
        />
      </div>
    </div>

    <!-- Horological status badge with subtle live pulse -->
    <span
      data-product-status={data.publicLabel}
      class="inline-flex max-w-full min-w-0 items-center gap-1.5 rounded-[var(--radius-card)] border border-[var(--border-subtle)] px-2.5 py-1 text-xs font-semibold tracking-wide text-[var(--action-primary)] [overflow-wrap:anywhere] sm:px-3"
    >
      {data.publicLabel}
    </span>
  </header>

  <!-- Product Name + Tagline -->
  <div class="mt-4 min-w-0">
    <h3
      class:list={[
        "font-semibold tracking-[-0.02em] leading-tight text-[var(--text-primary)]",
        emphasis === "hero" ? "text-2xl sm:text-3xl" : "text-xl",
      ]}
    >
      <a
        href={profileHref}
        class="inline-flex min-h-11 max-w-full min-w-0 items-center text-inherit no-underline [overflow-wrap:anywhere] hover:underline"
        data-product-continuity="card"
        style={productTransitionStyle("card", data.slug)}
      >
        {data.name}
      </a>
    </h3>
    <p class="mt-2 text-sm leading-relaxed text-[var(--brand-slate-650)] min-w-0 [overflow-wrap:anywhere]">
      {data.shortDescription}
    </p>
  </div>

  <!-- Platform Chips (only platforms the record actually declares) -->
  <div
    class="mt-4 flex flex-wrap items-center gap-2"
    aria-label={labelFor(SHARED_LABELS.platforms, lang)}
  >
    {data.platforms?.map((platform: string) => (
      <span class="inline-flex max-w-full min-w-0 items-center gap-1.5 rounded-full border border-[var(--border-subtle)] bg-[var(--surface-subtle)] px-2.5 py-0.5 text-xs font-medium text-[var(--text-secondary)] [overflow-wrap:anywhere]">
        {platformLabels[platform] ?? platform}
      </span>
    ))}
  </div>

  <!-- Micro-tick Action Links -->
  <div class="mt-5 flex flex-wrap items-center gap-3">
    <a
      href={profileHref}
      class="inline-flex min-h-11 max-w-full min-w-0 items-center gap-1.5 rounded-full border border-[var(--border-subtle)] bg-transparent px-3 py-1.5 text-sm font-semibold text-[var(--action-primary)] no-underline [overflow-wrap:anywhere] hover:bg-[color-mix(in_srgb,var(--action-primary)_8%,transparent)] hover:border-[var(--action-primary)] active:scale-[0.98] transition-[transform,border-color,background-color] duration-100 ease-[var(--motion-ease-standard)]"
    >
      <span
        aria-hidden="true"
        class="size-1.5 shrink-0 rounded-full bg-current opacity-60"
      />
      {profileLabel}
    </a>

    <a
      href={data.primaryAction.href}
      rel={
        /^https?:\/\//i.test(data.primaryAction.href)
          ? "noopener noreferrer"
          : undefined
      }
      class="inline-flex min-h-11 max-w-full min-w-0 items-center gap-1.5 rounded-full border border-[var(--border-subtle)] bg-transparent px-3 py-1.5 text-sm font-semibold text-[var(--text-secondary)] no-underline [overflow-wrap:anywhere] hover:text-[var(--text-primary)] hover:border-[var(--text-secondary)] active:scale-[0.98] transition-[transform,border-color,color] duration-100 ease-[var(--motion-ease-standard)]"
    >
      <span
        aria-hidden="true"
        class="size-1.5 shrink-0 rounded-full border border-current opacity-40"
      />
      {data.primaryAction.label}
    </a>

    {data.secondaryAction && (
      <a
        href={data.secondaryAction.href}
        rel={
          /^https?:\/\//i.test(data.secondaryAction.href)
            ? "noopener noreferrer"
            : undefined
        }
        class="inline-flex min-h-11 max-w-full min-w-0 items-center gap-1.5 rounded-full border border-[var(--border-subtle)] bg-transparent px-3 py-1.5 text-sm font-medium text-[var(--text-muted)] no-underline [overflow-wrap:anywhere] hover:text-[var(--text-secondary)] hover:border-[var(--text-muted)] active:scale-[0.98] transition-[transform,border-color,color] duration-100 ease-[var(--motion-ease-standard)]"
      >
        <span
          aria-hidden="true"
          class="size-1.5 shrink-0 rounded-full border border-current opacity-30"
        />
        {data.secondaryAction.label}
      </a>
    )}
  </div>
</article>
