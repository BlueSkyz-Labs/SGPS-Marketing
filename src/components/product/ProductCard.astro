---
import type { CollectionEntry } from "astro:content";
import { SHARED_LABELS, labelFor, type Language } from "@/data/site";
import {
  getProductProfilePath,
  getProductIconPath,
} from "@/lib/product-routes";
import { productTransitionStyle } from "@/lib/product-transition";

interface Props {
  product: CollectionEntry<"products">;
  lang: Language;
  emphasis?: "default" | "hero";
}

const { product, lang, emphasis = "default" } = Astro.props;
const { data } = product;
const profileHref = getProductProfilePath(lang, data.slug);
const profileLabel = labelFor(SHARED_LABELS.viewProfile, lang);
const iconHref = getProductIconPath(data.slug);

// Platform label mapping for display
const platformLabels: Record<string, string> = {
  web: "Web",
  ios: "iOS",
  android: "Android",
  "browser-extension": "Extension",
  macos: "macOS",
  windows: "Windows",
  api: "API",
};
---

<article
  data-product-card
  data-product-tier={data.featuredTier}
