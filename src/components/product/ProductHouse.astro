---
import type { CollectionEntry } from "astro:content";
import { SHARED_LABELS, labelFor, type Language } from "@/data/site";
import { getProductIndexPath } from "@/lib/product-routes";
import {
  getProductIconThumbPath,
  getProductProfilePath,
} from "@/lib/product-routes";
import { productCopy } from "@/lib/product-copy";
import { resolveLifecycleCta } from "@/lib/lifecycle-cta";
import { HOME_ONE_LINER } from "@/data/home-copy";
import ProductCard from "./ProductCard.astro";
import ProofFirstEmptyState from "./ProofFirstEmptyState.astro";

/**
 * C2 Act II — Product House.
 * Editorial hierarchy over the existing public product collection: one hero,
 * up to two featured, then ecosystem. No second registry, no invented product:
 * hierarchy derives only from `featuredTier` metadata that the record owns.
 * With an empty registry the act renders the repository's honest
 * proof-first statement instead of a fabricated card grid.
 */
interface Props {
  products: CollectionEntry<"products">[];
  lang: Language;
  /** The Flagship Theatre already presents the hero above this section. */
  mode?: "house" | "continuation";
  /** Experience v6 S1: heading + cards only (no body line, no index button). */
  compact?: boolean;
}

const { products, lang, mode = "house", compact = false } = Astro.props;

const flagship = products.find(
  (product) => product.data.featuredTier === "hero",
);
const isContinuation = mode === "continuation" && Boolean(flagship);
const visibleProducts = isContinuation
  ? products.filter((product) => product.data.slug !== flagship?.data.slug)
  : products;

if (isContinuation && visibleProducts.length === 0) {
  return null;
}

const hero = isContinuation ? undefined : flagship;
const featured = visibleProducts
  .filter((product) => product.data.featuredTier === "featured")
  .slice(0, 2);
const ecosystem = visibleProducts.filter(
  (product) => product.data.featuredTier === "ecosystem",
);

const headingLabel = labelFor(
  isContinuation
    ? SHARED_LABELS.continuationHeading
    : SHARED_LABELS.featuredHeading,
  lang,
);
const ctaLabel = labelFor(SHARED_LABELS.exploreAllProducts, lang);
const indexPath = getProductIndexPath(lang);
// v8 W2: on the home the continuation is one full-width horizontal row per
// product: icon, name, badge, one-liner (deck hom-14) and the lifecycle CTA.
const rows = (compact && isContinuation ? visibleProducts : []).map(
  (product) => {
    const copy = productCopy(product.data, lang);
    const slug = product.data.slug;
    return {
      product,
      statusLabel: copy.statusLabel,
      line: HOME_ONE_LINER[slug]?.[lang] ?? copy.shortDescription,
      href: getProductProfilePath(lang, slug),
      icon: getProductIconThumbPath(slug),
      cta: resolveLifecycleCta(
        {
          slug,
          lifecycle: product.data.lifecycle,
          availability: product.data.availability,
          primaryActionHref: product.data.primaryAction.href,
          productName: product.data.name,
        },
        lang,
      ),
    };
  },
);
---

<section
  class:list={[
    "c2-product-house border-b border-[var(--border-subtle)]",
    compact ? "py-10 lg:py-12" : "py-16 lg:py-24",
  ]}
  aria-labelledby="product-house-title"
  data-product-house
>
  <div class="product-act-intro flex flex-wrap items-end justify-between gap-4">
    <div class="product-act-intro__copy">
      <h2 id="product-house-title" class="type-d2 product-act-intro__title">
        {headingLabel}
      </h2>
    </div>
    {products.length > 0 && !compact ? (
      <a
        href={indexPath}
        class="inline-flex min-h-11 items-center rounded-[var(--radius-sm)] border border-[var(--border-subtle)] px-5 py-2.5 font-medium text-[var(--text-primary)] no-underline hover:bg-[var(--bg-subtle)]"
      >
        {ctaLabel}
      </a>
    ) : null}
  </div>

  {products.length === 0 ? (
    <div class="mt-8">
      <ProofFirstEmptyState lang={lang} />
    </div>
  ) : rows.length > 0 ? (
    <div class="mt-6 grid gap-4">
      {rows.map((row) => (
        <article
          class="product-row"
          data-product-card
          data-product-tier={row.product.data.featuredTier}
        >
          <img
            class="product-row__icon"
            src={row.icon}
            alt=""
            width="48"
            height="48"
            loading="lazy"
            decoding="async"
          />
          <div class="product-row__main">
            <h3 class="product-row__name">
              <a
                href={row.href}
                class="inline-flex min-h-11 items-center text-inherit no-underline hover:underline"
              >
                {row.product.data.name}
              </a>
              <span
                data-product-status={row.product.data.publicLabel}
                class="product-row__badge"
              >
                {row.statusLabel}
              </span>
            </h3>
            <p class="product-row__line">{row.line}</p>
          </div>
          <a
            href={row.cta.href}
            data-product-cta={row.cta.verb}
            aria-label={`${row.cta.label}: ${row.product.data.name}`}
            class="product-row__cta"
          >
            {row.cta.label}
          </a>
        </article>
      ))}
    </div>
  ) : (
    <div class="mt-10 grid gap-6">
      {hero ? (
        <div class="break-words min-w-0">
          <ProductCard product={hero} lang={lang} emphasis="hero" />
        </div>
      ) : null}
      {featured.length > 0 || ecosystem.length > 0 ? (
        <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
          {[...featured, ...ecosystem].map((product) => (
            <div class="break-words min-w-0">
              <ProductCard product={product} lang={lang} />
            </div>
          ))}
        </div>
      ) : null}
    </div>
  )}
</section>

<style>
  .product-row {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    min-width: 0;
    align-items: center;
    gap: 0.75rem 1rem;
    padding: 1rem;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-card);
    background: var(--surface-raised);
  }
  .product-row__main {
    min-width: 0;
  }
  .product-row__icon {
    width: 3rem;
    height: 3rem;
    border-radius: var(--radius-card);
  }
  .product-row__name {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem 0.75rem;
    margin: 0;
    font-size: var(--size-5);
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--text-primary);
  }
  .product-row__badge {
    display: inline-flex;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-pill);
    max-width: 100%;
    min-width: 0;
    overflow-wrap: anywhere;
    padding: 0.125rem 0.625rem;
    font-size: var(--size-1);
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--action-primary);
  }
  .product-row__line {
    margin: 0.25rem 0 0;
    font-size: var(--size-2);
    line-height: 1.5;
    color: var(--text-secondary);
  }
  .product-row__cta {
    grid-column: 1 / -1;
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-pill);
    padding: 0.375rem 1rem;
    font-size: var(--size-2);
    font-weight: 600;
    color: var(--action-primary);
    text-decoration: none;
  }
  .product-row__cta:hover {
    border-color: var(--action-primary);
  }
  @media (min-width: 768px) {
    .product-row {
      grid-template-columns: auto minmax(0, 1fr) auto;
      padding: 1.25rem 1.5rem;
    }
    .product-row__cta {
      grid-column: auto;
    }
  }
</style>
