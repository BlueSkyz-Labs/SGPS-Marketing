---
import type { Language } from "@/data/site";
import type { ProductEntry } from "@/lib/products";

/**
 * Owner 2026-09-28 — "Truy cập ứng dụng": a direct sign-in link to the running
 * web app and the native Android/iOS apps shown honestly as in development.
 * Static, no client script. The sign-in button renders only when the record
 * carries an Owner-supplied `appAccess.signInUrl`; a native app links to a
 * store only when it is `available` with a store URL (schema-enforced).
 */
interface Props {
  appAccess: ProductEntry["data"]["appAccess"];
  productName: string;
  lang: Language;
  showSignIn?: boolean;
}

const { appAccess, productName, lang, showSignIn = true } = Astro.props;

const LABELS = {
  heading: {
    en: "Access",
    vi: "Truy cập",
    zh: "访问入口",
    "zh-hant": "存取方式",
  },
  signIn: { en: "Sign in", vi: "Đăng nhập", zh: "登录", "zh-hant": "登入" },
  signInHint: {
    en: "Opens the web app sign-in page",
    vi: "Mở thẳng trang đăng nhập của ứng dụng web",
    zh: "直接打开网页应用的登录页面",
    "zh-hant": "直接開啟網頁應用程式的登入頁面",
  },
  inDevelopment: {
    en: "In development",
    vi: "Đang phát triển",
    zh: "开发中",
    "zh-hant": "開發中",
  },
  getOn: { en: "Get it on", vi: "Tải trên", zh: "下载于", "zh-hant": "下載於" },
} as const;

const STORES = [
  { key: "android", name: "Android", store: "Google Play" },
  { key: "ios", name: "iOS", store: "App Store" },
] as const;

const signInUrl = showSignIn ? appAccess?.signInUrl : undefined;
const apps = STORES.flatMap((s) => {
  const app = appAccess?.[s.key];
  return app ? [{ ...s, app }] : [];
});
const headingId = "profile-app-access";
---

{signInUrl || apps.length > 0 ? (
  <section class="app-access mt-10" aria-labelledby={headingId} data-app-access>
    <h2
      id={headingId}
      class="text-xl font-semibold tracking-tight text-[var(--text-primary)]"
    >
      {LABELS.heading[lang]}
    </h2>
    <div class="app-access__row mt-4">
      {signInUrl ? (
        <a
          class="app-access__signin"
          href={signInUrl}
          rel="noopener noreferrer"
          data-app-signin
        >
          <span>
            {LABELS.signIn[lang]} · {productName}
          </span>
          <span class="app-access__hint">{LABELS.signInHint[lang]}</span>
        </a>
      ) : null}
      {apps.map(({ key, name, store, app }) =>
        app.state === "available" && app.storeUrl ? (
          <a
            class="app-access__store"
            href={app.storeUrl}
            rel="noopener noreferrer"
            data-mobile-app={key}
            data-mobile-state="available"
          >
            <span class="app-access__platform">{name}</span>
            <span class="app-access__hint">
              {LABELS.getOn[lang]} {store}
            </span>
          </a>
        ) : (
          <p
            class="app-access__store app-access__store--pending"
            data-mobile-app={key}
            data-mobile-state="in-development"
          >
            <span class="app-access__platform">{name}</span>
            <span class="app-access__hint">{LABELS.inDevelopment[lang]}</span>
          </p>
        ),
      )}
    </div>
  </section>
) : null}

<style>
  .app-access__row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .app-access__signin,
  .app-access__store {
    display: inline-flex;
    min-height: 2.75rem;
    flex-direction: column;
    justify-content: center;
    border-radius: var(--radius-card);
    border: 1px solid var(--border-subtle);
    background: var(--surface-raised);
    padding: 0.625rem 1.125rem;
    color: var(--text-primary);
    font-size: 0.9375rem;
    font-weight: 600;
    line-height: 1.3;
    text-decoration: none;
  }
  .app-access__signin {
    border-color: transparent;
    background: var(--brand-cobalt);
    color: #ffffff;
  }
  .app-access__signin .app-access__hint {
    color: color-mix(in srgb, #ffffff 82%, transparent);
  }
  .app-access__signin:focus-visible,
  .app-access__store:focus-visible {
    outline: 2px solid var(--brand-cobalt);
    outline-offset: 2px;
  }
  .app-access__store--pending {
    margin: 0;
    border-style: dashed;
  }
  .app-access__hint {
    color: var(--text-muted);
    font-size: 0.75rem;
    font-weight: 500;
  }
  @media (forced-colors: active) {
    .app-access__signin,
    .app-access__store {
      border: 1px solid CanvasText;
    }
  }
</style>
