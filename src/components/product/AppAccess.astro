---
import type { Language } from "@/data/site";
import type { ProductEntry } from "@/lib/products";
import { AVAILABILITY } from "./product-page-copy";

/**
 * v8 W3: one "Availability" line replaces the separate Access, Current stage,
 * Platforms and Audience blocks. An in-development native app is plain text
 * with no store link; a store link renders only for an app that is
 * `available` with a store URL (schema-enforced). Static, no client script.
 * The sign-in link is a plain text link rendered by the page.
 */
interface Props {
  appAccess: ProductEntry["data"]["appAccess"];
  lang: Language;
  /** The record lists the web platform. */
  web?: boolean;
}

const { appAccess, lang, web = true } = Astro.props;
const A = AVAILABILITY;

const STORES = [
  { key: "android", name: "Android", store: "Google Play" },
  { key: "ios", name: "iOS", store: "App Store" },
] as const;
const apps = STORES.flatMap((s) => {
  const app = appAccess?.[s.key];
  return app ? [{ ...s, app }] : [];
});
const live = apps.filter((a) => a.app.state === "available" && a.app.storeUrl);
const pending = apps.filter((a) => !live.includes(a));
const nativeName =
  pending.length === STORES.length
    ? A.native[lang]
    : pending.map((a) => a.name).join(" · ");
const colon = A.colon[lang];
---

{web || apps.length > 0 ? (
  <p
    class="app-access mt-5 text-sm leading-relaxed text-[var(--text-secondary)]"
    data-app-access
  >
    {web ? (
      <span>
        {A.web[lang]}
        {colon}
        {A.inDevelopment[lang]}
      </span>
    ) : null}
    {pending.length > 0 ? (
      <>
        {web ? <span aria-hidden="true"> · </span> : null}
        <span data-mobile-state="in-development">
          {nativeName}
          {colon}
          {A.inDevelopment[lang]}, {A.noStore[lang]}
        </span>
      </>
    ) : null}
    {live.map(({ key, name, store, app }) => (
      <>
        <span aria-hidden="true"> · </span>
        <a
          href={app.storeUrl}
          rel="noopener noreferrer"
          data-mobile-app={key}
          data-mobile-state="available"
        >
          {name} · {store}
        </a>
      </>
    ))}
  </p>
) : null}
