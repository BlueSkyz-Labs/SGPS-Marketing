---
import type { CollectionEntry } from "astro:content";
import type { Language } from "@/lib/i18n";
import type { ShowcaseSchema } from "@/lib/showcase-schema";
import { getShowcase } from "@/lib/showcases";
import { resolveFeatureStory, sentenceCase } from "@/lib/feature-story";
import { productCopy } from "@/lib/product-copy";
import { getProductProfilePath } from "@/lib/product-routes";
import {
  STORY_COPY,
  phoneSmallSrc,
  phoneTinySrc,
} from "@/components/product/story-copy";

/**
 * v12 S1 home teaser: the first three chapters of the flagship's Feature
 * Story, linking into the story on the product page. Renders nothing without
 * a flagship or without a recorded story. Every heading and line is the
 * showcase record's screen title and caption.
 *
 * The hero stays the LCP: this section sits two acts below it, its images are
 * lazy with intrinsic width/height (no CLS), and no client script is shipped.
 * Where scroll-driven animations exist and motion is allowed, the three
 * phones open out of one stacked hand (shared `stage-fan` / `stage-caption`
 * grammar in reveal.css); the CSS default is the final row.
 * Guard: tests/architecture/feature-story.test.mjs.
 */
interface Props {
  product: CollectionEntry<"products"> | null;
  lang: Language;
}

const { product, lang } = Astro.props;
const showcase: ShowcaseSchema | null = product
  ? ((await getShowcase(product.data.slug))?.data ?? null)
  : null;
const story =
  product && showcase?.story
    ? resolveFeatureStory(
        showcase.story,
        showcase.screens,
        productCopy(product.data, lang),
      )
    : null;
const chapters = story ? story.chapters.slice(0, 3) : [];
const t = STORY_COPY[lang];
const href = product
  ? `${getProductProfilePath(lang, product.data.slug)}#profile-showcase`
  : "";
// Phones render at most 13rem (row of three) and 7.5rem (phone list).
const SIZES = "(min-width: 48rem) 13rem, min(7.5rem, 30vw)";
---

{product && chapters.length === 3 ? (
  <section
    class="story-teaser border-b border-[var(--border-subtle)] py-14 lg:py-20"
    aria-labelledby="story-teaser-title"
    data-story-teaser
  >
    <h2 id="story-teaser-title" class="type-d2 text-[var(--text-primary)]">
      {t.title(product.data.name)}
    </h2>
    <p class="story-teaser__lead">{t.lead}</p>
    <ol class="story-teaser__row" role="list">
      {chapters.map(({ screen }, index) => (
        <li class="story-teaser__item" data-story-teaser-chapter={screen.id}>
          <figure class="story-teaser__device">
            <img
              src={phoneTinySrc(screen.src)}
              srcset={`${phoneTinySrc(screen.src)} 240w, ${phoneSmallSrc(screen.src)} 480w, ${screen.src} ${screen.width}w`}
              sizes={SIZES}
              alt={screen.alt[lang]}
              width={screen.width}
              height={screen.height}
              loading="lazy"
              decoding="async"
            />
          </figure>
          <div class="story-teaser__text">
            <p class="story-teaser__index" aria-hidden="true">
              {String(index + 1).padStart(2, "0")}
            </p>
            <h3 class="story-teaser__title">{screen.title[lang]}</h3>
            <p class="story-teaser__line">
              {sentenceCase(screen.caption[lang], lang)}
            </p>
          </div>
        </li>
      ))}
    </ol>
    <p class="story-teaser__more">
      <a href={href} class="story-teaser__link" data-story-teaser-link>
        {t.teaserLink}
        <span aria-hidden="true">→</span>
      </a>
    </p>
  </section>
) : null}

<style is:global>
  .story-teaser__lead {
    margin: 1rem 0 0;
    max-width: 40rem;
    font-size: var(--size-5);
    line-height: 1.55;
    color: var(--text-secondary);
  }
  .story-teaser__row {
    display: grid;
    gap: 1.75rem;
    margin: 2.5rem 0 0;
    padding: 0;
    list-style: none;
  }
  .story-teaser__item {
    display: grid;
    grid-template-columns: min(7.5rem, 32%) minmax(0, 1fr);
    gap: 1.25rem;
    align-items: center;
    min-width: 0;
  }
  .story-teaser__device {
    margin: 0;
    padding: 0.375rem;
    border-radius: var(--radius-media);
    border: 1px solid var(--border-subtle);
    background: linear-gradient(
      160deg,
      color-mix(in srgb, var(--text-primary) 16%, transparent),
      color-mix(in srgb, var(--text-primary) 6%, transparent)
    );
    box-shadow:
      0 1px 0 color-mix(in srgb, white 30%, transparent) inset,
      0 28px 48px -28px color-mix(in srgb, #0b1020 55%, transparent);
  }
  .story-teaser__device img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--radius-card);
  }
  .story-teaser__text {
    min-width: 0;
  }
  .story-teaser__index {
    margin: 0;
    font-size: var(--size-2);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.06em;
    color: var(--action-primary);
  }
  .story-teaser__title {
    margin: 0.25rem 0 0;
    font-size: var(--size-5);
    font-weight: 600;
    line-height: 1.3;
    color: var(--text-primary);
  }
  .story-teaser__line {
    margin: 0.375rem 0 0;
    font-size: var(--size-3);
    line-height: 1.55;
    color: var(--text-secondary);
  }
  .story-teaser__more {
    margin: 2.5rem 0 0;
  }
  .story-teaser__link {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    gap: 0.5rem;
    font-size: var(--size-3);
    font-weight: 600;
    color: var(--action-primary);
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }
  .story-teaser__link:focus-visible {
    outline: 2px solid var(--brand-cobalt, #2564ff);
    outline-offset: 3px;
  }
  @media (min-width: 48rem) {
    .story-teaser__row {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 2.5rem;
    }
    .story-teaser__item {
      grid-template-columns: none;
      justify-items: center;
      align-items: start;
      /* Rows hug their content: a shorter caption must not stretch the
         phone row and push its text lower than its neighbours'. */
      align-content: start;
      text-align: center;
    }
    .story-teaser__device {
      width: min(100%, 13rem);
    }
  }

  /* Stage: the three phones open out of one stacked hand (outer phones tucked
     behind the centre one, tilted) as the row scrolls in; captions fade in
     once the hand has opened. Default (no support, reduced motion, forced
     colors, no JS) is the final row. */
  @media (min-width: 64rem) and (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .story-teaser__row > .story-teaser__item {
        animation: stage-fan linear both;
        animation-timeline: view();
        animation-range: entry 10% cover 40%;
      }
      .story-teaser__row > .story-teaser__item:nth-child(2) {
        position: relative;
        z-index: 1;
      }
      .story-teaser__row > .story-teaser__item:nth-child(1) {
        --stack-x: calc(85% + 2.5rem);
        --stack-r: -7deg;
      }
      .story-teaser__row > .story-teaser__item:nth-child(3) {
        --stack-x: calc(-85% - 2.5rem);
        --stack-r: 7deg;
      }
      .story-teaser__row > .story-teaser__item .story-teaser__text {
        animation: stage-caption linear both;
        animation-timeline: view();
        /* The text's own timeline: it reaches cover 10-22% just as the hand
           above it has opened (the item's cover 40%). */
        animation-range: cover 10% cover 22%;
      }
    }
  }
  @media (forced-colors: active) {
    .story-teaser__row > .story-teaser__item,
    .story-teaser__row > .story-teaser__item .story-teaser__text {
      animation: none;
    }
  }
</style>
