---
import type { CollectionEntry } from "astro:content";
import { SHARED_LABELS, labelFor, type Language } from "@/data/site";
import { getProductProfilePath } from "@/lib/product-routes";
import ProductStatus from "@/components/product/ProductStatus.astro";
import ProductVisual from "@/components/product/ProductVisual.astro";
import ProductProofLink from "@/components/integrity/ProductProofLink.astro";
import {
  getPublicClaims,
  type PublicProductRef,
  type ResolvedClaim,
} from "@/lib/claims";
import { productTransitionStyle } from "@/lib/product-transition";

/**
 * C2 Act II — Flagship Theatre.
 * Consumes exactly one real public product entry. This component defines no
 * product truth of its own: every visible fact comes from the record. With
 * `product === null` it renders nothing — the homepage falls back honestly
 * rather than fabricating a product moment.
 */
interface Props {
  product: CollectionEntry<"products"> | null;
  /** Canonical public registry refs; the proof affordance binds through them. */
  products: readonly PublicProductRef[];
  /** Already-resolved public claims. Defaults to canonical resolution from the
   * registry, which is what production always uses; a harness may pass its own
   * resolved rows (the parity fixture does) so capability binding is testable
   * while the production registry stays owner-gated and empty. */
  claims?: readonly ResolvedClaim[] | undefined;
  lang: Language;
}

const {
  product,
  products,
  claims = getPublicClaims([...products]),
  lang,
} = Astro.props;

if (!product) {
  return null;
}

const { data } = product;
const media = data.proof.media;
const capabilities = data.capabilities ?? [];
const profileHref = getProductProfilePath(lang, data.slug);
const viewProfileLabel = labelFor(SHARED_LABELS.viewProfile, lang);

/**
 * Loading decision (recorded, not guessed): the theatre sits immediately after
 * the hero, so eager above-the-fold media would compete with the hero LCP.
 * The proof media therefore stays lazy with intrinsic width/height (no CLS) and
 * opacity 1 — it is the act's visual protagonist, never faded in.
 */
---

<section
  class="c2-flagship-theatre c2-product-house border-b border-[var(--border-subtle)] py-16 lg:py-24"
  aria-labelledby="flagship-theatre-title"
  data-flagship-theatre
>
  <div class="grid gap-10 lg:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)] lg:items-center">
    <div class="c2-flagship-theatre__copy">
      <ProductStatus label={data.publicLabel} />
      <h2
        id="flagship-theatre-title"
        class="mt-3 text-3xl font-semibold tracking-tight sm:text-4xl"
      >
        {data.name}
      </h2>
      <p class="mt-4 max-w-xl text-lg text-[var(--text-secondary)]">
        {data.shortDescription}
      </p>
      {capabilities.length > 0 ? (
        <ul class="mt-6 space-y-2 text-[var(--text-secondary)]">
          {capabilities.slice(0, 3).map((capability: string) => (
            <li class="c2-flagship-theatre__capability">
              {capability}
              <ProductProofLink
                slug={data.slug}
                capability={capability}
                products={products}
                claims={claims}
                lang={lang}
              />
            </li>
          ))}
        </ul>
      ) : null}
      <div class="mt-8 flex flex-wrap items-center gap-3">
        <a
          href={data.primaryAction.href}
          class="inline-flex min-h-11 max-w-full items-center justify-center rounded-[var(--radius-sm)] bg-[var(--action-primary)] px-4 py-2.5 font-medium text-white no-underline hover:bg-[var(--action-primary-hover)] sm:px-5"
        >
          {data.primaryAction.label}
        </a>
        <a
          href={profileHref}
          class="inline-flex min-h-11 max-w-full items-center justify-center rounded-[var(--radius-sm)] border border-[var(--border-subtle)] px-4 py-2.5 font-medium text-[var(--text-primary)] no-underline hover:bg-[var(--bg-subtle)] sm:px-5"
        >
          {viewProfileLabel}
        </a>
      </div>
    </div>
    {media ? (
      <figure class="c2-flagship-theatre__frame m-0">
        <ProductVisual
          media={media}
          transitionStyle={productTransitionStyle("media", data.slug)}
          continuity="media"
        />
        <figcaption class="mt-3 text-sm text-[var(--text-muted)]">
          {labelFor(SHARED_LABELS.proofCaption, lang)}
        </figcaption>
      </figure>
    ) : null}
  </div>
</section>
