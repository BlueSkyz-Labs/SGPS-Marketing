---
import ButtonLink from "@/components/ui/ButtonLink.astro";
import { SITE, type Language } from "@/data/site";
import { emptyRegistryPrimaryCta, emptyRegistrySecondaryCta } from "@/lib/act";

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const primary = emptyRegistryPrimaryCta(SITE.contactEmail, lang);
const secondary = emptyRegistrySecondaryCta(SITE.contactEmail, lang);

const COPY = {
  heading: {
    en: "Publication requires proof",
    vi: "Công bố cần bằng chứng",
    zh: "发布须有证据",
  },
  body: {
    en: "A product appears in this registry only after its public evidence — at least one verifiable artifact such as a working build, a real screenshot, or a live destination — is ready to verify. Until then this registry stays quiet by design.",
    vi: "Sản phẩm chỉ xuất hiện trong danh mục này khi bằng chứng công khai của nó — ít nhất một hiện vật có thể xác minh như bản chạy thật, ảnh chụp thật hoặc một đích đến đang hoạt động — sẵn sàng để xác minh. Trước đó, danh mục giữ im lặng có chủ đích.",
    zh: "只有当产品的公开证据 — 至少一项可核验的凭证，例如可运行的构建、真实截图，或可访问的线上目的地 — 可供核验时，该产品才会出现在本目录中。在此之前，本目录按设计保持静默。",
  },
} as const;
---

<div
  class="mt-8 max-w-2xl border-y border-[var(--border-subtle)] py-6"
  data-proof-first-empty-state
>
  <h2 class="text-lg font-semibold tracking-tight">{COPY.heading[lang]}</h2>
  <p class="mt-3 leading-[1.65] text-[var(--text-secondary)]">
    {COPY.body[lang]}
  </p>
  <div class="mt-6 flex flex-wrap gap-3">
    <ButtonLink href={primary.href}>{primary.label}</ButtonLink>
    <ButtonLink href={secondary.href} variant="secondary">
      {secondary.label}
    </ButtonLink>
  </div>
</div>
