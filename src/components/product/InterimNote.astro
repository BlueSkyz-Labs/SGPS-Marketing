---
import type { Language } from "@/data/site";
import type { ProductEntry } from "@/lib/products";
import { INTERIM_NOTE, PREVIEW_NOTE } from "./product-page-copy";

/**
 * Owner-approved 2026-10-12 (U10): honest interim sentence while a product has
 * no available store listing. Renders only when the record lists at least one
 * native app and none is `available`. Static, no client script, no waitlist.
 * Once the web app is open as a preview (2026-10-15) the sentence says so
 * instead of "not yet open for sign-up".
 */
interface Props {
  appAccess: ProductEntry["data"]["appAccess"];
  lang: Language;
  /** The web app is open to new users as a preview. */
  webPreview?: boolean;
}
const { appAccess, lang, webPreview = false } = Astro.props;
const states = [appAccess?.android, appAccess?.ios].flatMap((a) =>
  a ? [a.state] : [],
);
const show = states.length > 0 && !states.includes("available");
const t = (webPreview ? PREVIEW_NOTE : INTERIM_NOTE)[lang];
---

{show ? (
  <p
    class="mt-3 max-w-2xl text-sm leading-relaxed text-[var(--text-secondary)]"
    data-interim-note
    data-interim-state={webPreview ? "web-preview" : "closed"}
  >
    {t.before}
    <a
      href={`/${lang}/contact/`}
      class="inline-flex min-h-11 items-center font-semibold underline underline-offset-4 hover:no-underline"
    >
      {t.link}
    </a>
    {t.after}
  </p>
) : null}
