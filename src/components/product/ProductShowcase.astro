---
import type { Language } from "@/lib/i18n";
import type { ShowcaseSchema } from "@/lib/showcase-schema";

/**
 * GOLIVE W5 — real screens of a product's running application.
 * Every image is a `ui-screenshot` bound to the capture revision and data
 * class in the showcase record; the disclosure line is always rendered, so a
 * screen can never appear without saying where it came from. Motion is pure
 * CSS (scroll-driven where supported) and is disabled for reduced motion; no
 * client script is shipped.
 *
 * Mobile LCP (the hero text above this section) is guarded by Lighthouse, so
 * the section stays off its critical path: styles are inlined instead of a
 * render-blocking stylesheet (CSP allows inline styles, not scripts), and the
 * section skips layout and paint until it nears the viewport.
 */
interface Props {
  showcase: ShowcaseSchema;
  lang: Language;
  productName: string;
}

const { showcase, lang, productName } = Astro.props;
const phones = showcase.screens.filter((item) => item.surface === "phone");
const desktops = showcase.screens.filter((item) => item.surface === "desktop");
const revision = showcase.capture.sourceRevision.slice(0, 7);
const capturedOn = showcase.capture.capturedAt.toISOString().slice(0, 10);

const COPY = {
  en: {
    eyebrow: "Real screens",
    heading: `See ${productName}’s screens`,
    disclosure: `Captured from a development build (revision ${revision}, ${capturedOn}) with illustrative demo data — no real tenants, payments or personal data.`,
    video: "Quick introduction",
    videoNote:
      "Silent video with Vietnamese on-screen text; subtitles in English, Vietnamese and Chinese are available in the player.",
    phone: "On a family member’s phone",
    phoneRail: "Phone screens — scroll sideways or use the arrow keys",
    desktop: "On the owner’s computer",
    guide: "Read the getting-started guide",
  },
  vi: {
    eyebrow: "Giao diện thật",
    heading: `Xem giao diện ${productName}`,
    disclosure: `Ảnh chụp từ bản đang phát triển (phiên bản ${revision}, ${capturedOn}) với dữ liệu minh hoạ — không có người thuê, khoản thu hay dữ liệu cá nhân thật.`,
    video: "Giới thiệu nhanh",
    videoNote:
      "Video không có tiếng, chữ tiếng Việt hiển thị trên hình; trình phát có phụ đề tiếng Anh, tiếng Việt và tiếng Trung.",
    phone: "Trên điện thoại của người nhà",
    phoneRail: "Màn hình điện thoại — vuốt ngang hoặc dùng phím mũi tên",
    desktop: "Trên máy tính của chủ trọ",
    guide: "Xem hướng dẫn bắt đầu",
  },
  zh: {
    eyebrow: "真实界面",
    heading: `查看 ${productName} 的实际界面`,
    disclosure: `截图来自开发版本（修订 ${revision}，${capturedOn}），使用示例演示数据——不含真实租客、付款或个人数据。`,
    video: "快速介绍",
    videoNote:
      "无声视频，画面内为越南语文字；播放器中提供英文、越南语及中文字幕。",
    phone: "家人的手机上",
    phoneRail: "手机界面——左右滑动或使用方向键",
    desktop: "房东的电脑上",
    guide: "阅读入门指南",
  },
  "zh-hant": {
    eyebrow: "真實介面",
    heading: `看看 ${productName} 的實際畫面`,
    disclosure: `截圖來自開發版本（修訂 ${revision}，${capturedOn}），使用示例演示資料——不含真實租客、付款或個人資料。`,
    video: "快速介紹",
    videoNote:
      "無聲影片，畫面內為越南語文字；播放器中提供英文、越南語及中文字幕。",
    phone: "家人的手機上",
    phoneRail: "手機介面——左右滑動或使用方向鍵",
    desktop: "房東的電腦上",
    guide: "閱讀入門指南",
  },
} as const satisfies Record<Language, Record<string, string>>;

const t = COPY[lang];
const guideHref = showcase.guide
  ? `/${lang}/products/${showcase.product}/guide/`
  : null;
// Vietnamese text is burned into the video, so the Vietnamese page shows no
// subtitles by default; other pages default to their own script, else English.
const PAGE_TRACK: Record<Language, string | null> = {
  en: "en",
  vi: null,
  zh: "zh-Hans",
  "zh-hant": "zh-Hant",
};
const wanted = PAGE_TRACK[lang];
const defaultTrack = wanted
  ? (showcase.video?.captions.find((track) => track.lang === wanted) ??
    showcase.video?.captions.find((track) => track.lang === "en") ??
    null)
  : null;
---

<section
  class="showcase mt-16"
  aria-labelledby="profile-showcase"
  data-product-showcase={showcase.product}
  data-capture-data={showcase.capture.data}
  data-capture-revision={showcase.capture.sourceRevision}
>
  <div class="showcase__header">
    <span class="showcase__eyebrow">
      <span class="showcase__pulse" aria-hidden="true"></span>
      {t.eyebrow}
    </span>
    <h2 id="profile-showcase" class="type-d2 mt-3 text-[var(--text-primary)]">
      {t.heading}
    </h2>
    <p
      class="mt-3 max-w-3xl text-sm leading-relaxed text-[var(--text-muted)]"
      data-showcase-disclosure
    >
      {t.disclosure}
    </p>
  </div>

  {showcase.video ? (
    <figure class="showcase__video view-rise m-0 mt-8">
      <video
        controls
        playsinline
        muted
        preload="none"
        poster={showcase.video.poster}
        width={showcase.video.width}
        height={showcase.video.height}
        aria-describedby="showcase-video-note"
      >
        {showcase.video.webm ? (
          <source src={showcase.video.webm} type="video/webm" />
        ) : null}
        <source src={showcase.video.src} type="video/mp4" />
        {showcase.video.captions.map((track) => (
          <track
            kind="subtitles"
            src={track.src}
            srclang={track.lang}
            label={track.label}
            default={defaultTrack?.lang === track.lang}
          />
        ))}
      </video>
      <figcaption class="mt-3 text-sm text-[var(--text-muted)]">
        <strong class="font-semibold text-[var(--text-secondary)]">
          {t.video}
        </strong>
        <span id="showcase-video-note"> · {t.videoNote}</span>
      </figcaption>
    </figure>
  ) : null}

  {phones.length > 0 ? (
    <div class="mt-10">
      <h3 class="showcase__label">{t.phone}</h3>
      <ul
        class="showcase__rail"
        role="list"
        tabindex="0"
        aria-label={t.phoneRail}
      >
        {phones.map((item, index) => (
          <li class="showcase__phone view-rise" style={`--i:${index}`}>
            <figure class="m-0">
              <div class="showcase__device">
                <img
                  src={item.src}
                  alt={item.alt[lang]}
                  width={item.width}
                  height={item.height}
                  loading="lazy"
                  decoding="async"
                />
              </div>
              <figcaption class="mt-4">
                <span class="block text-base font-semibold text-[var(--text-primary)]">
                  {item.title[lang]}
                </span>
                <span class="mt-1 block text-sm leading-relaxed text-[var(--text-secondary)]">
                  {item.caption[lang]}
                </span>
              </figcaption>
            </figure>
          </li>
        ))}
      </ul>
    </div>
  ) : null}

  {desktops.length > 0 ? (
    <div class="mt-12">
      <h3 class="showcase__label">{t.desktop}</h3>
      <ul class="showcase__desktops" role="list">
        {desktops.map((item) => (
          <li class="view-rise">
            <figure class="m-0">
              <div class="showcase__browser">
                <span class="showcase__browser-bar" aria-hidden="true">
                  <i />
                  <i />
                  <i />
                </span>
                <img
                  src={item.src}
                  alt={item.alt[lang]}
                  width={item.width}
                  height={item.height}
                  loading="lazy"
                  decoding="async"
                />
              </div>
              <figcaption class="mt-4">
                <span class="block text-base font-semibold text-[var(--text-primary)]">
                  {item.title[lang]}
                </span>
                <span class="mt-1 block text-sm leading-relaxed text-[var(--text-secondary)]">
                  {item.caption[lang]}
                </span>
              </figcaption>
            </figure>
          </li>
        ))}
      </ul>
    </div>
  ) : null}

  {guideHref ? (
    <p class="mt-10">
      <a class="showcase__guide" href={guideHref} data-showcase-guide-link>
        {t.guide}
        <span aria-hidden="true">→</span>
      </a>
    </p>
  ) : null}
</section>

<style is:inline>
  /* Below the fold: skip layout and paint until near the viewport. The
     placeholder heights are the measured section heights (2848 px mobile,
     4615 px desktop) so the scrollbar does not jump. */
  .showcase {
    content-visibility: auto;
    contain-intrinsic-size: auto 2850px;
  }
  @media (min-width: 64rem) {
    .showcase {
      contain-intrinsic-size: auto 4600px;
    }
  }
  .showcase__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    border: 1px solid var(--border-subtle);
    border-radius: 999px;
    padding: 0.25rem 0.75rem;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-secondary);
    background: var(--surface-raised);
  }
  .showcase__pulse {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 999px;
    background: var(--brand-cobalt);
    box-shadow: 0 0 0 3px
      color-mix(in srgb, var(--brand-cobalt) 22%, transparent);
  }
  .showcase__label {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-muted);
  }
  .showcase__video video {
    display: block;
    width: 100%;
    max-width: 64rem;
    height: auto;
    aspect-ratio: 16 / 9;
    border-radius: var(--radius-card);
    border: 1px solid var(--border-subtle);
    background: #0b1020;
    box-shadow: 0 24px 60px -24px
      color-mix(in srgb, var(--brand-cobalt) 35%, transparent);
  }
  .showcase__rail {
    margin: 1.25rem -1rem 0;
    padding: 0.5rem 1rem 1.5rem;
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: min(72%, 17rem);
    gap: 1.25rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: 1rem;
    overscroll-behavior-x: contain;
    list-style: none;
  }
  .showcase__phone {
    scroll-snap-align: start;
  }
  @media (min-width: 64rem) {
    .showcase__rail {
      margin: 1.25rem 0 0;
      padding: 0.5rem 0 0;
      grid-auto-flow: row;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      grid-auto-columns: auto;
      column-gap: 2rem;
      row-gap: 2.75rem;
      overflow: visible;
    }
  }
  .showcase__device {
    position: relative;
    border-radius: 2.25rem;
    padding: 0.5rem;
    background: linear-gradient(
      160deg,
      color-mix(in srgb, var(--text-primary) 16%, transparent),
      color-mix(in srgb, var(--text-primary) 6%, transparent)
    );
    border: 1px solid var(--border-subtle);
    box-shadow:
      0 1px 0 color-mix(in srgb, white 30%, transparent) inset,
      0 28px 48px -28px color-mix(in srgb, #0b1020 55%, transparent);
    transition:
      transform 320ms var(--brand-ease-standard, ease),
      box-shadow 320ms var(--brand-ease-standard, ease);
  }
  .showcase__device img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 1.75rem;
  }
  .showcase__phone:hover .showcase__device {
    transform: translateY(-6px);
    box-shadow:
      0 1px 0 color-mix(in srgb, white 30%, transparent) inset,
      0 36px 60px -28px color-mix(in srgb, var(--brand-cobalt) 40%, transparent);
  }
  .showcase__desktops {
    margin-top: 1.25rem;
    display: grid;
    gap: 2rem;
    list-style: none;
    padding: 0;
  }
  @media (min-width: 48rem) {
    .showcase__desktops {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .showcase__desktops > li:first-child {
      grid-column: 1 / -1;
    }
  }
  .showcase__browser {
    overflow: hidden;
    border-radius: 0.875rem;
    border: 1px solid var(--border-subtle);
    background: var(--surface-raised);
    box-shadow: 0 24px 48px -28px color-mix(in srgb, #0b1020 50%, transparent);
    transition: transform 320ms var(--brand-ease-standard, ease);
  }
  .showcase__browser:hover {
    transform: translateY(-4px);
  }
  .showcase__browser-bar {
    display: flex;
    gap: 0.375rem;
    padding: 0.625rem 0.875rem;
    border-bottom: 1px solid var(--border-subtle);
  }
  .showcase__browser-bar i {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--text-primary) 22%, transparent);
  }
  .showcase__browser img {
    display: block;
    width: 100%;
    height: auto;
  }
  .showcase__guide {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    gap: 0.5rem;
    border-radius: var(--radius-card);
    border: 1px solid var(--border-subtle);
    background: var(--surface-raised);
    padding: 0.5rem 1rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--action-primary);
    text-decoration: none;
    transition:
      border-color 150ms ease,
      transform 150ms ease;
  }
  .showcase__guide:hover {
    border-color: var(--brand-cobalt);
    transform: translateX(2px);
  }
  .showcase__guide:focus-visible,
  .showcase__rail:focus-visible {
    outline: 2px solid var(--brand-cobalt);
    outline-offset: 3px;
  }

  @media (prefers-reduced-motion: reduce) {
    .showcase__device,
    .showcase__browser,
    .showcase__guide {
      transition: none;
    }
    .showcase__phone:hover .showcase__device,
    .showcase__browser:hover,
    .showcase__guide:hover {
      transform: none;
    }
  }
</style>
