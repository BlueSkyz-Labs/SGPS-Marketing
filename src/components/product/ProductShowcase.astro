---
import type { Language } from "@/lib/i18n";
import type { ShowcaseSchema } from "@/lib/showcase-schema";
import ShowcaseGroup from "@/components/product/ShowcaseGroup.astro";

/**
 * GOLIVE W5 — real screens of a product's running application.
 * Every image is a `ui-screenshot` bound to the capture revision and data
 * class in the showcase record; the disclosure line is always rendered, so a
 * screen can never appear without saying where it came from. Motion is pure
 * CSS (scroll-driven where supported) and is disabled for reduced motion; no
 * client script is shipped.
 *
 * Mobile LCP (the hero text above this section) is guarded by Lighthouse, so
 * the section stays off its critical path: styles are inlined instead of a
 * render-blocking stylesheet (CSP allows inline styles, not scripts), and the
 * section skips layout and paint until it nears the viewport.
 */
interface Props {
  showcase: ShowcaseSchema;
  lang: Language;
  productName: string;
}

const { showcase, lang, productName } = Astro.props;
const phones = showcase.screens.filter((item) => item.surface === "phone");
const desktops = showcase.screens.filter((item) => item.surface === "desktop");
// v8 W3: three phone captures and one desktop capture lead; the rest sit
// behind "More screens" so the page stays a story, not a data sheet.
const heroPhones = phones.slice(0, 3);
const heroDesktops = desktops.slice(0, 1);
const morePhones = phones.slice(3);
const moreDesktops = desktops.slice(1);
const hasMore = morePhones.length + moreDesktops.length > 0;
const capturedOn = showcase.capture.capturedAt.toISOString().slice(0, 10);

const COPY = {
  en: {
    heading: `See ${productName}’s screens`,
    disclosure: `Screens from the development build. Captured ${capturedOn} with sample data only: no real tenants, payments or personal data.`,
    video: "Quick introduction",
    videoNote:
      "Short silent video. On-screen text is Vietnamese; subtitles in English, Vietnamese and Chinese.",
    phone: "On a family phone",
    phoneRail: "Phone screens — scroll sideways or use the arrow keys",
    desktop: "On the owner’s computer",
    more: "More screens",
    guide: "Read the guide",
  },
  vi: {
    heading: `Xem giao diện ${productName}`,
    disclosure: `Giao diện của bản đang phát triển. Chụp ngày ${capturedOn}, chỉ dùng dữ liệu mẫu: không có người thuê, thanh toán hay dữ liệu cá nhân thật.`,
    video: "Giới thiệu nhanh",
    videoNote:
      "Video ngắn, không tiếng. Chữ trên màn hình là tiếng Việt; có phụ đề tiếng Anh, Việt, Trung.",
    phone: "Trên điện thoại người nhà",
    phoneRail: "Màn hình điện thoại — vuốt ngang hoặc dùng phím mũi tên",
    desktop: "Trên máy tính của chủ trọ",
    more: "Xem thêm màn hình",
    guide: "Đọc hướng dẫn",
  },
  zh: {
    heading: `查看 ${productName} 的实际界面`,
    disclosure: `开发版本的界面。截取于 ${capturedOn}，仅使用示例数据：没有真实租客、付款或个人数据。`,
    video: "快速介绍",
    videoNote: "简短无声视频。画面文字为越南语；提供英、越、中字幕。",
    phone: "家人手机",
    phoneRail: "手机界面——左右滑动或使用方向键",
    desktop: "房东电脑",
    more: "更多界面",
    guide: "阅读入门指南",
  },
  "zh-hant": {
    heading: `看看 ${productName} 的實際畫面`,
    disclosure: `開發版本的畫面。擷取於 ${capturedOn}，僅使用範例資料：沒有真實房客、付款或個人資料。`,
    video: "快速介紹",
    videoNote: "簡短無聲影片。畫面文字為越南語；提供英、越、中字幕。",
    phone: "家人手機",
    phoneRail: "手機介面——左右滑動或使用方向鍵",
    desktop: "房東電腦",
    more: "更多畫面",
    guide: "閱讀入門指南",
  },
} as const satisfies Record<Language, Record<string, string>>;

const t = COPY[lang];
const guideHref = showcase.guide
  ? `/${lang}/products/${showcase.product}/guide/`
  : null;
// Vietnamese text is burned into the video, so the Vietnamese page shows no
// subtitles by default; other pages default to their own script, else English.
const PAGE_TRACK: Record<Language, string | null> = {
  en: "en",
  vi: null,
  zh: "zh-Hans",
  "zh-hant": "zh-Hant",
};
const wanted = PAGE_TRACK[lang];
const defaultTrack = wanted
  ? (showcase.video?.captions.find((track) => track.lang === wanted) ??
    showcase.video?.captions.find((track) => track.lang === "en") ??
    null)
  : null;
---

<section
  class="showcase mt-16"
  aria-labelledby="profile-showcase"
  data-product-showcase={showcase.product}
  data-capture-data={showcase.capture.data}
  data-capture-revision={showcase.capture.sourceRevision}
>
  <div class="showcase__header">
    <h2 id="profile-showcase" class="type-d2 text-[var(--text-primary)]">
      {t.heading}
    </h2>
    <p
      class="mt-3 max-w-3xl text-sm leading-relaxed text-[var(--text-muted)]"
      data-showcase-disclosure
    >
      {t.disclosure}
    </p>
  </div>

  {showcase.video ? (
    <figure class="showcase__video view-rise m-0 mt-8">
      <video
        controls
        playsinline
        muted
        preload="none"
        poster={showcase.video.poster}
        width={showcase.video.width}
        height={showcase.video.height}
        aria-describedby="showcase-video-note"
      >
        {showcase.video.webm ? (
          <source src={showcase.video.webm} type="video/webm" />
        ) : null}
        <source src={showcase.video.src} type="video/mp4" />
        {showcase.video.captions.map((track) => (
          <track
            kind="subtitles"
            src={track.src}
            srclang={track.lang}
            label={track.label}
            default={defaultTrack?.lang === track.lang}
          />
        ))}
      </video>
      <figcaption class="mt-3 text-sm text-[var(--text-muted)]">
        <strong class="font-semibold text-[var(--text-secondary)]">
          {t.video}
        </strong>
        <span id="showcase-video-note"> · {t.videoNote}</span>
      </figcaption>
    </figure>
  ) : null}

  <ShowcaseGroup
    phones={heroPhones}
    desktops={heroDesktops}
    lang={lang}
    labels={t}
    first
  />

  {hasMore ? (
    <details class="showcase__more mt-10" data-showcase-more>
      <summary>{t.more}</summary>
      <ShowcaseGroup
        phones={morePhones}
        desktops={moreDesktops}
        lang={lang}
        labels={t}
      />
    </details>
  ) : null}

  {guideHref ? (
    <p class="mt-10">
      <a class="showcase__guide" href={guideHref} data-showcase-guide-link>
        {t.guide}
        <span aria-hidden="true">→</span>
      </a>
    </p>
  ) : null}
</section>

<style is:inline>
  /* Below the fold: skip layout and paint until near the viewport. The
     placeholder heights are the measured section heights (1655 px mobile,
     2777 px desktop, gallery collapsed) so the scrollbar does not jump. */
  .showcase {
    content-visibility: auto;
    contain-intrinsic-size: auto 1660px;
  }
  @media (min-width: 64rem) {
    .showcase {
      contain-intrinsic-size: auto 2780px;
    }
  }
  .showcase__label {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-muted);
  }
  .showcase__video video {
    display: block;
    width: 100%;
    max-width: 64rem;
    height: auto;
    aspect-ratio: 16 / 9;
    border-radius: var(--radius-card);
    border: 1px solid var(--border-subtle);
    background: #0b1020;
    box-shadow: 0 24px 60px -24px
      color-mix(in srgb, var(--brand-cobalt) 35%, transparent);
  }
  .showcase__rail {
    margin: 1.25rem -1rem 0;
    padding: 0.5rem 1rem 1.5rem;
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: min(72%, 17rem);
    gap: 1.25rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: 1rem;
    overscroll-behavior-x: contain;
    list-style: none;
  }
  .showcase__phone {
    scroll-snap-align: start;
    /* Far-below captures stay out of the first-paint request graph. */
    /* Top padding leaves room for the hover lift under paint containment. */
    content-visibility: auto;
    contain-intrinsic-size: auto 41rem;
    padding-top: 0.5rem;
    margin-top: -0.5rem;
  }
  @media (min-width: 64rem) {
    .showcase__rail {
      margin: 1.25rem 0 0;
      padding: 0.5rem 0 0;
      grid-auto-flow: row;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      grid-auto-columns: auto;
      column-gap: 2rem;
      row-gap: 2.75rem;
      overflow: visible;
    }
  }
  .showcase__device {
    position: relative;
    border-radius: 2.25rem;
    padding: 0.5rem;
    background: linear-gradient(
      160deg,
      color-mix(in srgb, var(--text-primary) 16%, transparent),
      color-mix(in srgb, var(--text-primary) 6%, transparent)
    );
    border: 1px solid var(--border-subtle);
    box-shadow:
      0 1px 0 color-mix(in srgb, white 30%, transparent) inset,
      0 28px 48px -28px color-mix(in srgb, #0b1020 55%, transparent);
    transition:
      transform 320ms var(--brand-ease-standard, ease),
      box-shadow 320ms var(--brand-ease-standard, ease);
  }
  .showcase__device img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 1.75rem;
  }
  .showcase__phone:hover .showcase__device {
    transform: translateY(-6px);
    box-shadow:
      0 1px 0 color-mix(in srgb, white 30%, transparent) inset,
      0 36px 60px -28px color-mix(in srgb, var(--brand-cobalt) 40%, transparent);
  }
  .showcase__desktops {
    margin-top: 1.25rem;
    display: grid;
    gap: 2rem;
    list-style: none;
    padding: 0;
  }
  @media (min-width: 48rem) {
    .showcase__desktops {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .showcase__desktops > li:first-child {
      grid-column: 1 / -1;
    }
  }
  .showcase__browser {
    overflow: hidden;
    border-radius: 0.875rem;
    border: 1px solid var(--border-subtle);
    background: var(--surface-raised);
    box-shadow: 0 24px 48px -28px color-mix(in srgb, #0b1020 50%, transparent);
    transition: transform 320ms var(--brand-ease-standard, ease);
  }
  .showcase__browser:hover {
    transform: translateY(-4px);
  }
  .showcase__browser-bar {
    display: flex;
    gap: 0.375rem;
    padding: 0.625rem 0.875rem;
    border-bottom: 1px solid var(--border-subtle);
  }
  .showcase__browser-bar i {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--text-primary) 22%, transparent);
  }
  .showcase__browser img {
    display: block;
    width: 100%;
    height: auto;
  }
  .showcase__guide {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--action-primary);
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }
  .showcase__more > summary {
    display: inline-flex;
    min-height: 2.75rem;
    cursor: pointer;
    align-items: center;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--action-primary);
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }
  .showcase__more > summary:focus-visible {
    outline: 2px solid var(--brand-cobalt);
    outline-offset: 3px;
  }
  .showcase__guide:focus-visible,
  .showcase__rail:focus-visible {
    outline: 2px solid var(--brand-cobalt);
    outline-offset: 3px;
  }

  @media (prefers-reduced-motion: reduce) {
    .showcase__device,
    .showcase__browser {
      transition: none;
    }
    .showcase__phone:hover .showcase__device,
    .showcase__browser:hover {
      transform: none;
    }
  }
</style>
