---
import { EMPTY_STATE_COPY } from "@/data/empty-state-copy";
import { labelFor, type Language } from "@/data/site";
import { LIFECYCLE_LADDER, lifecycleLabel } from "@/lib/product-copy";
import type { Lifecycle } from "@/lib/product-schema";

interface Props {
  lifecycle: Lifecycle;
  lang: Language;
}

const { lifecycle, lang } = Astro.props;
const heading = {
  en: "Lifecycle",
  vi: "Vòng đời",
  zh: "生命周期",
  "zh-hant": "生命週期",
}[lang];
const index = LIFECYCLE_LADDER.indexOf(lifecycle);
const next = index >= 0 ? LIFECYCLE_LADDER[index + 1] : undefined;
---

<section class="product-ladder" aria-label={heading} data-product-ladder>
  <p class="product-ladder__summary">
    <span class="product-ladder__term">
      {labelFor(EMPTY_STATE_COPY.ladderCurrent, lang)}
    </span>
    <strong>{lifecycleLabel(lifecycle, lang)}</strong>
    {next ? (
      <>
        <span class="product-ladder__term">
          {labelFor(EMPTY_STATE_COPY.ladderNext, lang)}
        </span>
        <span>{lifecycleLabel(next, lang)}</span>
      </>
    ) : null}
  </p>
  <details class="product-ladder__all">
    <summary>{labelFor(EMPTY_STATE_COPY.ladderAll, lang)}</summary>
    <ol class="product-ladder__stages">
      {LIFECYCLE_LADDER.map((stage) => (
        <li
          class="product-ladder__stage"
          aria-current={stage === lifecycle ? "step" : undefined}
        >
          {lifecycleLabel(stage, lang)}
        </li>
      ))}
    </ol>
  </details>
</section>

<style>
  .product-ladder {
    margin-top: 1rem;
  }

  .product-ladder__summary {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 0.75rem;
    margin: 0;
    color: var(--text-secondary);
    font-size: 0.875rem;
  }

  .product-ladder__summary strong {
    color: var(--text-primary);
  }

  .product-ladder__term {
    color: var(--text-muted);
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .product-ladder__all {
    margin-top: 0.5rem;
  }

  .product-ladder__all summary {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    color: var(--action-primary);
    font-size: 0.875rem;
    font-weight: 600;
    cursor: pointer;
  }

  .product-ladder__stages {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 8rem), 1fr));
    gap: 0.5rem;
    margin: 0.25rem 0 0;
    padding: 0;
    list-style: none;
  }

  .product-ladder__stage {
    min-width: 0;
    border-top: 2px solid var(--border-subtle);
    padding-top: 0.35rem;
    color: var(--text-muted);
    font-size: 0.875rem;
  }

  .product-ladder__stage[aria-current="step"] {
    border-color: var(--action-primary);
    color: var(--text-primary);
    font-weight: 600;
  }

  @media (forced-colors: active) {
    .product-ladder__stage {
      border-color: CanvasText;
      color: CanvasText;
    }

    .product-ladder__stage[aria-current="step"] {
      border-color: Highlight;
    }
  }
</style>
