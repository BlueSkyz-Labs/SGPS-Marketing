---
import { EMPTY_STATE_COPY } from "@/data/empty-state-copy";
import { labelFor, type Language } from "@/data/site";
import { lifecycleLabel } from "@/lib/product-copy";
import type { Lifecycle } from "@/lib/product-schema";

/**
 * Current stage only. The stage ladder and a "next" stage are internal
 * vocabulary and read as a roadmap commitment no dated fact backs, so the
 * visitor surface states what is recorded now and nothing about what follows.
 */
interface Props {
  lifecycle: Lifecycle;
  lang: Language;
}

const { lifecycle, lang } = Astro.props;
const heading = {
  en: "Stage",
  vi: "Giai đoạn",
  zh: "阶段",
  "zh-hant": "階段",
}[lang];
---

<section class="product-ladder" aria-label={heading} data-product-ladder>
  <p class="product-ladder__summary">
    <span class="product-ladder__term">
      {labelFor(EMPTY_STATE_COPY.ladderCurrent, lang)}
    </span>
    <strong>{lifecycleLabel(lifecycle, lang)}</strong>
  </p>
</section>

<style>
  .product-ladder {
    margin-top: 1rem;
  }

  .product-ladder__summary {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 0.75rem;
    margin: 0;
    color: var(--text-secondary);
    font-size: 0.875rem;
  }

  .product-ladder__summary strong {
    color: var(--text-primary);
  }

  .product-ladder__term {
    color: var(--text-muted);
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
</style>
