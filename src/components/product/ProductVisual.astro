---
import type { CollectionEntry } from "astro:content";

type ProductMedia = NonNullable<
  CollectionEntry<"products">["data"]["proof"]["media"]
>;

/**
 * C3-A Task 2 — shared static product visual.
 * Renders record-backed image metadata and forwards the caller's continuity identity.
 * Plan v5 W3.1 — the typed media kind travels with the visual so the surface
 * (ink ground for artwork) follows the record, not the filename.
 */
interface Props {
  media: ProductMedia;
  /** Localized override; falls back to the record's media.alt (English). */
  alt?: string;
  loading?: "eager" | "lazy";
  transitionStyle?: string;
  continuity?: "media";
}

const {
  media,
  alt = media.alt,
  loading = "lazy",
  transitionStyle,
  continuity,
} = Astro.props;
/**
 * Perf 2026-10-08: identity art ships WebP derivatives (`identity-480.webp`,
 * `identity-768.webp`, `identity.webp`) next to the PNG master. The PNG stays
 * as `src` fallback (and for the provenance tests that pin it); browsers take
 * the WebP from `srcset` — mobile drops from ~60KB to ~10KB.
 */
const webpSrc = (src: string, suffix: string) =>
  src.replace(/\.png$/, `${suffix}.webp`);
const srcSet = [
  `${webpSrc(media.src, "-480")} 480w`,
  `${webpSrc(media.src, "-768")} 768w`,
  `${webpSrc(media.src, "")} ${media.width}w`,
].join(", ");
/** Identity art renders full-width of its figure (max-w-4xl stage). */
const SIZES = "(min-width: 64rem) 56rem, calc(100vw - 2.5rem)";
---

<div
  class="c3-product-visual"
  data-product-visual
  data-media-kind={media.kind}
  data-product-continuity={continuity}
  style={transitionStyle}
>
  <img
    src={media.src}
    srcset={srcSet}
    sizes={SIZES}
    alt={alt}
    width={media.width}
    height={media.height}
    class="c3-product-visual__image"
    loading={loading}
    decoding="async"
  />
</div>
