---
import type { CollectionEntry } from "astro:content";

type ProductMedia = NonNullable<
  CollectionEntry<"products">["data"]["proof"]["media"]
>;

/**
 * C3-A Task 2 — shared static product visual.
 * Renders record-backed image metadata and forwards the caller's continuity identity.
 * Plan v5 W3.1 — the typed media kind travels with the visual so the surface
 * (ink ground for artwork) follows the record, not the filename.
 */
interface Props {
  media: ProductMedia;
  /** Localized override; falls back to the record's media.alt (English). */
  alt?: string;
  loading?: "eager" | "lazy";
  transitionStyle?: string;
  continuity?: "media";
}

const { media, alt = media.alt, loading = "lazy", transitionStyle, continuity } = Astro.props;
---

<div
  class="c3-product-visual"
  data-product-visual
  data-media-kind={media.kind}
  data-product-continuity={continuity}
  style={transitionStyle}
>
  <img
    src={media.src}
    alt={alt}
    width={media.width}
    height={media.height}
    class="c3-product-visual__image"
    loading={loading}
    decoding="async"
  />
</div>
