---
import type { CollectionEntry } from "astro:content";

type ProductScreenshot = NonNullable<
  CollectionEntry<"products">["data"]["proof"]["screenshot"]
>;

interface Props {
  screenshot: ProductScreenshot;
  loading?: "eager" | "lazy";
  transitionStyle?: string;
  continuity?: "media";
}

const {
  screenshot,
  loading = "lazy",
  transitionStyle,
  continuity,
} = Astro.props;
---

<div
  class="c3-product-visual"
  data-product-visual
  data-product-continuity={continuity}
  style="min-width: 0; max-width: 100%; overflow: hidden; width: 100%;"
>
  <img
    src={screenshot.src}
    alt={screenshot.alt}
    class="c3-product-visual__image"
    loading={loading}
    decoding="async"
    style="display: block; box-sizing: border-box; width: 100% !important; max-width: 100% !important; height: auto !important;"
  />
</div>
