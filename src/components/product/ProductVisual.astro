---
import type { CollectionEntry } from "astro:content";

type ProductMedia = NonNullable<
  CollectionEntry<"products">["data"]["proof"]["media"]
>;

/**
 * C3-A Task 2 — the single shared product-visual primitive.
 *
 * It owns presentation only: intrinsic size, alt text and the optional
 * continuity hook all come from the caller. It never derives product facts,
 * and it forwards — never authors — the continuity identity produced by the
 * shared naming convention in `src/lib`.
 */
interface Props {
  media: ProductMedia;
  loading?: "eager" | "lazy";
  transitionStyle?: string;
  continuity?: "media";
}

const { media, loading = "lazy", transitionStyle, continuity } = Astro.props;
---

<div
  class="c3-product-visual"
  data-product-visual
  data-product-continuity={continuity}
  style={transitionStyle}
>
  <img
    src={media.src}
    alt={media.alt}
    width={media.width}
    height={media.height}
    class="c3-product-visual__image"
    loading={loading}
    decoding="async"
  />
</div>
