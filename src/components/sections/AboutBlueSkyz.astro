---
import { SITE } from "@/data/site";

interface Props {
  lang?: "en" | "vi";
}
const { lang = "en" } = Astro.props;
const isVi = lang === "vi";
---

<section
  class="border-b border-[var(--border-subtle)] py-16"
  aria-labelledby="about-title"
>
  <h2 id="about-title" class="text-3xl font-semibold tracking-tight">
    {isVi ? "Về BlueSkyz" : "About BlueSkyz"}
  </h2>
  <p class="mt-4 max-w-2xl text-[var(--text-secondary)]">
    {
      isVi
        ? "Chúng tôi xây dựng những sản phẩm thông minh để trao quyền cho con người và nâng tầm cách công việc được thực hiện. Một góc nhìn cao hơn xây dựng một ngày mai tươi sáng hơn."
        : `${SITE.proposition} ${SITE.supporting}`
    }
  </p>
  <p class="mt-4 text-sm font-medium text-[var(--text-muted)]">
    {
      isVi
        ? "Tony Nguyen — Nhà sáng lập & Giám đốc điều hành"
        : "Tony Nguyen — Founder & CEO"
    }
  </p>
</section>
