---
const links = [
  {
    href: "/privacy/",
    label: "Privacy",
    viHref: "/vi/privacy/",
    viLabel: "Quyền riêng tư",
    desc: "How corporate-site data is handled",
    viDesc: "Cách dữ liệu trang doanh nghiệp được xử lý",
  },
  {
    href: "/security/",
    label: "Security",
    viHref: "/vi/security/",
    viLabel: "Bảo mật",
    desc: "Private vulnerability reporting",
    viDesc: "Báo cáo lỗ hổng riêng tư",
  },
  {
    href: "/support/",
    label: "Support",
    viHref: "/vi/support/",
    viLabel: "Hỗ trợ",
    desc: "Working help and recourse paths",
    viDesc: "Đường dẫn trợ giúp và khắc phục",
  },
];

interface Props {
  lang?: "en" | "vi";
}
const { lang = "en" } = Astro.props;
const isVi = lang === "vi";
---

<section
  class="border-b border-[var(--border-subtle)] py-16 lg:py-20"
  aria-labelledby="trust-title"
>
  <p
    class="text-xs font-semibold tracking-[0.18em] text-[var(--text-muted)] uppercase"
  >
    {isVi ? "Tin cậy" : "Trust"}
  </p>
  <h2
    id="trust-title"
    class="mt-3 text-3xl font-semibold tracking-tight text-balance sm:text-4xl"
  >
    {isVi ? "Sự trưởng thành được thể hiện rõ ràng" : "Maturity you can verify"}
  </h2>
  <p class="mt-4 max-w-2xl text-lg text-[var(--text-secondary)] text-pretty">
    {
      isVi
        ? "Đường dẫn đến quyền riêng tư, bảo mật và hỗ trợ là những tuyến đường hạng nhất — không phải khẩu hiệu."
        : "Privacy, security, and support paths are first-class routes — not slogans."
    }
  </p>
  <ul class="mt-10 grid gap-4 sm:grid-cols-3">
    {
      links.map((link) => (
        <li>
          <a
            href={isVi ? link.viHref : link.href}
            class="group flex min-h-11 flex-col gap-1 rounded-lg border border-[var(--border-subtle)] bg-white p-5 no-underline transition-[border-color,box-shadow] duration-150 hover:border-[var(--action-primary)] hover:shadow-sm"
          >
            <span class="flex items-center justify-between gap-2">
              <span class="text-base font-semibold tracking-tight text-[var(--text-primary)]">
                {isVi ? link.viLabel : link.label}
              </span>
              <span
                aria-hidden="true"
                class="text-[var(--action-primary)] transition-transform group-hover:translate-x-0.5"
              >
                →
              </span>
            </span>
            <span class="text-sm text-[var(--text-muted)]">
              {isVi ? link.viDesc : link.desc}
            </span>
          </a>
        </li>
      ))
    }
  </ul>
</section>
