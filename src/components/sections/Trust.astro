---
import TrustLedger from "@/components/experience/TrustLedger.astro";

interface Props {
  lang?: "en" | "vi";
}
const { lang = "en" } = Astro.props;
const isVi = lang === "vi";
---

<section
  class="border-b border-[var(--border-subtle)] py-16 lg:py-20"
  aria-labelledby="trust-title"
>
  <h2
    id="trust-title"
    class="text-3xl font-semibold tracking-tight text-balance sm:text-4xl"
  >
    {isVi ? "Tin cậy bạn có thể xác minh" : "Trust you can verify"}
  </h2>
  <p class="mt-4 max-w-2xl text-lg text-[var(--text-secondary)] text-pretty">
    {
      isVi
        ? "Đường dẫn đến quyền riêng tư, bảo mật và hỗ trợ là những tuyến đường hạng nhất — không phải khẩu hiệu."
        : "Privacy, security, and support paths are first-class routes — not slogans."
    }
  </p>
  <TrustLedger lang={lang} />
</section>
