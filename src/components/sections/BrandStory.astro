---
import { BRAND_PRINCIPLES, SITE } from "@/data/site";

const locationLabel = `${SITE.location.locality}, ${SITE.location.country}`;
---

<section
  class="grid gap-10 border-b border-[var(--border-subtle)] py-16 lg:grid-cols-[minmax(0,1.05fr)_minmax(18rem,0.95fr)] lg:gap-16 lg:py-20"
  aria-labelledby="brand-story-title"
>
  <div class="max-w-3xl">
    <p
      class="text-xs font-semibold tracking-[0.16em] text-[var(--text-muted)] uppercase"
    >
      Product house · {SITE.location.locality}
    </p>
    <h2
      id="brand-story-title"
      class="mt-4 text-3xl font-semibold tracking-tight sm:text-4xl"
    >
      Intelligence with a point of view.
    </h2>
    <div
      class="mt-6 space-y-4 text-base leading-7 text-[var(--text-secondary)]"
    >
      <p>
        BlueSkyz Labs is a product house based in {SITE.location.locality},
        building intelligent digital products around clarity, trust, and useful
        impact.
      </p>
      <p>
        Founded by {SITE.founder.name}, BlueSkyz brings product thinking,
        engineering discipline, and brand craft into one house. We prefer simple
        systems, evidence-backed decisions, and products that earn trust through
        how they work.
      </p>
    </div>

    <dl
      class="mt-8 grid gap-5 border-t border-[var(--border-subtle)] pt-6 sm:grid-cols-3"
    >
      <div>
        <dt class="text-xs font-medium text-[var(--text-muted)]">Founder</dt>
        <dd class="mt-1 text-sm font-semibold text-[var(--text-primary)]">
          {SITE.founder.name}
          <span class="block font-normal text-[var(--text-secondary)]"
            >{SITE.founder.role}</span
          >
        </dd>
      </div>
      <div>
        <dt class="text-xs font-medium text-[var(--text-muted)]">Based in</dt>
        <dd class="mt-1 text-sm font-semibold text-[var(--text-primary)]">
          {locationLabel}
        </dd>
      </div>
      <div>
        <dt class="text-xs font-medium text-[var(--text-muted)]">Online</dt>
        <dd class="mt-1 text-sm font-semibold">
          <a
            href={SITE.publicWebsite}
            class="inline-flex min-h-11 items-center text-[var(--action-primary)] underline decoration-[color-mix(in_srgb,var(--action-primary)_35%,transparent)] underline-offset-4 hover:decoration-current"
          >
            blueskyzlabs.com
          </a>
        </dd>
      </div>
    </dl>
  </div>

  <div
    class="rounded-[var(--radius-card)] border border-[var(--border-subtle)] bg-[color-mix(in_srgb,var(--surface-subtle)_72%,white)] p-6 sm:p-8"
  >
    <div class="mx-auto max-w-sm" aria-hidden="true">
      <img
        src="/brand/blueskyz/r4d/symbol_material_expression.svg"
        alt=""
        width="520"
        height="520"
        class="h-auto w-full"
        loading="lazy"
        decoding="async"
      />
    </div>
    <ul class="mt-6 grid gap-3 sm:grid-cols-2" aria-label="BlueSkyz principles">
      {
        BRAND_PRINCIPLES.map((principle) => (
          <li class="rounded-lg border border-[var(--border-subtle)] bg-white/70 p-4">
            <h3 class="text-sm font-semibold text-[var(--text-primary)]">
              {principle.name}
            </h3>
            <p class="mt-1 text-sm leading-6 text-[var(--text-secondary)]">
              {principle.summary}
            </p>
          </li>
        ))
      }
    </ul>
  </div>
</section>
