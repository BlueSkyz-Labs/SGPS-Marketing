---
import HorizonField from "@/components/experience/HorizonField.astro";
import ButtonLink from "@/components/ui/ButtonLink.astro";
import SailReveal from "@/components/motion/SailReveal.astro";
import { SITE, labelFor, type Language } from "@/data/site";
import { HOME_ONE_LINER, HOME_PRODUCT_LINE } from "@/data/home-copy";
import { emptyRegistryPrimaryCta, emptyRegistrySecondaryCta } from "@/lib/act";
import { resolveLifecycleCta } from "@/lib/lifecycle-cta";
import { productCopy } from "@/lib/product-copy";
import {
  getProductIconThumbPath,
  getProductProfilePath,
} from "@/lib/product-routes";
import { getPublicProducts } from "@/lib/products";
import FlagshipCapture from "@/components/product/FlagshipCapture.astro";

/**
 * Experience v6 S2 — brand + flagship hero (Owner 2026-10-01).
 *
 * The H1 is BlueSkyz's one-line promise, the existing localized
 * `SITE.proposition`. Immediately below it the flagship is presented with a
 * real, labelled capture of the app (`FlagshipCapture`, from the product's
 * showcase record), its name and status chip, its registry one-line
 * description (`productCopy`) and the one primary action, which is
 * `resolveLifecycleCta` (no authored verb). With no public flagship the hero
 * falls back to the company tagline and the honest empty-registry Act path, so
 * nothing is invented.
 */
interface Props {
  lang?: Language;
}
const { lang = "en" } = Astro.props;

const products = await getPublicProducts();
const flagship =
  products.find((product) => product.data.featuredTier === "hero") ?? null;
const copy = flagship ? productCopy(flagship.data, lang) : null;
const cta = flagship
  ? resolveLifecycleCta(
      {
        slug: flagship.data.slug,
        lifecycle: flagship.data.lifecycle,
        availability: flagship.data.availability,
        primaryActionHref: flagship.data.primaryAction.href,
        productName: flagship.data.name,
      },
      lang,
    )
  : null;

// Company-level fallback (no public flagship): tagline once, no slogan stack.
const taglineLead = labelFor(
  {
    en: SITE.taglineLead,
    vi: "Trí tuệ. Nâng tầm.",
    zh: "智能。提升。",
    "zh-hant": "智慧。提升。",
  },
  lang,
);
const taglineAccent = labelFor(
  {
    en: SITE.taglineAccent,
    vi: "Tác động.",
    zh: "影响。",
    "zh-hant": "影響。",
  },
  lang,
);
const proposition = labelFor(
  {
    en: SITE.proposition,
    vi: "Chúng tôi xây dựng sản phẩm thông minh, giúp con người làm chủ và nâng tầm cách làm việc.",
    zh: "我们打造智能化产品，赋能个人并提升工作方式。",
    "zh-hant": "我們打造智慧化產品，賦能個人並提升工作方式。",
  },
  lang,
);
// Product line under the H1 (hom-2, verbatim from the copy deck), each name
// linking to its profile.
const lineFirst = products.find((product) => product.data.slug === "sotro");
const lineSecond = products.find((product) => product.data.slug === "sotam");
const productLine =
  flagship && lineFirst && lineSecond ? HOME_PRODUCT_LINE[lang] : null;
const flagshipLine =
  (flagship ? HOME_ONE_LINER[flagship.data.slug]?.[lang] : undefined) ??
  copy?.shortDescription ??
  "";
const emptyPrimary = emptyRegistryPrimaryCta(SITE.contactEmail, lang);
const emptySecondary = emptyRegistrySecondaryCta(SITE.contactEmail, lang);
// Flagship present: the proposition is the H1 and carries the promise alone.
// Fallback: tagline H1 plus the proposition as the one supporting sentence.
const supportingLine = flagship ? null : proposition;
---

<section
  class="hero-plane hero-plane--ink relative isolate overflow-hidden border-b border-white/10"
  aria-labelledby="hero-title"
>
  <div class="hero-atmosphere hero-atmosphere--ink" aria-hidden="true"></div>
  <div class="horizon-container">
    <div class="horizon-signature">
      <HorizonField />
    </div>
  </div>
  <!-- Plain container, not the rise wrapper: the LCP headline lives inside it and must
       not animate or move, so no ancestor may carry the 400 ms rise either. -->
  <div class="site-container relative grid grid-cols-[minmax(0,1fr)] gap-8 py-10 sm:py-14 md:grid-cols-[minmax(0,1.1fr)_minmax(0,0.9fr)] md:items-center md:gap-10 lg:py-8">
    <div class="hero-content" data-hero>
      <h1
        id="hero-title"
        class:list={[
          "hero-headline text-[var(--brand-porcelain)] font-semibold tracking-tight",
          flagship
            ? "hero-headline--promise max-w-[24ch] text-balance sm:max-w-[32ch] md:max-w-none"
            : "mt-2 max-w-[11ch] text-4xl sm:text-5xl lg:text-7xl",
        ]}
      >
        {flagship ? (
          proposition
        ) : (
          <>
            <span class="block">{taglineLead}</span>
            <span class="mt-1 block text-[var(--brand-cobalt)]">
              {taglineAccent}
            </span>
          </>
        )}
      </h1>
      {supportingLine ? (
        <p class="hero-tagline mt-5 max-w-xl text-lg leading-relaxed text-[color-mix(in_srgb,var(--brand-porcelain)_82%,transparent)]">
          {supportingLine}
        </p>
      ) : null}
      {productLine && lineFirst && lineSecond ? (
        <p
          class="hero-product-line hero-tagline mt-4 max-w-xl text-base leading-relaxed text-[color-mix(in_srgb,var(--brand-porcelain)_82%,transparent)]"
          data-hero-product-line
        >
          <span class="whitespace-pre-wrap">{productLine.lead}</span>
          <a
            href={getProductProfilePath(lang, lineFirst.data.slug)}
            class="inline-flex min-h-11 items-center align-middle font-semibold text-[var(--brand-porcelain)] underline underline-offset-4 hover:no-underline"
          >
            {lineFirst.data.name}
          </a>
          <span class="whitespace-pre-wrap">{productLine.a}</span>
          <a
            href={getProductProfilePath(lang, lineSecond.data.slug)}
            class="inline-flex min-h-11 items-center align-middle font-semibold text-[var(--brand-porcelain)] underline underline-offset-4 hover:no-underline"
          >
            {lineSecond.data.name}
          </a>
          <span class="whitespace-pre-wrap">{productLine.b}</span>
        </p>
      ) : null}
      {!(flagship && cta) ? (
        <div class="hero-actions mt-6">
          <ButtonLink href={emptyPrimary.href} data-hero-primary>
            {emptyPrimary.label}
          </ButtonLink>
          <a
            href={emptySecondary.href}
            data-hero-secondary
            class="inline-flex min-h-11 items-center text-sm font-semibold text-[var(--brand-porcelain)] underline underline-offset-4 hover:no-underline"
          >
            {emptySecondary.label}
          </a>
        </div>
      ) : null}
    </div>
    {flagship && cta ? (
      <div class="hero-stage">
        <div class="hero-visual" aria-hidden="true">
          <picture>
            <source
              type="image/avif"
              media="(min-width: 1024px)"
              srcset="/brand/blueskyz/v4/hero/prismatic-r4d-mark-560.avif 560w, /brand/blueskyz/v4/hero/prismatic-r4d-mark-840.avif 840w"
              sizes="26rem"
            />
            <source
              type="image/webp"
              media="(min-width: 1024px)"
              srcset="/brand/blueskyz/v4/hero/prismatic-r4d-mark-560.webp 560w, /brand/blueskyz/v4/hero/prismatic-r4d-mark-840.webp 840w"
              sizes="26rem"
            />
            <img
              class="hero-mark"
              src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7"
              alt=""
              width="560"
              height="560"
              decoding="async"
              fetchpriority="low"
            />
          </picture>
          <SailReveal handoff />
        </div>
        <div class="hero-flagship" data-hero-flagship>
          <div class="hero-focal" data-hero-focal>
            <FlagshipCapture
              slug={flagship.data.slug}
              screen="today"
              lang={lang}
              priority
              lowPriority
              sizes="(min-width: 768px) 17.5rem, 13.75rem"
              smallSrc={
                flagship.data.slug === "sotro"
                  ? [
                      {
                        src: "/products/sotro/showcase/op-01-home-288.webp",
                        width: 288,
                      },
                      {
                        src: "/products/sotro/showcase/op-01-home-480.webp",
                        width: 480,
                      },
                    ]
                  : undefined
              }
              class="hero-flagship__capture"
            />
          </div>
          <div class="hero-flagship__body">
            <p class="hero-product flex flex-wrap items-center gap-x-3 gap-y-2">
              <img
                class="size-9 rounded-lg"
                src={getProductIconThumbPath(flagship.data.slug)}
                alt=""
                width="36"
                height="36"
                decoding="async"
              />
              <span class="text-lg font-semibold text-[var(--brand-porcelain)]">
                {flagship.data.name}
              </span>
              <span
                data-product-status={flagship.data.publicLabel}
                class="inline-flex rounded-full border border-white/30 px-3 py-1 text-xs font-semibold tracking-wide text-[var(--brand-porcelain)]"
              >
                {copy?.statusLabel}
              </span>
            </p>
            <p class="hero-tagline mt-2 text-sm leading-relaxed text-[color-mix(in_srgb,var(--brand-porcelain)_82%,transparent)]">
              {flagshipLine}
            </p>
            <ButtonLink
              href={cta.href}
              data-product-cta={cta.verb}
              data-hero-primary
              class="hero-flagship__cta mt-4"
              aria-label={`${cta.label}: ${flagship.data.name}`}
            >
              {cta.label}
            </ButtonLink>
          </div>
        </div>
      </div>
    ) : null}
  </div>
</section>

<style>
  .hero-stage {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    justify-items: center;
    min-width: 0;
  }
  /* The sail is atmosphere: reduced scale, behind the capture, desktop and
     tablet only (hidden below md; the hero atmosphere glow stays). */
  .hero-stage :global(.hero-visual) {
    position: absolute;
    inset: 38% auto auto 50%;
    transform: translate(-50%, -50%);
    width: min(26rem, 120%);
    z-index: 0;
    opacity: 0.55;
  }
  .hero-flagship {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    justify-items: center;
    gap: 1rem;
    width: 100%;
    max-width: 22rem;
    min-width: 0;
  }
  .hero-focal {
    width: 13.75rem;
    max-width: 100%;
  }
  .hero-flagship :global(.hero-flagship__capture) {
    width: 100%;
  }
  .hero-flagship :global(.flagship-capture__image) {
    /* Reserve the slot before the image arrives (CLS 0); full frame, no crop. */
    aspect-ratio: 780 / 1440;
    object-fit: contain;
  }
  .hero-flagship__body {
    min-width: 0;
    width: 100%;
  }
  /* The CTA is never allowed to break inside a word. Full width on phones. */
  .hero-flagship :global(.hero-flagship__cta) {
    width: 100%;
    overflow-wrap: normal;
    word-break: normal;
    hyphens: none;
    text-align: center;
  }
  @media (min-width: 768px) {
    .hero-focal {
      width: 17.5rem;
    }
    .hero-flagship :global(.hero-flagship__cta) {
      width: auto;
    }
  }
</style>
