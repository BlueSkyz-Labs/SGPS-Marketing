---
import BrandLockup from "@/components/brand/BrandLockup.astro";
import HorizonField from "@/components/experience/HorizonField.astro";
import ButtonLink from "@/components/ui/ButtonLink.astro";
import Reveal from "@/components/ui/Reveal.astro";
import { SITE, SHARED_LABELS, labelFor, type Language } from "@/data/site";
import { emptyRegistryPrimaryCta, emptyRegistrySecondaryCta } from "@/lib/act";
import { getPublicProducts } from "@/lib/products";

interface Props {
  lang?: Language;
}
const { lang = "en" } = Astro.props;

const taglineLead = labelFor(
  { en: SITE.taglineLead, vi: "Trí tuệ. Nâng tầm.", zh: "智能。提升。" },
  lang,
);
const taglineAccent = labelFor(
  { en: SITE.taglineAccent, vi: "Tác động.", zh: "影响。" },
  lang,
);
const proposition = labelFor(
  {
    en: SITE.proposition,
    vi: "Chúng tôi xây dựng những sản phẩm thông minh để trao quyền cho con người và nâng tầm cách công việc được thực hiện.",
    zh: "我们打造智能化产品，赋能个人并提升工作方式。",
  },
  lang,
);
const supporting = labelFor(
  {
    en: SITE.supporting,
    vi: "Một góc nhìn cao hơn kiến tạo một ngày mai rạng rỡ.",
    zh: "更高的视角，成就更明亮的明天。",
  },
  lang,
);
const exploreProducts = labelFor(SHARED_LABELS.exploreProducts, lang);
const aboutBlueSkyz = labelFor(SHARED_LABELS.aboutBlueSkyz, lang);
const productsHref = `/${lang}/products/`;
const aboutHref = `/${lang}/about/`;

const products = await getPublicProducts();
const hasPublicProducts = products.length > 0;
const emptyPrimary = emptyRegistryPrimaryCta(SITE.contactEmail, lang);
const emptySecondary = emptyRegistrySecondaryCta(SITE.contactEmail, lang);
---

<section
  class="hero-plane hero-plane--ink relative isolate overflow-hidden border-b border-white/10"
  aria-labelledby="hero-title"
>
  <div class="hero-atmosphere hero-atmosphere--ink" aria-hidden="true"></div>
  <div class="horizon-container">
    <div class="horizon-signature">
      <HorizonField />
    </div>
  </div>
  <Reveal
    as="div"
    class="relative mx-auto grid w-full max-w-7xl gap-10 px-4 py-16 sm:px-6 sm:py-24 lg:grid-cols-[minmax(0,0.92fr)_minmax(0,1.08fr)] lg:items-center lg:px-8"
  >
    <div class="hero-content">
      <BrandLockup size="hero" surface="ink" />
      <h1
        id="hero-title"
        class="hero-headline mt-8 max-w-[11ch] text-4xl font-semibold tracking-tight text-[var(--brand-porcelain)] sm:text-5xl lg:text-7xl"
      >
        <span class="block">{taglineLead}</span>
        <span class="mt-1 block text-[var(--brand-cobalt)]"
          >{taglineAccent}</span
        >
      </h1>
      <p
        class="hero-tagline mt-5 max-w-xl text-lg leading-relaxed text-[color-mix(in_srgb,var(--brand-porcelain)_82%,transparent)]"
      >
        {proposition}
      </p>
      <p
        class="hero-supporting mt-3 max-w-xl text-sm leading-relaxed text-[color-mix(in_srgb,var(--brand-porcelain)_68%,transparent)]"
      >
        {supporting}
      </p>
      <div class="hero-actions">
        {
          hasPublicProducts ? (
            <>
              <ButtonLink href={productsHref}>{exploreProducts}</ButtonLink>
              <ButtonLink href={aboutHref} variant="on-ink">
                {aboutBlueSkyz}
              </ButtonLink>
            </>
          ) : (
            <>
              <ButtonLink href={emptyPrimary.href}>
                {emptyPrimary.label}
              </ButtonLink>
              <ButtonLink href={emptySecondary.href} variant="on-ink">
                {emptySecondary.label}
              </ButtonLink>
            </>
          )
        }
      </div>
    </div>
    <div class="hero-seam"></div>
  </Reveal>
</section>
