---
import BrandLockup from "@/components/brand/BrandLockup.astro";
import ButtonLink from "@/components/ui/ButtonLink.astro";
import Reveal from "@/components/ui/Reveal.astro";
import { brandAssets } from "@/data/brand-assets";
import { SITE } from "@/data/site";
import { emptyRegistryPrimaryCta, emptyRegistrySecondaryCta } from "@/lib/act";
import { getPublicProducts } from "@/lib/products";

const products = await getPublicProducts();
const hasPublicProducts = products.length > 0;
const emptyPrimary = emptyRegistryPrimaryCta(SITE.contactEmail);
const emptySecondary = emptyRegistrySecondaryCta(SITE.contactEmail);
---

<section
  class="hero-plane hero-plane--ink relative isolate overflow-hidden border-b border-white/10"
  aria-labelledby="hero-title"
>
  <div class="hero-atmosphere hero-atmosphere--ink" aria-hidden="true"></div>
  <Reveal
    as="div"
    class="relative mx-auto grid w-full max-w-7xl gap-10 px-4 py-16 sm:px-6 sm:py-24 lg:grid-cols-[minmax(0,0.92fr)_minmax(0,1.08fr)] lg:items-center lg:px-8"
  >
    <div>
      <BrandLockup size="hero" surface="ink" />
      <h1
        id="hero-title"
        class="mt-8 max-w-[11ch] text-4xl font-semibold tracking-tight text-[var(--brand-porcelain)] sm:text-5xl lg:text-7xl"
      >
        <span class="block">{SITE.taglineLead}</span>
        <span class="mt-1 block text-[var(--brand-cobalt)]"
          >{SITE.taglineAccent}</span
        >
      </h1>
      <p
        class="mt-5 max-w-xl text-lg leading-relaxed text-[color-mix(in_srgb,var(--brand-porcelain)_82%,transparent)]"
      >
        {SITE.proposition}
      </p>
      <p
        class="mt-3 max-w-xl text-sm leading-relaxed text-[color-mix(in_srgb,var(--brand-porcelain)_68%,transparent)]"
      >
        {SITE.supporting}
      </p>
      <div class="mt-10 flex flex-wrap gap-3">
        {
          hasPublicProducts ? (
            <>
              <ButtonLink href="/products/">Explore Our Products</ButtonLink>
              <ButtonLink href="/about/" variant="on-ink">
                About BlueSkyz
              </ButtonLink>
            </>
          ) : (
            <>
              <ButtonLink href={emptyPrimary.href}>
                {emptyPrimary.label}
              </ButtonLink>
              <ButtonLink href={emptySecondary.href} variant="on-ink">
                {emptySecondary.label}
              </ButtonLink>
            </>
          )
        }
      </div>
    </div>
    <figure
      class="hero-art-frame relative mx-auto w-full overflow-hidden rounded-[var(--radius-xl)] border border-white/15 bg-[var(--brand-ink)] shadow-2xl shadow-black/30"
      aria-label="BlueSkyz Labs brand mark above a bright horizon"
    >
      <picture>
        <source srcset={brandAssets.hero.avif} type="image/avif" />
        <source srcset={brandAssets.hero.webp} type="image/webp" />
        <img
          src={brandAssets.hero.png}
          alt=""
          width="1920"
          height="1080"
          class="hero-art block h-auto w-full"
          decoding="async"
          fetchpriority="high"
        />
      </picture>
    </figure>
  </Reveal>
</section>
