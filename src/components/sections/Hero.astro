---
import HorizonField from "@/components/experience/HorizonField.astro";
import ButtonLink from "@/components/ui/ButtonLink.astro";
import SailReveal from "@/components/motion/SailReveal.astro";
import { SITE, labelFor, type Language } from "@/data/site";
import { HOME_ONE_LINER, HOME_PRODUCT_LINE } from "@/data/home-copy";
import { emptyRegistryPrimaryCta, emptyRegistrySecondaryCta } from "@/lib/act";
import { resolveLifecycleCta } from "@/lib/lifecycle-cta";
import { productCopy } from "@/lib/product-copy";
import {
  getProductIconThumbPath,
  getProductProfilePath,
} from "@/lib/product-routes";
import { getPublicProducts } from "@/lib/products";
import FlagshipCapture from "@/components/product/FlagshipCapture.astro";

/**
 * Experience v6 S2 — brand + flagship hero (Owner 2026-10-01).
 *
 * The H1 is BlueSkyz's one-line promise, the existing localized
 * `SITE.proposition`. Immediately below it the flagship is presented with a
 * real, labelled capture of the app (`FlagshipCapture`, from the product's
 * showcase record), its name and status chip, its registry one-line
 * description (`productCopy`) and the one primary action, which is
 * `resolveLifecycleCta` (no authored verb). With no public flagship the hero
 * falls back to the company tagline and the honest empty-registry Act path, so
 * nothing is invented.
 */
interface Props {
  lang?: Language;
}
const { lang = "en" } = Astro.props;

const products = await getPublicProducts();
const flagship =
  products.find((product) => product.data.featuredTier === "hero") ?? null;
const copy = flagship ? productCopy(flagship.data, lang) : null;
const cta = flagship
  ? resolveLifecycleCta(
      {
        slug: flagship.data.slug,
        lifecycle: flagship.data.lifecycle,
        availability: flagship.data.availability,
        primaryActionHref: flagship.data.primaryAction.href,
        productName: flagship.data.name,
      },
      lang,
    )
  : null;

// Company-level fallback (no public flagship): tagline once, no slogan stack.
const taglineLead = labelFor(
  {
    en: SITE.taglineLead,
    vi: "Trí tuệ. Nâng tầm.",
    zh: "智能。提升。",
    "zh-hant": "智慧。提升。",
  },
  lang,
);
const taglineAccent = labelFor(
  {
    en: SITE.taglineAccent,
    vi: "Tác động.",
    zh: "影响。",
    "zh-hant": "影響。",
  },
  lang,
);
const proposition = labelFor(
  {
    en: SITE.proposition,
    vi: "Chúng tôi xây dựng sản phẩm thông minh, giúp con người làm chủ và nâng tầm cách làm việc.",
    zh: "我们打造智能化产品，赋能个人并提升工作方式。",
    "zh-hant": "我們打造智慧化產品，賦能個人並提升工作方式。",
  },
  lang,
);
// Product line under the H1 (hom-2, verbatim from the copy deck), each name
// linking to its profile.
const lineFirst = products.find((product) => product.data.slug === "sotro");
const lineSecond = products.find((product) => product.data.slug === "sotam");
const productLine =
  flagship && lineFirst && lineSecond ? HOME_PRODUCT_LINE[lang] : null;
const flagshipLine =
  (flagship ? HOME_ONE_LINER[flagship.data.slug]?.[lang] : undefined) ??
  copy?.shortDescription ??
  "";
const publicContactEmail = SITE.contactEmail || SITE.supportEmail;
const emptyPrimary = emptyRegistryPrimaryCta(publicContactEmail, lang);
const emptySecondary = emptyRegistrySecondaryCta(publicContactEmail, lang);
// Flagship present: the proposition is the H1 and carries the promise alone.
// Fallback: tagline H1 plus the proposition as the one supporting sentence.
const supportingLine = flagship ? null : proposition;
---

<section
  class="hero-plane hero-plane--ink relative isolate overflow-hidden border-b border-white/10"
  aria-labelledby="hero-title"
>
  <div class="hero-atmosphere hero-atmosphere--ink" aria-hidden="true"></div>
  <div class="horizon-container">
    <div class="horizon-signature">
      <HorizonField />
    </div>
  </div>
  <!-- Plain container, not the rise wrapper: the LCP headline lives inside it and must
       not animate or move, so no ancestor may carry the 400 ms rise either. -->
  <div
    class="site-container relative grid hero-grid py-10 sm:py-14 lg:py-12"
    data-hero-layout={flagship && cta ? "flagship" : "company"}
  >
    <div class="hero-content" data-hero>
      <h1
        id="hero-title"
        class:list={[
          "hero-headline text-[var(--brand-porcelain)] font-semibold tracking-tight",
          flagship
            ? "hero-headline--promise max-w-[24ch] text-balance sm:max-w-[32ch] md:max-w-none"
            : "mt-2 max-w-[11ch] text-4xl sm:text-5xl lg:text-7xl",
        ]}
      >
        {flagship ? (
          proposition
        ) : (
          <>
            <span class="block">{taglineLead}</span>
            <span class="mt-1 block text-[var(--brand-cobalt)]">
              {taglineAccent}
            </span>
          </>
        )}
      </h1>
      {supportingLine ? (
        <p class="hero-tagline mt-5 max-w-xl text-lg leading-relaxed text-[color-mix(in_srgb,var(--brand-porcelain)_82%,transparent)]">
          {supportingLine}
        </p>
      ) : null}
      {productLine && lineFirst && lineSecond ? (
        <p
          class="hero-product-line hero-tagline mt-4 max-w-xl text-base text-[color-mix(in_srgb,var(--brand-porcelain)_82%,transparent)]"
          data-hero-product-line
        >
          <span class="whitespace-pre-wrap">{productLine.lead}</span>
          <a
            href={getProductProfilePath(lang, lineFirst.data.slug)}
            class="hero-inline-link"
          >
            {lineFirst.data.name}
          </a>
          <span class="whitespace-pre-wrap">{productLine.a}</span>
          <a
            href={getProductProfilePath(lang, lineSecond.data.slug)}
            class="hero-inline-link"
          >
            {lineSecond.data.name}
          </a>
          <span class="whitespace-pre-wrap">{productLine.b}</span>
        </p>
      ) : null}
      {!(flagship && cta) ? (
        <div class="hero-actions mt-6">
          <ButtonLink href={emptyPrimary.href} data-hero-primary>
            {emptyPrimary.label}
          </ButtonLink>
          <a
            href={emptySecondary.href}
            data-hero-secondary
            class="inline-flex min-h-11 items-center text-sm font-semibold text-[var(--brand-porcelain)] underline underline-offset-4 hover:no-underline"
          >
            {emptySecondary.label}
          </a>
        </div>
      ) : null}
    </div>
    <!-- F4: in DOM order the flagship name and its one action come before the
         capture, so on a phone they sit under the H1 inside the first screen.
         The wrapper is `display: contents`; the grid places body and stage, so
         reading order and visual order agree at every width (no CSS order). -->
    {flagship && cta ? (
      <div class="hero-flagship" data-hero-flagship>
        <div class="hero-flagship__body">
          <p class="hero-product flex flex-wrap items-center gap-x-3 gap-y-2">
            <img
              class="size-9 rounded-lg"
              src={getProductIconThumbPath(flagship.data.slug)}
              alt=""
              width="36"
              height="36"
              decoding="async"
            />
            <span class="text-lg font-semibold text-[var(--brand-porcelain)]">
              {flagship.data.name}
            </span>
            <span
              data-product-status={flagship.data.publicLabel}
              class="inline-flex rounded-full border border-white/30 px-3 py-1 text-xs font-semibold tracking-wide text-[var(--brand-porcelain)]"
            >
              {copy?.statusLabel}
            </span>
          </p>
          <p class="hero-tagline mt-2 max-w-md text-sm leading-relaxed text-[color-mix(in_srgb,var(--brand-porcelain)_82%,transparent)]">
            {flagshipLine}
          </p>
          <ButtonLink
            href={cta.href}
            data-product-cta={cta.verb}
            data-hero-primary
            class="hero-flagship__cta mt-4"
            aria-label={`${cta.label}: ${flagship.data.name}`}
          >
            {cta.label}
          </ButtonLink>
        </div>
        <div class="hero-stage">
          <!-- W1 "Horizon & Sail": the prismatic mark rises behind the capture
               like a sun on the horizon; decorative, desktop only. -->
          <div class="hero-visual" aria-hidden="true">
            <picture>
              <source
                type="image/avif"
                media="(min-width: 1024px)"
                srcset="/brand/blueskyz/v4/hero/prismatic-r4d-mark-560.avif 560w, /brand/blueskyz/v4/hero/prismatic-r4d-mark-840.avif 840w"
                sizes="24rem"
              />
              <source
                type="image/webp"
                media="(min-width: 1024px)"
                srcset="/brand/blueskyz/v4/hero/prismatic-r4d-mark-560.webp 560w, /brand/blueskyz/v4/hero/prismatic-r4d-mark-840.webp 840w"
                sizes="24rem"
              />
              <img
                class="hero-mark"
                src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7"
                alt=""
                width="560"
                height="560"
                decoding="async"
                fetchpriority="low"
              />
            </picture>
            <SailReveal handoff />
          </div>
          <span class="hero-stage__horizon" aria-hidden="true"></span>
          <div class="hero-focal" data-hero-focal>
            <FlagshipCapture
              slug={flagship.data.slug}
              screen="today"
              lang={lang}
              priority
              lowPriority
              sizes="(min-width: 1024px) 18rem, (min-width: 768px) 17.5rem, 13.75rem"
              smallSrc={
                flagship.data.slug === "sotro"
                  ? [
                      {
                        src: "/products/sotro/showcase/op-01-home-288.webp",
                        width: 288,
                      },
                      {
                        src: "/products/sotro/showcase/op-01-home-480.webp",
                        width: 480,
                      },
                    ]
                  : undefined
              }
              class="hero-flagship__capture"
            />
          </div>
        </div>
      </div>
    ) : null}
  </div>
</section>

<style>
  /* ---- Layout -------------------------------------------------------------
     One column on phones in DOM order: promise, product line, flagship name +
     CTA, then the capture. From 768 px the promise and the flagship body share
     the left column and the capture stage spans both rows on the right. */
  .hero-grid {
    grid-template-columns: minmax(0, 1fr);
    row-gap: 2rem;
  }
  .hero-flagship {
    display: contents;
  }
  .hero-flagship__body {
    min-width: 0;
    width: 100%;
  }
  /* Product line: plain inline links (no inline-flex box, so every line keeps
     the same pitch). Vertical padding on an inline box does not change the line
     box, so the target still measures >= 44 px tall (the project's 44 x 44
     target standard, above WCAG 2.5.8) while the line-height alone sets the
     rhythm. */
  .hero-product-line {
    line-height: 1.625;
  }
  .hero-inline-link {
    white-space: nowrap;
    padding-block: 0.85rem;
    font-weight: 600;
    color: var(--brand-porcelain);
    text-decoration-line: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.25em;
    text-decoration-color: color-mix(
      in srgb,
      var(--brand-porcelain) 55%,
      transparent
    );
  }
  .hero-inline-link:hover {
    text-decoration-color: currentColor;
  }

  .hero-stage {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    justify-items: center;
    min-width: 0;
  }
  .hero-focal {
    position: relative;
    z-index: 2;
    width: 13.75rem;
    max-width: 100%;
  }
  .hero-flagship :global(.hero-flagship__capture) {
    width: 100%;
  }
  .hero-flagship :global(.flagship-capture__image) {
    /* Reserve the slot before the image arrives (CLS 0); full frame, no crop. */
    aspect-ratio: 780 / 1440;
    object-fit: contain;
  }
  /* The CTA is never allowed to break inside a word. Full width on phones. */
  .hero-flagship :global(.hero-flagship__cta) {
    width: 100%;
    overflow-wrap: normal;
    word-break: normal;
    hyphens: none;
    text-align: center;
  }
  .hero-stage__horizon {
    display: none;
  }

  @media (min-width: 768px) {
    .hero-grid[data-hero-layout="flagship"] {
      grid-template-columns: minmax(0, 1.08fr) minmax(0, 0.92fr);
      grid-template-areas:
        "copy stage"
        "body stage";
      /* The stage spans both rows; its extra height is shared by the two rows,
         so the promise (bottom of row 1) and the body (top of row 2) stay a
         centred group beside the capture. */
      grid-template-rows: auto auto;
      column-gap: 2.5rem;
      row-gap: 1.75rem;
      align-items: start;
    }
    .hero-grid[data-hero-layout="flagship"] > .hero-content {
      grid-area: copy;
      align-self: end;
    }
    .hero-flagship__body {
      grid-area: body;
    }
    .hero-stage {
      grid-area: stage;
      align-self: center;
    }
    .hero-focal {
      width: 17.5rem;
    }
    .hero-flagship :global(.hero-flagship__cta) {
      width: auto;
    }
    /* Restrained 3D: the capture turns a few degrees toward the promise. A
       static transform (no layout box change, CLS 0); the slot stays reserved. */
    .hero-focal {
      transform: perspective(2000px) rotateY(-8deg);
      transform-origin: 60% 50%;
    }
    .hero-flagship :global(.flagship-capture__image) {
      box-shadow:
        0 1px 0 0 color-mix(in srgb, var(--brand-porcelain) 30%, transparent)
          inset,
        0 2px 6px color-mix(in srgb, #000 30%, transparent),
        0 36px 72px -24px color-mix(in srgb, #000 70%, transparent),
        0 24px 64px -32px
          color-mix(in srgb, var(--brand-cobalt) 55%, transparent);
    }
  }

  /* ---- W1 Horizon & Sail (desktop) ----------------------------------------
     The mark sits up and to the right of the capture so its whole silhouette
     reads, and it rises out of a cobalt horizon line like a sun: the lower edge
     fades into the line instead of being cut by the capture. */
  .hero-stage :global(.hero-visual) {
    position: absolute;
    z-index: 0;
    pointer-events: none;
  }
  @media (min-width: 1024px) {
    /* 18rem so the tilted capture still renders >= 280 px wide. */
    .hero-focal {
      justify-self: start;
      width: 18rem;
      margin-inline-start: 6%;
    }
    .hero-stage :global(.hero-visual) {
      top: -1.5rem;
      right: -3rem;
      width: 24rem;
      opacity: 0.92;
      /* The sail stands on the horizon line at 88.5 % of its box. */
      mask-image: linear-gradient(180deg, #000 0 87%, transparent 95%);
    }
    .hero-stage__horizon {
      display: block;
      position: absolute;
      z-index: 1;
      top: calc(-1.5rem + 24rem * 0.885);
      left: -10%;
      right: -6rem;
      height: 1px;
      pointer-events: none;
      background: linear-gradient(
        90deg,
        transparent 0%,
        color-mix(in srgb, var(--brand-cobalt) 70%, transparent) 22%,
        color-mix(in srgb, var(--brand-porcelain) 85%, transparent) 62%,
        color-mix(in srgb, var(--brand-cobalt) 70%, transparent) 86%,
        transparent 100%
      );
      box-shadow: 0 0 18px
        color-mix(in srgb, var(--brand-cobalt) 50%, transparent);
    }
  }

  @media (forced-colors: active) {
    .hero-stage__horizon {
      display: none;
    }
    .hero-focal {
      transform: none;
    }
  }
</style>
