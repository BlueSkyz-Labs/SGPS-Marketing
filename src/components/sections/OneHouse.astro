---
import { brandAssets } from "@/data/brand-assets";
import { BRAND_PRINCIPLES } from "@/data/site";

const principleIcons = [
  brandAssets.principles.intelligence,
  brandAssets.principles.elevation,
  brandAssets.principles.trust,
  brandAssets.principles.impact,
] as const;

interface Props {
  lang?: "en" | "vi";
}
const { lang = "en" } = Astro.props;
const isVi = lang === "vi";

const VI_PRINCIPLE_NAMES = {
  Intelligence: "Trí tuệ",
  Elevation: "Nâng tầm",
  Trust: "Tin cậy",
  Impact: "Tác động",
} as const;

const VI_PRINCIPLE_SUMMARIES = {
  Intelligence: "Suy nghĩ sâu sắc. Giải pháp thông minh.",
  Elevation: "Góc nhìn tốt hơn. Tác động lớn hơn.",
  Trust: "Đáng tin cậy, an toàn, nhất quán.",
  Impact: "Giá trị thực. Thay đổi thực.",
} as const;
---

<section
  class="border-b border-[var(--border-subtle)] py-16 lg:py-20"
  aria-labelledby="house-title"
>
  <p
    class="text-xs font-semibold tracking-[0.18em] text-[var(--text-muted)] uppercase"
  >
    {isVi ? "Một nhà" : "One house"}
  </p>
  <h2
    id="house-title"
    class="mt-3 text-3xl font-semibold tracking-tight text-balance sm:text-4xl"
  >
    {
      isVi
        ? "Một cách suy nghĩ, không một danh mục"
        : "A way of thinking, not a category"
    }
  </h2>
  <p class="mt-4 max-w-2xl text-lg text-[var(--text-secondary)] text-pretty">
    {
      isVi
        ? "Chúng tôi không xây dựng xung quanh một danh mục. Chúng tôi xây dựng xung quanh một cách suy nghĩ."
        : "We don’t build around one category. We build around a way of thinking."
    }
  </p>
  <ul class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
    {
      BRAND_PRINCIPLES.map((item, index) => (
        <li class="rounded-lg border border-[var(--border-subtle)] bg-white p-6 transition-shadow hover:shadow-sm">
          <img
            src={principleIcons[index]}
            alt=""
            width="32"
            height="32"
            loading="lazy"
          />
          <h3 class="mt-4 text-lg font-semibold tracking-tight">
            {isVi
              ? VI_PRINCIPLE_NAMES[item.name as keyof typeof VI_PRINCIPLE_NAMES]
              : item.name}
          </h3>
          <p class="mt-2 text-sm text-[var(--text-secondary)]">
            {isVi
              ? VI_PRINCIPLE_SUMMARIES[
                  item.name as keyof typeof VI_PRINCIPLE_SUMMARIES
                ]
              : item.summary}
          </p>
        </li>
      ))
    }
  </ul>
</section>
