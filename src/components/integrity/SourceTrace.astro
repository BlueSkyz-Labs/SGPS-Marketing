---
import { getClaimTrace, type ClaimTraceStep } from "@/lib/claims";
import type { Language } from "@/data/site";

interface Props {
  claimId: string;
  lang: Language;
  products: { slug: string; name: string }[];
  /** Evidence ids whose anchor id is already emitted elsewhere on the page. */
  omitAnchorIds?: string[];
  /** false: the page already shows its own boundary card (no repeated limits). */
  showBoundary?: boolean;
}

const {
  claimId,
  lang,
  products,
  omitAnchorIds = [],
  showBoundary = true,
} = Astro.props;
const trace =
  getClaimTrace(claimId, products)?.filter(
    (step) => showBoundary || step.kind !== "boundary",
  ) ?? null;

const ROLE_LABELS: Record<ClaimTraceStep["kind"], Record<Language, string>> = {
  claim: { en: "Claim", vi: "Tuyên bố", zh: "声明", "zh-hant": "聲明" },
  evidence: { en: "Evidence", vi: "Bằng chứng", zh: "证据", "zh-hant": "證據" },
  boundary: {
    en: "Limits",
    vi: "Giới hạn",
    zh: "适用范围",
    "zh-hant": "適用範圍",
  },
  surface: {
    en: "Page",
    vi: "Trang",
    zh: "页面",
    "zh-hant": "頁面",
  },
};

const HEADING: Record<Language, string> = {
  en: "Where this statement comes from",
  vi: "Thông tin này đến từ đâu",
  zh: "这条说法从何而来",
  "zh-hant": "這項說法從何而來",
};
---

{trace ? (
  <div class="source-trace" data-source-trace={claimId}>
    <h3 class="source-trace__title">{HEADING[lang]}</h3>
    <ol class="source-trace__list">
      {trace.map((step) => (
        <li
          class="source-trace__step"
          data-trace-step={step.kind}
          id={
            step.kind === "evidence" && !omitAnchorIds.includes(step.id)
              ? `evidence-${step.id}`
              : undefined
          }
        >
          <span class="source-trace__role">{ROLE_LABELS[step.kind][lang]}</span>
          {step.href ? (
            <a
              href={step.href[lang]}
              class="inline-flex min-h-11 items-center text-sm font-semibold text-[var(--action-primary)] underline-offset-2 hover:underline"
              rel={
                /^https?:\/\//i.test(step.href[lang])
                  ? "noopener noreferrer"
                  : undefined
              }
            >
              {step.label[lang]}
            </a>
          ) : (
            <span>{step.label[lang]}</span>
          )}
        </li>
      ))}
    </ol>
  </div>
) : null}
