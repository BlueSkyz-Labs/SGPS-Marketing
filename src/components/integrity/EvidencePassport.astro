---
import { getEvidencePassport, getClaimAnchor } from "@/lib/claims";
import { formatDisplayDate } from "@/lib/display-date";
import TruthState from "./TruthState.astro";
import { SOURCE_LINKED_LEGEND } from "@/data/integrity";
import BoundaryCard from "./BoundaryCard.astro";
import type { Language } from "@/data/site";

interface Props {
  id: string;
  lang: Language;
  products: { slug: string; name: string }[];
  /** The evidence page makes the claim its document title (the one H1). */
  claimAs?: "h1" | "h2";
}

const { id, lang, products, claimAs = "h2" } = Astro.props;
const ClaimHeading = claimAs;
// Never skip a level: under an H1 claim the sources heading is an H2.
const SourcesHeading = claimAs === "h1" ? "h2" : "h3";
const passport = getEvidencePassport(id, products);

const LABELS = {
  en: {
    kind: "Evidence for this claim",
    sources: "Public sources",
    reviewed: "Reviewed",
    context: "View in context",
  },
  vi: {
    kind: "Bằng chứng cho nhận định này",
    sources: "Nguồn công khai",
    reviewed: "Đã xem xét",
    context: "Xem trong ngữ cảnh",
  },
  zh: {
    kind: "这条说法的证据",
    sources: "公开来源",
    reviewed: "已审阅",
    context: "在原文中查看",
  },
  "zh-hant": {
    kind: "這項說法的證據",
    sources: "公開來源",
    reviewed: "已審閱",
    context: "在原文中檢視",
  },
} as const;

const labels = LABELS[lang];
---

{passport ? (
  <article class="evidence-passport" data-evidence-passport={passport.id}>
    <ClaimHeading
      id={getClaimAnchor(passport.id)}
      class="evidence-passport__claim"
    >
      {passport.claim[lang]}
    </ClaimHeading>
    <p class="evidence-passport__meta">
      <TruthState state={passport.state} lang={lang} />
      {passport.reviewedOn ? (
        <span class="evidence-passport__review" data-passport-review>
          {labels.reviewed}:{" "}
          <time datetime={passport.reviewedOn}>
            {formatDisplayDate(passport.reviewedOn, lang)}
          </time>
        </span>
      ) : null}
    </p>
    {passport.state === "source-linked" ? (
      <p class="integrity-lens__legend">{SOURCE_LINKED_LEGEND[lang]}</p>
    ) : null}
    <div class="evidence-passport__sources">
      <SourcesHeading class="evidence-passport__sources-title">
        {labels.sources}
      </SourcesHeading>
      <ul>
        {passport.evidence.map((ref) => (
          <li id={`evidence-${ref.id}`}>
            <a
              href={ref.href[lang]}
              rel={
                /^https?:\/\//i.test(ref.href[lang])
                  ? "noopener noreferrer"
                  : undefined
              }
              class="inline-flex min-h-11 items-center text-sm font-semibold text-[var(--action-primary)] no-underline hover:underline"
            >
              {ref.label[lang]}
            </a>
          </li>
        ))}
      </ul>
    </div>
    {passport.boundary ? (
      <div class="evidence-passport__boundary">
        <BoundaryCard boundary={passport.boundary} lang={lang} />
      </div>
    ) : null}
    <p class="evidence-passport__context">
      <a
        href={passport.contextHref[lang]}
        class="inline-flex min-h-11 items-center text-sm font-semibold text-[var(--action-primary)] no-underline hover:underline"
      >
        {labels.context} →
      </a>
    </p>
  </article>
) : null}
