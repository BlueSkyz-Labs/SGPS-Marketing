---
import { MIRROR_PAIRS } from "@/data/integrity";
import type { Language } from "@/data/site";

interface Props {
  lang: Language;
}

const { lang } = Astro.props;

const LABELS = {
  en: {
    heading: "Same wording in two languages",
    note: "The localized route remains the primary reading path; these authored pairs let you compare the exact wording.",
    enTag: "English",
    viTag: "Tiếng Việt",
  },
  vi: {
    heading: "Nguyên văn hai ngôn ngữ",
    note: "Trang theo ngôn ngữ vẫn là đường đọc chính; các cặp được biên soạn dưới đây giúp bạn đối chiếu nguyên văn.",
    enTag: "English",
    viTag: "Tiếng Việt",
  },
  zh: {
    heading: "双语对照",
    note: "本地化页面仍是主要阅读路径；以下由我们编写的对照条目便于你比对原文措辞。",
    enTag: "英文",
    viTag: "越南语",
  },
  "zh-hant": {
    heading: "雙語對照",
    note: "本地化頁面仍是主要閱讀路徑；以下由我們編寫的對照條目便於你比對原文措辭。",
    enTag: "英文",
    viTag: "越南語",
  },
} as const;

const labels = LABELS[lang];
---

{MIRROR_PAIRS.length > 0 ? (
  <section
    class="bilingual-mirror"
    data-bilingual-mirror
    aria-labelledby="bilingual-mirror-title"
  >
    <h2 id="bilingual-mirror-title" class="bilingual-mirror__title">
      {labels.heading}
    </h2>
    <p class="bilingual-mirror__note">{labels.note}</p>
    <div class="bilingual-mirror__pairs">
      {MIRROR_PAIRS.map((pair) => (
        <div class="bilingual-mirror__pair" data-mirror-pair={pair.id}>
          <div lang="en" class="bilingual-mirror__cell">
            <span class="bilingual-mirror__tag" aria-hidden="true">
              {labels.enTag}
            </span>
            <p>{pair.en}</p>
          </div>
          <div lang="vi" class="bilingual-mirror__cell">
            <span class="bilingual-mirror__tag" aria-hidden="true">
              {labels.viTag}
            </span>
            <p>{pair.vi}</p>
          </div>
        </div>
      ))}
    </div>
  </section>
) : null}

<style is:global>
  .bilingual-mirror__title {
    font-size: var(--size-4);
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--text-primary);
  }
  .bilingual-mirror__note {
    margin-top: 0.5rem;
    color: var(--text-muted);
    font-size: var(--size-2);
    line-height: 1.6;
  }
  .bilingual-mirror__pairs {
    margin-top: 1.25rem;
    display: grid;
    gap: 1rem;
  }
  .bilingual-mirror__pair {
    display: grid;
    gap: 0.75rem;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-card, 0.75rem);
    padding: 1rem 1.25rem;
    background: var(--surface-subtle);
  }
  @media (min-width: 768px) {
    .bilingual-mirror__pair {
      /* minmax(0, 1fr): a bare `1fr` track refuses to shrink below its content's
         min-content, so a long tag or word widened the pair and pushed the
         document sideways at 200% text. */
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 1.25rem;
    }
  }
  .bilingual-mirror__cell {
    min-width: 0;
  }
  .bilingual-mirror__tag {
    display: inline-block;
    font-size: var(--size-1);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted);
    /* The tag is an inline-block label; at 200% text it can be wider than a
       narrow cell, so it must be allowed to break rather than overflow. */
    overflow-wrap: anywhere;
  }

  /* Vietnamese: sentence case (cross-subset kerning, see .eyebrow). */
  :lang(vi) .bilingual-mirror__tag {
    text-transform: none;
    letter-spacing: var(--tracking-eyebrow, 0.03em);
  }
  .bilingual-mirror__cell p {
    margin-top: 0.375rem;
    color: var(--text-secondary);
    line-height: 1.6;
  }
</style>
