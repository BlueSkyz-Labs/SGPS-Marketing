---
import ButtonLink from "@/components/ui/ButtonLink.astro";
import type { Language } from "@/data/site";

interface Props {
  href: string;
  label: string;
  boundary: "external" | "mailto" | "private-reporting";
  lang: Language;
  /** Replaces the destination context line with a plainer one-line note. */
  note?: string;
  /** Size the action to its label instead of the full column. A fitted
   * tertiary action pulls back by its 0.75rem padding so its text lines up
   * with the links above it (customer review F7). */
  fit?: boolean;
  /** Visual weight of the action; the boundary note is unchanged. */
  variant?: "primary" | "secondary" | "tertiary";
}

const {
  href,
  label,
  boundary,
  lang,
  note,
  fit = false,
  variant = "primary",
} = Astro.props;

const host = /^https?:\/\//i.test(href) ? new URL(href).host : "";
const mailTarget = href.replace(/^mailto:/i, "");

/** Visible destination context — no click interception, no modal. */
const CONTEXT = {
  external: {
    en: `Opens an external site — ${host}`,
    vi: `Mở trang bên ngoài — ${host}`,
    zh: `打开外部网站 — ${host}`,
    "zh-hant": `開啟外部網站 — ${host}`,
  },
  mailto: {
    en: `Opens your email app — ${mailTarget}`,
    vi: `Mở ứng dụng email — ${mailTarget}`,
    zh: `打开你的邮件应用 — ${mailTarget}`,
    "zh-hant": `開啟你的電子郵件應用程式 — ${mailTarget}`,
  },
  "private-reporting": {
    en: "Opens GitHub private vulnerability reporting — visible only to maintainers",
    vi: "Mở kênh báo cáo lỗ hổng riêng tư trên GitHub — chỉ người bảo trì nhìn thấy",
    zh: "打开 GitHub 私密漏洞报告 — 仅维护者可见",
    "zh-hant": "開啟 GitHub 私密漏洞報告 — 僅維護者可見",
  },
} as const;
---

<div class="safe-action" data-safe-action={boundary}>
  <ButtonLink
    href={href}
    variant={variant}
    class={
      fit ? (variant === "tertiary" ? "self-start -ms-3" : "self-start") : ""
    }
  >
    {label}
  </ButtonLink>
  <p class="safe-action__context">{note ?? CONTEXT[boundary][lang]}</p>
</div>
