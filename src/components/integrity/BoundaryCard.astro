---
import type { BoundaryStatement } from "@/data/integrity";
import type { Language } from "@/data/site";

interface Props {
  boundary: BoundaryStatement;
  lang: Language;
}

const { boundary, lang } = Astro.props;

const LABELS = {
  en: {
    establishes: "What this covers",
    notEstablishes: "What this does not cover",
  },
  vi: {
    establishes: "Phạm vi áp dụng",
    notEstablishes: "Ngoài phạm vi",
  },
  zh: {
    establishes: "涵盖范围",
    notEstablishes: "不涵盖范围",
  },
  "zh-hant": {
    establishes: "涵蓋範圍",
    notEstablishes: "不涵蓋範圍",
  },
} as const;
---

<aside class="boundary-card" data-boundary-card>
  <div>
    <h2 class="boundary-card__label">{LABELS[lang].establishes}</h2>
    <p class="boundary-card__text">{boundary.claim[lang]}</p>
  </div>
  <div>
    <h2 class="boundary-card__label">{LABELS[lang].notEstablishes}</h2>
    <p class="boundary-card__text">{boundary.doesNotImply[lang]}</p>
  </div>
</aside>
