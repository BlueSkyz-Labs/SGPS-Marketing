---
/**
 * C2 P4 — compact evidence teaser (homepage meaning/trust act).
 *
 * Progressive disclosure without trust theatre: the visitor sees the
 * published claim line, and the evidence behind it opens on demand.
 *
 * Canonical consumption only. This component owns no claim text, no
 * evidence reference, no review date, and no second registry:
 *
 *   - published claim ids come from `getEvidencePassportIds`
 *     (which resolves `getPublicClaims` over the canonical fabric);
 *   - the disclosed model — claim statement, authored truth state,
 *     boundary, evidence destinations, context route — comes from the
 *     `getEvidencePassport` selector;
 *   - the deeper destination is built by `getEvidencePassportPath`;
 *   - the truth-state wording is rendered by the `TruthState` primitive.
 *
 * Fail-closed: with nothing publishable the whole block renders nothing
 * (the `: null` branch below), never an empty shell and never an invented
 * placeholder claim.
 *
 * Static-first: a native `details`/`summary` disclosure, no hydration
 * directive, no framework island, no script — the reveal and every link
 * work with JavaScript disabled.
 *
 * Labels: both EN/VI affordance strings are reused verbatim from existing
 * canonical integrity surfaces (the `EvidenceDetails` disclosure summary
 * and the evidence passport's own name). No new copy is introduced here.
 */
import {
  getClaimAnchor,
  getEvidencePassport,
  getEvidencePassportIds,
  getEvidencePassportPath,
  type EvidencePassportModel,
} from "@/lib/claims";
import { getPublicProducts } from "@/lib/products";
import TruthState from "./TruthState.astro";
import type { Language } from "@/data/site";

interface Props {
  lang: Language;
}

const { lang } = Astro.props;

const products = (await getPublicProducts()).map((product) => ({
  slug: product.data.slug,
  name: product.data.name,
}));

const teasers = getEvidencePassportIds(products)
  .map((id) => getEvidencePassport(id, products))
  .filter((passport): passport is EvidencePassportModel => passport !== null);

const LABELS = {
  en: { more: "See the evidence", passport: "Evidence passport" },
  vi: { more: "Xem bằng chứng", passport: "Hộ chiếu bằng chứng" },
} as const;

const labels = LABELS[lang];
---

{
  teasers.length > 0 ? (
    <div class="evidence-teaser" data-evidence-teaser>
      <ul class="evidence-teaser__list">
        {teasers.map((passport) => (
          <li
            class="evidence-teaser__item"
            data-evidence-teaser-item
            data-claim-id={passport.id}
          >
            <h3 class="evidence-teaser__claim" id={getClaimAnchor(passport.id)}>
              {passport.claim[lang]}
            </h3>
            <details class="evidence-teaser__more">
              <summary class="evidence-teaser__summary">{labels.more}</summary>
              <div class="evidence-teaser__reveal">
                <p class="evidence-teaser__state">
                  <TruthState state={passport.state} lang={lang} />
                </p>
                {passport.boundary ? (
                  <p
                    class="evidence-teaser__boundary"
                    data-evidence-teaser-boundary
                  >
                    {passport.boundary.doesNotImply[lang]}
                  </p>
                ) : null}
                <ul class="evidence-teaser__sources">
                  {passport.evidence.map((ref) => (
                    <li>
                      <a
                        href={ref.href[lang]}
                        rel={
                          /^https?:\/\//i.test(ref.href[lang])
                            ? "noopener noreferrer"
                            : undefined
                        }
                        class="evidence-teaser__link"
                      >
                        {ref.label[lang]}
                      </a>
                    </li>
                  ))}
                </ul>
                <p class="evidence-teaser__deep">
                  <a
                    href={getEvidencePassportPath(lang, passport.id)}
                    class="evidence-teaser__link"
                    data-evidence-teaser-passport
                  >
                    {labels.passport}
                  </a>
                </p>
              </div>
            </details>
          </li>
        ))}
      </ul>
    </div>
  ) : null
}

<style>
  .evidence-teaser__list {
    display: grid;
    gap: 1.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .evidence-teaser__item {
    min-width: 0;
  }

  .evidence-teaser__claim {
    margin: 0;
    font-size: 1.125rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.4;
    color: var(--text-primary);
    overflow-wrap: anywhere;
    text-wrap: balance;
  }

  .evidence-teaser__more {
    margin-top: 0.25rem;
  }

  .evidence-teaser__summary {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    cursor: pointer;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--action-primary);
  }

  .evidence-teaser__reveal {
    display: grid;
    gap: 0.5rem;
    margin-top: 0.25rem;
  }

  .evidence-teaser__state {
    margin: 0;
  }

  .evidence-teaser__boundary {
    margin: 0;
    max-width: 46ch;
    font-size: 0.8125rem;
    line-height: 1.5;
    color: var(--text-muted);
    overflow-wrap: anywhere;
  }

  .evidence-teaser__sources {
    display: grid;
    gap: 0.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .evidence-teaser__deep {
    margin: 0;
  }

  .evidence-teaser__link {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--action-primary);
    text-decoration: none;
    overflow-wrap: anywhere;
  }

  .evidence-teaser__link:hover {
    text-decoration: underline;
  }

  /* Paper: a collapsed toggle is dead on paper, so the reveal prints open. */
  @media print {
    .evidence-teaser__more > summary {
      display: none;
    }

    .evidence-teaser__more::details-content {
      content-visibility: visible !important;
    }

    .evidence-teaser__more > *:not(summary) {
      display: block !important;
    }
  }
</style>
