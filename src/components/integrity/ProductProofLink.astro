---
import EvidencePeek from "@/components/integrity/EvidencePeek.astro";
import type { Language } from "@/data/site";
import type { ProductProofLink as ProductProofItem } from "@/lib/product-proof";

interface Props {
  links: readonly ProductProofItem[];
  lang: Language;
}

const { links, lang } = Astro.props;

if (links.length === 0) {
  return null;
}

const primary = links[0];
const label = lang === "vi" ? "Xem bằng chứng" : "View proof";
---

<div
  class="c3-product-proof mt-2 flex flex-wrap items-start gap-x-3 gap-y-1"
  data-product-proof
>
  <a
    href={primary.passportHref[lang]}
    class="inline-flex min-h-11 items-center text-sm font-semibold text-[var(--action-primary)] no-underline hover:underline"
    data-product-proof-link
  >
    {label}
  </a>
  <EvidencePeek links={links} lang={lang} />
</div>
