---
/**
 * C3-B Task 2 (G4) — contextual, capability-bound product-to-proof affordance.
 *
 * The capability is the context: this component renders an affordance only for
 * the capability it is given, and only when the canonical selector resolves
 * public proof for that exact (product, capability) binding. With no proof it
 * renders nothing, so a surface can never grow trust chrome for something the
 * product has not published — and it can never borrow another capability's or
 * another product's evidence.
 *
 * Text carries the meaning: the item label says what will open, the canonical
 * truth state says how it is published, the boundary says what it does not
 * imply, and the destination was already vetted by the selector. The disclosure
 * is a native <details>, so it is keyboard-operable and complete without
 * JavaScript; no client script is loaded for it.
 */
import EvidencePeek from "@/components/integrity/EvidencePeek.astro";
import type { Language } from "@/data/site";
import type { PublicProductRef, ResolvedClaim } from "@/lib/claims";
import { getProductProofLinks } from "@/lib/product-proof";

interface Props {
  /** Canonical public product slug the affordance belongs to. */
  slug: string;
  /** The authored capability this affordance is bound to. */
  capability: string;
  /** Canonical public registry refs; the selector fails closed without them. */
  products: readonly PublicProductRef[];
  /** Already-resolved public claims; never re-resolved here. */
  claims: readonly ResolvedClaim[];
  lang: Language;
}

const { slug, capability, products, claims, lang } = Astro.props;

const links = getProductProofLinks(slug, capability, products, claims);
---

<EvidencePeek links={links} slug={slug} capability={capability} lang={lang} />
