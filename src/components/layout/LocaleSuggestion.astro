---
/**
 * Locale suggestion host (ADR 0009, no-cookie variant).
 *
 * Renders nothing server-side: with JavaScript disabled the banner is simply
 * absent. public/locale-suggestion-early.js builds the region before first
 * paint, the bundled script binds it; this file owns its styling.
 * Placement (Experience v6 S5): an in-flow strip directly under the header,
 * never a fixed/absolute overlay, so it can never cover first-viewport content
 * such as the hero or its call to action. It is a compact single band; the
 * one-time push it causes is bounded by its own height and it is removed by
 * either action.
 */
---

<!--
  Synchronous same-origin script (CSP script-src 'self', like theme-init.js):
  decides and inserts the strip before first paint so it causes no layout
  shift. The bundled module script below attaches the interactions.
-->
<script is:inline src="/locale-suggestion-early.js"></script>
<script>
  import { initLocaleSuggestion } from "@/scripts/locale-suggestion";

  initLocaleSuggestion();
</script>

<style is:global>
  .locale-suggestion {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.25rem 1rem;
    box-sizing: border-box;
    width: 100%;
    padding: 0.5rem 1rem;
    border-bottom: 1px solid var(--border-subtle);
    background: var(--surface-raised);
    color: var(--text-primary);
    transition: opacity 200ms ease-out;
  }

  .locale-suggestion__text {
    margin: 0;
    font-size: 0.9rem;
    font-weight: 600;
  }

  .locale-suggestion__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .locale-suggestion__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 44px;
    min-height: 44px;
    padding: 0 1rem;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm, 0.5rem);
    background: transparent;
    color: var(--text-primary);
    font: inherit;
    font-size: 0.875rem;
    font-weight: 600;
    text-decoration: none;
    cursor: pointer;
  }

  .locale-suggestion__accept {
    border-color: var(--action-fill);
    background: var(--action-fill);
    color: #ffffff;
  }

  .locale-suggestion__button:focus-visible {
    outline: 3px solid var(--focus-ring);
    outline-offset: 2px;
  }

  @starting-style {
    .locale-suggestion {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .locale-suggestion {
      transition: none;
    }
  }

  @media (forced-colors: active) {
    .locale-suggestion {
      border-bottom-color: CanvasText;
    }
  }
</style>
