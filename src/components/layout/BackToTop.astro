---
import type { Language } from "@/lib/i18n";

interface Props {
  lang: Language;
}
const LABEL: Record<string, string> = {
  en: "Back to top",
  vi: "Lên đầu trang",
  zh: "返回顶部",
  "zh-hant": "返回頂部",
};
// Outside <main> so it never counts toward page word or action caps; its own nav landmark keeps axe "region" satisfied.
const { lang } = Astro.props;
---

<nav class="back-to-top-nav" aria-label={LABEL[lang] ?? LABEL.en}>
  <a class="back-to-top" href="#top" data-back-to-top>
    {LABEL[lang] ?? LABEL.en}
  </a>
</nav>
