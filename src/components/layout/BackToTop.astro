---
import BlueSkyzIcon from "@/components/icon/BlueSkyzIcon.astro";
import type { Language } from "@/lib/i18n";

interface Props {
  lang: Language;
}
const LABEL: Record<string, string> = {
  en: "Back to top",
  vi: "Lên đầu trang",
  zh: "返回顶部",
  "zh-hant": "返回頂部",
};
// Outside <main> so it never counts toward page word or action caps; its own nav landmark keeps axe "region" satisfied.
// On phones global.css draws it as the footer's top row (F10); the icon is
// decorative because the visible text names the link.
const { lang } = Astro.props;
---

<nav class="back-to-top-nav" aria-label={LABEL[lang] ?? LABEL.en}>
  <a class="back-to-top" href="#top" data-back-to-top>
    <BlueSkyzIcon name="arrow-right" class="back-to-top__icon" />
    {LABEL[lang] ?? LABEL.en}
  </a>
</nav>
