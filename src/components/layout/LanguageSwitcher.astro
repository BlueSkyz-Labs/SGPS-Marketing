---
import {
  SUPPORTED_LANGUAGES,
  LANGUAGES,
  getAlternatePath,
  getLanguageFromPath,
} from "@/lib/i18n";
import { languageTransitionStyle } from "@/lib/route-transition";

interface Props {
  variant?: "light" | "dark";
}

const { variant = "light" } = Astro.props;
const currentPath = Astro.url.pathname;
const currentLang = getLanguageFromPath(currentPath);
---

<div
  class="flex min-w-0 flex-wrap items-center gap-1"
  role="navigation"
  aria-label={currentLang === "vi" ? "Ngôn ngữ" : "Language"}
>
  {
    SUPPORTED_LANGUAGES.map((lang) => {
      const isActive = currentLang === lang;
      const activeClasses =
        variant === "dark"
          ? "text-[var(--brand-porcelain)] bg-white/10"
          : "text-[var(--text-primary)] bg-[var(--surface-subtle)]";
      const idleClasses =
        variant === "dark"
          ? "text-[color-mix(in_srgb,var(--brand-porcelain)_82%,white)] hover:text-white"
          : "text-[var(--text-secondary)] hover:text-[var(--text-primary)]";
      return (
        <a
          href={getAlternatePath(currentPath, lang)}
          data-language-choice={lang}
          hreflang={LANGUAGES[lang].hreflang}
          aria-current={isActive ? "page" : undefined}
          style={languageTransitionStyle(lang)}
          class:list={[
            "inline-flex min-h-11 min-w-0 items-center px-3 text-sm font-medium no-underline rounded-md transition-colors",
            isActive ? activeClasses : idleClasses,
          ]}
        >
          {LANGUAGES[lang].label}
        </a>
      );
    })
  }
</div>


<script>
  import { LANGUAGE_STORAGE_KEY, isActiveLanguage } from "@/lib/i18n";

  document.addEventListener("click", (event) => {
    const target = event.target;
    if (!(target instanceof Element)) return;
    const link = target.closest<HTMLAnchorElement>("[data-language-choice]");
    const language = link?.dataset.languageChoice;
    if (!isActiveLanguage(language)) return;
    try {
      window.localStorage.setItem(LANGUAGE_STORAGE_KEY, language);
    } catch {
      // Preference persistence is best-effort; navigation remains functional.
    }
  });
</script>
