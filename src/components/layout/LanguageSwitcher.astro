---
import {
  SUPPORTED_LANGUAGES,
  LANGUAGES,
  getAlternatePath,
  getLanguageFromPath,
} from "@/lib/i18n";
import { languageTransitionStyle } from "@/lib/route-transition";

interface Props {
  variant?: "light" | "dark";
}

const { variant = "light" } = Astro.props;
const currentPath = Astro.url.pathname;
const currentLang = getLanguageFromPath(currentPath);

const NATIVE_NAMES = {
  en: "English",
  vi: "Tiếng Việt",
  zh: "中文",
} as const;

const GROUP_LABEL: Record<string, string> = {
  en: "Language",
  vi: "Ngôn ngữ",
  zh: "语言",
};
const aria = GROUP_LABEL[currentLang] ?? GROUP_LABEL.en;
const CODE: Record<string, string> = { en: "EN", vi: "VI", zh: "ZH" };

const isDark = variant === "dark";
---

<nav
  aria-label={aria}
  data-language-switcher
  class:list={[
    "lang-toggle-shell",
    isDark ? "lang-toggle-shell--dark" : "lang-toggle-shell--light",
  ]}
>
  {SUPPORTED_LANGUAGES.map((lang) => {
    const isActive = currentLang === lang;
    return (
      <a
        href={getAlternatePath(currentPath, lang)}
        data-language-choice={lang}
        hreflang={LANGUAGES[lang].hreflang}
        aria-current={isActive ? "page" : undefined}
        aria-label={`${CODE[lang]} — ${NATIVE_NAMES[lang as keyof typeof NATIVE_NAMES]}`}
        title={NATIVE_NAMES[lang as keyof typeof NATIVE_NAMES]}
        style={languageTransitionStyle(lang)}
        class:list={[
          "lang-toggle-item",
          isActive ? "lang-toggle-item--active" : "lang-toggle-item--idle",
        ]}
      >
        <span
          class:list={[
            "lang-toggle-flag",
            isActive ? "lang-toggle-flag--visible" : "lang-toggle-flag--hidden",
          ]}
          aria-hidden="true"
        >
          <img
            src={`/brand/blueskyz/flags/${lang}.svg`}
            alt=""
            width="20"
            height="20"
            loading="eager"
            decoding="async"
          />
        </span>
        <span class="lang-toggle-code">{CODE[lang]}</span>
      </a>
    );
  })}
</nav>

<style>
  /* ─── Shell ─────────────────────────────────────────────────────────── */
  .lang-toggle-shell {
    display: inline-flex;
    align-items: center;
    gap: 2px;
    padding: 3px;
    border-radius: 999px;
    /* Neumorphic inset cavity — carved-in look */
    box-shadow:
      inset 2px 2px 5px rgba(11, 16, 32, 0.12),
      inset -2px -2px 4px rgba(255, 255, 255, 0.72);
  }

  .lang-toggle-shell--light {
    background: var(--brand-porcelain, #f7f8fa);
    border: 1px solid rgba(11, 16, 32, 0.08);
  }

  /* F-21: the shell, the active pill and the idle label must flip together with
     the theme. The pill used `--surface-raised` (dark in dark mode) with a fixed
     ink token, which rendered 1.06:1 on dark. The dark theme keeps a dark
     cavity instead of the porcelain one. */
  :global([data-theme="dark"]) .lang-toggle-shell--light {
    background: var(--surface-raised, #0f172a);
    border-color: rgba(255, 255, 255, 0.12);
    box-shadow:
      inset 2px 2px 5px rgba(0, 0, 0, 0.3),
      inset -2px -2px 4px rgba(255, 255, 255, 0.05);
  }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"])) .lang-toggle-shell--light {
      background: var(--surface-raised, #0f172a);
      border-color: rgba(255, 255, 255, 0.12);
      box-shadow:
        inset 2px 2px 5px rgba(0, 0, 0, 0.3),
        inset -2px -2px 4px rgba(255, 255, 255, 0.05);
    }
  }

  .lang-toggle-shell--dark {
    background: rgba(255, 255, 255, 0.08);
    box-shadow:
      inset 2px 2px 5px rgba(0, 0, 0, 0.3),
      inset -2px -2px 4px rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.12);
  }

  /* ─── Item ───────────────────────────────────────────────────────────── */
  .lang-toggle-item {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 5px;
    min-width: 44px;
    min-height: 44px;
    padding: 0 10px;
    border-radius: 999px;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-decoration: none;
    transition:
      background 180ms
        var(--motion-ease-standard, cubic-bezier(0.22, 1, 0.36, 1)),
      box-shadow 180ms
        var(--motion-ease-standard, cubic-bezier(0.22, 1, 0.36, 1)),
      color 120ms ease;
    white-space: nowrap;
  }

  /* Active pill — floats with convex neumorphic shadow */
  .lang-toggle-shell--light .lang-toggle-item--active {
    background: var(--surface-raised);
    color: var(--text-primary);
    box-shadow:
      2px 2px 6px rgba(11, 16, 32, 0.14),
      -1px -1px 4px rgba(255, 255, 255, 0.9);
  }

  .lang-toggle-shell--dark .lang-toggle-item--active {
    background: rgba(255, 255, 255, 0.14);
    color: var(--brand-porcelain, #f7f8fa);
    box-shadow:
      2px 2px 6px rgba(0, 0, 0, 0.35),
      -1px -1px 3px rgba(255, 255, 255, 0.06);
  }

  /* Idle — transparent, muted text (theme-aware: #475569 light / #94a3b8 dark) */
  .lang-toggle-shell--light .lang-toggle-item--idle {
    background: transparent;
    color: var(--text-muted);
  }

  .lang-toggle-shell--dark .lang-toggle-item--idle {
    background: transparent;
    color: rgba(247, 248, 250, 0.6);
  }

  .lang-toggle-item--idle:hover {
    color: var(--text-primary);
  }

  .lang-toggle-shell--dark .lang-toggle-item--idle:hover {
    color: var(--brand-porcelain, #f7f8fa);
  }

  /* ─── Flag badge ─────────────────────────────────────────────────────── */
  .lang-toggle-flag {
    display: inline-flex;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    overflow: hidden;
    flex-shrink: 0;
    box-shadow: 0 1px 3px rgba(11, 16, 32, 0.2);
  }

  .lang-toggle-flag img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 50%;
  }

  .lang-toggle-flag--hidden {
    width: 0;
    opacity: 0;
    overflow: hidden;
    pointer-events: none;
    transform: scale(0.6);
    transition:
      width 180ms var(--motion-ease-standard, cubic-bezier(0.22, 1, 0.36, 1)),
      opacity 150ms ease,
      transform 180ms
        var(--motion-ease-standard, cubic-bezier(0.22, 1, 0.36, 1));
  }

  .lang-toggle-flag--visible {
    width: 20px;
    opacity: 1;
    transform: scale(1);
    transition:
      width 180ms var(--motion-ease-standard, cubic-bezier(0.22, 1, 0.36, 1)),
      opacity 150ms ease,
      transform 180ms
        var(--motion-ease-standard, cubic-bezier(0.22, 1, 0.36, 1));
  }

  /* ─── Code text ──────────────────────────────────────────────────────── */
  .lang-toggle-code {
    font-variant-numeric: tabular-nums;
  }

  /* ─── Reduced motion ─────────────────────────────────────────────────── */
  @media (prefers-reduced-motion: reduce) {
    .lang-toggle-item,
    .lang-toggle-flag--hidden,
    .lang-toggle-flag--visible {
      transition: none !important;
    }
  }
</style>

<script>
  import { LANGUAGE_STORAGE_KEY, isActiveLanguage } from "@/lib/i18n";

  document.addEventListener("click", (event) => {
    const target = event.target;
    if (!(target instanceof Element)) return;
    const link = target.closest<HTMLAnchorElement>("[data-language-choice]");
    const language = link?.dataset.languageChoice;
    if (!isActiveLanguage(language)) return;
    try {
      window.localStorage.setItem(LANGUAGE_STORAGE_KEY, language);
    } catch {
      // Preference persistence is best-effort; navigation remains functional.
    }
  });
</script>
