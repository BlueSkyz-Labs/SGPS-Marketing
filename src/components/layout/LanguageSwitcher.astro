---
import {
  SUPPORTED_LANGUAGES,
  LANGUAGES,
  getAlternatePath,
  getLanguageFromPath,
} from "@/lib/i18n";
import { languageTransitionStyle } from "@/lib/route-transition";

interface Props {
  variant?: "light" | "dark";
}

const { variant = "light" } = Astro.props;
const currentPath = Astro.url.pathname;
const currentLang = getLanguageFromPath(currentPath);

const NATIVE_NAMES = { en: "English", vi: "Tiếng Việt", zh: "中文" } as const;
const GROUP_LABEL: Record<string, string> = {
  en: "Language",
  vi: "Ngôn ngữ",
  zh: "语言",
};
const aria = GROUP_LABEL[currentLang] ?? GROUP_LABEL.en;
const CODE: Record<string, string> = { en: "EN", vi: "VI", zh: "中文" };
---

<div
  role="navigation"
  aria-label={aria}
  class="inline-flex min-w-0 flex-wrap items-center gap-0.5 rounded-lg border border-[var(--border-subtle)] bg-[var(--surface-primary)] p-0.5"
>
  {
    SUPPORTED_LANGUAGES.map((lang) => {
      const isActive = currentLang === lang;
      const activeClasses =
        variant === "dark"
          ? "text-[var(--brand-porcelain)] bg-white/10 shadow-[inset_0_0_0_1px_rgba(255,255,255,0.15)]"
          : "text-[var(--text-primary)] bg-[var(--surface-subtle)] shadow-[inset_0_0_0_1px_var(--border-subtle)]";
      const idleClasses =
        variant === "dark"
          ? "text-[color-mix(in_srgb,var(--brand-porcelain)_82%,white)] hover:text-white"
          : "text-[var(--text-secondary)] hover:text-[var(--text-primary)]";
      return (
        <a
          href={getAlternatePath(currentPath, lang)}
          data-language-choice={lang}
          hreflang={LANGUAGES[lang].hreflang}
          aria-current={isActive ? "page" : undefined}
          aria-label={NATIVE_NAMES[lang as keyof typeof NATIVE_NAMES]}
          title={NATIVE_NAMES[lang as keyof typeof NATIVE_NAMES]}
          style={`${languageTransitionStyle(lang)}; min-width: 44px; min-height: 44px`}
          class:list={[
            "inline-flex min-h-11 min-w-11 items-center justify-center px-2 text-sm font-semibold no-underline rounded-md transition-colors",
            isActive ? activeClasses : idleClasses,
          ]}
        >
          {CODE[lang] ?? LANGUAGES[lang].label}
        </a>
      );
    })
  }
</div>

<script>
  import { LANGUAGE_STORAGE_KEY, isActiveLanguage } from "@/lib/i18n";

  document.addEventListener("click", (event) => {
    const target = event.target;
    if (!(target instanceof Element)) return;
    const link = target.closest<HTMLAnchorElement>("[data-language-choice]");
    const language = link?.dataset.languageChoice;
    if (!isActiveLanguage(language)) return;
    try {
      window.localStorage.setItem(LANGUAGE_STORAGE_KEY, language);
    } catch {
      // Preference persistence is best-effort; navigation remains functional.
    }
  });
</script>
