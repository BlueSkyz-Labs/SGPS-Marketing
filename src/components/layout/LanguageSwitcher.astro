---
/**
 * Language switcher — globe + language code trigger, native Popover panel.
 *
 * Visual family shared with the theme control and the search trigger through
 * ONE stylesheet (./header-control.css: hc-trigger / hc-panel / hc-row).
 * Language identity never uses country flags (ADR 0009, re-affirmed by the
 * Owner on 2026-10-05 for the portfolio): flags name countries, not languages.
 * The trigger is a brand-tinted globe + the ISO 639-1 code (VI, EN) + chevron
 * at every width; each panel row leads with a brand-tinted code chip and the
 * native name. The trigger is a real <button popovertarget>, and the
 * panel is a `popover` element, so the disclosure opens, light-dismisses and
 * closes on Escape with no JavaScript and under `script-src 'self'`. Every row
 * is a plain <a href hreflang lang> to the same page in that language. The
 * current row carries `aria-current="page"` AND a visible check mark.
 */
import BlueSkyzIcon from "@/components/icon/BlueSkyzIcon.astro";
import {
  SUPPORTED_LANGUAGES,
  LANGUAGES,
  getAlternatePath,
  getLanguageFromPath,
  type Language,
} from "@/lib/i18n";
import { languageTransitionStyle } from "@/lib/route-transition";
import "./header-control.css";

interface Props {
  /** `dark` sits on the always-ink footer; `light` follows the header scene. */
  variant?: "light" | "dark";
  /** Unique per rendered instance: it names the popover and its anchor. */
  placement?: "header" | "menu" | "footer";
}

const { variant = "light", placement = "header" } = Astro.props;
const currentPath = Astro.url.pathname;
const currentLang = getLanguageFromPath(currentPath);
const current = LANGUAGES[currentLang];

const GROUP_LABEL: Record<Language, string> = {
  en: "Language",
  vi: "Ngôn ngữ",
  zh: "语言",
  "zh-hant": "語言",
};
const groupLabel = GROUP_LABEL[currentLang];
const panelId = `lang-panel-${placement}`;
const anchor = `--lang-anchor-${placement}`;
// WCAG 2.5.3: the accessible name contains the visible short code.
const triggerName = `${current.shortLabel} · ${groupLabel}: ${current.label}`;
const isMenu = placement === "menu";
---

<div
  class:list={[
    "lang-switch",
    `lang-switch--${variant}`,
    `lang-switch--${placement}`,
    { "hc-group": isMenu, "hc-on-ink": variant === "dark" },
  ]}
  data-language-switcher
  data-current-language={currentLang}
>
  {/* In the compact menu the trigger is a row of the shared row system under
      the same caption the panel uses; elsewhere it is the header pill. */}
  {isMenu ? (
    <div class="hc-caption" aria-hidden="true">
      <BlueSkyzIcon name="globe" />
      <span>{groupLabel}</span>
    </div>
  ) : null}
  <button
    type="button"
    class:list={[
      "lang-switch__trigger",
      isMenu ? "hc-row hc-row--disclosure" : "hc-trigger",
    ]}
    popovertarget={panelId}
    aria-label={triggerName}
    aria-expanded="false"
    data-language-trigger
    style={`anchor-name: ${anchor}`}
  >
    <span class="lang-switch__globe hc-glyph" aria-hidden="true">
      <BlueSkyzIcon name="globe" />
    </span>
    <span class="lang-switch__code" lang={current.hreflang}>
      {current.shortLabel}
    </span>
    <span
      class:list={["lang-switch__name", { "hc-row__label": isMenu }]}
      lang={current.hreflang}
    >
      {current.label}
    </span>
    <span class="hc-chevron" aria-hidden="true">
      <BlueSkyzIcon name="chevron-down" class="h-3.5 w-3.5" />
    </span>
  </button>

  <nav
    id={panelId}
    popover="auto"
    class="lang-panel hc-panel"
    aria-label={groupLabel}
    data-language-panel
    style={`position-anchor: ${anchor}`}
  >
    {/* Visible caption only: the nav's aria-label already names the panel, so
        the caption is aria-hidden to avoid announcing the name twice. */}
    <div class="hc-caption lang-panel__caption" aria-hidden="true">
      <BlueSkyzIcon name="globe" />
      <span>{groupLabel}</span>
    </div>
    <ul class="lang-panel__list" role="list">
      {SUPPORTED_LANGUAGES.map((lang) => {
        const config = LANGUAGES[lang];
        const isActive = currentLang === lang;
        const showEnglish = config.englishLabel !== config.label;
        return (
          <li>
            <a
              href={getAlternatePath(currentPath, lang)}
              data-language-choice={lang}
              hreflang={config.hreflang}
              lang={config.hreflang}
              aria-current={isActive ? "page" : undefined}
              style={languageTransitionStyle(lang)}
              class:list={[
                "lang-option hc-row",
                isActive ? "lang-option--current" : "lang-option--idle",
              ]}
            >
              <span class="hc-row__lead lang-chip" aria-hidden="true">
                {config.shortLabel}
              </span>
              <span class="hc-row__text">
                <span class="lang-option__native hc-row__label">
                  {config.label}
                </span>
                {showEnglish ? (
                  <span class="lang-option__english hc-row__sub" lang="en">
                    {config.englishLabel}
                  </span>
                ) : null}
              </span>
              <span class="hc-check lang-option__check" aria-hidden="true">
                {isActive ? (
                  <BlueSkyzIcon name="check" class="h-5 w-5" />
                ) : null}
              </span>
            </a>
          </li>
        );
      })}
    </ul>
  </nav>
</div>

<style>
  /* Trigger, panel, caption and row styling come from the shared
     header-control.css; only the switcher-specific layout lives here. */
  .lang-switch {
    display: inline-flex;
    align-self: flex-start;
  }

  /* Compact menu: a full-width captioned row group, like the theme rows. */
  .lang-switch--menu {
    display: grid;
    align-self: stretch;
  }

  /* Brand colour lives in the globe, never in a national symbol. */
  .lang-switch__globe {
    color: var(--hc-accent);
  }

  .lang-switch__code {
    font-variant-numeric: tabular-nums;
    min-width: 1.25ch;
    text-align: center;
  }

  /* Header and footer pill: the code at every width; the native name is only
     in the accessible name and the panel rows. */
  .lang-switch__name {
    display: none;
    white-space: nowrap;
  }

  /* Panel row lead: the language code on a brand tint. The text is the
     family foreground, so it keeps AA contrast on the tint in every theme. */
  .lang-chip {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 2rem;
    height: 1.5rem;
    padding: 0 0.375rem;
    border-radius: var(--radius-sm);
    background: color-mix(in srgb, var(--hc-accent) 16%, transparent);
    box-shadow: inset 0 0 0 1px
      color-mix(in srgb, var(--hc-accent) 30%, transparent);
    color: var(--hc-fg);
    font-size: var(--size-1);
    font-weight: 600;
    letter-spacing: 0.04em;
    line-height: 1;
  }

  /* Menu row: globe | native name | chevron at every width. */
  .lang-switch--menu .lang-switch__code {
    display: none;
  }

  .lang-switch--menu .lang-switch__name {
    display: block;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .lang-panel__list {
    display: grid;
    gap: 0.125rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* The footer sits low on the page: open the panel above its trigger. */
  @supports (anchor-name: --lang-probe) {
    .lang-switch--footer .lang-panel {
      top: auto;
      bottom: calc(anchor(top) + 0.5rem);
      left: anchor(left);
      right: auto;
      transform-origin: bottom left;
    }
  }

  @media (max-width: 40rem) {
    .lang-switch--footer .lang-panel {
      inset: auto 0.75rem 0.75rem 0.75rem;
      transform-origin: bottom center;
    }
  }

  /* Engines without the Popover API render the list inline instead. */
  @supports not selector(:popover-open) {
    .lang-switch {
      flex-direction: column;
      gap: 0.5rem;
    }

    .lang-switch__trigger {
      display: none;
    }

    .lang-panel {
      display: grid;
      position: static;
      width: auto;
      opacity: 1;
      transform: none;
      box-shadow: none;
    }
  }
</style>

<script>
  import { LANGUAGE_STORAGE_KEY, isActiveLanguage } from "@/lib/i18n";

  document.addEventListener("click", (event) => {
    const target = event.target;
    if (!(target instanceof Element)) return;
    const link = target.closest<HTMLAnchorElement>("[data-language-choice]");
    const language = link?.dataset.languageChoice;
    if (!isActiveLanguage(language)) return;
    try {
      window.localStorage.setItem(LANGUAGE_STORAGE_KEY, language);
    } catch {
      // Preference persistence is best-effort; navigation remains functional.
    }
  });

  // Progressive enhancement only: the popover opens and closes without this.
  // `toggle` does not bubble, so listen in the capture phase and keep the
  // trigger's aria-expanded truthful for engines that do not reflect it.
  document.addEventListener(
    "toggle",
    (event) => {
      const panel = event.target;
      if (!(panel instanceof HTMLElement)) return;
      if (!panel.hasAttribute("data-language-panel")) return;
      const open = (event as ToggleEvent).newState === "open";
      for (const trigger of document.querySelectorAll(
        `[data-language-trigger][popovertarget="${panel.id}"]`,
      )) {
        trigger.setAttribute("aria-expanded", String(open));
      }
    },
    true,
  );
</script>
