---
interface Props {
  class?: string;
  /** "wide" (default) or the narrower reading measure. */
  width?: "wide" | "reading";
}
const { class: className = "", width = "wide" } = Astro.props;
---

<div
  class:list={[
    "site-container",
    width === "reading" && "site-container--reading",
    className,
  ]}
>
  <slot />
</div>
