---
import BrandLockup from "@/components/brand/BrandLockup.astro";
import Container from "@/components/layout/Container.astro";
import LanguageSwitcher from "@/components/layout/LanguageSwitcher.astro";
import ButtonLink from "@/components/ui/ButtonLink.astro";
import { SITE, SHARED_LABELS, labelFor, getNav } from "@/data/site";
import { emptyRegistryPrimaryCta } from "@/lib/act";
import { getPublicProducts } from "@/lib/products";
import { getLanguageFromPath } from "@/lib/i18n";

const currentPath = Astro.url.pathname;
const lang = getLanguageFromPath(currentPath);
const NAV = getNav(lang);

const isActive = (href: string): boolean =>
  currentPath.replace(/\/+$/, "") === href.replace(/\/+$/, "");

const hasPublicProducts = (await getPublicProducts()).length > 0;
const primaryCta = hasPublicProducts
  ? SITE.contactEmail
    ? {
        href: `/${lang}/contact/`,
        label: labelFor(SHARED_LABELS.contactUs, lang),
      }
    : {
        href: `/${lang}/products/`,
        label: labelFor(SHARED_LABELS.exploreProducts, lang),
      }
  : emptyRegistryPrimaryCta(SITE.contactEmail, lang);
---

<header
  class="border-b border-[var(--border-subtle)] bg-[var(--surface-primary)]"
>
  <Container
    class="flex min-h-16 flex-wrap items-center justify-between gap-x-4 gap-y-1 py-3"
  >
    <BrandLockup href={`/${lang}/`} />

    <nav
      aria-label={lang === "vi" ? "Chính" : "Primary"}
      class="hidden items-center gap-2 md:flex"
    >
      <button
        type="button"
        data-command-trigger
        aria-keyshortcuts="Control+K Meta+K"
        class="inline-flex min-h-11 items-center gap-2 rounded-lg border border-[var(--border-subtle)] px-3 text-sm font-medium text-[var(--text-secondary)] transition-colors hover:text-[var(--text-primary)]"
      >
        {labelFor(SHARED_LABELS.search, lang)}
        <kbd
          class="rounded border border-[var(--border-subtle)] bg-[var(--surface-subtle)] px-1.5 py-0.5 text-[0.65rem] font-medium"
          >Ctrl / ⌘K</kbd
        >
      </button>
      {
        NAV.map((item) => (
          <a
            href={item.href}
            aria-current={isActive(item.href) ? "page" : undefined}
            class="inline-flex min-h-11 items-center px-3 text-sm font-medium text-[var(--text-secondary)] no-underline hover:text-[var(--text-primary)]"
          >
            {item.label}
          </a>
        ))
      }
      <LanguageSwitcher />
      <ButtonLink href={primaryCta.href} variant="primary"
        >{primaryCta.label}</ButtonLink
      >
    </nav>

    <details class="relative md:hidden">
      <summary
        class="inline-flex min-h-11 min-w-11 list-none items-center justify-center rounded-lg border border-[var(--border-subtle)] px-3 text-sm font-medium"
        >{labelFor(SHARED_LABELS.menu, lang)}</summary
      >
      <div
        class="absolute right-0 z-20 mt-2 w-56 rounded-lg border border-[var(--border-subtle)] bg-white p-3 shadow-sm"
      >
        <nav
          aria-label={lang === "vi" ? "Di động" : "Mobile"}
          class="flex flex-col gap-2"
        >
          <button
            type="button"
            data-command-trigger
            aria-keyshortcuts="Control+K Meta+K"
            class="min-h-11 rounded-md border border-[var(--border-subtle)] px-3 py-2 text-left text-sm font-medium text-[var(--text-primary)]"
          >
            {labelFor(SHARED_LABELS.searchPages, lang)}
          </button>
          {
            NAV.map((item) => (
              <a
                href={item.href}
                aria-current={isActive(item.href) ? "page" : undefined}
                class="min-h-11 rounded-md px-3 py-2 text-sm font-medium text-[var(--text-primary)] no-underline hover:bg-[var(--surface-subtle)]"
              >
                {item.label}
              </a>
            ))
          }
          <LanguageSwitcher />
          <ButtonLink href={primaryCta.href} class="w-full"
            >{primaryCta.label}</ButtonLink
          >
        </nav>
      </div>
    </details>
  </Container>
</header>
