---
import BrandLockup from "@/components/brand/BrandLockup.astro";
import BlueSkyzIcon from "@/components/icon/BlueSkyzIcon.astro";
import Container from "@/components/layout/Container.astro";
import LanguageSwitcher from "@/components/layout/LanguageSwitcher.astro";
import ThemeToggle from "@/components/layout/ThemeToggle.astro";
import "@/components/layout/header-control.css";
import ButtonLink from "@/components/ui/ButtonLink.astro";
import { SHARED_LABELS, labelFor, getNav } from "@/data/site";
import { getLanguageFromPath } from "@/lib/i18n";
import { journalNavItems } from "@/lib/journal-nav";
import { getCollection } from "astro:content";
import { DEFAULT_SCENE, lockupSurface, type Scene } from "@/lib/scene";

interface Props {
  /** Authored scene marker (C3-A Task 4 / design S4). */
  scene?: Scene;
}

const { scene = DEFAULT_SCENE } = Astro.props;

const currentPath = Astro.url.pathname;
const lang = getLanguageFromPath(currentPath);
// Owner decision 2026-10-20 (TRU-15): the Journal joins the navigation only
// once the collection holds a published entry (empty today, so no item).
const NAV = [
  ...getNav(lang),
  ...journalNavItems(lang, await getCollection("journal")),
];

const trimmed = (path: string): string => path.replace(/\/+$/, "");
const isActive = (href: string): boolean =>
  trimmed(currentPath) === trimmed(href);

// Owner decision 2026-10-01 (v7 A-12): the one filled CTA leads to Products.
// Owner decision 2026-10-18 (audit A-03): About and Contact are the plain
// links, so desktop carries the same routes as the compact menu (seven
// controls: lockup, About, Contact, search, language, theme, CTA). Every
// other route stays in the command navigator and the footer.
const primaryCta = NAV[0]!;
const plainLinks = NAV.slice(1);
---

<header
  data-scene={scene}
  class="header-glass border-b text-[var(--text-primary)]"
>
  <Container class="header-bar flex min-h-16 flex-wrap items-center justify-between gap-x-4 gap-y-1 py-3">
    <BrandLockup href={`/${lang}/`} surface={lockupSurface(scene)} />

    <nav
      aria-label={labelFor(SHARED_LABELS.primaryNav, lang)}
      class="hidden flex-wrap items-center gap-2 md:flex"
    >
      {plainLinks.map((link) => (
        <a
          href={link.href}
          aria-current={isActive(link.href) ? "page" : undefined}
          class="inline-flex min-h-11 items-center px-3 text-sm font-medium text-[var(--text-secondary)] no-underline hover:text-[var(--text-primary)]"
        >
          {link.label}
        </a>
      ))}
      <button
        type="button"
        data-command-trigger
        aria-keyshortcuts="Control+K Meta+K"
        title={`${labelFor(SHARED_LABELS.search, lang)} (Ctrl / ⌘K)`}
        class="hc-trigger hc-trigger--icon"
      >
        <BlueSkyzIcon name="search" class="hc-glyph" />
        <span class="sr-only">{labelFor(SHARED_LABELS.search, lang)}</span>
      </button>
      <LanguageSwitcher placement="header" />
      <ThemeToggle lang={lang} placement="header" />
      <ButtonLink
        href={primaryCta.href}
        variant="primary"
        aria-current={isActive(primaryCta.href) ? "page" : undefined}
      >
        {primaryCta.label}
      </ButtonLink>
    </nav>

    <details class="md:hidden">
      <summary class="inline-flex min-h-11 min-w-11 list-none items-center justify-center rounded-lg border border-[var(--border-subtle)] px-3 text-sm font-medium">
        {labelFor(SHARED_LABELS.menu, lang)}
      </summary>
      <div class="absolute right-4 z-20 mt-2 w-[min(16rem,calc(100vw-2rem))] rounded-lg border border-[var(--border-subtle)] bg-[var(--surface-primary)] p-3 shadow-sm">
        <nav
          aria-label={labelFor(SHARED_LABELS.mobileNav, lang)}
          class="flex flex-col gap-2"
        >
          <button
            type="button"
            data-command-trigger
            aria-keyshortcuts="Control+K Meta+K"
            class="inline-flex min-h-11 items-center gap-2 rounded-md border border-[var(--border-subtle)] px-3 py-2 text-left text-sm font-medium text-[var(--text-primary)]"
          >
            <BlueSkyzIcon name="search" class="h-4 w-4 shrink-0" />
            {labelFor(SHARED_LABELS.searchPages, lang)}
          </button>
          {NAV.map((item) => (
            <a
              href={item.href}
              aria-current={isActive(item.href) ? "page" : undefined}
              class="min-h-11 rounded-md px-3 py-2 text-sm font-medium text-[var(--text-primary)] no-underline hover:bg-[var(--surface-subtle)]"
            >
              {item.label}
            </a>
          ))}
          <hr class="my-1 border-[var(--border-subtle)]" />
          <LanguageSwitcher placement="menu" />
          <ThemeToggle lang={lang} placement="menu" />
        </nav>
      </div>
    </details>
  </Container>
</header>
