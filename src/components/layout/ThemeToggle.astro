---
import type { Language } from "@/lib/i18n";
interface Props {
  lang?: Language;
  /** Extra classes for the wrapper (e.g. vertical spacing inside the mobile menu). */
  class?: string;
  /** `popover`: one compact header trigger that opens the three-way group. */
  variant?: "inline" | "popover";
}

const { lang = "en", class: className = "", variant = "inline" } = Astro.props;
const asPopover = variant === "popover";
const panelId = "theme-panel-header";

const L = {
  en: { label: "Theme", system: "System", light: "Light", dark: "Dark" },
  vi: { label: "Giao diện", system: "Tự động", light: "Sáng", dark: "Tối" },
  zh: { label: "主题", system: "跟随系统", light: "浅色", dark: "深色" },
  "zh-hant": { label: "主題", system: "跟隨系統", light: "淺色", dark: "深色" },
}[lang];

const base =
  "inline-flex min-h-11 min-w-11 items-center justify-center rounded-md px-2 text-xs font-medium";
const idle = "text-[var(--text-secondary)] hover:text-[var(--text-primary)]";
---

{asPopover ? (
  <button
    type="button"
    class="theme-trigger"
    popovertarget={panelId}
    aria-label={L.label}
    aria-expanded="false"
    title={L.label}
    data-theme-trigger
  >
    <svg
      viewBox="0 0 20 20"
      class="h-5 w-5"
      aria-hidden="true"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
    >
      <circle cx="10" cy="10" r="7"></circle>
      <path d="M10 3a7 7 0 0 1 0 14Z" fill="currentColor" stroke="none"></path>
    </svg>
  </button>
) : null}
<div
  role="group"
  id={asPopover ? panelId : undefined}
  popover={asPopover ? "auto" : undefined}
  aria-label={L.label}
  class:list={[
    "flex items-center gap-0.5 rounded-lg border border-[var(--border-subtle)] bg-[var(--surface-primary)] p-0.5",
    asPopover && "theme-panel",
    className,
  ]}
>
  <button
    type="button"
    data-theme-mode="system"
    data-theme-toggle
    aria-pressed="false"
    aria-label={L.system}
    class:list={[base, idle]}
    title={L.system}
  >
    <svg
      viewBox="0 0 20 20"
      class="h-4 w-4"
      aria-hidden="true"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
    >
      <rect x="2.5" y="3.5" width="15" height="13" rx="2"></rect>
      <path d="M2.5 7.5h15M7 16.5V8.5"></path>
    </svg>
  </button>
  <button
    type="button"
    data-theme-mode="light"
    data-theme-toggle
    aria-pressed="false"
    aria-label={L.light}
    class:list={[base, idle]}
    title={L.light}
  >
    <svg
      viewBox="0 0 20 20"
      class="h-4 w-4"
      aria-hidden="true"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
    >
      <circle cx="10" cy="10" r="3.25"></circle>
      <path d="M10 2v1.5M10 16.5V18M2 10h1.5M16.5 10H18M4.3 4.3l1.05 1.05M14.65 14.65l1.05 1.05M15.7 4.3l-1.05 1.05M5.35 14.65l-1.05 1.05"></path>
    </svg>
  </button>
  <button
    type="button"
    data-theme-mode="dark"
    data-theme-toggle
    aria-pressed="false"
    aria-label={L.dark}
    class:list={[base, idle]}
    title={L.dark}
  >
    <svg
      viewBox="0 0 20 20"
      class="h-4 w-4"
      aria-hidden="true"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
    >
      <path d="M15.5 12.5A5.5 5.5 0 1 1 7.5 4.5a4.5 4.5 0 0 0 8 8Z"></path>
    </svg>
  </button>
</div>

<style>
  .theme-trigger {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 44px;
    min-height: 44px;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm, 0.5rem);
    background: transparent;
    color: var(--text-secondary);
    cursor: pointer;
    anchor-name: --theme-anchor;
    transition:
      background-color 150ms var(--motion-ease-standard, ease),
      color 150ms var(--motion-ease-standard, ease);
  }
  .theme-trigger:hover,
  .theme-trigger[aria-expanded="true"] {
    color: var(--text-primary);
    background: color-mix(in srgb, currentColor 9%, transparent);
  }
  .theme-trigger:focus-visible {
    outline: 3px solid var(--focus-ring, #1d4ed8);
    outline-offset: 2px;
  }
  /* ADR 0012: the header is the only translucent surface; this panel is solid. */
  .theme-panel {
    position: fixed;
    inset: auto;
    margin: 0;
    background: var(--surface-raised, #fff);
    color: var(--text-primary);
    box-shadow:
      0 1px 2px rgba(11, 16, 32, 0.12),
      0 18px 44px -12px rgba(11, 16, 32, 0.4);
  }
  .theme-panel:not(:popover-open) {
    display: none;
  }
  .theme-panel:popover-open {
    display: flex;
  }
  @supports (anchor-name: --theme-probe) {
    .theme-panel {
      position-anchor: --theme-anchor;
      top: calc(anchor(bottom) + 0.5rem);
      right: anchor(right);
      position-try-fallbacks: flip-block, flip-inline;
    }
  }
  @supports not (anchor-name: --theme-probe) {
    .theme-panel {
      inset: 4.5rem 1rem auto auto;
    }
  }
</style>

<script>
  import { applyTheme, initTheme, type ThemeMode } from "@/lib/theme";

  const MODES: ThemeMode[] = ["system", "light", "dark"];
  const ACTIVE =
    "text-[var(--text-primary)] bg-[var(--surface-subtle)] shadow-[inset_0_0_0_1px_var(--border-subtle)]";
  let mode: ThemeMode = initTheme();
  const buttons = [
    ...document.querySelectorAll<HTMLButtonElement>("[data-theme-toggle]"),
  ];

  function paint(): void {
    for (const button of buttons) {
      const active = button.getAttribute("data-theme-mode") === mode;
      button.setAttribute("aria-pressed", String(active));
      if (active) button.classList.add(...ACTIVE.split(" "));
      else button.classList.remove(...ACTIVE.split(" "));
    }
  }

  for (const button of buttons) {
    button.addEventListener("click", () => {
      const next = button.getAttribute("data-theme-mode") as ThemeMode | null;
      if (next && MODES.includes(next)) {
        mode = next;
        applyTheme(mode);
        paint();
      }
    });
  }

  // Keep the trigger's expanded state truthful (native popover, no JS needed to open).
  for (const panel of document.querySelectorAll<HTMLElement>(".theme-panel")) {
    const trigger = document.querySelector<HTMLElement>("[data-theme-trigger]");
    panel.addEventListener("toggle", (event) => {
      const open = (event as ToggleEvent).newState === "open";
      trigger?.setAttribute("aria-expanded", String(open));
    });
  }

  paint();
</script>
