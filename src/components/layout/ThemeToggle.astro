---
/**
 * Appearance control. Same visual family as LanguageSwitcher and the search
 * trigger through ONE stylesheet (./header-control.css) and the Sổ Trọ
 * appearance menu.
 *
 * `popover` (desktop header): an ICON-ONLY 44px square (the search trigger's
 * shell) whose glyph morphs sun <-> moon to show the RESOLVED theme, with a
 * cobalt status dot while the mode is System. Its accessible name is
 * "<label>: <mode>" and a CSS-only tooltip repeats that text on hover and
 * :focus-visible (aria-hidden, so it is never announced twice). It opens a
 * native popover card with three rows (Light, Dark, System). `inline`
 * (compact menu): the same three rows, no popover. The rows stay toggle
 * buttons in a `role="group"` carrying `aria-pressed`; the current row also
 * shows a check mark and an accent border.
 *
 * Without JavaScript the server-rendered state is `system`, and the controls
 * are hidden by the <noscript> rule in BaseLayout (they cannot do anything).
 */
import BlueSkyzIcon from "@/components/icon/BlueSkyzIcon.astro";
import type { Language } from "@/lib/i18n";
import ThemeMorphIcon from "./ThemeMorphIcon.astro";
import "./header-control.css";
interface Props {
  lang?: Language;
  /** Extra classes for the wrapper (e.g. vertical spacing inside the mobile menu). */
  class?: string;
  /** `popover`: one header trigger that opens the three-way group. */
  variant?: "inline" | "popover";
}

const { lang = "en", class: className = "", variant = "inline" } = Astro.props;
const asPopover = variant === "popover";
const panelId = "theme-panel-header";

const L = {
  en: { label: "Theme", system: "System", light: "Light", dark: "Dark" },
  vi: { label: "Giao diện", system: "Tự động", light: "Sáng", dark: "Tối" },
  zh: { label: "主题", system: "跟随系统", light: "浅色", dark: "深色" },
  "zh-hant": { label: "主題", system: "跟隨系統", light: "淺色", dark: "深色" },
}[lang];

// Row order follows the Sổ Trọ control: Light, Dark, System.
const MODES = ["light", "dark", "system"] as const;
type Mode = (typeof MODES)[number];
// Server-rendered state; the client paints the stored mode on load.
const DEFAULT_MODE: Mode = "system";

// Row glyphs: the morph drawing frozen as sun / moon, and a monitor for
// System (the platform convention; a sun or moon there would repeat a
// neighbouring row and change meaning with the OS).
const SYSTEM_ICON = [
  "M4.25 3.25h11.5a2 2 0 0 1 2 2v7.5a2 2 0 0 1-2 2H4.25a2 2 0 0 1-2-2v-7.5a2 2 0 0 1 2-2Z",
  "M7 17.75h6M10 14.75v3",
];
const ROW_GLYPH = { light: "sun", dark: "moon" } as const;

// The accessible name states the mode; the tooltip shows the same text.
const triggerName = `${L.label}: ${L[DEFAULT_MODE]}`;
---

{asPopover ? (
  <button
    type="button"
    class="theme-trigger hc-trigger hc-trigger--icon"
    popovertarget={panelId}
    aria-label={triggerName}
    aria-expanded="false"
    data-theme-trigger
    data-theme-current={DEFAULT_MODE}
    style="anchor-name: --theme-anchor"
  >
    <span class="theme-trigger__glyph hc-glyph" aria-hidden="true">
      <ThemeMorphIcon state="live" dot />
    </span>
    {/* CSS-only tooltip, hidden until hover / :focus-visible. The text of the
        current mode is chosen from the root attribute, like the glyph. */}
    <span class="theme-tip" aria-hidden="true" data-theme-tip>
      {L.label}:{" "}
      {MODES.map((mode) => (
        <span class="theme-tip__mode" data-theme-tip-mode={mode}>
          {L[mode]}
        </span>
      ))}
    </span>
  </button>
) : null}
<div
  role="group"
  id={asPopover ? panelId : undefined}
  popover={asPopover ? "auto" : undefined}
  aria-label={L.label}
  style={asPopover ? "position-anchor: --theme-anchor" : undefined}
  class:list={[
    "theme-group",
    asPopover
      ? "theme-group--panel theme-panel hc-panel"
      : "theme-group--inline hc-group",
    className,
  ]}
>
  {/* Visible caption in the panel and in the compact menu (the language row
      above it carries the same caption); the group's aria-label names it. */}
  <div class="theme-group__caption hc-caption" aria-hidden="true">
    <ThemeMorphIcon state="sun" />
    <span>{L.label}</span>
  </div>
  {MODES.map((mode) => (
    <button
      type="button"
      data-theme-mode={mode}
      data-theme-toggle
      aria-pressed={mode === DEFAULT_MODE ? "true" : "false"}
      class="theme-row hc-row"
    >
      <span class="theme-row__icon hc-row__lead" aria-hidden="true">
        {mode === "system" ? (
          <svg
            viewBox="0 0 20 20"
            fill="none"
            stroke="currentColor"
            stroke-width="1.75"
            stroke-linecap="round"
            stroke-linejoin="round"
            focusable="false"
          >
            {SYSTEM_ICON.map((d) => (
              <path d={d} />
            ))}
          </svg>
        ) : (
          <ThemeMorphIcon state={ROW_GLYPH[mode]} />
        )}
      </span>
      <span class="theme-row__label hc-row__label" data-theme-row-label>
        {L[mode]}
      </span>
      <span class="theme-row__check hc-check" aria-hidden="true">
        <BlueSkyzIcon name="check" class="h-5 w-5" />
      </span>
    </button>
  ))}
</div>

<style>
  /* Trigger, panel, caption and row styling come from the shared
     header-control.css (the trigger is the search button's 44px square);
     only the appearance-specific parts live here. */

  .theme-trigger {
    position: relative;
    /* The status dot's ring follows the trigger fill in every state. */
    --tt-ring: var(--hc-surface);
  }

  .theme-trigger:is(:hover, [aria-expanded="true"]) {
    --tt-ring: color-mix(
      in srgb,
      var(--hc-accent) var(--hc-tint),
      var(--hc-surface)
    );
  }

  /* Optical size: an open sun reads lighter than the closed magnifier at
     the same box, so this glyph gets 22px instead of the family's 20px. */
  .theme-trigger__glyph {
    width: 1.375rem;
    height: 1.375rem;
  }

  /* Press feedback: the glyph gives way a touch and springs back. */
  .theme-trigger__glyph :global(.tt-morph) {
    width: 100%;
    height: 100%;
    transition: scale 420ms cubic-bezier(0.34, 1.32, 0.52, 1);
  }

  .theme-trigger:active .theme-trigger__glyph :global(.tt-morph) {
    scale: 0.86;
    transition-duration: 90ms;
  }

  /* ─── Tooltip ─── below the trigger, inverted surface, shown after a short
     delay on hover (pointer devices) and :focus-visible, never while the
     panel is open. Hidden immediately on leave. */
  .theme-tip {
    position: absolute;
    top: calc(100% + 0.5rem);
    left: 50%;
    z-index: 1;
    padding: 0.375rem 0.625rem;
    border-radius: var(--radius-sm, 0.375rem);
    background: var(--hc-fg);
    color: var(--hc-surface);
    box-shadow: 0 6px 18px -8px rgba(11, 16, 32, 0.45);
    font-size: var(--size-1);
    font-weight: 600;
    line-height: 1.2;
    white-space: nowrap;
    pointer-events: none;
    opacity: 0;
    visibility: hidden;
    transform: translate(-50%, -0.25rem);
    transition:
      opacity 120ms ease-out,
      transform 120ms ease-out,
      visibility 0s linear 120ms;
  }

  .theme-tip__mode {
    display: none;
  }

  :global(:root[data-theme="light"]) [data-theme-tip-mode="light"],
  :global(:root[data-theme="dark"]) [data-theme-tip-mode="dark"],
  :global(:root:not([data-theme])) [data-theme-tip-mode="system"] {
    display: inline;
  }

  @media (hover: hover) {
    .theme-trigger:hover:not([aria-expanded="true"]) .theme-tip {
      opacity: 1;
      visibility: visible;
      transform: translate(-50%, 0);
      transition:
        opacity 160ms ease-out 300ms,
        transform 220ms cubic-bezier(0.2, 0.9, 0.3, 1) 300ms,
        visibility 0s linear 300ms;
    }
  }

  /* A pointer selection returns focus to the trigger programmatically; WebKit
     reports that as :focus-visible. data-tip-quiet (set only for pointer
     clicks, cleared on blur) keeps the tooltip for genuine keyboard focus. */
  .theme-trigger:focus-visible:not([aria-expanded="true"], [data-tip-quiet])
    .theme-tip {
    opacity: 1;
    visibility: visible;
    transform: translate(-50%, 0);
    transition:
      opacity 160ms ease-out 300ms,
      transform 220ms cubic-bezier(0.2, 0.9, 0.3, 1) 300ms,
      visibility 0s linear 300ms;
  }

  /* Without anchor positioning the panel sits under the header's right edge. */
  @supports not (anchor-name: --theme-probe) {
    .theme-panel {
      inset: 4.5rem 1rem auto auto;
    }
  }

  @media (max-width: 40rem) {
    .theme-panel {
      inset: auto 0.75rem 0.75rem 0.75rem;
    }
  }

  /* Row and caption glyphs fill their shared lead box. */
  .theme-row__icon :global(.tt-morph) {
    width: 1.5rem;
    height: 1.5rem;
  }

  .theme-group__caption :global(.tt-morph) {
    width: 18px;
    height: 18px;
  }

  /* The check is rendered in every row but shown only for the current one, so
     the state has a single source (aria-pressed) that JS repaints. */
  .theme-row:not([aria-pressed="true"]) .theme-row__check :global(svg) {
    display: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .theme-trigger__glyph :global(.tt-morph),
    .theme-tip {
      transition: none !important;
    }
  }

  @media (forced-colors: active) {
    .theme-tip {
      border: 1px solid CanvasText;
      background: Canvas;
      color: CanvasText;
    }
  }
</style>

<script>
  import { applyTheme, initTheme, type ThemeMode } from "@/lib/theme";

  const MODES: ThemeMode[] = ["system", "light", "dark"];
  let mode: ThemeMode = initTheme();
  const buttons = [
    ...document.querySelectorAll<HTMLButtonElement>("[data-theme-toggle]"),
  ];
  const triggers = [
    ...document.querySelectorAll<HTMLElement>("[data-theme-trigger]"),
  ];

  function labelOf(next: ThemeMode): string {
    const row = buttons.find((b) => b.dataset.themeMode === next);
    return row?.querySelector("[data-theme-row-label]")?.textContent ?? "";
  }

  function paint(): void {
    for (const button of buttons) {
      const active = button.getAttribute("data-theme-mode") === mode;
      button.setAttribute("aria-pressed", String(active));
    }
    const current = labelOf(mode);
    for (const trigger of triggers) {
      trigger.setAttribute("data-theme-current", mode);
      const group = trigger.getAttribute("popovertarget");
      const caption = group
        ? (document.getElementById(group)?.getAttribute("aria-label") ?? "")
        : "";
      // Icon-only trigger: the name states the mode (the tooltip repeats it).
      trigger.setAttribute("aria-label", `${caption}: ${current}`);
    }
  }

  for (const trigger of triggers) {
    trigger.addEventListener("blur", () => {
      trigger.removeAttribute("data-tip-quiet");
    });
  }

  for (const button of buttons) {
    button.addEventListener("click", (event) => {
      const next = button.getAttribute("data-theme-mode") as ThemeMode | null;
      if (!next || !MODES.includes(next)) return;
      mode = next;
      applyTheme(mode);
      paint();
      const panel = button.closest<HTMLElement>("[popover]");
      if (panel) {
        panel.hidePopover();
        const trigger = document.querySelector<HTMLElement>(
          `[data-theme-trigger][popovertarget="${panel.id}"]`,
        );
        // detail > 0: a pointer click. Keyboard activation (detail 0) keeps
        // the tooltip so keyboard users hear and see the new mode.
        if ((event as MouseEvent).detail > 0) {
          trigger?.setAttribute("data-tip-quiet", "");
        }
        trigger?.focus();
      }
    });
  }

  // Keep the trigger's expanded state truthful (native popover, no JS needed to open).
  for (const panel of document.querySelectorAll<HTMLElement>(".theme-panel")) {
    panel.addEventListener("toggle", (event) => {
      const open = (event as ToggleEvent).newState === "open";
      for (const trigger of triggers) {
        if (trigger.getAttribute("popovertarget") === panel.id) {
          trigger.setAttribute("aria-expanded", String(open));
        }
      }
    });
  }

  paint();
</script>
