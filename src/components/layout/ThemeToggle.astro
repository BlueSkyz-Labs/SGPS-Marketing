---
/**
 * Appearance control. Same visual family as LanguageSwitcher and the search
 * trigger through ONE stylesheet (./header-control.css) and the Sổ Trọ
 * appearance menu.
 *
 * `popover` (desktop header): a trigger showing the icon + label of the CURRENT
 * mode and a chevron, opening a native popover card with three rows
 * (Light, Dark, System). `inline` (compact menu): the same three rows, no
 * popover. The rows stay toggle buttons in a `role="group"` carrying
 * `aria-pressed`; the current row also shows a check mark and an accent border.
 *
 * Without JavaScript the server-rendered state is `system`, and the controls
 * are hidden by the <noscript> rule in BaseLayout (they cannot do anything).
 */
import BlueSkyzIcon from "@/components/icon/BlueSkyzIcon.astro";
import type { Language } from "@/lib/i18n";
import "./header-control.css";
interface Props {
  lang?: Language;
  /** Extra classes for the wrapper (e.g. vertical spacing inside the mobile menu). */
  class?: string;
  /** `popover`: one header trigger that opens the three-way group. */
  variant?: "inline" | "popover";
}

const { lang = "en", class: className = "", variant = "inline" } = Astro.props;
const asPopover = variant === "popover";
const panelId = "theme-panel-header";

const L = {
  en: { label: "Theme", system: "System", light: "Light", dark: "Dark" },
  vi: { label: "Giao diện", system: "Tự động", light: "Sáng", dark: "Tối" },
  zh: { label: "主题", system: "跟随系统", light: "浅色", dark: "深色" },
  "zh-hant": { label: "主題", system: "跟隨系統", light: "淺色", dark: "深色" },
}[lang];

// Row order follows the Sổ Trọ control: Light, Dark, System.
const MODES = ["light", "dark", "system"] as const;
type Mode = (typeof MODES)[number];
// Server-rendered state; the client paints the stored mode on load.
const DEFAULT_MODE: Mode = "system";

// 20-unit glyphs drawn to the optical size of the 24x16 trigger flag: the sun
// core and the moon fill the same circle so no mode reads lighter.
const ICONS: Record<Mode, string[]> = {
  light: [
    "M13.5 10a3.5 3.5 0 1 1-7 0 3.5 3.5 0 0 1 7 0Z",
    "M10 1.75v1.5M10 16.75v1.5M1.75 10h1.5M16.75 10h1.5M4.17 4.17l1.06 1.06M14.77 14.77l1.06 1.06M15.83 4.17l-1.06 1.06M5.23 14.77l-1.06 1.06",
  ],
  dark: ["M17 12.4A7.25 7.25 0 0 1 7.6 3a7.25 7.25 0 1 0 9.4 9.4Z"],
  system: [
    "M4.25 3.25h11.5a2 2 0 0 1 2 2v7.5a2 2 0 0 1-2 2H4.25a2 2 0 0 1-2-2v-7.5a2 2 0 0 1 2-2Z",
    "M7 17.75h6M10 14.75v3",
  ],
};

// WCAG 2.5.3: the accessible name contains the visible label.
const triggerName = `${L.label}: ${L[DEFAULT_MODE]}`;
---

{asPopover ? (
  <button
    type="button"
    class="theme-trigger hc-trigger"
    popovertarget={panelId}
    aria-label={triggerName}
    aria-expanded="false"
    title={L.label}
    data-theme-trigger
    data-theme-current={DEFAULT_MODE}
    style="anchor-name: --theme-anchor"
  >
    <span class="theme-trigger__icons hc-glyph" aria-hidden="true">
      {MODES.map((mode) => (
        <svg
          viewBox="0 0 20 20"
          class="theme-trigger__icon"
          data-theme-icon={mode}
          fill="none"
          stroke="currentColor"
          stroke-width="1.75"
          stroke-linecap="round"
          stroke-linejoin="round"
          focusable="false"
        >
          {ICONS[mode].map((d) => (
            <path d={d} />
          ))}
        </svg>
      ))}
    </span>
    <span
      class="theme-trigger__label"
      aria-hidden="true"
      data-theme-current-label
    >
      {L[DEFAULT_MODE]}
    </span>
    <span class="theme-trigger__chevron hc-chevron" aria-hidden="true">
      <BlueSkyzIcon name="chevron-down" class="h-3.5 w-3.5" />
    </span>
  </button>
) : null}
<div
  role="group"
  id={asPopover ? panelId : undefined}
  popover={asPopover ? "auto" : undefined}
  aria-label={L.label}
  style={asPopover ? "position-anchor: --theme-anchor" : undefined}
  class:list={[
    "theme-group",
    asPopover
      ? "theme-group--panel theme-panel hc-panel"
      : "theme-group--inline hc-group",
    className,
  ]}
>
  {/* Visible caption in the panel and in the compact menu (the language row
      above it carries the same caption); the group's aria-label names it. */}
  <div class="theme-group__caption hc-caption" aria-hidden="true">
    <svg
      viewBox="0 0 20 20"
      fill="none"
      stroke="currentColor"
      stroke-width="1.75"
      stroke-linecap="round"
      stroke-linejoin="round"
      focusable="false"
    >
      {ICONS.light.map((d) => (
        <path d={d} />
      ))}
    </svg>
    <span>{L.label}</span>
  </div>
  {MODES.map((mode) => (
    <button
      type="button"
      data-theme-mode={mode}
      data-theme-toggle
      aria-pressed={mode === DEFAULT_MODE ? "true" : "false"}
      class="theme-row hc-row"
    >
      <span class="theme-row__icon hc-row__lead" aria-hidden="true">
        <svg
          viewBox="0 0 20 20"
          fill="none"
          stroke="currentColor"
          stroke-width="1.75"
          stroke-linecap="round"
          stroke-linejoin="round"
          focusable="false"
        >
          {ICONS[mode].map((d) => (
            <path d={d} />
          ))}
        </svg>
      </span>
      <span class="theme-row__label hc-row__label" data-theme-row-label>
        {L[mode]}
      </span>
      <span class="theme-row__check hc-check" aria-hidden="true">
        <BlueSkyzIcon name="check" class="h-5 w-5" />
      </span>
    </button>
  ))}
</div>

<style>
  /* Trigger, panel, caption and row styling come from the shared
     header-control.css; only the appearance-specific parts live here. */

  /* One icon per mode, stacked; only the current mode's icon is shown. */
  .theme-trigger__icons {
    position: relative;
  }

  .theme-trigger__icon {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    transform: rotate(-90deg) scale(0.5);
    transition:
      opacity 240ms ease-out,
      transform 240ms ease-out;
  }

  .theme-trigger[data-theme-current="light"] [data-theme-icon="light"],
  .theme-trigger[data-theme-current="dark"] [data-theme-icon="dark"],
  .theme-trigger[data-theme-current="system"] [data-theme-icon="system"] {
    opacity: 1;
    transform: none;
  }

  /* The visible label shows from lg; below it the icon + chevron remain and the
     accessible name still says the mode. */
  .theme-trigger__label {
    display: none;
    white-space: nowrap;
  }

  @media (min-width: 64rem) {
    .theme-trigger__label {
      display: inline;
    }
  }

  /* Without anchor positioning the panel sits under the header's right edge. */
  @supports not (anchor-name: --theme-probe) {
    .theme-panel {
      inset: 4.5rem 1rem auto auto;
    }
  }

  @media (max-width: 40rem) {
    .theme-panel {
      inset: auto 0.75rem 0.75rem 0.75rem;
    }
  }

  /* The check is rendered in every row but shown only for the current one, so
     the state has a single source (aria-pressed) that JS repaints. */
  .theme-row:not([aria-pressed="true"]) .theme-row__check :global(svg) {
    display: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .theme-trigger__icon {
      transition: none !important;
    }
  }
</style>

<script>
  import { applyTheme, initTheme, type ThemeMode } from "@/lib/theme";

  const MODES: ThemeMode[] = ["system", "light", "dark"];
  let mode: ThemeMode = initTheme();
  const buttons = [
    ...document.querySelectorAll<HTMLButtonElement>("[data-theme-toggle]"),
  ];
  const triggers = [
    ...document.querySelectorAll<HTMLElement>("[data-theme-trigger]"),
  ];

  function labelOf(next: ThemeMode): string {
    const row = buttons.find((b) => b.dataset.themeMode === next);
    return row?.querySelector("[data-theme-row-label]")?.textContent ?? "";
  }

  function paint(): void {
    for (const button of buttons) {
      const active = button.getAttribute("data-theme-mode") === mode;
      button.setAttribute("aria-pressed", String(active));
    }
    const current = labelOf(mode);
    for (const trigger of triggers) {
      trigger.setAttribute("data-theme-current", mode);
      const group = trigger.getAttribute("popovertarget");
      const caption = group
        ? (document.getElementById(group)?.getAttribute("aria-label") ?? "")
        : "";
      // WCAG 2.5.3: the accessible name keeps the visible label.
      trigger.setAttribute("aria-label", `${caption}: ${current}`);
      const visible = trigger.querySelector("[data-theme-current-label]");
      if (visible) visible.textContent = current;
    }
  }

  for (const button of buttons) {
    button.addEventListener("click", () => {
      const next = button.getAttribute("data-theme-mode") as ThemeMode | null;
      if (!next || !MODES.includes(next)) return;
      mode = next;
      applyTheme(mode);
      paint();
      const panel = button.closest<HTMLElement>("[popover]");
      if (panel) {
        panel.hidePopover();
        document
          .querySelector<HTMLElement>(
            `[data-theme-trigger][popovertarget="${panel.id}"]`,
          )
          ?.focus();
      }
    });
  }

  // Keep the trigger's expanded state truthful (native popover, no JS needed to open).
  for (const panel of document.querySelectorAll<HTMLElement>(".theme-panel")) {
    panel.addEventListener("toggle", (event) => {
      const open = (event as ToggleEvent).newState === "open";
      for (const trigger of triggers) {
        if (trigger.getAttribute("popovertarget") === panel.id) {
          trigger.setAttribute("aria-expanded", String(open));
        }
      }
    });
  }

  paint();
</script>
