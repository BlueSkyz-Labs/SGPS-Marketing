---
/**
 * Appearance control: ONE icon (SGPS-DEC-2026-037 HC-7, Owner 2026-10-05).
 *
 * The same 44px icon button (the search trigger's shell, shared
 * ./header-control.css family) is rendered in the desktop header and in the
 * compact menu. Its glyph morphs sun <-> moon to show the RESOLVED theme, with
 * a cobalt status dot while the site follows the OS (System). A press flips
 * the resolved theme at once; when the new theme is what the OS already
 * prefers, the stored choice is cleared and the site follows the OS again, so
 * "System" needs no third option and no popup list.
 *
 * The accessible name is "<label>: <mode>" and a CSS-only tooltip repeats it
 * on hover and :focus-visible (aria-hidden, never announced twice). In the
 * compact menu the label sits visibly beside the icon instead of the tooltip.
 *
 * Without JavaScript the control cannot act: the <noscript> rule in
 * BaseLayout hides it and the CSS default follows the OS.
 */
import type { Language } from "@/lib/i18n";
import ThemeMorphIcon from "./ThemeMorphIcon.astro";
import "./header-control.css";

interface Props {
  lang?: Language;
  /** Extra classes for the wrapper (e.g. vertical spacing inside the mobile menu). */
  class?: string;
  /** `header`: the bare icon. `menu`: the icon on a captioned compact-menu row. */
  placement?: "header" | "menu";
}

const {
  lang = "en",
  class: className = "",
  placement = "header",
} = Astro.props;
const inMenu = placement === "menu";

const L = {
  en: { label: "Theme", system: "System", light: "Light", dark: "Dark" },
  vi: { label: "Giao diện", system: "Hệ thống", light: "Sáng", dark: "Tối" },
  zh: { label: "主题", system: "跟随系统", light: "浅色", dark: "深色" },
  "zh-hant": { label: "主題", system: "跟隨系統", light: "淺色", dark: "深色" },
}[lang];

const MODES = ["light", "dark", "system"] as const;
// Server-rendered state; the client paints the stored mode on load.
const DEFAULT_MODE = "system";
const triggerName = `${L.label}: ${L[DEFAULT_MODE]}`;
---

<div
  class:list={[
    "theme-control",
    `theme-control--${placement}`,
    { "hc-group": inMenu },
    className,
  ]}
>
  {inMenu ? (
    <span class="theme-control__label hc-row__label" aria-hidden="true">
      {L.label}
    </span>
  ) : null}
  <button
    type="button"
    class="theme-trigger hc-trigger hc-trigger--icon"
    aria-label={triggerName}
    data-theme-trigger
    data-theme-current={DEFAULT_MODE}
    data-theme-label={L.label}
    data-theme-names={JSON.stringify({
      light: L.light,
      dark: L.dark,
      system: L.system,
    })}
  >
    <span class="theme-trigger__glyph hc-glyph" aria-hidden="true">
      <ThemeMorphIcon state="live" dot />
    </span>
    {/* CSS-only tooltip, hidden until hover / :focus-visible. The text of the
        current mode is chosen from the root attribute, like the glyph. */}
    <span class="theme-tip" aria-hidden="true" data-theme-tip>
      {L.label}:{" "}
      {MODES.map((mode) => (
        <span class="theme-tip__mode" data-theme-tip-mode={mode}>
          {L[mode]}
        </span>
      ))}
    </span>
  </button>
</div>

<style>
  /* Trigger styling comes from the shared header-control.css (the trigger is
     the search button's 44px square); only appearance-specific parts live
     here. */
  .theme-control {
    display: inline-flex;
  }

  /* Compact menu: one row, label left, the same icon right. */
  .theme-control--menu {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.25rem 0.25rem 0.25rem 0.75rem;
  }

  .theme-trigger {
    position: relative;
    /* The status dot's ring follows the trigger fill in every state. */
    --tt-ring: var(--hc-surface);
  }

  .theme-trigger:hover {
    --tt-ring: color-mix(
      in srgb,
      var(--hc-accent) var(--hc-tint),
      var(--hc-surface)
    );
  }

  /* Optical size: an open sun reads lighter than the closed magnifier at
     the same box, so this glyph gets 22px instead of the f