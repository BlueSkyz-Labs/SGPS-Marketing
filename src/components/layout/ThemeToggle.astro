---
/**
 * Appearance control. Same visual family as LanguageSwitcher (shared trigger
 * and panel numbers) and the Sổ Trọ appearance menu.
 *
 * `popover` (desktop header): a trigger showing the icon + label of the CURRENT
 * mode and a chevron, opening a native popover card with three rows
 * (Light, Dark, System). `inline` (compact menu): the same three rows, no
 * popover. The rows stay toggle buttons in a `role="group"` carrying
 * `aria-pressed`; the current row also shows a check mark and an accent border.
 *
 * Without JavaScript the server-rendered state is `system`, and the controls
 * are hidden by the <noscript> rule in BaseLayout (they cannot do anything).
 */
import BlueSkyzIcon from "@/components/icon/BlueSkyzIcon.astro";
import type { Language } from "@/lib/i18n";
interface Props {
  lang?: Language;
  /** Extra classes for the wrapper (e.g. vertical spacing inside the mobile menu). */
  class?: string;
  /** `popover`: one header trigger that opens the three-way group. */
  variant?: "inline" | "popover";
}

const { lang = "en", class: className = "", variant = "inline" } = Astro.props;
const asPopover = variant === "popover";
const panelId = "theme-panel-header";

const L = {
  en: { label: "Theme", system: "System", light: "Light", dark: "Dark" },
  vi: { label: "Giao diện", system: "Tự động", light: "Sáng", dark: "Tối" },
  zh: { label: "主题", system: "跟随系统", light: "浅色", dark: "深色" },
  "zh-hant": { label: "主題", system: "跟隨系統", light: "淺色", dark: "深色" },
}[lang];

// Row order follows the Sổ Trọ control: Light, Dark, System.
const MODES = ["light", "dark", "system"] as const;
type Mode = (typeof MODES)[number];
// Server-rendered state; the client paints the stored mode on load.
const DEFAULT_MODE: Mode = "system";

const ICONS: Record<Mode, string[]> = {
  light: [
    "M13.25 10a3.25 3.25 0 1 1-6.5 0 3.25 3.25 0 0 1 6.5 0Z",
    "M10 2v1.5M10 16.5V18M2 10h1.5M16.5 10H18M4.3 4.3l1.05 1.05M14.65 14.65l1.05 1.05M15.7 4.3l-1.05 1.05M5.35 14.65l-1.05 1.05",
  ],
  dark: ["M15.5 12.5A5.5 5.5 0 1 1 7.5 4.5a4.5 4.5 0 0 0 8 8Z"],
  system: [
    "M4.5 3.5h11a2 2 0 0 1 2 2v7a2 2 0 0 1-2 2h-11a2 2 0 0 1-2-2v-7a2 2 0 0 1 2-2Z",
    "M7 17h6M10 14.5V17",
  ],
};

// WCAG 2.5.3: the accessible name contains the visible label.
const triggerName = `${L.label}: ${L[DEFAULT_MODE]}`;
---

{asPopover ? (
  <button
    type="button"
    class="theme-trigger"
    popovertarget={panelId}
    aria-label={triggerName}
    aria-expanded="false"
    title={L.label}
    data-theme-trigger
    data-theme-current={DEFAULT_MODE}
  >
    <span class="theme-trigger__icons" aria-hidden="true">
      {MODES.map((mode) => (
        <svg
          viewBox="0 0 20 20"
          class="theme-trigger__icon"
          data-theme-icon={mode}
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          focusable="false"
        >
          {ICONS[mode].map((d) => (
            <path d={d} />
          ))}
        </svg>
      ))}
    </span>
    <span
      class="theme-trigger__label"
      aria-hidden="true"
      data-theme-current-label
    >
      {L[DEFAULT_MODE]}
    </span>
    <span class="theme-trigger__chevron" aria-hidden="true">
      <BlueSkyzIcon name="chevron-down" class="h-3.5 w-3.5" />
    </span>
  </button>
) : null}
<div
  role="group"
  id={asPopover ? panelId : undefined}
  popover={asPopover ? "auto" : undefined}
  aria-label={L.label}
  class:list={[
    "theme-group",
    asPopover ? "theme-group--panel theme-panel" : "theme-group--inline",
    className,
  ]}
>
  {asPopover ? (
    <div class="theme-group__caption" aria-hidden="true">
      <svg
        viewBox="0 0 20 20"
        class="theme-group__caption-icon"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"
        focusable="false"
      >
        {ICONS.light.map((d) => (
          <path d={d} />
        ))}
      </svg>
      <span>{L.label}</span>
    </div>
  ) : null}
  {MODES.map((mode) => (
    <button
      type="button"
      data-theme-mode={mode}
      data-theme-toggle
      aria-pressed={mode === DEFAULT_MODE ? "true" : "false"}
      class="theme-row"
    >
      <span class="theme-row__icon" aria-hidden="true">
        <svg
          viewBox="0 0 20 20"
          class="h-6 w-6"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          focusable="false"
        >
          {ICONS[mode].map((d) => (
            <path d={d} />
          ))}
        </svg>
      </span>
      <span class="theme-row__label" data-theme-row-label>
        {L[mode]}
      </span>
      <span class="theme-row__check" aria-hidden="true">
        <BlueSkyzIcon name="check" class="h-5 w-5" />
      </span>
    </button>
  ))}
</div>

<style>
  /* ─── Trigger ───────────────────────────────────────────────────────── */
  .theme-trigger {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-width: 44px;
    min-height: 44px;
    padding: 0 0.75rem;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    background: var(--surface-raised);
    color: var(--text-primary);
    box-shadow:
      0 1px 2px rgba(11, 16, 32, 0.05),
      0 6px 16px -10px rgba(11, 16, 32, 0.18);
    font: inherit;
    font-size: var(--size-2);
    font-weight: 600;
    line-height: 1;
    cursor: pointer;
    anchor-name: --theme-anchor;
    transition:
      background-color 150ms var(--motion-ease-standard, ease),
      border-color 150ms var(--motion-ease-standard, ease);
  }

  /* The ink scene re-points --text-* to porcelain but --surface-raised stays
     theme-aware (white in light), so the trigger takes the scene's own
     translucent surface there instead. */
  :global(header[data-scene="ink"]) .theme-trigger {
    background: var(--surface-subtle);
  }

  .theme-trigger:hover,
  .theme-trigger:where([aria-expanded="true"]) {
    border-color: var(--focus-ring);
    background: color-mix(in srgb, var(--focus-ring) 6%, var(--surface-raised));
  }

  :global(header[data-scene="ink"]) .theme-trigger:hover,
  :global(header[data-scene="ink"])
    .theme-trigger:where([aria-expanded="true"]) {
    background: color-mix(
      in srgb,
      var(--focus-ring) 14%,
      var(--surface-subtle)
    );
  }

  .theme-trigger:focus-visible {
    outline: 3px solid var(--focus-ring);
    outline-offset: 2px;
  }

  .theme-trigger__icons {
    position: relative;
    display: block;
    flex-shrink: 0;
    width: 1.25rem;
    height: 1.25rem;
  }

  /* One icon per mode, stacked; only the current mode's icon is shown. */
  .theme-trigger__icon {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    transform: rotate(-90deg) scale(0.5);
    transition:
      opacity 240ms ease-out,
      transform 240ms ease-out;
  }

  .theme-trigger[data-theme-current="light"] [data-theme-icon="light"],
  .theme-trigger[data-theme-current="dark"] [data-theme-icon="dark"],
  .theme-trigger[data-theme-current="system"] [data-theme-icon="system"] {
    opacity: 1;
    transform: none;
  }

  /* The visible label shows from lg; below it the icon + chevron remain and the
     accessible name still says the mode. */
  .theme-trigger__label {
    display: none;
    white-space: nowrap;
  }

  @media (min-width: 64rem) {
    .theme-trigger__label {
      display: inline;
    }
  }

  .theme-trigger__chevron {
    display: inline-flex;
    flex-shrink: 0;
    opacity: 0.7;
    transition: transform 160ms var(--motion-ease-standard, ease);
  }

  .theme-trigger:where([aria-expanded="true"]) .theme-trigger__chevron {
    transform: rotate(180deg);
  }

  /* ─── Palette ───────────────────────────────────────────────────────── */
  /* The popover is its own solid surface in the top layer, so it owns its
     palette (the header re-points --text-* / --border-subtle on the ink
     scene). The inline group sits on the compact menu surface and reads that
     surface's ambient tokens; only its accent depends on the surface. */
  .theme-group--panel {
    --theme-fg: #0b1020;
    --theme-fg-muted: #475569;
    --theme-line: #cbd5e1;
    --theme-hover: #f1f5f9;
    --theme-current-bg: rgba(29, 78, 216, 0.09);
    --theme-accent: #1d4ed8;
    --theme-shadow:
      0 1px 2px rgba(11, 16, 32, 0.06), 0 18px 44px -12px rgba(11, 16, 32, 0.28);
  }

  .theme-group--inline {
    --theme-fg: var(--text-primary);
    --theme-fg-muted: var(--text-secondary);
    --theme-line: var(--border-subtle);
    --theme-hover: var(--surface-subtle);
    --theme-current-bg: rgba(29, 78, 216, 0.09);
    --theme-accent: #1d4ed8;
  }

  :global([data-theme="dark"]) .theme-group--panel {
    --theme-fg: #ffffff;
    --theme-fg-muted: #94a3b8;
    --theme-line: #334155;
    --theme-hover: rgba(255, 255, 255, 0.08);
    --theme-current-bg: rgba(59, 130, 246, 0.18);
    --theme-accent: #3b82f6;
    --theme-shadow:
      0 1px 2px rgba(0, 0, 0, 0.4), 0 22px 48px -12px rgba(0, 0, 0, 0.7);
  }

  :global([data-theme="dark"]) .theme-group--inline,
  :global(header[data-scene="ink"]) .theme-group--inline {
    --theme-current-bg: rgba(59, 130, 246, 0.18);
    --theme-accent: #3b82f6;
  }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"])) .theme-group--panel {
      --theme-fg: #ffffff;
      --theme-fg-muted: #94a3b8;
      --theme-line: #334155;
      --theme-hover: rgba(255, 255, 255, 0.08);
      --theme-current-bg: rgba(59, 130, 246, 0.18);
      --theme-accent: #3b82f6;
      --theme-shadow:
        0 1px 2px rgba(0, 0, 0, 0.4), 0 22px 48px -12px rgba(0, 0, 0, 0.7);
    }

    :global(:root:not([data-theme="light"])) .theme-group--inline {
      --theme-current-bg: rgba(59, 130, 246, 0.18);
      --theme-accent: #3b82f6;
    }
  }

  /* ─── Panel ─────────────────────────────────────────────────────────── */
  /* ADR 0012: the header is the only translucent surface; the panel is a solid
     raised surface with a soft shadow, never a blur material. */
  .theme-panel {
    position: fixed;
    inset: auto;
    margin: 0;
    padding: 0.5rem;
    width: min(16rem, calc(100vw - 1.5rem));
    overflow: visible;
    border: 1px solid var(--theme-line);
    border-radius: 1rem;
    background: var(--surface-raised, #ffffff);
    color: var(--theme-fg);
    box-shadow: var(--theme-shadow);
    gap: 0.25rem;

    opacity: 0;
    transform: translateY(-0.375rem) scale(0.98);
    transform-origin: top right;
    transition:
      opacity 170ms var(--motion-ease-standard, ease),
      transform 170ms var(--motion-ease-standard, ease),
      overlay 170ms allow-discrete,
      display 170ms allow-discrete;
  }

  .theme-panel:not(:popover-open) {
    display: none;
  }

  .theme-panel:popover-open {
    display: grid;
    opacity: 1;
    transform: none;
  }

  @starting-style {
    .theme-panel:popover-open {
      opacity: 0;
      transform: translateY(-0.375rem) scale(0.98);
    }
  }

  @supports (anchor-name: --theme-probe) {
    .theme-panel {
      position-anchor: --theme-anchor;
      top: calc(anchor(bottom) + 0.5rem);
      right: anchor(right);
      position-try-fallbacks:
        flip-block,
        flip-inline,
        flip-block flip-inline;
    }
  }

  @supports not (anchor-name: --theme-probe) {
    .theme-panel {
      inset: 4.5rem 1rem auto auto;
    }
  }

  /* Phones: a bottom sheet is easier to reach than a corner popover. */
  @media (max-width: 40rem) {
    .theme-panel {
      inset: auto 0.75rem 0.75rem 0.75rem;
      position-try-fallbacks: none;
      width: auto;
      transform-origin: bottom center;
      transform: translateY(0.75rem);
    }

    .theme-panel::backdrop {
      background: rgba(11, 16, 32, 0);
      transition:
        background-color 170ms var(--motion-ease-standard, ease),
        overlay 170ms allow-discrete,
        display 170ms allow-discrete;
    }

    .theme-panel:popover-open::backdrop {
      background: rgba(11, 16, 32, 0.45);
    }

    @starting-style {
      .theme-panel:popover-open::backdrop {
        background: rgba(11, 16, 32, 0);
      }

      .theme-panel:popover-open {
        transform: translateY(0.75rem);
      }
    }
  }

  .theme-group--inline {
    display: grid;
    gap: 0.25rem;
  }

  .theme-group__caption {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0.75rem 0.25rem;
    color: var(--theme-fg-muted);
    font-size: var(--size-1);
    font-weight: 600;
    line-height: 1.25;
  }

  .theme-group__caption-icon {
    width: 18px;
    height: 18px;
    flex-shrink: 0;
  }

  /* ─── Rows ──────────────────────────────────────────────────────────── */
  .theme-row {
    display: grid;
    grid-template-columns: 2.25rem minmax(0, 1fr) 1.5rem;
    align-items: center;
    gap: 0.75rem;
    width: 100%;
    min-height: 3.5rem;
    padding: 0.5rem 0.75rem;
    border: 2px solid transparent;
    border-radius: var(--radius-md);
    background: transparent;
    color: var(--theme-fg);
    font: inherit;
    text-align: left;
    cursor: pointer;
    transition:
      background-color 120ms var(--motion-ease-standard, ease),
      border-color 120ms var(--motion-ease-standard, ease);
  }

  .theme-row:hover {
    background: var(--theme-hover);
  }

  .theme-row:focus-visible {
    outline: 3px solid var(--theme-accent);
    outline-offset: -3px;
  }

  .theme-row[aria-pressed="true"],
  .theme-row[aria-pressed="true"]:hover {
    border-color: var(--theme-accent);
    background: var(--theme-current-bg);
  }

  .theme-row__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--theme-accent);
  }

  .theme-row__label {
    font-size: var(--size-3);
    font-weight: 600;
    line-height: 1.25;
  }

  .theme-row[aria-pressed="true"] .theme-row__label {
    font-weight: 700;
  }

  /* The check is rendered in every row but shown only for the current one, so
     the state has a single source (aria-pressed) that JS repaints. */
  .theme-row__check {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.5rem;
    height: 1.5rem;
    color: var(--theme-accent);
  }

  .theme-row__check :global(svg) {
    stroke-width: 2.25;
  }

  .theme-row:not([aria-pressed="true"]) .theme-row__check :global(svg) {
    display: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .theme-trigger,
    .theme-trigger__icon,
    .theme-trigger__chevron,
    .theme-panel,
    .theme-panel::backdrop,
    .theme-row {
      transition: none !important;
    }
  }

  @media (forced-colors: active) {
    .theme-panel {
      border-color: CanvasText;
    }

    .theme-row[aria-pressed="true"] {
      border-color: Highlight;
    }
  }
</style>

<script>
  import { applyTheme, initTheme, type ThemeMode } from "@/lib/theme";

  const MODES: ThemeMode[] = ["system", "light", "dark"];
  let mode: ThemeMode = initTheme();
  const buttons = [
    ...document.querySelectorAll<HTMLButtonElement>("[data-theme-toggle]"),
  ];
  const triggers = [
    ...document.querySelectorAll<HTMLElement>("[data-theme-trigger]"),
  ];

  function labelOf(next: ThemeMode): string {
    const row = buttons.find((b) => b.dataset.themeMode === next);
    return row?.querySelector("[data-theme-row-label]")?.textContent ?? "";
  }

  function paint(): void {
    for (const button of buttons) {
      const active = button.getAttribute("data-theme-mode") === mode;
      button.setAttribute("aria-pressed", String(active));
    }
    const current = labelOf(mode);
    for (const trigger of triggers) {
      trigger.setAttribute("data-theme-current", mode);
      const group = trigger.getAttribute("popovertarget");
      const caption = group
        ? (document.getElementById(group)?.getAttribute("aria-label") ?? "")
        : "";
      // WCAG 2.5.3: the accessible name keeps the visible label.
      trigger.setAttribute("aria-label", `${caption}: ${current}`);
      const visible = trigger.querySelector("[data-theme-current-label]");
      if (visible) visible.textContent = current;
    }
  }

  for (const button of buttons) {
    button.addEventListener("click", () => {
      const next = button.getAttribute("data-theme-mode") as ThemeMode | null;
      if (!next || !MODES.includes(next)) return;
      mode = next;
      applyTheme(mode);
      paint();
      const panel = button.closest<HTMLElement>("[popover]");
      if (panel) {
        panel.hidePopover();
        document
          .querySelector<HTMLElement>(
            `[data-theme-trigger][popovertarget="${panel.id}"]`,
          )
          ?.focus();
      }
    });
  }

  // Keep the trigger's expanded state truthful (native popover, no JS needed to open).
  for (const panel of document.querySelectorAll<HTMLElement>(".theme-panel")) {
    panel.addEventListener("toggle", (event) => {
      const open = (event as ToggleEvent).newState === "open";
      for (const trigger of triggers) {
        if (trigger.getAttribute("popovertarget") === panel.id) {
          trigger.setAttribute("aria-expanded", String(open));
        }
      }
    });
  }

  paint();
</script>
