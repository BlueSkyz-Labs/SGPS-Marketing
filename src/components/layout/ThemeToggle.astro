---
/**
 * Appearance control: ONE icon (SGPS-DEC-2026-037 HC-7, Owner 2026-10-05).
 *
 * The same 44px icon button (the search trigger's shell, shared
 * ./header-control.css family) is rendered in the desktop header and in the
 * compact menu. Its glyph morphs sun <-> moon to show the RESOLVED theme, with
 * a cobalt status dot while the site follows the OS (System). A press flips
 * the resolved theme at once; when the new theme is what the OS already
 * prefers, the stored choice is cleared and the site follows the OS again, so
 * "System" needs no third option and no popup list.
 *
 * The accessible name is "<label>: <mode>" and a CSS-only tooltip repeats it
 * on hover and :focus-visible (aria-hidden, never announced twice). In the
 * compact menu the label sits visibly beside the icon instead of the tooltip.
 *
 * Without JavaScript the control cannot act: the <noscript> rule in
 * BaseLayout hides it and the CSS default follows the OS.
 */
import type { Language } from "@/lib/i18n";
import ThemeMorphIcon from "./ThemeMorphIcon.astro";
import "./header-control.css";

interface Props {
  lang?: Language;
  /** Extra classes for the wrapper (e.g. vertical spacing inside the mobile menu). */
  class?: string;
  /** `header`: the bare icon. `menu`: the icon on a captioned compact-menu row. */
  placement?: "header" | "menu";
}

const {
  lang = "en",
  class: className = "",
  placement = "header",
} = Astro.props;
const inMenu = placement === "menu";

const L = {
  en: { label: "Theme", system: "System", light: "Light", dark: "Dark" },
  vi: { label: "Giao diện", system: "Tự động", light: "Sáng", dark: "Tối" },
  zh: { label: "主题", system: "跟随系统", light: "浅色", dark: "深色" },
  "zh-hant": { label: "主題", system: "跟隨系統", light: "淺色", dark: "深色" },
}[lang];

const MODES = ["light", "dark", "system"] as const;
// Server-rendered state; the client paints the stored mode on load.
const DEFAULT_MODE = "system";
const triggerName = `${L.label}: ${L[DEFAULT_MODE]}`;
---

<div
  class:list={[
    "theme-control",
    `theme-control--${placement}`,
    { "hc-group": inMenu },
    className,
  ]}
>
  {inMenu ? (
    <span class="theme-control__label hc-row__label" aria-hidden="true">
      {L.label}
    </span>
  ) : null}
  <button
    type="button"
    class="theme-trigger hc-trigger hc-trigger--icon"
    aria-label={triggerName}
    data-theme-trigger
    data-theme-current={DEFAULT_MODE}
    data-theme-label={L.label}
    data-theme-names={JSON.stringify({
      light: L.light,
      dark: L.dark,
      system: L.system,
    })}
  >
    <span class="theme-trigger__glyph hc-glyph" aria-hidden="true">
      <ThemeMorphIcon state="live" dot />
    </span>
    {/* CSS-only tooltip, hidden until hover / :focus-visible. The text of the
        current mode is chosen from the root attribute, like the glyph. */}
    <span class="theme-tip" aria-hidden="true" data-theme-tip>
      {L.label}:{" "}
      {MODES.map((mode) => (
        <span class="theme-tip__mode" data-theme-tip-mode={mode}>
          {L[mode]}
        </span>
      ))}
    </span>
  </button>
</div>

<style>
  /* Trigger styling comes from the shared header-control.css (the trigger is
     the search button's 44px square); only appearance-specific parts live
     here. */
  .theme-control {
    display: inline-flex;
  }

  /* Compact menu: one row, label left, the same icon right. */
  .theme-control--menu {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.25rem 0.25rem 0.25rem 0.75rem;
  }

  .theme-trigger {
    position: relative;
    /* The status dot's ring follows the trigger fill in every state. */
    --tt-ring: var(--hc-surface);
  }

  .theme-trigger:hover {
    --tt-ring: color-mix(
      in srgb,
      var(--hc-accent) var(--hc-tint),
      var(--hc-surface)
    );
  }

  /* Optical size: an open sun reads lighter than the closed magnifier at
     the same box, so this glyph gets 22px instead of the family's 20px. */
  .theme-trigger__glyph {
    width: 1.375rem;
    height: 1.375rem;
  }

  /* Press feedback: the glyph gives way a touch and springs back. */
  .theme-trigger__glyph :global(.tt-morph) {
    width: 100%;
    height: 100%;
    transition: scale 420ms cubic-bezier(0.34, 1.32, 0.52, 1);
  }

  .theme-trigger:active .theme-trigger__glyph :global(.tt-morph) {
    scale: 0.86;
    transition-duration: 90ms;
  }

  /* ─── Tooltip ─── below the trigger, inverted surface, shown after a short
     delay on hover (pointer devices) and on :focus-visible. */
  .theme-tip {
    position: absolute;
    top: calc(100% + 0.5rem);
    left: 50%;
    z-index: 1;
    padding: 0.375rem 0.625rem;
    border-radius: var(--radius-sm, 0.375rem);
    background: var(--hc-fg);
    color: var(--hc-surface);
    box-shadow: 0 6px 18px -8px rgba(11, 16, 32, 0.45);
    font-size: var(--size-1);
    font-weight: 600;
    line-height: 1.2;
    white-space: nowrap;
    pointer-events: none;
    opacity: 0;
    visibility: hidden;
    transform: translate(-50%, -0.25rem);
    transition:
      opacity 120ms ease-out,
      transform 120ms ease-out,
      visibility 0s linear 120ms;
  }

  .theme-tip__mode {
    display: none;
  }

  /* The compact menu shows the label beside the icon instead. */
  .theme-control--menu .theme-tip {
    display: none;
  }

  :global(:root[data-theme="light"]) [data-theme-tip-mode="light"],
  :global(:root[data-theme="dark"]) [data-theme-tip-mode="dark"],
  :global(:root:not([data-theme])) [data-theme-tip-mode="system"] {
    display: inline;
  }

  @media (hover: hover) {
    .theme-trigger:hover .theme-tip {
      opacity: 1;
      visibility: visible;
      transform: translate(-50%, 0);
      transition:
        opacity 160ms ease-out 300ms,
        transform 220ms cubic-bezier(0.2, 0.9, 0.3, 1) 300ms,
        visibility 0s linear 300ms;
    }
  }

  .theme-trigger:focus-visible .theme-tip {
    opacity: 1;
    visibility: visible;
    transform: translate(-50%, 0);
    transition:
      opacity 160ms ease-out 300ms,
      transform 220ms cubic-bezier(0.2, 0.9, 0.3, 1) 300ms,
      visibility 0s linear 300ms;
  }

  @media (prefers-reduced-motion: reduce) {
    .theme-trigger__glyph :global(.tt-morph),
    .theme-tip {
      transition: none !important;
    }
  }

  @media (forced-colors: active) {
    .theme-tip {
      border: 1px solid CanvasText;
      background: Canvas;
      color: CanvasText;
    }
  }
</style>

<script>
  import {
    applyTheme,
    initTheme,
    nextTheme,
    type ThemeMode,
  } from "@/lib/theme";

  let mode: ThemeMode = initTheme();
  const osDark = window.matchMedia("(prefers-color-scheme: dark)");
  const triggers = [
    ...document.querySelectorAll<HTMLButtonElement>("[data-theme-trigger]"),
  ];

  function paint(): void {
    for (const trigger of triggers) {
      const names = JSON.parse(trigger.dataset.themeNames ?? "{}") as Record<
        ThemeMode,
        string
      >;
      trigger.setAttribute("data-theme-current", mode);
      trigger.setAttribute(
        "aria-label",
        `${trigger.dataset.themeLabel ?? ""}: ${names[mode] ?? ""}`,
      );
    }
  }

  for (const trigger of triggers) {
    trigger.addEventListener("click", () => {
      mode = nextTheme(mode, osDark.matches);
      applyTheme(mode);
      paint();
    });
  }

  paint();
</script>
