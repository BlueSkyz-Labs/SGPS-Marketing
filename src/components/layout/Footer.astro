---
import BrandLockup from "@/components/brand/BrandLockup.astro";
import Container from "@/components/layout/Container.astro";
import { FOOTER_LINKS, SITE } from "@/data/site";

const publicWebsiteHost = new URL(SITE.publicWebsite).hostname;
---

<footer
  class="mt-auto bg-[var(--surface-inverse)] text-[var(--brand-porcelain)]"
>
  <Container class="flex flex-col gap-6 py-12">
    <BrandLockup size="footer" />
    <nav aria-label="Footer">
      <ul class="flex flex-wrap gap-x-5 gap-y-3">
        {
          FOOTER_LINKS.map((item) => (
            <li>
              <a
                href={item.href}
                class="inline-flex min-h-11 items-center text-sm text-[color-mix(in_srgb,var(--brand-porcelain)_82%,white)] no-underline hover:text-white"
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <p
      class="max-w-2xl text-sm text-[color-mix(in_srgb,var(--brand-porcelain)_72%,white)]"
    >
      <span class="font-medium text-[var(--brand-porcelain)]"
        >{SITE.taglineLead}{" "}
        {SITE.taglineAccent}</span
      >
    </p>
    <p
      class="max-w-2xl text-sm text-[color-mix(in_srgb,var(--brand-porcelain)_72%,white)]"
    >
      {SITE.proposition}
    </p>
    <p
      class="text-xs tracking-[0.12em] text-[color-mix(in_srgb,var(--brand-porcelain)_58%,white)] uppercase"
    >
      {SITE.motto}
    </p>
    <p
      class="flex flex-wrap items-center gap-x-2 gap-y-1 border-t border-white/10 pt-5 text-xs text-[color-mix(in_srgb,var(--brand-porcelain)_62%,white)]"
    >
      <span>{SITE.founder.name}</span>
      <span aria-hidden="true">·</span>
      <span>{SITE.location.locality}</span>
      <span aria-hidden="true">·</span>
      <a
        href={SITE.publicWebsite}
        class="inline-flex min-h-11 items-center text-[color-mix(in_srgb,var(--brand-porcelain)_82%,white)] underline decoration-white/25 underline-offset-4 hover:text-white hover:decoration-white"
      >
        {publicWebsiteHost}
      </a>
    </p>
  </Container>
</footer>
