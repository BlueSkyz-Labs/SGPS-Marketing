---
import BrandLockup from "@/components/brand/BrandLockup.astro";
import Container from "@/components/layout/Container.astro";
import LanguageSwitcher from "@/components/layout/LanguageSwitcher.astro";
import { SITE, SHARED_LABELS, labelFor, getFooterGroups } from "@/data/site";
import { getLanguageFromPath } from "@/lib/i18n";

const currentPath = Astro.url.pathname;
const lang = getLanguageFromPath(currentPath);
const isVi = lang === "vi";
const FOOTER_GROUPS = getFooterGroups(lang);

const taglineLead = isVi ? "Trí tuệ. Nâng tầm." : SITE.taglineLead;
const taglineAccent = isVi ? "Tác động." : SITE.taglineAccent;

// C4-A S6 — colophon: identity + language only. Every public trust/security
// route already exists exactly once in the footer navigation; repeating them
// here would create duplicate targets for the same public destination.
const languageName = isVi
  ? "Tiếng Việt"
  : lang === "zh"
    ? "简体中文"
    : lang === "zh-hant"
      ? "繁體中文"
      : "English";
---

<!-- Always ink: its text is porcelain in both themes. --surface-inverse flips
     to porcelain in dark mode, which made every footer label invisible. -->
<footer class="mt-auto bg-[var(--brand-ink)] text-[var(--brand-porcelain)]">
  <Container class="flex flex-col gap-10 py-14">
    <div class="flex flex-wrap items-center justify-between gap-6">
      <BrandLockup size="footer" />
      <LanguageSwitcher variant="dark" placement="footer" />
    </div>
    <div class="footer-body grid gap-10 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.6fr)] lg:gap-16">
      <p
        lang={isVi ? undefined : "en"}
        class="footer-tagline max-w-sm text-2xl leading-tight font-semibold text-[var(--brand-porcelain)] sm:text-3xl"
      >
        {taglineLead}{" "}
        <span class="text-[color-mix(in_srgb,var(--brand-cobalt)_70%,white)]">
          {taglineAccent}
        </span>
      </p>
      <nav
        aria-label={labelFor(SHARED_LABELS.footerNav, lang)}
        class="grid gap-x-8 gap-y-6 sm:grid-cols-3"
      >
        {FOOTER_GROUPS.map((group, index) => (
          <div>
            <p
              id={`footer-group-${index}`}
              class="text-xs font-semibold tracking-wide text-[color-mix(in_srgb,var(--brand-porcelain)_72%,white)] uppercase"
            >
              {group.label}
            </p>
            <ul aria-labelledby={`footer-group-${index}`} class="mt-2">
              {group.links.map((item) => (
                <li>
                  <a
                    href={item.href}
                    class="footer-nav-link inline-flex min-h-11 items-center text-[0.9375rem] text-[color-mix(in_srgb,var(--brand-porcelain)_86%,white)] no-underline transition-colors hover:text-white"
                  >
                    {item.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </nav>
    </div>
    <div class="c4-colophon" data-c4-colophon>
      <span class="c4-colophon__identity">{SITE.name}</span>
      <span class="c4-colophon__rule" aria-hidden="true"></span>
      <span class="c4-colophon__language">{languageName}</span>
    </div>
  </Container>
</footer>
