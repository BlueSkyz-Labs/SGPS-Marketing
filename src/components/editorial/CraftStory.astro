---
import { renderCraftStory, type CraftStoryDraft } from "@/lib/craft-stories";
import type { Language } from "@/lib/i18n";

/**
 * C4-B G9 — Craft provenance story.
 *
 * Renders only the validated view model. An invalid story (unknown evidence,
 * hidden limitations, invented outcome, unsupported assurance) produces no
 * markup at all, so the surface fails closed instead of narrating something
 * that is not source-backed.
 */
interface Props {
  story: CraftStoryDraft;
  lang?: Language;
}

const { story, lang = "en" } = Astro.props;
const view = renderCraftStory(story, lang);

const LABELS: Record<
  Language,
  { sections: Record<string, string>; evidence: string }
> = {
  en: {
    sections: {
      problem: "Why a private channel",
      designChoice: "What we chose",
      constraint: "What limits it",
      implementation: "How it works",
      limitations: "What it does not do",
    },
    evidence: "Evidence",
  },
  vi: {
    sections: {
      problem: "Vì sao cần kênh riêng tư",
      designChoice: "Chúng tôi chọn gì",
      constraint: "Giới hạn",
      implementation: "Cách hoạt động",
      limitations: "Kênh này không làm gì",
    },
    evidence: "Bằng chứng",
  },
  zh: {
    sections: {
      problem: "为什么要私密渠道",
      designChoice: "我们的选择",
      constraint: "限制",
      implementation: "如何运作",
      limitations: "不做什么",
    },
    evidence: "证据",
  },
  "zh-hant": {
    sections: {
      problem: "為什麼要私密管道",
      designChoice: "我們的選擇",
      constraint: "限制",
      implementation: "如何運作",
      limitations: "不做什麼",
    },
    evidence: "證據",
  },
};

const labels = LABELS[lang];
---

{view && (
  <article class="c4-craft" data-craft-story={view.id}>
    <ol class="c4-craft__sections">
      {view.sections.map((section) => (
        <li class="c4-craft__section" data-craft-section={section.section}>
          <h2 class="c4-craft__heading">{labels.sections[section.section]}</h2>
          <p class="c4-craft__text">{section.text}</p>
        </li>
      ))}
    </ol>
    <h2 class="c4-craft__heading">{labels.evidence}</h2>
    <ul class="c4-craft__evidence">
      {view.evidence.map((entry) => (
        <li class="c4-craft__evidence-item" data-craft-evidence={entry.id}>
          <a class="c4-craft__evidence-link" href={entry.href}>
            {entry.label}
          </a>
        </li>
      ))}
    </ul>
  </article>
)}

<style is:global>
  /* ---- C4-B G9 — Craft provenance story ---- */

  .c4-craft {
    margin-block-start: var(--space-10);
    padding-block-start: var(--space-8);
    border-top: 1px solid var(--c4-hairline);
    max-width: var(--container-reading);
  }

  .c4-craft__sections {
    display: grid;
    gap: var(--space-8);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .c4-craft__heading {
    margin: 0 0 var(--space-2);
    font-size: var(--size-6);
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.25;
    color: var(--text-primary);
  }

  .c4-craft__sections + .c4-craft__heading {
    margin-block-start: var(--space-8);
  }

  .c4-craft__text {
    font-size: var(--c4-type-reading);
    /* Sits on the theme-following page surface, so it must use the theme-aware
       token: porcelain-on-porcelain in light mode was invisible (1:1). */
    color: var(--text-secondary);
  }

  .c4-craft__evidence {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .c4-craft__evidence-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: inherit;
    text-decoration: none;
  }

  .c4-craft__evidence-link:hover {
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }

  @media print {
    .c4-craft__evidence-link {
      min-height: 0;
      text-decoration: underline;
    }
  }
</style>
