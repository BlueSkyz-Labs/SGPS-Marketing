---
/**
 * C4-A S5 — Editorial Folio.
 *
 * A decorative running-context affordance for long, multi-act surfaces. The
 * ordinal is redundant ornament (`aria-hidden`); the label and any running
 * context stay REAL text, so nothing meaningful lives only in decoration.
 * It is never a progress score and never a heading.
 */
interface Props {
  /** Authored chapter label. Real text. */
  label: string;
  /** Decorative ordinal, e.g. "01". Redundant by construction. */
  ordinal?: string;
  /** Running context, e.g. the surface name. Real text. */
  context?: string;
}

const { label, ordinal, context } = Astro.props;
---

<p class="c4-folio" data-c4-folio>
  {ordinal ? (
    <span class="c4-folio__ordinal" aria-hidden="true">
      {ordinal}
    </span>
  ) : null}
  <span class="c4-folio__label">{label}</span>
  {context ? (
    <>
      <span class="c4-folio__rule" aria-hidden="true" />
      <span class="c4-folio__context">{context}</span>
    </>
  ) : null}
</p>

<style is:global>
  /* C4-A S2 — calibrated type role utilities (semantic element keeps its level). */

  .c4-folio__ordinal {
    font-variant-numeric: tabular-nums;
  }

  /* C4-A S5 — Editorial folio: running context as real text, ordinal as ornament. */
  .c4-folio {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    margin: 0;
    font-size: var(--c4-type-meta);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  /* Vietnamese: sentence case (cross-subset kerning, see .eyebrow). */
  :lang(vi) .c4-folio {
    text-transform: none;
    letter-spacing: var(--tracking-eyebrow, 0.03em);
  }

  /* C4-A S1 — Editorial grid roles.
   *
   * Desktop composition is deliberately asymmetric (a focal column beside a wider
   * supporting column); the phone composition is authored as a single column in
   * source order, so DOM reading order never depends on visual placement.
   */

  .c4-folio__rule {
    align-self: center;
    width: var(--space-8);
    height: 1px;
    background: var(--c4-hairline);
  }
</style>
