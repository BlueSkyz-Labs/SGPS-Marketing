---
import BlueSkyzIcon from "@/components/icon/BlueSkyzIcon.astro";
import ButtonLink from "@/components/ui/ButtonLink.astro";
import ProductStatus from "@/components/product/ProductStatus.astro";
import { EMPTY_STATE_COPY } from "@/data/empty-state-copy";
import { SITE, labelFor, SHARED_LABELS, type Language } from "@/data/site";
import { getPublicProducts } from "@/lib/products";
import { productPageCopy } from "@/components/product/product-page-copy";
import { getEntry } from "astro:content";

/**
 * Experience v6 S8 — About, composed only from existing authored data:
 * registry products and the "What you can check" block (v8
 * abt-5; two bound claims linked to their pages).
 *
 * Owner-confirmed entity facts (audit E-26 resolved 2026-10-07, #523): the
 * `pages` collection `{lang}-about` entry supplies founder name/title and
 * location, rendered below as the entity identity block. The confirmed
 * operating year is shown once from SITE.operatingSinceYear above.
 * Absent fields are still omitted, never padded. The founder feature uses
 * decorative brand artwork rather than implying an unverified portrait.
 *
 * UI upgrade F12 (presentation only): products render as hairline cards whose
 * whole surface is the link target; each checkable claim is a full-width row
 * with a trailing arrow, so the link affordance no longer depends on an
 * underlined sentence. Product and claim copy remain authored by their sources.
 *
 * v12 S2: each card says what the product does for the visitor, with the
 * same presentation one-liner as its profile page (`productPageCopy`, which
 * falls back to the registry `shortDescription`), instead of the registry's
 * internal phrasing ("Vietnam-first", "trusted history").
 */
interface Props {
  lang: Language;
}

interface AboutContent {
  founder_name?: unknown;
  founder_title?: unknown;
  location?: unknown;
}

const { lang } = Astro.props;
const products = (await getPublicProducts()).map((product) => ({
  slug: product.data.slug,
  name: product.data.name,
  description: productPageCopy(product.data, lang).oneLiner,
  publicLabel: product.data.publicLabel,
}));

const aboutEntry = await getEntry("pages", `${lang}-about`);
const aboutContent = aboutEntry?.data.sections?.content as
  AboutContent | undefined;
const founderName =
  typeof aboutContent?.founder_name === "string"
    ? aboutContent.founder_name
    : null;
const founderTitle =
  typeof aboutContent?.founder_title === "string"
    ? aboutContent.founder_title
    : null;
const founderLocation =
  typeof aboutContent?.location === "string" ? aboutContent.location : null;
---

<p class="about-founded" data-organization-founding-year>
  {labelFor(SHARED_LABELS.operatingSince, lang)}{" "}
  <time datetime={String(SITE.operatingSinceYear)}>
    {SITE.operatingSinceYear}
  </time>
</p>
{founderName && founderLocation && (
  <section
    class="about-founder"
    aria-labelledby="about-founder"
    data-about-founder
  >
    <header class="about-founder__identity">
      {founderTitle && <p class="about-founder__title">{founderTitle}</p>}
      <h2 id="about-founder" class="about-founder__name">
        {founderName}
      </h2>
      <p class="about-founder__meta text-pretty">{founderLocation}</p>
    </header>
    <div class="about-founder__art" aria-hidden="true">
      <img
        src="/images/about/founder-elevation.webp"
        alt=""
        width="960"
        height="1200"
        loading="lazy"
        decoding="async"
      />
    </div>
  </section>
)}
<div class="about-grid" data-about-composition>
  {products.length > 0 ? (
    <section aria-labelledby="about-make">
      <h2 id="about-make" class="about-label">
        {labelFor(EMPTY_STATE_COPY.aboutWhatWeMake, lang)}
      </h2>
      <ul class="about-products">
        {products.map((product) => (
          <li class="about-product" data-about-product>
            <a
              href={`/${lang}/products/${product.slug}/`}
              class="about-product__name"
            >
              {product.name}
              <BlueSkyzIcon
                name="arrow-right"
                class="about-arrow h-4 w-4 shrink-0"
              />
            </a>
            <ProductStatus label={product.publicLabel} lang={lang} />
            <p class="about-product__desc text-pretty">{product.description}</p>
          </li>
        ))}
      </ul>
    </section>
  ) : null}
  <section aria-labelledby="about-check" data-about-check>
    <h2 id="about-check" class="about-label">
      {labelFor(EMPTY_STATE_COPY.aboutCheck, lang)}
    </h2>
    <ul class="about-checks">
      <li data-claim-id="privacy-no-tracking-on-this-site">
        <a href={`/${lang}/privacy/`} class="about-check">
          <span class="text-pretty">
            {labelFor(EMPTY_STATE_COPY.aboutCheckNoCookies, lang)}
          </span>
          <BlueSkyzIcon
            name="arrow-right"
            class="about-arrow h-4 w-4 shrink-0"
          />
        </a>
      </li>
      <li data-claim-id="security-reporting-is-private">
        <a href={`/${lang}/security/`} class="about-check">
          <span class="text-pretty">
            {labelFor(EMPTY_STATE_COPY.aboutCheckSecurity, lang)}
          </span>
          <BlueSkyzIcon
            name="arrow-right"
            class="about-arrow h-4 w-4 shrink-0"
          />
        </a>
      </li>
    </ul>
    <a
      href={`/${lang}/verify/`}
      class="about-verify inline-flex items-center gap-2"
    >
      {labelFor(EMPTY_STATE_COPY.aboutCheckCta, lang)}
      <BlueSkyzIcon name="arrow-right" class="about-arrow h-4 w-4 shrink-0" />
    </a>
  </section>
</div>
{SITE.founderEmail ? (
  <p
    class="mt-8 text-sm text-[var(--text-secondary)]"
    data-public-email-role="founder"
  >
    {labelFor(SHARED_LABELS.strategicContact, lang)}{" "}
    <a
      href={`mailto:${SITE.founderEmail}`}
      class="font-semibold text-[var(--action-primary)] no-underline hover:underline"
    >
      {SITE.founderEmail}
    </a>
  </p>
) : null}
<div class="mt-12 flex flex-wrap gap-3">
  <ButtonLink href={`/${lang}/products/`}>
    {labelFor(SHARED_LABELS.exploreProducts, lang)}
  </ButtonLink>
  <ButtonLink href={`/${lang}/contact/`} variant="secondary">
    {labelFor(SHARED_LABELS.contactUs, lang)}
  </ButtonLink>
</div>

<style>
  .about-founded {
    margin: 0 0 3rem;
    color: var(--text-secondary);
    font-size: var(--size-2);
  }
  .about-grid {
    display: grid;
    gap: 3rem;
    margin-block-start: 3rem;
  }
  @media (min-width: 48rem) {
    .about-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 3.5rem;
    }
  }
  .about-label {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin: 0;
    font-size: var(--size-1);
    font-weight: 600;
    letter-spacing: var(--tracking-eyebrow, 0.12em);
    text-transform: uppercase;
    color: var(--text-secondary);
  }

  /* Vietnamese: sentence case (cross-subset kerning, see .eyebrow). */
  :lang(vi) .about-label {
    text-transform: none;
    letter-spacing: var(--tracking-eyebrow, 0.03em);
  }
  .about-label::before {
    content: "";
    inline-size: 1.5rem;
    border-block-start: 1px solid var(--action-primary);
    flex: none;
  }
  :lang(vi) .about-label {
    letter-spacing: 0.06em;
  }
  :lang(zh) .about-label {
    letter-spacing: 0.04em;
  }
  .about-founder {
    display: grid;
    overflow: hidden;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-media);
    background: var(--surface-raised);
  }
  .about-founder__identity {
    align-self: center;
    min-inline-size: 0;
    padding: 2rem;
  }
  .about-founder__title {
    margin: 0 0 1.5rem;
    font-size: var(--size-2);
    font-weight: 600;
    line-height: var(--lh-2);
    color: var(--action-primary);
  }
  .about-founder__name {
    margin: 0;
    font-size: var(--size-7);
    font-weight: 600;
    line-height: var(--lh-7);
    letter-spacing: -0.02em;
    overflow-wrap: anywhere;
    color: var(--text-primary);
  }
  .about-founder__meta {
    margin: 1.25rem 0 0;
    padding-block-start: 1.25rem;
    border-block-start: 1px solid var(--border-subtle);
    font-size: var(--size-2);
    line-height: var(--lh-2);
    color: var(--text-secondary);
  }
  .about-founder__art {
    aspect-ratio: 4 / 5;
    overflow: hidden;
  }
  .about-founder__art img {
    display: block;
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
  }
  @media (min-width: 48rem) {
    .about-founder {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }
    .about-founder__identity {
      padding: 3rem;
    }
  }
  .about-products,
  .about-checks {
    display: grid;
    margin: 1.25rem 0 0;
    padding: 0;
    list-style: none;
  }
  .about-products {
    gap: 1rem;
  }
  .about-product {
    position: relative;
    padding: 1.25rem 1.5rem 1.5rem;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-card);
    background: var(--surface-raised);
    transition: border-color 150ms var(--brand-ease-standard, ease);
  }
  .about-product:hover {
    border-color: var(--text-secondary);
  }
  .about-product__name {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    font-size: var(--size-4);
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--text-primary);
    text-decoration: none;
  }
  /* The whole card is the target; the name stays the accessible link text. */
  .about-product__name::after {
    content: "";
    position: absolute;
    z-index: 0;
    inset: 0;
    border-radius: inherit;
  }
  .about-product [data-product-status] {
    position: relative;
    z-index: 1;
    margin-inline-start: 0.75rem;
    pointer-events: none;
    vertical-align: middle;
  }
  .about-product__name:focus-visible {
    outline: none;
  }
  .about-product__name:focus-visible::after {
    outline: 2px solid var(--brand-cobalt);
    outline-offset: 2px;
  }
  .about-product__desc {
    margin: 0;
    font-size: var(--size-2);
    line-height: 1.6;
    color: var(--text-secondary);
  }
  /* The icon is rendered by a child component, so it is styled through
     :global() under this component's scoped ancestors. */
  .about-grid :global(.about-arrow) {
    color: var(--action-primary);
    transition: translate 150ms var(--brand-ease-standard, ease);
  }
  .about-product:hover :global(.about-arrow),
  .about-check:hover :global(.about-arrow) {
    translate: 0.1875rem 0;
  }
  .about-checks {
    border-block-end: 1px solid var(--border-subtle);
  }
  .about-check {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 2.75rem;
    padding-block: 1rem;
    border-block-start: 1px solid var(--border-subtle);
    color: var(--text-primary);
    text-decoration: none;
  }
  .about-check:hover span {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .about-verify {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    margin-block-start: 0.75rem;
    font-size: var(--size-2);
    font-weight: 600;
    color: var(--action-primary);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .about-verify:hover {
    text-decoration: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .about-product,
    .about-grid :global(.about-arrow) {
      transition: none;
    }
    .about-product:hover :global(.about-arrow),
    .about-check:hover :global(.about-arrow) {
      translate: none;
    }
  }
  @media (forced-colors: active) {
    .about-label::before,
    .about-founder,
    .about-founder__meta {
      border-color: CanvasText;
    }
    .about-founder__title {
      color: CanvasText;
    }
    .about-grid :global(.about-arrow) {
      color: LinkText;
    }
  }
</style>
