---
import ButtonLink from "@/components/ui/ButtonLink.astro";
import BusinessRouteState from "@/components/empty-state/BusinessRouteState.astro";
import { SITE, labelFor, SHARED_LABELS } from "@/data/site";
import type { Language } from "@/data/site";

interface Props {
  lang: Language;
  boundary: string;
}

const { lang, boundary } = Astro.props;
const hasPublicEmail = Boolean(SITE.contactEmail || SITE.supportEmail);
---

{hasPublicEmail ? (
  <li
    data-contact-card="business"
    class="flex min-w-0 flex-col gap-3 rounded-xl border border-[var(--border-subtle)] bg-[var(--surface-raised)] p-6"
  >
    <h2 class="text-lg font-semibold tracking-tight">
      {labelFor(SHARED_LABELS.generalContact, lang)}
    </h2>
    {SITE.contactEmail ? (
      <p
        class="text-sm text-[var(--text-secondary)]"
        data-public-email-role="contact"
      >
        <ButtonLink
          href={`mailto:${SITE.contactEmail}`}
          variant="primary"
          icon="none"
          data-contact-primary
        >
          {SITE.contactEmail}
        </ButtonLink>
      </p>
    ) : null}
    {SITE.supportEmail ? (
      <p
        class="flex flex-wrap items-center gap-2 text-sm text-[var(--text-secondary)]"
        data-public-email-role="support"
      >
        <span>{labelFor(SHARED_LABELS.productSupport, lang)}: </span>
        {/* ACQ-08: the tertiary pulls back by its 0.75rem inline padding so
            the label-to-address gap is exactly the 8px flex gap. */}
        <ButtonLink
          href={`mailto:${SITE.supportEmail}`}
          variant="tertiary"
          icon="none"
          class="-ms-3"
        >
          {SITE.supportEmail}
        </ButtonLink>
      </p>
    ) : null}
  </li>
) : (
  <BusinessRouteState
    lang={lang}
    heading={labelFor(SHARED_LABELS.generalContact, lang)}
    boundary={boundary}
  />
)}
