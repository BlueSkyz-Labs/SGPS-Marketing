---
import type { CollectionEntry } from "astro:content";
import ProductVisual from "@/components/product/ProductVisual.astro";
import { EMPTY_STATE_COPY } from "@/data/empty-state-copy";
import { labelFor, type Language } from "@/data/site";
import { proofCaptionForKind } from "@/lib/product-copy";

/**
 * Experience v6 S8 — a product profile with no published captures shows its
 * registry identity artwork on the ink stage, captioned as artwork, plus one
 * plain line saying no app screenshots exist yet. No device frame, no
 * placeholder screen.
 */
type ProductMedia = NonNullable<
  CollectionEntry<"products">["data"]["proof"]["media"]
>;

interface Props {
  media: ProductMedia;
  lang: Language;
}

const { media, lang } = Astro.props;
---

<figure class="m-0 mt-10 max-w-4xl" data-profile-identity-stage data-no-capture>
  <ProductVisual media={media} />
  <figcaption class="mt-3 text-sm text-[var(--text-muted)]">
    {proofCaptionForKind(media.kind, lang)}{" "}
    {media.kind === "identity-art"
      ? labelFor(EMPTY_STATE_COPY.noCaptures, lang)
      : null}
  </figcaption>
</figure>
