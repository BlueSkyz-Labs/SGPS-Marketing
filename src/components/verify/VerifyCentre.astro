---
/**
 * v8 W5a — the verification page (/{locale}/verify/), deck rows ver-1..8.
 *
 * Presentation only: claims, evidence references and the trust lanes come from
 * the canonical data modules. Nothing here authors or strengthens a claim.
 * Each claim is shown once with its limit and its sources inline (sources rail
 * on the right from 1024 px). "What backs it" lists the three trust lanes, one
 * pointer leads to Compare claims, and the claim map sits in a native
 * <details> that is closed by default and complete without JavaScript.
 */
import Container from "@/components/layout/Container.astro";
import PageHeader from "@/components/layout/PageHeader.astro";
import TrustLedger from "@/components/experience/TrustLedger.astro";
import Atlas from "@/components/experience/Atlas.astro";
import DeepLinkOpener from "@/components/verify/DeepLinkOpener.astro";
import SourcesLine from "@/components/trust/SourcesLine.astro";
import { getClaimAnchor, getPublicClaims } from "@/lib/claims";
import { getPublicProducts } from "@/lib/products";
import type { Language } from "@/data/site";
import type { SourceRef } from "@/data/trust-copy";

interface Props {
  lang: Language;
}

const { lang } = Astro.props;

const products = (await getPublicProducts()).map((product) => ({
  slug: product.data.slug,
  name: product.data.name,
}));
// Only claims the registry publishes are shown (fail-closed).
const published = new Set(
  getPublicClaims(products).map((resolved) => resolved.claim.id),
);

interface ClaimCopy {
  id: string;
  statement: string;
  limit?: string;
  sources: SourceRef[];
}

interface VerifyCopy {
  title: string;
  lede: string;
  claims: string;
  limit: string;
  sources: string;
  backs: string;
  comparePre: string;
  compareLink: string;
  map: string;
  items: ClaimCopy[];
}

const COPY: Record<Language, VerifyCopy> = {
  en: {
    title: "Verify",
    lede: "Check our claims against public sources.",
    claims: "What we claim",
    limit: "Limit:",
    sources: "Sources:",
    backs: "What backs it",
    comparePre: "To compare claims side by side, use",
    compareLink: "Compare claims",
    map: "Map of our claims",
    items: [
      {
        id: "security-reporting-is-private",
        statement:
          "Security reports go to the maintainers through a private GitHub channel, never a public issue.",
        limit:
          "no bug bounty, response-time commitment or right to public disclosure.",
        sources: [
          {
            id: "ev-security-advisory",
            label: "GitHub private vulnerability reporting",
          },
          { id: "ev-security-route", label: "Security route" },
        ],
      },
      {
        id: "privacy-no-tracking-on-this-site",
        statement:
          "This site sets no cookies. It stores only the language and theme you choose, in your browser.",
        limit:
          "network data such as IP addresses is still handled by the infrastructure.",
        sources: [
          { id: "ev-privacy-route", label: "Privacy route" },
          { id: "ev-security-route", label: "Security route" },
        ],
      },
      {
        id: "registry-publishes-only-proven-products",
        statement:
          "A product is listed here only when its public evidence is ready to check.",
        sources: [{ id: "ev-products-route", label: "Products page" }],
      },
    ],
  },
  vi: {
    title: "Xác minh",
    lede: "Đối chiếu các tuyên bố của chúng tôi với nguồn công khai.",
    claims: "Chúng tôi nói gì",
    limit: "Giới hạn:",
    sources: "Nguồn:",
    backs: "Căn cứ là gì",
    comparePre: "Để xem các tuyên bố cạnh nhau, dùng",
    compareLink: "So sánh tuyên bố",
    map: "Sơ đồ các tuyên bố",
    items: [
      {
        id: "security-reporting-is-private",
        statement:
          "Báo cáo bảo mật đến người bảo trì qua kênh GitHub riêng tư, không bao giờ qua issue công khai.",
        limit:
          "không có thưởng lỗ hổng, cam kết thời gian phản hồi hay quyền công bố công khai.",
        sources: [
          {
            id: "ev-security-advisory",
            label: "Báo cáo lỗ hổng riêng tư của GitHub",
          },
          { id: "ev-security-route", label: "Trang Bảo mật" },
        ],
      },
      {
        id: "privacy-no-tracking-on-this-site",
        statement:
          "Trang web này không đặt cookie. Chỉ lưu ngôn ngữ và giao diện bạn chọn trong trình duyệt.",
        limit: "dữ liệu mạng như địa chỉ IP vẫn do hạ tầng xử lý.",
        sources: [
          { id: "ev-privacy-route", label: "Trang Quyền riêng tư" },
          { id: "ev-security-route", label: "Trang Bảo mật" },
        ],
      },
      {
        id: "registry-publishes-only-proven-products",
        statement:
          "Sản phẩm chỉ được liệt kê khi bằng chứng công khai sẵn sàng để kiểm chứng.",
        sources: [{ id: "ev-products-route", label: "Trang Sản phẩm" }],
      },
    ],
  },
  zh: {
    title: "核实",
    lede: "对照公开来源，检查我们的声明。",
    claims: "我们说了什么",
    limit: "限制：",
    sources: "来源：",
    backs: "依据是什么",
    comparePre: "要并排比较，请用",
    compareLink: "比较声明",
    map: "我们的声明图谱",
    items: [
      {
        id: "security-reporting-is-private",
        statement:
          "安全报告通过 GitHub 私有渠道送达维护者，绝不通过公开 issue。",
