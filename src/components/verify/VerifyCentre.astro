    compareLink: "side-by-side view",
    map: "Map of what we say",
    items: [
      {
        id: "security-reporting-is-private",
        statement:
          "Security reports go to the maintainers through a private GitHub channel, never a public issue.",
        limit:
          "no bug bounty, response-time commitment or right to public disclosure.",
        sources: [
          {
            id: "ev-security-advisory",
            label: "Private reporting form on GitHub",
          },
          {
            id: "ev-security-route",
            label: "Security page",
          },
