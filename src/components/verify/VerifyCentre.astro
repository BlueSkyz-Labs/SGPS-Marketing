          { id: "ev-privacy-route", label: "View the privacy page" },
          {
            id: "ev-security-route",
            label: "Security page: details",
          },
        ],
      },
      {
        id: "registry-publishes-only-proven-products",
        statement:
          "A product is listed here only when its public evidence is ready to check.",
        sources: [{ id: "ev-products-route", label: "View the products page" }],
      },
    ],
  },
  vi: {
    title: "Kiểm chứng",
    lede: "Đối chiếu các tuyên bố của chúng tôi với nguồn công khai.",
    claims: "Chúng tôi nói gì",
    limit: "Giới hạn:",
    sources: "Nguồn:",
    backs: "Căn cứ là gì",
    comparePre: "Để xem các tuyên bố cạnh nhau, dùng",
    compareLink: "So sánh tuyên bố",
    map: "Sơ đồ các tuyên bố",
    items: [
      {
        id: "security-reporting-is-private",
        statement:
          "Báo cáo bảo mật đến người bảo trì (người quản lý kho mã nguồn trên GitHub) qua kênh GitHub riêng tư, không bao giờ qua issue công khai (mục báo lỗi công khai trên GitHub).",
        limit:
          "không có thưởng lỗ hổng, cam kết thời gian phản hồi hay quyền công bố công khai.",
        sources: [
          {
            id: "ev-security-advisory",
            label: "Báo cáo lỗ hổng riêng tư của GitHub",
          },
          {
            id: "ev-security-route",
            label: "Trang Bảo mật",
          },
        ],
      },
      {
        id: "privacy-no-tracking-on-this-site",
        statement:
          "Trang web này không đặt cookie. Chỉ lưu ngôn ngữ và giao diện bạn chọn trong trình duyệt.",
        limit: "dữ liệu mạng như địa chỉ IP vẫn do hạ tầng xử lý.",
        sources: [
          { id: "ev-privacy-route", label: "Về quyền riêng tư" },
          {
            id: "ev-security-route",
            label: "Về bảo mật",
          },
        ],
      },
      {
        id: "registry-publishes-only-proven-products",
        statement:
          "Sản phẩm chỉ được liệt kê khi bằng chứng công khai sẵn sàng để kiểm chứng.",
        sources: [{ id: "ev-products-route", label: "Sản phẩm" }],
      },
    ],
  },
  zh: {
    title: "核实",
    lede: "对照公开来源，检查我们的说法。",
    claims: "我们说了什么",
    limit: "限制：",
    sources: "来源：",
    backs: "依据是什么",
    comparePre: "要并排比较，请用",
    compareLink: "并排查看我们的说法",
    map: "我们所说内容的图谱",
    items: [
      {
        id: "security-reporting-is-private",
        statement:
          "安全报告通过 GitHub 私有渠道送达维护者，绝不通过公开 issue。",
