---
/**
 * v8 W5a — the verification page (/{locale}/verify/), deck rows ver-1..8.
 *
 * Presentation only: claims, evidence references and the trust lanes come from
 * the canonical data modules. Nothing here authors or strengthens a claim.
 * Each claim is shown once with its limit and its sources inline (sources rail
 * on the right from 1024 px). "What backs it" lists the three trust lanes, one
 * pointer leads to Compare claims, and the claim map sits in a native
 * <details> that is closed by default and complete without JavaScript.
 */
import Container from "@/components/layout/Container.astro";
import PageHeader from "@/components/layout/PageHeader.astro";
import TrustLedger from "@/components/experience/TrustLedger.astro";
import Atlas from "@/components/experience/Atlas.astro";
import DeepLinkOpener from "@/components/verify/DeepLinkOpener.astro";
import SourcesLine from "@/components/trust/SourcesLine.astro";
import { getClaimAnchor, getPublicClaims } from "@/lib/claims";
import { getPublicProducts } from "@/lib/products";
import type { Language } from "@/data/site";
import type { SourceRef } from "@/data/trust-copy";

interface Props {
  lang: Language;
}

const { lang } = Astro.props;

const products = (await getPublicProducts()).map((product) => ({
  slug: product.data.slug,
  name: product.data.name,
}));
// Only claims the registry publishes are shown (fail-closed).
const published = new Set(
  getPublicClaims(products).map((resolved) => resolved.claim.id),
);

interface ClaimCopy {
  id: string;
  statement: string;
  limit?: string;
  sources: SourceRef[];
}

interface VerifyCopy {
  title: string;
  lede: string;
  claims: string;
  limit: string;
  sources: string;
  backs: string;
  comparePre: string;
  compareLink: string;
  map: string;
  items: ClaimCopy[];
}

const COPY: Record<Language, VerifyCopy> = {
  en: {
    title: "Verify",
    lede: "Check what we say against public sources.",
    claims: "What we say",
    limit: "Limit:",
    sources: "Sources:",
