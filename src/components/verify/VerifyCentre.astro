          { id: "ev-security-advisory", label: "GitHub 私密漏洞报告" },
          { id: "ev-security-route", label: "安全页面" },
        ],
      },
      {
        id: "privacy-no-tracking-on-this-site",
        statement: "本站不设置 Cookie，只在浏览器中保存你选择的语言和主题。",
