      {
        id: "security-reporting-is-private",
        statement:
          "資安通報透過 GitHub 私有管道送達維護者，絕不透過公開 issue。",
        limit: "不含漏洞賞金、回應時限承諾或公開揭露權。",
        sources: [
          { id: "ev-security-advisory", label: "在 GitHub 私下通報漏洞" },
          { id: "ev-security-route", label: "資訊安全頁面：通報送達方式" },
        ],
      },
      {
        id: "privacy-no-tracking-on-this-site",
        statement: "本站不設定 Cookie，只在瀏覽器中儲存你選擇的語言與主題。",
        limit: "IP 位址等網路資料仍由基礎設施處理。",
        sources: [
          { id: "ev-privacy-route", label: "查看隱私權頁面" },
          { id: "ev-security-route", label: "資訊安全頁面：通報詳情" },
        ],
      },
      {
        id: "registry-publishes-only-proven-products",
        statement: "只有公開證據可查證時，產品才會列在這裡。",
        sources: [{ id: "ev-products-route", label: "查看產品頁面" }],
      },
    ],
  },
};

const c = COPY[lang];
const items = c.items.filter((item) => published.has(item.id));

// Claims can share evidence; emit each evidence anchor id once per page (first
// claim wins) so deep links stay unique and resolvable.
const seen = new Set<string>();
const omitByClaim = new Map<string, string[]>();
for (const item of items) {
  omitByClaim.set(
    item.id,
    item.sources.filter((source) => seen.has(source.id)).map((s) => s.id),
  );
  for (const source of item.sources) seen.add(source.id);
}
---

<section class="py-16 lg:py-24" data-verify-centre>
  <Container>
    <PageHeader title={c.title} lede={c.lede} />

    {items.length > 0 ? (
      <div class="mt-12">
        <h2 class="text-xl font-semibold tracking-tight sm:text-2xl">
          {c.claims}
        </h2>
        <ul class="verify-claims mt-6" data-evidence-teaser>
          {items.map((item) => (
            <li
              class="verify-claim"
              data-evidence-teaser-item
              data-claim-id={item.id}
            >
              <div class="verify-claim__main">
                <h3
                  class="verify-claim__statement"
                  id={getClaimAnchor(item.id)}
                >
                  {item.statement}
                </h3>
                {item.limit ? (
                  <p class="verify-claim__limit">
                    <strong>{c.limit}</strong> {item.limit}
                  </p>
                ) : null}
              </div>
              <SourcesLine
                lang={lang}
                claimId={item.id}
                label={c.sources}
                sources={item.sources}
                omitAnchorIds={omitByClaim.get(item.id) ?? []}
                class="verify-claim__sources"
              />
            </li>
          ))}
        </ul>
      </div>
    ) : null}

    <div class="mt-12 max-w-3xl">
      <h2 class="text-xl font-semibold tracking-tight sm:text-2xl">
        {c.backs}
      </h2>
      <TrustLedger lang={lang} compare={false} />
    </div>

    <p class="mt-10 max-w-3xl text-[var(--text-secondary)]">
      {c.comparePre}{" "}
      <a
        href={`/${lang}/decision-room/`}
        class="inline-flex min-h-11 items-center font-semibold text-[var(--action-primary)] underline underline-offset-4 hover:no-underline"
        data-verify-room
      >
        {c.compareLink} →
      </a>
    </p>

    <details class="verify-layer mt-10 max-w-3xl" data-verify-layer="atlas">
      <summary class="verify-layer__summary">{c.map}</summary>
      <div class="verify-layer__body">
        <Atlas lang={lang} />
      </div>
    </details>
  </Container>
</section>

<DeepLinkOpener />

<style>
  /* No margin reset: it would beat the layered mt-6 (audit B-03). */
  .verify-claims {
    display: grid;
    gap: 1rem;
    padding: 0;
    list-style: none;
  }

  /* UX-U7: each claim is one card, so its statement, limit and sources read
     as one unit (the source link sits inside the card). */
  .verify-claim {
    display: grid;
    gap: 0.75rem;
    min-width: 0;
    padding: 1.25rem;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-card);
    background: var(--surface-raised);
  }

  .verify-claim__main {
    min-width: 0;
    max-width: 46rem;
  }

  /* v8 contract: the sources rail sits beside its claim from 1024px. The
     columns hug their content widths so the rail reads as attached to the
     claim (gap = --space-8) instead of floating at the far edge. */
  @media (min-width: 1024px) {
    .verify-claim {
      grid-template-columns: minmax(0, 46rem) minmax(0, 28rem);
      column-gap: var(--space-8);
      justify-content: start;
      align-items: start;
    }
  }

  .verify-claim__statement {
    margin: 0;
    font-size: var(--size-4);
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.4;
    color: var(--text-primary);
    overflow-wrap: anywhere;
    text-wrap: balance;
    scroll-margin-top: 6rem;
  }

  .verify-claim__limit {
    margin: 0.5rem 0 0;
    font-size: var(--size-3);
    line-height: 1.6;
    color: var(--text-secondary);
  }

  .verify-claim__limit strong {
    font-weight: 600;
    color: var(--text-primary);
  }

  .verify-layer {
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-card);
    background: var(--surface-raised);
  }

  .verify-layer__summary {
    display: flex;
    align-items: center;
    min-height: 2.75rem;
    padding: 0.5rem 1.25rem;
    font-weight: 600;
    color: var(--text-primary);
    cursor: pointer;
  }

  .verify-layer__summary:focus-visible {
    outline: 2px solid var(--action-primary);
    outline-offset: 2px;
  }

  .verify-layer__body {
    padding: 0 1.25rem 1.25rem;
    min-width: 0;
  }

  .verify-layer__body :global(#atlas-title) {
    font-size: var(--size-5);
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.3;
  }

  .verify-layer__body :global(.atlas-section) {
    padding-block: 1rem;
    border-bottom: 0;
  }
</style>
