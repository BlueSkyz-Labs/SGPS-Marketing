---
import {
  PUBLIC_LENSES,
  getPublicArchitectureView,
} from "@/lib/public-architecture";
import type { Language } from "@/lib/i18n";
import { ARCHITECTURE_COPY } from "@/data/architecture-copy";
import ArchitectureLens from "@/components/architecture/ArchitectureLens.astro";

/**
 * Architecture explainer (was the C4-D "salon"): five plain-language sections.
 *
 * Static-first and text-first: all five lenses are rendered as ordinary
 * sections with semantic headings, reached by ordinary in-page links. Nothing
 * is hidden behind JavaScript and no diagram carries information on its own.
 * The optional script only moves focus to a lens named in a validated URL
 * parameter; an unknown value changes nothing, so the safe default is simply
 * the full page.
 */
interface Props {
  lang: Language;
}

const { lang } = Astro.props;

const copy = ARCHITECTURE_COPY[lang];
const verifyHref = `/${lang}/verify/`;

const views = PUBLIC_LENSES.map((lens) => ({
  lens,
  view: getPublicArchitectureView(lens),
}));
const lastVerified = views[0]?.view.lastVerified ?? null;
const lastVerifiedText = lastVerified
  ? new Intl.DateTimeFormat(lang, {
      dateStyle: "long",
      timeZone: "UTC",
    }).format(new Date(`${lastVerified}T00:00:00Z`))
  : null;
---

<section class="c4-salon" data-architecture-salon>
  <nav class="c4-salon__nav" aria-label={copy.nav}>
    <ul class="c4-salon__nav-list">
      {views.map(({ lens }) => (
        <li class="c4-salon__nav-item">
          <a class="c4-salon__nav-link" href={`#lens-${lens}`}>
            {copy.lenses[lens].nav}
          </a>
        </li>
      ))}
    </ul>
  </nav>

  {views.map(({ lens, view }) => (
    <ArchitectureLens
      lens={lens}
      nodes={view.nodes}
      edges={view.edges}
      lang={lang}
      {...(lens === "evidence" ? { verifyHref } : {})}
    />
  ))}

  {lastVerified && (
    <p class="c4-salon__source">
      {copy.lastVerified}:{" "}
      <time datetime={lastVerified}>{lastVerifiedText}</time>
    </p>
  )}
</section>

<script>
  /**
   * Optional enhancement: focus a lens named in a validated URL parameter.
   * An unknown value is ignored, so the safe default is the full page.
   */
  const sections = document.querySelectorAll<HTMLElement>(
    "[data-architecture-lens]",
  );
  const allowed = new Set(
    [...sections].map(
      (section) => section.getAttribute("data-architecture-lens") ?? "",
    ),
  );
  const requested = new URLSearchParams(window.location.search).get("lens");
  if (requested && allowed.has(requested)) {
    const target = document.getElementById(`lens-${requested}`);
    if (target) {
      target.setAttribute("tabindex", "-1");
      target.focus({ preventScroll: false });
    }
  }
</script>
