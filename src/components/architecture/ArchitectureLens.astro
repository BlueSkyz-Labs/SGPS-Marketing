---
import type {
  PublicArchitectureEdge,
  PublicArchitectureNode,
  PublicLens,
} from "@/lib/public-architecture";
import type { Language } from "@/lib/i18n";

/**
 * C4-D Task 2 — one architecture lens.
 *
 * Text carries every fact: the heading, the node list and the relationship
 * list are ordinary semantic markup. The connector diagram is supplemental and
 * aria-hidden, so nothing is diagram-only and nothing needs JavaScript.
 */
interface Props {
  lens: PublicLens;
  nodes: PublicArchitectureNode[];
  edges: PublicArchitectureEdge[];
  lang: Language;
}

const { lens, nodes, edges, lang } = Astro.props;

const LABELS: Record<
  Language,
  { nodes: string; relationships: string; boundary: string; none: string }
> = {
  en: {
    nodes: "Public components",
    relationships: "Relationships",
    boundary: "Boundary",
    none: "No relationship is published for this lens.",
  },
  vi: {
    nodes: "Thành phần công khai",
    relationships: "Quan hệ",
    boundary: "Ranh giới",
    none: "Lens này không công bố quan hệ nào.",
  },
  zh: {
    nodes: "公开组件",
    relationships: "关系",
    boundary: "边界",
    none: "此视角未发布任何关系。",
  },
};

const labels = LABELS[lang];
const labelOf = new Map(nodes.map((node) => [node.id, node.label]));

// A compact, purely decorative layout: one column per node, one row per edge.
const column = (index: number) => 24 + index * 44;
const row = (index: number) => 18 + index * 22;
---

<section
  class="c4-salon__lens"
  id={`lens-${lens}`}
  data-architecture-lens={lens}
>
  <h2 class="c4-salon__lens-heading">{lens}</h2>

  <h3 class="c4-salon__subheading">{labels.nodes}</h3>
  <ul class="c4-salon__nodes">
    {
      nodes.map((node) => (
        <li class="c4-salon__node" data-architecture-node={node.id}>
          <span class="c4-salon__node-label">{node.label}</span>
          <span class="c4-salon__node-kind">{node.kind}</span>
          {node.boundary && (
            <span class="c4-salon__node-boundary">
              {labels.boundary}: {node.boundary}
            </span>
          )}
        </li>
      ))
    }
  </ul>

  <h3 class="c4-salon__subheading">{labels.relationships}</h3>
  {
    edges.length === 0 ? (
      <p class="c4-salon__none">{labels.none}</p>
    ) : (
      <ul class="c4-salon__edges">
        {edges.map((edge) => (
          <li class="c4-salon__edge" data-architecture-edge={edge.id}>
            <span class="c4-salon__edge-from">
              {labelOf.get(edge.from) ?? edge.from}
            </span>
            <span class="c4-salon__edge-type">{edge.type}</span>
            <span class="c4-salon__edge-to">
              {labelOf.get(edge.to) ?? edge.to}
            </span>
          </li>
        ))}
      </ul>
    )
  }

  {
    edges.length > 0 && (
      <svg
        class="c4-salon__diagram"
        aria-hidden="true"
        focusable="false"
        viewBox={`0 0 ${Math.max(120, column(nodes.length - 1) + 24)} ${Math.max(60, row(edges.length - 1) + 18)}`}
        preserveAspectRatio="xMinYMin meet"
      >
        <g class="c4-salon__diagram-edges">
          {edges.map((edge, index) => {
            const from = nodes.findIndex((node) => node.id === edge.from);
            const to = nodes.findIndex((node) => node.id === edge.to);
            return (
              <line
                x1={column(from)}
                y1={row(index)}
                x2={column(to)}
                y2={row(index)}
                class="c4-salon__diagram-line"
              />
            );
          })}
        </g>
        <g class="c4-salon__diagram-nodes">
          {nodes.map((node, index) => (
            <circle
              cx={column(index)}
              cy={row(0)}
              r="4"
              class="c4-salon__diagram-dot"
            />
          ))}
        </g>
      </svg>
    )
  }
</section>
