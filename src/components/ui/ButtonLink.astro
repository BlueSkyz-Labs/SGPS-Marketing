---
import BlueSkyzIcon from "@/components/icon/BlueSkyzIcon.astro";

interface Props {
  href: string;
  variant?: "primary" | "secondary" | "on-ink";
  class?: string;
  icon?: "arrow-right" | "external" | "none";
  /** Pass-through data-* hooks (e.g. data-hero-primary). */
  [attribute: `data-${string}`]: string | boolean | undefined;
}
const {
  href,
  variant = "primary",
  class: className = "",
  icon,
  ...attributes
} = Astro.props;
const isExternal = /^https?:\/\//i.test(href);
const trailingIcon =
  icon ??
  (isExternal ? "external" : variant === "primary" ? "arrow-right" : "none");
---

<a
  href={href}
  {...attributes}
  rel={isExternal ? "noopener noreferrer" : undefined}
  class:list={[
    "inline-flex min-h-11 max-w-full items-center justify-center gap-2 rounded-full px-5 py-2.5 text-sm font-semibold no-underline [overflow-wrap:anywhere] transition-[background-color,border-color,transform] duration-150 focus-visible:ring-2 focus-visible:ring-[var(--brand-cobalt)] focus-visible:ring-offset-2 focus-visible:outline-none active:scale-[0.98] motion-reduce:transition-none motion-reduce:active:scale-100",
    variant === "primary" &&
      "bg-[var(--brand-cobalt)] text-[#ffffff] hover:bg-[#1d4ed8] hover:shadow-[0_12px_30px_-10px_color-mix(in_srgb,var(--brand-cobalt)_60%,transparent)] motion-reduce:hover:shadow-none",
    variant === "secondary" &&
      "border border-[var(--border-subtle)] bg-[var(--surface-raised)] text-[var(--text-primary)] hover:bg-[var(--surface-subtle)]",
    variant === "on-ink" &&
      "border border-white/40 bg-transparent text-[var(--brand-porcelain)] hover:border-white/60 hover:bg-white/10",
    className,
  ]}
>
  <slot />
  {trailingIcon !== "none" ? (
    <BlueSkyzIcon name={trailingIcon} class="btn__icon h-4 w-4 shrink-0" />
  ) : null}
</a>
