---
/**
 * v8 W5a: one inline "Sources: a · b" line for a published claim.
 *
 * Presentation only. Hrefs and the review date resolve from the canonical
 * claim passport (claims.ts / integrity.ts); the visible labels are passed by
 * the page from the copy deck. Each source link carries the stable evidence
 * anchor (`#evidence-<id>`) so existing deep links keep resolving, unless the
 * page has already emitted that anchor for an earlier claim.
 *
 * A source that is the current page (the Security route on /security) is
 * shown as plain text with aria-current: a link to itself is circular evidence
 * (customer review F6). It keeps its anchor id and trace step.
 */
import { getEvidencePassport } from "@/lib/claims";
import { getPublicProducts } from "@/lib/products";
import { formatDisplayDate } from "@/lib/display-date";
import type { SourceRef } from "@/data/trust-copy";
import type { Language } from "@/data/site";

interface Props {
  lang: Language;
  claimId: string;
  label: string;
  sources: readonly SourceRef[];
  /** Show "Reviewed <date>" from the claim's review record. */
  reviewedLabel?: string | undefined;
  omitAnchorIds?: readonly string[] | undefined;
  class?: string | undefined;
}

const {
  lang,
  claimId,
  label,
  sources,
  reviewedLabel,
  omitAnchorIds = [],
  class: className,
} = Astro.props;

const products = (await getPublicProducts()).map((product) => ({
  slug: product.data.slug,
  name: product.data.name,
}));
const passport = getEvidencePassport(claimId, products);
const refs = new Map((passport?.evidence ?? []).map((ref) => [ref.id, ref]));
const pathname = Astro.url.pathname;
const items = sources.flatMap((source) => {
  const ref = refs.get(source.id);
  return ref
    ? [
        {
          ...source,
          href: ref.href[lang],
          current: ref.href[lang] === pathname,
        },
      ]
    : [];
});
const reviewedOn = reviewedLabel ? passport?.reviewedOn : undefined;
---

{items.length > 0 ? (
  <p class:list={["sources-line", className]} data-sources-line>
    <span class="sources-line__label">{label}</span>{" "}
    {items.map((item, index) => (
      <>
        {index > 0 ? " " : null}
        <span
          class:list={[
            "sources-line__item",
            reviewedOn && index === items.length - 1
              ? "sources-line__item--last"
              : null,
          ]}
          data-sources-item
        >
          {item.current ? (
            <span
              id={
                omitAnchorIds.includes(item.id)
                  ? undefined
                  : `evidence-${item.id}`
              }
              data-trace-step={
                omitAnchorIds.includes(item.id) ? undefined : "evidence"
              }
              aria-current="page"
              class="sources-line__current"
            >
              {item.label}
            </span>
          ) : (
            <a
              href={item.href}
              id={
                omitAnchorIds.includes(item.id)
                  ? undefined
                  : `evidence-${item.id}`
              }
              data-trace-step={
                omitAnchorIds.includes(item.id) ? undefined : "evidence"
              }
              rel={
                /^https?:\/\//i.test(item.href)
                  ? "noopener noreferrer"
                  : undefined
              }
              class="sources-line__link"
            >
              {item.label}
            </a>
          )}
        </span>
      </>
    ))}{" "}
    {reviewedOn ? (
      <span class="sources-line__reviewed">
        {reviewedLabel}{" "}
        <span class="sources-line__date">
          <time datetime={reviewedOn}>
            {formatDisplayDate(reviewedOn, lang)}
          </time>
          {"."}
        </span>
      </span>
    ) : null}
  </p>
) : null}

<style>
  /*
   * Rows are laid out by flex so each wrapped row owns its own 44px band: the
   * link boxes of adjacent rows never overlap and a tap on one link cannot be
   * captured by the next row. (44px is the WCAG 2.5.5 AAA target; 2.5.8 AA
   * needs 24px.) Each source is one unit, the separator that PRECEDES it plus
   * the link, so a "·" can begin a wrapped row but never end one.
   */
  .sources-line {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    column-gap: 0.25rem;
    row-gap: 0;
    margin: 0;
    font-size: var(--size-2);
    line-height: 1.6;
    color: var(--text-muted);
  }

  .sources-line__label,
  .sources-line__reviewed {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
  }

  /* F5: the flex box drops the text-node space before <time>. */
  .sources-line__reviewed {
    column-gap: 0.25em;
  }

  .sources-line__current {
    display: inline-flex;
    align-items: center;
    align-self: stretch;
    font-weight: 600;
    color: var(--text-secondary);
  }

  .sources-line__item {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
  }

  /* TRU-13: separators are decoration, drawn by CSS, so they add no stray
     whitespace to the text and leave the DOM text exactly the sources. The
     dot belongs to the item it introduces: it can begin a wrapped row but it
     never ends one (no orphan "·" at a line end). */
  .sources-line__item + .sources-line__item::before {
    content: "\00b7";
    content: "\00b7" / "";
    margin-inline-end: 0.375rem;
    white-space: nowrap;
  }

  /* The closing full stop of the source list hugs the last link (it is only
     present when a review date follows). */
  .sources-line__item--last::after {
    content: ".";
    content: "." / "";
  }

  .sources-line__link {
    display: inline-flex;
    align-items: center;
    align-self: stretch;
    font-weight: 600;
    color: var(--action-primary);
    text-decoration: underline;
    text-underline-offset: 3px;
    overflow-wrap: anywhere;
  }

  .sources-line__link:hover {
    text-decoration: none;
  }
</style>
