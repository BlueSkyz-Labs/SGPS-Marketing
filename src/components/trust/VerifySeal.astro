---
/**
 * VerifySeal — decorative verification mark for the Verify page.
 *
 * A static CSS-only mark. Purely presentational;
 * it marks the page's identity, not a certification of any specific claim.
 */
import type { Language } from "@/data/site";

interface Props {
  lang: Language;
}

const { lang } = Astro.props;

const LABEL: Record<Language, string> = {
  en: "Verify",
  vi: "Xác minh",
  zh: "验证",
  "zh-hant": "驗證",
};
---

<div class="verify-seal" aria-hidden="true">
  <svg
    class="verify-seal__ring"
    viewBox="0 0 120 120"
    fill="none"
    role="presentation"
  >
    <circle
      cx="60"
      cy="60"
      r="56"
      stroke="currentColor"
      stroke-width="3"
      stroke-dasharray="8 6"
      class="verify-seal__dash"
    />
    <circle
      cx="60"
      cy="60"
      r="44"
      stroke="currentColor"
      stroke-width="1.5"
      opacity="0.5"
    />
    <path
      d="M42 61.5 54 73l24-28"
      stroke="currentColor"
      stroke-width="5"
      stroke-linecap="round"
      stroke-linejoin="round"
      class="verify-seal__check"
    />
  </svg>
  <span class="verify-seal__label">{LABEL[lang]}</span>
</div>

<style>
  .verify-seal {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    color: var(--action-primary);
  }
  .verify-seal__ring {
    width: 5rem;
    height: 5rem;
  }
  .verify-seal__dash {
    transform-origin: 60px 60px;
  }
  .verify-seal__check {
    stroke-dasharray: 60;
    stroke-dashoffset: 0;
  }
  .verify-seal__label {
    font-size: var(--size-1);
    font-weight: 700;
    letter-spacing: 0.2em;
  }
</style>
