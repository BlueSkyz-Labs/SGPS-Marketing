---
/**
 * UI upgrade F12: the editorial frame shared by /security/ and /privacy/.
 * Phones and tablets read one column. From 1024 px the header and the primary
 * action sit in a lead column that stays in view while the facts column
 * scrolls beside it, separated by a quiet hairline. DOM order is lead first,
 * so the visual order always matches the reading order (WCAG 1.3.2).
 */
import Container from "@/components/layout/Container.astro";

interface Props {
  page: "security" | "privacy";
}
const { page } = Astro.props;
---

<section class="trust-page" data-trust-page={page}>
  <Container>
    <div class="trust-layout">
      <div class="trust-layout__lead">
        <slot name="lead" />
      </div>
      <div class="trust-layout__body">
        <slot />
      </div>
    </div>
  </Container>
</section>

<style>
  .trust-page {
    padding-block: 4rem;
  }
  .trust-layout {
    display: grid;
    gap: 2.5rem;
  }
  .trust-layout__lead,
  .trust-layout__body {
    min-width: 0;
  }
  @media (min-width: 64rem) {
    .trust-page {
      padding-block: 6rem;
    }
    .trust-layout {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: 0;
      align-items: start;
    }
    .trust-layout__lead {
      position: sticky;
      top: 7rem;
      padding-inline-end: 3.5rem;
    }
    .trust-layout__body {
      padding-inline-start: 3.5rem;
      border-inline-start: 1px solid var(--border-subtle);
    }
  }
</style>
