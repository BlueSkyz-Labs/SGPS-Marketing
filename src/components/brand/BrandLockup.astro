---
import { BRAND_ASSETS } from "@/data/brand";

interface Props {
  size?: "header" | "hero" | "footer";
  href?: string;
  /** Light or dark surface polarity; runtime asset mapping is centralized. */
  surface?: "porcelain" | "ink";
}

const { size = "header", href, surface = "porcelain" } = Astro.props;

type LockupGeometry = {
  height: number;
  width: number;
  src: string;
};

function lockupGeometry(
  value: "header" | "hero" | "footer",
  surfaceValue: "porcelain" | "ink",
): LockupGeometry {
  // Current fallback lockup viewBox ≈ 900×190 → aspect ~4.737.
  const onInk = surfaceValue === "ink" || value === "footer";
  const src = onInk
    ? BRAND_ASSETS.lockupHorizontalLight
    : BRAND_ASSETS.lockupHorizontalDark;

  switch (value) {
    case "header":
      return { height: 28, width: 133, src };
    case "hero":
      return { height: 44, width: 208, src };
    case "footer":
      return { height: 28, width: 133, src };
    default: {
      const _exhaustive: never = value;
      return _exhaustive;
    }
  }
}

const geometry = lockupGeometry(size, surface);
const Tag = href ? "a" : "p";
const className = [
  "brand-lockup inline-flex min-h-11 items-center no-underline",
  size === "header" && "brand-signal",
  size === "hero" && "brand-signal",
]
  .filter(Boolean)
  .join(" ");
---

<Tag href={href} class={className} aria-label="BlueSkyz Labs">
  <img
    src={geometry.src}
    alt="BlueSkyz Labs"
    width={geometry.width}
    height={geometry.height}
    class="block h-auto max-w-full"
    decoding="async"
  />
</Tag>
