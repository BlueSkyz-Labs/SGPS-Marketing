---
interface Props {
  size?: "header" | "hero" | "footer";
  href?: string;
  /** Porcelain (default) or Ink surfaces — picks outlined lockup polarity. */
  surface?: "porcelain" | "ink";
}

const { size = "header", href, surface = "porcelain" } = Astro.props;

type LockupGeometry = {
  height: number;
  width: number;
  src: string;
};

function lockupGeometry(
  value: "header" | "hero" | "footer",
  surfaceValue: "porcelain" | "ink",
): LockupGeometry {
  // v4 horizontal lockup viewBox 1650×520 → aspect ~3.173.
  const onInk = surfaceValue === "ink" || value === "footer";
  const src = onInk
    ? "/brand/blueskyz/v4/logos/horizontal-reverse-white.svg"
    : "/brand/blueskyz/v4/logos/horizontal-flat-light.svg";

  switch (value) {
    case "header":
      return { height: 50, width: 160, src };
    case "hero":
      return { height: 76, width: 240, src };
    case "footer":
      return { height: 50, width: 160, src };
    default: {
      const _exhaustive: never = value;
      return _exhaustive;
    }
  }
}

const geometry = lockupGeometry(size, surface);
const Tag = href ? "a" : "p";
const className = [
  "brand-lockup inline-flex min-h-11 items-center no-underline",
  size === "header" && "brand-signal",
  size === "hero" && "brand-signal",
]
  .filter(Boolean)
  .join(" ");
---

<Tag href={href} class={className} aria-label="BlueSkyz Labs">
  <img
    src={geometry.src}
    alt="BlueSkyz Labs"
    width={geometry.width}
    height={geometry.height}
    class="block h-auto max-w-full"
    decoding="async"
  />
</Tag>
