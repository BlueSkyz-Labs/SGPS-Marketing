---
import { CLAIMS } from "@/data/claims";
import Dateline from "@/components/shared/Dateline.astro";
import { getPublicProvenance } from "@/lib/provenance-lens";
import type { Language } from "@/lib/dossier";

interface SourceRequest {
  id: string;
}

interface Props {
  lang: Language;
  entries?: readonly SourceRequest[];
}

const { lang, entries = CLAIMS.map((claim) => ({ id: claim.id })) } =
  Astro.props;

const LABELS: Record<
  Language,
  { heading: string; sources: string; freshness: string; unknown: string }
> = {
  en: {
    heading: "Sources and freshness",
    sources: "Published sources",
    freshness: "Last reviewed",
    unknown: "No canonical public source is published for this item.",
  },
  vi: {
    heading: "Nguồn và độ mới",
    sources: "Nguồn đã công bố",
    freshness: "Rà soát gần nhất",
    unknown: "Chưa công bố nguồn công khai chuẩn cho mục này.",
  },
  zh: {
    heading: "来源与时效",
    sources: "已发布来源",
    freshness: "最近复核",
    unknown: "尚未为此条目发布规范公开来源。",
  },
  "zh-hant": {
    heading: "來源與時效",
    sources: "已發布來源",
    freshness: "最近複核",
    unknown: "尚未為此條目發布規範公開來源。",
  },
};

const labels = LABELS[lang];
const statements = new Map(
  CLAIMS.map((claim) => [claim.id, claim.statement?.[lang]] as const),
);
const resolved = entries.map((entry) => ({
  id: entry.id,
  statement: statements.get(entry.id) ?? null,
  provenance: getPublicProvenance(entry.id, lang),
}));
---

<section class="c4-dossier-sources" data-dossier-sources>
  <h2>{labels.heading}</h2>
  {resolved.map(({ id, statement, provenance }) =>
    provenance && !provenance.unknown ? (
      <article data-dossier-source={id}>
        <h3>{provenance.statementLabel ?? provenance.statement}</h3>
        {provenance.sourceRefs.length > 0 && (
          <div data-dossier-source-group>
            <h4>{labels.sources}</h4>
            <ul>
              {provenance.sourceRefs.map((source) => (
                <li>
                  <a data-dossier-source-link href={source.href}>
                    {source.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )}
        {provenance.freshness && (
          <p data-dossier-freshness={provenance.freshness}>
            {labels.freshness}:{" "}
            <Dateline
              iso={provenance.freshness}
              lang={lang}
              class="dateline--inherit"
            />
          </p>
        )}
      </article>
    ) : (
      <article data-dossier-source-unknown={id}>
        {statement && <h3>{statement}</h3>}
        <p>{labels.unknown}</p>
      </article>
    ),
  )}
</section>

<style is:global>
  /* Sources and freshness: same card grammar, one scale. */
  .c4-dossier-sources {
    max-width: var(--container-reading);
    margin-block-start: var(--space-12);
    padding-block-start: var(--space-8);
    border-top: 1px solid var(--c4-hairline);
  }

  .c4-dossier-sources > h2 {
    margin: 0 0 var(--space-4);
    font-size: var(--size-6);
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--text-primary);
  }

  .c4-dossier-sources > article {
    margin-block-end: var(--space-3);
    padding: var(--space-4);
    border: 1px solid var(--border-subtle);
    border-radius: 0.5rem;
    background: var(--surface-raised);
    font-size: var(--size-2);
    color: var(--text-secondary);
  }

  .c4-dossier-sources h3 {
    margin: 0 0 var(--space-2);
    font-size: var(--size-3);
    font-weight: 600;
    line-height: 1.4;
    color: var(--text-primary);
  }

  .c4-dossier-sources h4 {
    margin: var(--space-2) 0 var(--space-1);
    font-size: var(--size-1);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  /* Vietnamese: sentence case (cross-subset kerning, see .eyebrow). */
  :lang(vi) .c4-dossier-sources h4 {
    text-transform: none;
    letter-spacing: var(--tracking-eyebrow, 0.03em);
  }

  .c4-dossier-sources ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .c4-dossier-sources p {
    margin: var(--space-2) 0 0;
  }

  .c4-dossier-sources a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-weight: 600;
    color: var(--action-primary);
  }
</style>
