---
import type { Language } from "@/lib/dossier";

/**
 * C4-C Task 2 — dossier preview shell.
 *
 * The shell is server-rendered and empty by default: the client module fills it
 * by cloning the composer's rendered entry templates, so the preview can never
 * contain anything the server did not already publish.
 */
interface Props {
  lang: Language;
}

const { lang } = Astro.props;

const LABELS: Record<
  Language,
  {
    heading: string;
    empty: string;
    unknown: string;
    invalidRequest: string;
  }
> = {
  en: {
    heading: "Preview",
    empty:
      "Nothing selected yet. Choose published items above to assemble the view.",
    unknown: "Requested items that are not published were ignored",
    invalidRequest: "The requested selection was too large and was ignored.",
  },
  vi: {
    heading: "Xem trước",
    empty:
      "Chưa chọn mục nào. Hãy chọn các mục đã công bố ở trên để dựng bản xem trước.",
    unknown: "Các mục được yêu cầu nhưng chưa công bố đã bị bỏ qua",
    invalidRequest: "Yêu cầu lựa chọn quá lớn nên đã bị bỏ qua.",
  },
  zh: {
    heading: "预览",
    empty: "尚未选择任何条目。请在上方选择已发布条目以组装视图。",
    unknown: "请求但未发布的条目已被忽略",
    invalidRequest: "请求的选择内容过大，已被忽略。",
  },
  "zh-hant": {
    heading: "預覽",
    empty: "尚未選擇任何條目。請在上方選擇已發布條目以組裝檢視。",
    unknown: "請求但未發布的條目已被忽略",
    invalidRequest: "請求的選擇內容過大，已被忽略。",
  },
};

const labels = LABELS[lang];
---

<section class="c4-dossier-preview">
  <h3 class="c4-dossier__preview-heading">
    {labels.heading}
    <span class="c4-dossier__counter" data-dossier-counter>
      0
    </span>
  </h3>
  <ul class="c4-dossier__preview-list" data-dossier-preview data-empty></ul>
  <p class="c4-dossier__empty">{labels.empty}</p>
  <div class="c4-dossier__unknown-block" data-dossier-unknown-block hidden>
    <p class="c4-dossier__unknown-heading">{labels.unknown}</p>
    <ul
      class="c4-dossier__unknown-list"
      data-dossier-unknown
      data-dossier-invalid-message={labels.invalidRequest}
      hidden
    ></ul>
  </div>
</section>
