---
/**
 * Decorative national flag for the language control (inline SVG, 30x20).
 *
 * Owner decision, shared with the Sổ Trọ app: en -> United States,
 * vi -> Vietnam, zh (Simplified) -> China, zh-hant -> Hong Kong. Inline SVG on
 * purpose: Windows does not render flag emoji and an emoji flag would change
 * with the OS font. The flag is `aria-hidden`; the control's accessible name
 * stays the language name. Flag colours are the `--flag-*` tokens declared in
 * global.css, so no raw hex lives in a component (brand-token guard).
 */
import type { Language } from "@/lib/i18n";

type FlagCode = "VN" | "US" | "CN" | "HK";

const LANGUAGE_FLAG_CODE: Record<Language, FlagCode> = {
  en: "US",
  vi: "VN",
  zh: "CN",
  "zh-hant": "HK",
};

interface Props {
  language: Language;
  class?: string;
}

const { language, class: className } = Astro.props;
const code = LANGUAGE_FLAG_CODE[language];

const WIDTH = 30;
const HEIGHT = 20;

/** Five-point star; `turn` rotates the apex clockwise from "up", in degrees. */
function starPath(cx: number, cy: number, outer: number, turn = 0): string {
  const inner = outer * 0.382;
  const points: string[] = [];
  for (let i = 0; i < 10; i += 1) {
    const radius = i % 2 === 0 ? outer : inner;
    const angle = ((turn + i * 36) * Math.PI) / 180;
    points.push(
      `${(cx + radius * Math.sin(angle)).toFixed(2)} ${(cy - radius * Math.cos(angle)).toFixed(2)}`,
    );
  }
  return `M${points.join("L")}Z`;
}

const stripe = HEIGHT / 13;
const cantonWidth = 12.5;
const cantonHeight = stripe * 7;
const usStripes = Array.from({ length: 13 }, (_, i) => ({
  y: i * stripe,
  red: i % 2 === 0,
}));
const usDots = Array.from({ length: 20 }, (_, i) => ({
  cx: (cantonWidth / 6) * ((i % 5) + 1),
  cy: (cantonHeight / 5) * (Math.floor(i / 5) + 1),
}));

const big = { x: 6.2, y: 6 };
const smalls = [
  { x: 12.4, y: 2.2 },
  { x: 14.6, y: 4.8 },
  { x: 14.6, y: 8 },
  { x: 12.4, y: 10.6 },
].map((star) => ({
  ...star,
  turn: (Math.atan2(big.x - star.x, star.y - big.y) * 180) / Math.PI,
}));
---

<span class:list={["lang-flag", className]} aria-hidden="true" data-flag={code}>
  <svg
    focusable="false"
    viewBox={`0 0 ${WIDTH} ${HEIGHT}`}
    width={WIDTH}
    height={HEIGHT}
  >
    {code === "VN" && (
      <>
        <rect width={WIDTH} height={HEIGHT} class="f-red-vn" />
        <path d={starPath(15, 10.8, 6)} class="f-yellow-vn" />
      </>
    )}
    {code === "US" && (
      <>
        {usStripes.map((s) => (
          <rect
            y={s.y}
            width={WIDTH}
            height={stripe + 0.02}
            class={s.red ? "f-red-us" : "f-white"}
          />
        ))}
        <rect width={cantonWidth} height={cantonHeight} class="f-blue-us" />
        {usDots.map((d) => (
          <circle cx={d.cx} cy={d.cy} r="0.6" class="f-white" />
        ))}
      </>
    )}
    {code === "CN" && (
      <>
        <rect width={WIDTH} height={HEIGHT} class="f-red-cn" />
        <path d={starPath(big.x, big.y, 3.6)} class="f-yellow-cn" />
        {smalls.map((s) => (
          <path d={starPath(s.x, s.y, 1.25, s.turn)} class="f-yellow-cn" />
        ))}
      </>
    )}
    {code === "HK" && (
      <>
        <rect width={WIDTH} height={HEIGHT} class="f-red-cn" />
        {[0, 72, 144, 216, 288].map((angle) => (
          <g transform={`rotate(${angle} 15 10)`}>
            <path
              d="M15 10C11.6 8.4 11.4 3.6 15 2.6C18.6 3.6 18.4 8.4 15 10Z"
              class="f-white"
            />
            <circle cx="15" cy="6" r="0.85" class="f-red-cn" />
          </g>
        ))}
      </>
    )}
    <rect
      x="0.5"
      y="0.5"
      width={WIDTH - 1}
      height={HEIGHT - 1}
      rx="4.5"
      fill="none"
      stroke-width="1"
      class="f-edge"
    ></rect>
  </svg>
</span>

<style>
  .lang-flag {
    display: inline-flex;
    flex-shrink: 0;
    overflow: hidden;
    border-radius: 4px;
    box-shadow:
      0 1px 2px rgba(15, 23, 42, 0.14),
      0 4px 10px -4px rgba(15, 23, 42, 0.3);
  }

  .lang-flag svg {
    display: block;
    width: 1.875rem;
    height: auto;
  }

  .f-white {
    fill: var(--flag-white);
  }
  .f-red-vn {
    fill: var(--flag-red-vn);
  }
  .f-yellow-vn {
    fill: var(--flag-yellow-vn);
  }
  .f-red-us {
    fill: var(--flag-red-us);
  }
  .f-blue-us {
    fill: var(--flag-blue-us);
  }
  .f-red-cn {
    fill: var(--flag-red-cn);
  }
  .f-yellow-cn {
    fill: var(--flag-yellow-cn);
  }
  .f-edge {
    stroke: color-mix(in srgb, var(--border-subtle) 70%, transparent);
  }

  @media (forced-colors: active) {
    .lang-flag {
      forced-color-adjust: none;
    }
  }
</style>
