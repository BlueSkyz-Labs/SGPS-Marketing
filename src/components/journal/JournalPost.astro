---
import Dateline from "@/components/shared/Dateline.astro";
import Container from "@/components/layout/Container.astro";
import PageHeader from "@/components/layout/PageHeader.astro";
import { AUTHORS } from "@/data/authors";
import JOURNAL_ART from "@/data/journal-art.json";
import { JOURNAL_COPY, JOURNAL_POST_COPY } from "@/data/journal-copy";
import {
  journalArtVariant,
  journalFeedPath,
  journalIndexPath,
  partitionSources,
} from "@/lib/journal-posts";
import type { JournalEntry } from "@/lib/journal-schema";

/**
 * Journey P1-A: one journal post (VI or EN). The Markdown body arrives as the
 * rendered `Content` component of the collection entry. Static HTML only:
 * no client script, no third-party embed. Sources are external https links or
 * plain evidence ids (no evidence anchor route exists for `ev-*` ids).
 *
 * Press standard (docs/editorial/JOURNAL_PRESS_STANDARD.md R1): byline with
 * the engraved portrait, lead illustration with caption and credit, drop cap,
 * end-of-article summary infographic, closing rights line. Figures are the
 * stamped renders listed in src/data/journal-art.json.
 */
interface Props {
  entry: JournalEntry;
  Content: (props: Record<string, unknown>) => unknown;
}

const { entry, Content } = Astro.props;
const lang = entry.lang;
const copy = JOURNAL_COPY[lang];
const post = JOURNAL_POST_COPY[lang];
const author = AUTHORS[entry.author];
const branchLabel = entry.branch === "news" ? copy.news : copy.product;
const { links, evidenceIds } = partitionSources(entry.sources);
/** A source's publisher label is data: the URL's hostname without `www.`. */
const sourceHost = (href: string): string | null => {
  try {
    return new URL(href).hostname.replace(/^www\./, "");
  } catch {
    return null;
  }
};
/** Intrinsic size of a stamped render, from the art manifest. */
const artSize = (src: string) => {
  const meta = (
    JOURNAL_ART as Record<string, { width: number; height: number }>
  )[src];
  if (!meta) throw new Error(`${src} is not in src/data/journal-art.json`);
  return meta;
};
const figures = (["hero", "infographic"] as const).flatMap((key) => {
  const art = entry[key];
  if (!art) return [];
  const full = artSize(art.src);
  const small = journalArtVariant(art.src, "1200");
  return [
    {
      key,
      ...art,
      width: full.width,
      height: full.height,
      srcset: `${small} ${artSize(small).width}w, ${art.src} ${full.width}w`,
    },
  ];
});
const hero = figures.find((f) => f.key === "hero");
const infographic = figures.find((f) => f.key === "infographic");
const rightsYear = entry.datePublished.slice(0, 4);
const modified =
  entry.dateModified && entry.dateModified !== entry.datePublished
    ? entry.dateModified
    : null;
---

<article class="py-12 sm:py-16" data-journal-post={entry.id}>
  <Container width="reading">
    <nav
      aria-label="Breadcrumb"
      class="text-sm font-medium text-[var(--text-muted)]"
    >
      <ol class="flex flex-wrap items-center gap-x-2">
        <li>
          <a
            href={journalIndexPath(lang)}
            class="breadcrumb-link inline-flex min-h-11 items-center text-sm font-semibold text-[var(--action-primary)] underline underline-offset-4 hover:no-underline"
          >
            {copy.title}
          </a>
        </li>
        <li aria-hidden="true" class="text-[var(--border-subtle)]">
          /
        </li>
        <li aria-current="page" class="text-[var(--text-primary)]">
          {entry.title}
        </li>
      </ol>
    </nav>

    <div class="journal-post__head mt-8">
      <PageHeader
        eyebrow={branchLabel}
        title={entry.title}
        lede={entry.description}
      />
    </div>

    <p class="journal-post__folio" data-journal-meta>
      <span>
        {post.published}{" "}
        <Dateline
          iso={entry.datePublished}
          lang={lang}
          class="dateline--inherit"
          data-journal-published
        />
      </span>
      {modified ? (
        <>
          <span aria-hidden="true">·</span>
          <span data-journal-updated>
            {post.updated}{" "}
            <Dateline iso={modified} lang={lang} class="dateline--inherit" />
            {entry.updateNote ? <span>{` · ${entry.updateNote}`}</span> : null}
          </span>
        </>
      ) : null}
      <span aria-hidden="true">·</span>
      <span class="journal-post__byline" data-journal-byline>
        <img
          src={author.avatar}
          alt=""
          width="24"
          height="24"
          decoding="async"
          class="journal-post__byline-portrait"
        />
        {author.name}
      </span>
    </p>

    {hero ? (
      <figure class="journal-figure journal-figure--hero" data-journal-hero>
        <img
          src={hero.src}
          srcset={hero.srcset}
          sizes="(min-width: 48rem) 46rem, 100vw"
          alt={hero.alt}
          width={hero.width}
          height={hero.height}
          fetchpriority="high"
          decoding="async"
          class="journal-figure__img"
        />
        <figcaption class="journal-figure__caption">
          {hero.caption ? <span>{hero.caption}</span> : null}
          <span class="journal-figure__credit" data-journal-credit>
            {post.figureCredit}
          </span>
        </figcaption>
      </figure>
    ) : null}

    <div class="journal-post__body mt-10" data-journal-body>
      <Content />
    </div>

    {infographic ? (
      <section
        class="journal-post__summary"
        aria-labelledby="journal-summary"
        data-journal-infographic
      >
        <h2 id="journal-summary" class="journal-post__section-title">
          {post.summary}
        </h2>
        <figure class="journal-figure">
          <img
            src={infographic.src}
            srcset={infographic.srcset}
            sizes="(min-width: 48rem) 46rem, 100vw"
            alt={infographic.alt}
            width={infographic.width}
            height={infographic.height}
            loading="lazy"
            decoding="async"
            class="journal-figure__img"
          />
          <figcaption class="journal-figure__caption">
            {infographic.caption ? <span>{infographic.caption}</span> : null}
            <span class="journal-figure__credit" data-journal-credit>
              {post.figureCredit}
            </span>
          </figcaption>
        </figure>
      </section>
    ) : null}

    <section
      class="journal-post__sources"
      aria-labelledby="journal-sources"
      data-journal-sources
    >
      <h2 id="journal-sources" class="journal-post__section-title">
        {post.sources}
      </h2>
      <ul class="journal-post__sources-list">
        {links.map((href) => (
          <li class="journal-post__source-item">
            {sourceHost(href) ? (
              <span class="journal-post__source-host" data-journal-source-host>
                {sourceHost(href)}
              </span>
            ) : null}
            <a
              href={href}
              rel="noopener"
              target="_blank"
              class="journal-post__source"
              data-journal-source
            >
              {href}
            </a>
          </li>
        ))}
        {evidenceIds.map((id) => (
          <li class="journal-post__source-item" data-journal-evidence-id>
            <code>{id}</code>
          </li>
        ))}
      </ul>
    </section>

    <aside
      class="journal-author"
      aria-label={post.aboutAuthor}
      data-journal-author={entry.author}
    >
      <img
        src={author.avatar}
        alt={author.avatarAlt[lang]}
        width="64"
        height="64"
        loading="lazy"
        decoding="async"
        class="journal-author__avatar"
      />
      <div class="journal-author__text">
        <p class="journal-author__name">{author.name}</p>
        <p class="journal-author__role">{author.role[lang]}</p>
        <p class="journal-author__bio">{author.bio[lang].short}</p>
        <a href={author.aboutPath[lang]} class="journal-author__link">
          {post.aboutAuthor}
        </a>
      </div>
    </aside>

    <p class="journal-post__rights" data-journal-rights>
      {post.copyright.replace("{year}", rightsYear)}
    </p>

    <p class="journal-post__end">
      <a href={journalIndexPath(lang)}>{post.backToJournal}</a>
      <a href={journalFeedPath(lang)}>{post.rss}</a>
    </p>
  </Container>
</article>

<style>
  /* IX-08: the title block takes the column's measure, the same as the body,
     instead of the page header's own rem caps. */
  .journal-post__head :global(.page-header),
  .journal-post__head :global(.page-header__title),
  .journal-post__head :global(.page-header__lede) {
    max-width: none;
  }
  /* Wave G1: a quiet folio line under the header, hairline below the header's rule. */
  .journal-post__folio {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 var(--space-2);
    margin: var(--space-6) 0 0;
    padding-block: var(--space-3);
    /* The header's horizon rule is the only rule above the folio line. */
    border-block-end: 1px solid var(--c4-hairline);
    font-size: var(--c4-type-meta);
    font-variant-numeric: tabular-nums;
    color: var(--text-secondary);
  }
  .journal-post__byline {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-weight: 600;
    color: var(--text-primary);
  }
  .journal-post__byline-portrait {
    inline-size: 1.5rem;
    block-size: 1.5rem;
    border-radius: 50%;
  }
  /* Press standard R1: figures sit on the reading column with a hairline
     caption rule; the credit names the rights holder. */
  .journal-figure {
    margin: var(--space-8) 0 0;
  }
  .journal-figure__img {
    display: block;
    inline-size: 100%;
    block-size: auto;
    border: 1px solid var(--c4-hairline);
    border-radius: var(--radius-media);
    background: var(--surface-subtle);
  }
  .journal-figure__caption {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-1) var(--space-4);
    margin-block-start: var(--space-3);
    padding-block-start: var(--space-2);
    border-block-start: 1px solid var(--c4-hairline);
    font-size: var(--c4-type-meta);
    color: var(--text-secondary);
  }
  .journal-figure__credit {
    font-weight: 600;
    letter-spacing: 0.02em;
  }
  .journal-post__summary {
    margin-block-start: var(--space-12);
    padding-block-start: var(--space-6);
    border-block-start: 1px solid var(--c4-hairline);
  }
  .journal-post__summary .journal-figure {
    margin-block-start: var(--space-4);
  }
  .journal-post__rights {
    margin: var(--space-8) 0 0;
    font-size: var(--c4-type-meta);
    color: var(--text-secondary);
  }
  /* Sources: the publisher hostname leads; the full URL stays visible as the
     link text, wrapping anywhere, in the quiet meta tone. */
  .journal-post__sources {
    margin-block-start: var(--space-12);
    padding-block-start: var(--space-6);
    border-block-start: 1px solid var(--c4-hairline);
  }
  .journal-post__section-title {
    margin: 0;
    font-size: var(--c4-type-evidence);
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  .journal-post__sources-list {
    display: grid;
    gap: var(--space-4);
    margin: var(--space-4) 0 0;
    padding: 0;
    list-style: none;
  }
  .journal-post__source-item {
    display: grid;
    gap: 0.125rem;
    min-width: 0;
  }
  .journal-post__source-host {
    font-size: var(--c4-type-meta);
    font-weight: 600;
    color: var(--text-primary);
  }
  /* IX-08: the full URL stays visible as the link text; it wraps anywhere so
     a long address never widens the column, in the quiet meta-text tone. */
  .journal-post__source {
    overflow-wrap: anywhere;
    font-size: var(--c4-type-meta);
    color: var(--text-secondary);
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .journal-post__source:hover {
    text-decoration: none;
  }
  .journal-post__source-item code {
    font-size: var(--c4-type-meta);
    overflow-wrap: anywhere;
    color: var(--text-secondary);
  }
  .journal-post__body {
    font-size: var(--c4-type-reading);
    color: var(--text-primary);
    line-height: 1.75;
  }
  /* Press standard R1: drop cap on the opening paragraph. */
  .journal-post__body > :global(p:first-of-type)::first-letter {
    float: inline-start;
    margin: 0.08em var(--space-2) 0 0;
    font-size: 3.4em;
    font-weight: 700;
    line-height: 0.85;
    color: var(--text-primary);
  }
  /* Section heads: a hairline rule above, the newspaper section break. */
  .journal-post__body :global(h2) {
    margin-block: var(--space-12) var(--space-4);
    padding-block-start: var(--space-4);
    border-block-start: 1px solid var(--c4-hairline);
    font-size: var(--c4-type-product);
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.25;
  }
  .journal-post__body :global(h3) {
    margin-block: var(--space-8) var(--space-3);
    font-size: var(--c4-type-evidence);
    font-weight: 600;
    line-height: 1.3;
  }
  .journal-post__body :global(p),
  .journal-post__body :global(ul),
  .journal-post__body :global(ol),
  .journal-post__body :global(blockquote),
  .journal-post__body :global(pre) {
    margin-block: var(--space-4);
  }
  .journal-post__body :global(ul),
  .journal-post__body :global(ol) {
    padding-inline-start: var(--space-6);
  }
  .journal-post__body :global(ul) {
    list-style: disc;
  }
  .journal-post__body :global(ol) {
    list-style: decimal;
  }
  .journal-post__body :global(li + li) {
    margin-block-start: 0.375rem;
  }
  .journal-post__body :global(a) {
    color: var(--action-primary);
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .journal-post__body :global(a:hover) {
    text-decoration: none;
  }
  .journal-post__body :global(blockquote) {
    padding-inline-start: var(--space-4);
    border-inline-start: 2px solid var(--c4-hairline);
    color: var(--text-secondary);
  }
  .journal-post__body :global(code) {
    font-size: 0.9em;
  }
  .journal-post__body :global(pre) {
    overflow-x: auto;
  }
  /* Author card: hairline, 48 px portrait, name / role / bio in the C4 roles. */
  .journal-author {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: var(--space-4);
    margin-block-start: var(--space-12);
    padding-block-start: var(--space-6);
    border-block-start: 1px solid var(--c4-hairline);
  }
  .journal-author__avatar {
    flex: none;
    inline-size: 3rem;
    block-size: 3rem;
    border-radius: 50%;
  }
  .journal-author__text {
    flex: 1 1 15rem;
    min-width: 0;
  }
  .journal-author__name,
  .journal-author__role,
  .journal-author__bio {
    margin: 0;
  }
  .journal-author__name {
    font-size: var(--c4-type-reading);
    font-weight: 600;
    color: var(--text-primary);
  }
  .journal-author__role {
    font-size: var(--c4-type-meta);
    color: var(--text-secondary);
  }
  .journal-author__bio {
    max-width: var(--c4-reading-measure);
    margin-block-start: var(--space-3);
    color: var(--text-secondary);
  }
  .journal-author__link {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    font-size: var(--c4-type-meta);
    font-weight: 600;
    color: var(--action-primary);
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .journal-author__link:hover {
    text-decoration: none;
  }
  /* Back / RSS row: hairline above, meta tone, links quiet until hovered. */
  .journal-post__end {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-6);
    margin: var(--space-8) 0 0;
    padding-block-start: var(--space-3);
    border-block-start: 1px solid var(--c4-hairline);
    font-size: var(--c4-type-meta);
  }
  .journal-post__end a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    font-weight: 600;
    color: var(--text-secondary);
    text-decoration: none;
  }
  .journal-post__end a:hover,
  .journal-post__end a:focus-visible {
    color: var(--text-primary);
    text-decoration: underline;
    text-underline-offset: 4px;
  }
</style>
