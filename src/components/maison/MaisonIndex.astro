---
import { getCollection } from "astro:content";
import { getMaisonSections } from "@/lib/maison";
import { SHARED_LABELS, labelFor, type Language } from "@/data/site";

/**
 * C4-B G1 — Maison orientation surface.
 *
 * A calm index of the public house surfaces, built from the maison adapter.
 * It is orientation, not navigation: one named landmark, real routes only, and
 * no duplicated primary-nav semantics.
 */
interface Props {
  lang?: Language;
}

const { lang = "en" } = Astro.props;
const sections = getMaisonSections(lang, await getCollection("journal"));
const heading = labelFor(SHARED_LABELS.houseIndex, lang);
---

{sections.length > 0 && (
  <nav class="c4-maison" aria-label={heading} data-maison-index>
    <ol class="c4-maison__list">
      {sections.map((section, index) => (
        <li class="c4-maison__item" data-maison-section={section.id}>
          <span class="c4-maison__ordinal" aria-hidden="true">
            {String(index + 1).padStart(2, "0")}
          </span>
          <a class="c4-maison__link" href={section.href}>
            {section.label}
          </a>
        </li>
      ))}
    </ol>
  </nav>
)}

<style is:global>
  @media print {
    .c4-maison {
      display: none;
    }
  }

  /* ---- C4-B G1 — Maison orientation surface ---- */

  .c4-maison {
    padding-block: var(--space-12);
    border-top: 1px solid var(--c4-hairline);
  }

  .c4-maison__list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4) var(--space-8);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .c4-maison__item {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
  }

  .c4-maison__ordinal {
    font-size: var(--c4-type-meta);
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.08em;
    color: var(--text-muted);
  }

  .c4-maison__link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: var(--c4-type-reading);
    color: inherit;
    text-decoration: none;
  }

  .c4-maison__link:hover {
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }

  @media (max-width: 47.99rem) {
    .c4-maison__list {
      flex-direction: column;
      gap: var(--space-2);
    }
  }

  @media print {
    .c4-maison {
      display: none;
    }
  }
</style>
