/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), browsing-topics=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; img-src 'self' data:; media-src 'self'; font-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'inline-speculation-rules'; connect-src 'self'; form-action 'self'; upgrade-insecure-requests; require-trusted-types-for 'script'
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-site

# Astro emits content-hashed filenames under /_astro/, so they are immutable.
/_astro/*
  Cache-Control: public, max-age=3153600, immutable

# Versioned font files, product art, icons and brand SVGs are content-stable:
# a new asset ships under a new filename, so these are immutable too.
# (Perf audit 2026-10-08: repeat-visit win on every page.)
/fonts/*
  Cache-Control: public, max-age=3153600, immutable
/products/*
  Cache-Control: public, max-age=3153600, immutable
/icons/*
  Cache-Control: public, max-age=3153600, immutable
/brand/*
  Cache-Control: public, max-age=3153600, immutable

# Stable workers.dev host (baked SITE.url may be a custom domain while this host still serves the same dist).
https://blueskyz-web.thinhnguyen-km10.workers.dev/*
  X-Robots-Tag: noindex

# Versioned Workers preview URLs: https://:version.:worker.:account.workers.dev/
https://:version.:worker.:account.workers.dev/*
  X-Robots-Tag: noindex
