/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  X-Permitted-Cross-Domain-Policies: none
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), browsing-topics=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; img-src 'self' data:; media-src 'self'; font-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'inline-speculation-rules' https://static.cloudflareinsights.com/beacon.min.js/; connect-src 'self'; form-action 'self'; upgrade-insecure-requests; require-trusted-types-for 'script'
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-site

# RFC 9116 section 3: security.txt must declare its charset (file contains non-ASCII).
/.well-known/security.txt
  Content-Type: text/plain; charset=utf-8

# Astro emits content-hashed filenames under /_astro/, so they are immutable.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Font filenames include their upstream version; the stable public assets below
# can be replaced in place, so let browsers refresh them regularly.
/fonts/*.woff2
  Cache-Control: public, max-age=31536000, immutable
/products/*
  Cache-Control: public, max-age=3600
/icons/*
  Cache-Control: public, max-age=3600
/brand/*
  Cache-Control: public, max-age=3600

# Stable workers.dev host (baked SITE.url may be a custom domain while this host still serves the same dist).
https://blueskyz-web.thinhnguyen-km10.workers.dev/*
  X-Robots-Tag: noindex

# Versioned Workers preview URLs: https://:version.:worker.:account.workers.dev/
https://:version.:worker.:account.workers.dev/*
  X-Robots-Tag: noindex
