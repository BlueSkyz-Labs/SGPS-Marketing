{
  "name": "blueskyz-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "BlueSkyz Labs Web — C1.1 Porcelain-first, Trust-forward Hybrid Product House",
  "author": "BlueSkyz Labs",
  "license": "UNLICENSED",
  "packageManager": "pnpm@11.25.0+sha512.5cde925b4f075f725eb71fbae18a42ffe784524789f19b61c731cb8721ec28aaee160e01a8d5af4fedb2a42cdbf300efe23db356b0d4a17b4d63e11f8ab7c956",
  "engines": {
    "node": ">=24.20.0",
    "pnpm": ">=11.25.0 <12"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build && node scripts/verify-static-export.mjs",
    "start": "node scripts/run-preview.mjs",
    "typecheck": "astro check",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix --max-warnings=0",
    "format": "prettier --write \"**/*.{astro,ts,tsx,js,mjs,json,md,css,yaml,yml}\"",
    "format:check": "prettier --check \"**/*.{astro,ts,tsx,js,mjs,json,md,css,yaml,yml}\"",
    "test:architecture": "node --test tests/architecture/*.test.mjs",
    "architecture:views": "node scripts/generate-architecture-views.mjs",
    "architecture:views:check": "node scripts/generate-architecture-views.mjs --check",
    "test:e2e:install": "playwright install chromium firefox webkit",
    "test:e2e": "node scripts/build-parity-fixture.mjs && playwright test --project=chromium --project=firefox --project=webkit --project=mobile-chromium",
    "check:client-budget": "node scripts/check-client-budget.mjs",
    "check:static-links": "node scripts/check-static-links.mjs",
    "check:publishability": "node scripts/check-publishability.mjs",
    "check:integrity-firewall": "node scripts/check-integrity-firewall.mjs",
    "verify:git-evidence": "node scripts/verify-git-evidence.mjs",
    "check:promotion-state": "node scripts/check-promotion-state.mjs",
    "check:deployment-evidence": "node scripts/validate-deployment-evidence.mjs",
    "check:product-provenance": "node scripts/check-product-provenance.mjs",
    "e4:matrix": "node scripts/e4-matrix.mjs",
    "deploy:workers": "node scripts/deploy-workers.mjs",
    "lighthouse": "node scripts/run-lighthouse.mjs",
    "prepare": "git config core.hooksPath .githooks || true",
    "validate:public-truth": "node scripts/validate-public-truth.mjs"
  },
  "dependencies": {
    "astro": "^7.3.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.6",
    "@axe-core/playwright": "4.13.0",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.9.0",
    "eslint": "^10.10.0",
    "eslint-plugin-astro": "^1.5.0",
    "postcss": "^8.5.28",
    "prettier": "^3.3.3",
    "prettier-plugin-astro": "^0.14.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "wrangler": "4.129.0"
  }
}
