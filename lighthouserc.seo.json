{
  "ci": {
    "collect": {
      "url": [
        "http://127.0.0.1:3000/en/",
        "http://127.0.0.1:3000/vi/",
        "http://127.0.0.1:3000/en/products/",
        "http://127.0.0.1:3000/vi/products/sotro/"
      ],
      "numberOfRuns": 3,
      "startServerCommand": "pnpm start",
      "startServerReadyTimeout": 60000,
      "settings": {
        "chromeFlags": "--no-sandbox",
        "onlyCategories": ["seo"],
        "disableFullPageScreenshot": true
      }
    },
    "assert": {
      "assertions": {
        "categories:seo": ["error", { "minScore": 0.95 }],
        "is-crawlable": "error",
        "canonical": "error",
        "hreflang": "error",
        "http-status-code": "error",
        "document-title": "error",
        "meta-description": "error",
        "robots-txt": "error",
        "crawlable-anchors": "error",
        "link-text": "error",
        "image-alt": "error"
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci-seo"
    }
  }
}
